<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <AssemblyName>MONOLITH</AssemblyName>
    <RootNamespace>Monolith</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\monolith.ico</ApplicationIcon>

    <Product>MONOLITH</Product>
    <Company>MONOLITH</Company>
    <Description>MONOLITH — безопасная оптимизация Windows для работы и игр</Description>
    <Copyright>© 2026 MONOLITH</Copyright>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <NeutralLanguage>ru-RU</NeutralLanguage>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
    <!-- WPF + WMI COM interop: trimming is not supported -->
    <PublishTrimmed>false</PublishTrimmed>
    <NoWarn>$(NoWarn);CA1416;NU1510</NoWarn>
  </PropertyGroup>

  <!-- Release publish: one self-contained exe that runs on any Windows 10/11 x64 without installing .NET -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Management" Version="10.0.14" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*.png" />
    <Resource Include="Assets\monolith.ico" />
    <Content Include="Data\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- English translation tables: one JSON file per area (docs/localization.md). Embedded, so single-file publish works. -->
  <ItemGroup>
    <EmbeddedResource Include="Core\Localization\en\*.json" LogicalName="Monolith.Loc.en.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Loc is available in every file without a using (docs/localization.md) -->
  <ItemGroup>
    <Using Include="Monolith.Core.Localization" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Monolith.Tests" />
  </ItemGroup>

</Project>
