<UserControl x:Class="Monolith.UI.Controls.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Monolith.UI.Controls"
             x:Name="Root">
    <!--
        Compact header, one band:  ОПТИМИЗАЦИЯ                       [actions]
                                   one muted line of subtitle
        Embedded (PageHeader.IsEmbedded inherited from a host page): only [actions], right-aligned.
    -->
    <UserControl.Resources>
        <Style x:Key="HideWhenEmbedded" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding (c:PageHeader.IsEmbedded), ElementName=Root}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding (c:PageHeader.IsEmbedded), ElementName=Root}" Value="True">
                        <!-- Leaves room for the host's tabs, which sit on the same line. -->
                        <Setter Property="MinHeight" Value="32" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Style="{StaticResource HideWhenEmbedded}" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title, ElementName=Root, Converter={StaticResource Sentence}}" Style="{StaticResource T.Display}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Subtitle, ElementName=Root}" Style="{StaticResource T.Caption}" Margin="0,3,0,0"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle, ElementName=Root}" />
        </StackPanel>
        <ContentPresenter Grid.Column="1" Content="{Binding Actions, ElementName=Root}" VerticalAlignment="Center" Margin="20,0,0,0" />
    </Grid>
</UserControl>
