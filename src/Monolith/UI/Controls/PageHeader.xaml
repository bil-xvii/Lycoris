<UserControl x:Class="Monolith.UI.Controls.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!--
        [02] ───────────────────────────────
        ОПТИМИЗАЦИЯ                    [actions]
        subtitle
    -->
    <StackPanel>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource B.White}" Padding="6,1,6,2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Index, ElementName=Root}" FontFamily="{StaticResource F.Mono}" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource B.Ink}" />
            </Border>
            <Rectangle Grid.Column="1" Height="1" Fill="{StaticResource B.Line2}" VerticalAlignment="Center" Margin="10,0" />
            <Border Grid.Column="2" Width="44" Height="8" Background="{StaticResource B.HatchStrong}" VerticalAlignment="Center" />
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource T.Display}" />
                <TextBlock Text="{Binding Subtitle, ElementName=Root}" Style="{StaticResource T.Body}" Margin="0,6,0,0" MaxWidth="760"
                           HorizontalAlignment="Left" />
            </StackPanel>
            <ContentPresenter Grid.Column="1" Content="{Binding Actions, ElementName=Root}" VerticalAlignment="Bottom" Margin="24,0,0,2" />
        </Grid>
    </StackPanel>
</UserControl>
