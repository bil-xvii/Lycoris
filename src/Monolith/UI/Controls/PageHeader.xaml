<UserControl x:Class="Monolith.UI.Controls.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Monolith.UI.Controls"
             x:Name="Root">
    <!--
        ──────────────────────────────── ▨▨
        ОПТИМИЗАЦИЯ                    [actions]
        subtitle

        Embedded (PageHeader.IsEmbedded inherited from a host page): only [actions], right-aligned.
    -->
    <UserControl.Resources>
        <Style x:Key="HideWhenEmbedded" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding (c:PageHeader.IsEmbedded), ElementName=Root}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Grid Margin="0,0,0,10" Style="{StaticResource HideWhenEmbedded}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Rectangle Height="1" Fill="{StaticResource B.Line2}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Border Grid.Column="1" Width="44" Height="8" Background="{StaticResource B.HatchStrong}" VerticalAlignment="Center" />
        </Grid>
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding (c:PageHeader.IsEmbedded), ElementName=Root}" Value="True">
                            <!-- Leaves room for the host's tabs, which sit on the same line. -->
                            <Setter Property="MinHeight" Value="36" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Style="{StaticResource HideWhenEmbedded}">
                <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource T.Display}" />
                <TextBlock Text="{Binding Subtitle, ElementName=Root}" Style="{StaticResource T.Body}" Margin="0,6,0,0" MaxWidth="760"
                           HorizontalAlignment="Left" />
            </StackPanel>
            <ContentPresenter Grid.Column="1" Content="{Binding Actions, ElementName=Root}" VerticalAlignment="Bottom" Margin="24,0,0,2" />
        </Grid>
    </StackPanel>
</UserControl>
