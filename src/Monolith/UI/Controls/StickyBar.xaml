<UserControl x:Class="Monolith.UI.Controls.StickyBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Monolith.UI"
             x:Name="Root">
    <!--
        The sticky action bar of a page, placed OUTSIDE the page's ScrollViewer (last grid row):
            ВЫБРАНО 26 · БУДЕТ ИЗМЕНЕНО 2   Перед применением покажем точный список…        [СНЯТЬ ВЫБОР] [✓ ПРИМЕНИТЬ · 2]
        Count/CountLabel = the number on the left; Text = one muted line; Actions = the buttons (last one = Btn.Hero).
    -->
    <Border Background="{StaticResource B.Surface2}" BorderBrush="{StaticResource B.Line2}" BorderThickness="1"
            CornerRadius="{StaticResource R.Lg}" ui:RoundClip.Content="True" Padding="14,8" MinHeight="54" SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding CountLabel, ElementName=Root}" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Count, ElementName=Root}" Margin="6,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource F.Display}"
                           FontWeight="Bold" FontSize="16" Foreground="{StaticResource B.Text}" />
                <TextBlock Text="·" Margin="10,0" Style="{StaticResource T.Label}" VerticalAlignment="Center"
                           Visibility="{Binding Detail, ElementName=Root, Converter={StaticResource NullToVis}}" />
                <TextBlock Text="{Binding Detail, ElementName=Root}" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center"
                           Visibility="{Binding Detail, ElementName=Root, Converter={StaticResource NullToVis}}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Text, ElementName=Root}" Style="{StaticResource T.Caption}" Margin="16,0" VerticalAlignment="Center"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, ElementName=Root}" />
            <ContentPresenter Grid.Column="2" Content="{Binding Actions, ElementName=Root}" VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
