<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Display: Bahnschrift (DIN-style, ships with Windows 10/11, Cyrillic) — condensed bold for headings.
        Body:    Segoe UI Variable.
        Mono:    Cascadia Mono → Consolas (numbers, logs, ids).
        Icons:   Segoe Fluent Icons (Win11) → Segoe MDL2 Assets (Win10).
    -->
    <FontFamily x:Key="F.Display">Bahnschrift</FontFamily>
    <FontFamily x:Key="F.Body">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Mono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="F.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Huge condensed title, e.g. page names -->
    <Style x:Key="T.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontStretch" Value="Condensed" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="LineHeight" Value="40" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>

    <Style x:Key="T.H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontStretch" Value="Condensed" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
    </Style>

    <Style x:Key="T.H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontStretch" Value="SemiCondensed" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
    </Style>

    <Style x:Key="T.H3" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
    </Style>

    <!-- Small uppercase label: section captions, table headers, tags -->
    <Style x:Key="T.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontStretch" Value="SemiCondensed" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
    </Style>

    <Style x:Key="T.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Body}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
    </Style>

    <Style x:Key="T.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="T.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Body}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="T.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
    </Style>

    <!-- Big numeric readouts on the dashboard -->
    <Style x:Key="T.Stat" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontStretch" Value="Condensed" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="T.StatUnit" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontStretch" Value="Condensed" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
        <Setter Property="Margin" Value="4,0,0,5" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <!-- Icon glyph -->
    <Style x:Key="T.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Icons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
