<Window x:Class="Monolith.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:Monolith.Shell"
        xmlns:ui="clr-namespace:Monolith.UI"
        xmlns:dash="clr-namespace:Monolith.Modules.Dashboard"
        xmlns:opt="clr-namespace:Monolith.Modules.Optimize"
        xmlns:games="clr-namespace:Monolith.Modules.Games"
        xmlns:maint="clr-namespace:Monolith.Modules.Maintenance"
        xmlns:drv="clr-namespace:Monolith.Modules.Drivers"
        xmlns:svc="clr-namespace:Monolith.Modules.Services"
        xmlns:apps="clr-namespace:Monolith.Modules.Apps"
        xmlns:dev="clr-namespace:Monolith.Modules.Devices"
        xmlns:rest="clr-namespace:Monolith.Modules.Restore"
        xmlns:set="clr-namespace:Monolith.Modules.Settings"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=shell:MainViewModel}"
        Title="MONOLITH" Width="1380" Height="880" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{StaticResource B.Base}"
        Foreground="{StaticResource B.Text}" FontFamily="{StaticResource F.Body}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/Assets/monolith.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Page view-model → view -->
        <DataTemplate DataType="{x:Type dash:DashboardViewModel}"><dash:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type opt:OptimizeViewModel}"><opt:OptimizeView /></DataTemplate>
        <DataTemplate DataType="{x:Type games:GamesViewModel}"><games:GamesView /></DataTemplate>
        <DataTemplate DataType="{x:Type maint:MaintenanceViewModel}"><maint:MaintenanceView /></DataTemplate>
        <DataTemplate DataType="{x:Type drv:DriversViewModel}"><drv:DriversView /></DataTemplate>
        <DataTemplate DataType="{x:Type svc:ServicesViewModel}"><svc:ServicesView /></DataTemplate>
        <DataTemplate DataType="{x:Type dev:DevicesViewModel}"><dev:DevicesView /></DataTemplate>
        <DataTemplate DataType="{x:Type apps:AppsViewModel}"><apps:AppsView /></DataTemplate>
        <DataTemplate DataType="{x:Type rest:RestoreViewModel}"><rest:RestoreView /></DataTemplate>
        <DataTemplate DataType="{x:Type set:SettingsViewModel}"><set:SettingsView /></DataTemplate>

        <!-- Page enter animation -->
        <Storyboard x:Key="PageEnter">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="10" To="0" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Title-bar buttons: outlined like every action, 28 px to fit the 40 px caption, clickable inside the chrome -->
        <Style x:Key="Btn.TitleBar" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource B.Line2}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="226" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═══════════════ Title bar ═══════════════ -->
            <Grid Grid.ColumnSpan="2" Background="{StaticResource B.Base}">
                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{StaticResource B.Line}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <!-- Logo: slab with cut corner -->
                    <Path Data="M0,0 L7,0 L11,4 L11,22 L0,22 Z" Fill="{StaticResource B.White}" Width="11" Height="22" VerticalAlignment="Center" />
                    <TextBlock Text="MONOLITH" Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource F.Display}"
                               FontWeight="Bold" FontStretch="Condensed" FontSize="21" Foreground="{StaticResource B.Text}" />
                    <TextBlock Text="{Binding Version}" Margin="10,3,0,0" VerticalAlignment="Center" Style="{StaticResource T.Mono}"
                               FontSize="11.5" Foreground="{StaticResource B.Text3}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Visible search: the one entry to the command palette besides Ctrl+K -->
                    <Button Style="{StaticResource Btn.TitleBar}" Command="{Binding OpenSearchCommand}" ToolTip="Поиск настроек, разделов и инструментов (Ctrl+K)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="ПОИСК" Margin="7,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="Ctrl+K" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource F.Mono}" FontSize="11.5"
                                       FontWeight="Normal" FontStretch="Normal" Foreground="{StaticResource B.Text3}" />
                        </StackPanel>
                    </Button>
                    <!-- «ОТКАТ · 71 ▾»: the last batch and the journal, one click away on every page -->
                    <Button x:Name="UndoButton" Style="{StaticResource Btn.TitleBar}" Click="Undo_Click" ToolTip="Откатить последний пакет изменений или открыть журнал">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding UndoButtonText}" Margin="7,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="7,1,0,0" Foreground="{StaticResource B.Text2}" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Placement="Bottom">
                                <MenuItem Header="{Binding LastBatchMenuText}" IsEnabled="{Binding HasLastBatch}" Command="{Binding RevertLastBatchCommand}" />
                                <MenuItem Header="ОТКРЫТЬ ЖУРНАЛ ИЗМЕНЕНИЙ" Command="{Binding OpenRestoreCenterCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Rectangle Width="1" Height="18" Fill="{StaticResource B.Line2}" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource Btn.Caption}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Свернуть" />
                    <Button x:Name="MaxButton" Style="{StaticResource Btn.Caption}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Развернуть" />
                    <Button Style="{StaticResource Btn.CaptionClose}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Закрыть" />
                </StackPanel>
            </Grid>

            <!-- ═══════════════ Read-only strip (the one place that explains read-only mode) ═══════════════ -->
            <!-- One 28 px line: honest text (any change button asks for rights by itself and continues the action) + the shortcut. -->
            <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="10,6,10,2" Padding="9,0" Height="28" Background="{StaticResource B.Surface2}"
                    BorderBrush="{StaticResource B.Line2}" BorderThickness="1" CornerRadius="{StaticResource R.Lg}"
                    Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="22" Height="8" Background="{StaticResource B.HatchStrong}" CornerRadius="{StaticResource R.Xs}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="РЕЖИМ ПРОСМОТРА" FontFamily="{StaticResource F.Display}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource B.Text}" />
                        <Run Text=" — смотреть и проверять можно сразу; любая кнопка изменения сама попросит права и продолжит действие." FontSize="12" Foreground="{StaticResource B.Text2}" />
                    </TextBlock>
                    <Button Grid.Column="2" Style="{StaticResource Btn}" Height="22" Padding="8,0" FontSize="11.5" Command="{Binding RestartAsAdminCommand}"
                            ToolTip="Перезапустить MONOLITH с правами администратора сейчас (запрос UAC)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA18;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="ПЕРЕЗАПУСТИТЬ С ПРАВАМИ" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══════════════ Sidebar ═══════════════ -->
            <Grid Grid.Row="2" Grid.RowSpan="2" Background="{StaticResource B.Surface}">
                <Rectangle Width="1" HorizontalAlignment="Right" Fill="{StaticResource B.Line}" />
                <DockPanel Margin="0,6,1,0">
                    <!-- Footer: settings -->
                    <Grid DockPanel.Dock="Bottom" Margin="0,0,0,14">
                        <!-- Same plate and marker as a selected nav item while Settings is open -->
                        <Border Margin="10,0,8,0" Height="34" Background="{StaticResource B.Surface2}" CornerRadius="{StaticResource R.Md}"
                                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                            <Rectangle Width="3" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{StaticResource B.White}"
                                       RadiusX="{StaticResource R.Xs.D}" RadiusY="{StaticResource R.Xs.D}" />
                        </Border>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="settings" ToolTip="Настройки MONOLITH"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="10,0,8,0" Height="34" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource F.Icons}" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Настройки" FontFamily="{StaticResource F.Body}" FontWeight="SemiBold" FontSize="13.5"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Button.Style>
                                <!-- A nav item, not a button: same plate as the list rows (no outline), foreground Text2 → Text -->
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Mono}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource R.Md}" Padding="10,0,8,0">
                                                    <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Surface3}" />
                                                        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Groups ОБЗОР · УСКОРЕНИЕ · ОБСЛУЖИВАНИЕ · ЗАЩИТА; a badge on the right = the page's own fact (PageViewModel.BadgeText) -->
                    <ListBox x:Name="NavList" Style="{StaticResource Nav.List}" ItemsSource="{Binding NavView}" SelectedItem="{Binding NavSelection}"
                             IsSynchronizedWithCurrentItem="False">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.Label}" Margin="20,12,0,4" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource F.Icons}" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title, Converter={StaticResource Sentence}}" FontFamily="{StaticResource F.Body}"
                                               FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2" Style="{StaticResource TabBadge}" Margin="8,0,0,0"
                                            Visibility="{Binding BadgeText, Converter={StaticResource NullToVis}}">
                                        <TextBlock Text="{Binding BadgeText}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>

            <!-- ═══════════════ Content ═══════════════ -->
            <Grid Grid.Row="2" Grid.Column="1" ClipToBounds="True">
                <ProgressBar VerticalAlignment="Top" IsIndeterminate="True" Height="2" Panel.ZIndex="5"
                             Visibility="{Binding CurrentPage.IsBusy, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}" Margin="24,16,24,14" Focusable="False">
                    <ContentControl.RenderTransform>
                        <TranslateTransform />
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>

            <!-- ═══════════════ Console ═══════════════ -->
            <!-- Shown only when expanded; the toggle lives in the status bar. An R.Lg panel aligned with the page content. -->
            <Border Grid.Row="3" Grid.Column="1" Margin="24,0,24,10" Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Line}"
                    BorderThickness="1" CornerRadius="{StaticResource R.Lg}" ui:RoundClip.Content="True"
                    Visibility="{Binding ConsoleExpanded, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="14,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="6" Height="6" Background="{StaticResource B.White}" VerticalAlignment="Center" />
                            <TextBlock Text="ЖУРНАЛ ДЕЙСТВИЙ" Style="{StaticResource T.Label}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource T.Mono}" FontSize="11.5" Foreground="{StaticResource B.Text3}"
                                       Text="{Binding LogEntries.Count, StringFormat=СТРОК: {0}}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource Btn.Ghost}" Margin="0,0,6,0" Command="{Binding ClearConsoleCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="ОЧИСТИТЬ" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn}" Command="{Binding ToggleConsoleCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="СКРЫТЬ" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="ConsoleList" Grid.Row="1" Height="128" Style="{StaticResource List.Plain}" ItemsSource="{Binding LogEntries}"
                             Margin="14,0,8,8"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource T.Mono}" FontSize="11.5" Foreground="{StaticResource B.Text3}" />
                                    <TextBlock Grid.Column="1" Text="{Binding LevelTag}" FontFamily="{StaticResource F.Mono}" FontSize="11.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="Success">
                                                        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                                        <Setter Property="Foreground" Value="{StaticResource B.White}" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" Style="{StaticResource T.Mono}" FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ═══════════════ Status bar (34 px) ═══════════════ -->
            <Grid Grid.Row="4" Grid.ColumnSpan="2" Background="{StaticResource B.Base}">
                <Rectangle Height="1" VerticalAlignment="Top" Fill="{StaticResource B.Line}" />
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Border Width="6" Height="6" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource B.Text3}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage.IsBusy}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource B.White}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11.5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource T.Mono}">
                                <Setter Property="Text" Value="ГОТОВ" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage.IsBusy}" Value="True">
                                        <Setter Property="Text" Value="{Binding CurrentPage.BusyText}" />
                                        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource T.Mono}" FontSize="11.5" Foreground="{StaticResource B.Text3}"
                               Text="{Binding CurrentPage.CheckedText, StringFormat=· {0}}"
                               Visibility="{Binding CurrentPage.CheckedText, Converter={StaticResource NullToVis}, FallbackValue=Collapsed}" />
                </StackPanel>
                <!-- The in-app log: an outlined button («ЖУРНАЛ ДЕЙСТВИЙ · 2 ▴»), 26 px inside the 34 px bar -->
                <Button Style="{StaticResource Btn}" Height="26" Padding="10,0" FontSize="11.5" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center"
                        Command="{Binding ToggleConsoleCommand}" ToolTip="Показать или скрыть журнал действий MONOLITH">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE756;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding LogEntries.Count, StringFormat=ЖУРНАЛ ДЕЙСТВИЙ · {0}}" VerticalAlignment="Center" />
                        <TextBlock FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="7,1,0,0" Foreground="{StaticResource B.Text2}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE70E;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConsoleExpanded}" Value="True">
                                            <Setter Property="Text" Value="&#xE70D;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ═══════════════ Toasts ═══════════════ -->
            <ItemsControl Grid.Row="2" Grid.RowSpan="2" Grid.Column="1" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right"
                          VerticalAlignment="Bottom" Margin="0,0,24,20" Panel.ZIndex="20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- R.Xl toast; the clip makes the accent bar follow the rounded left edge -->
                        <Border Width="400" Margin="0,8,0,0" Background="{StaticResource B.Surface3}" BorderBrush="{StaticResource B.Line3}" BorderThickness="1"
                                CornerRadius="{StaticResource R.Xl}" ui:RoundClip.Content="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.6" Color="Black" />
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle>
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Fill" Value="{StaticResource B.White}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAlert}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource B.HatchStrong}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <TextBlock Grid.Column="1" Text="{Binding Glyph}" FontFamily="{StaticResource F.Icons}" FontSize="15" Margin="14,14,0,0" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="2" Margin="12,12,12,12">
                                    <TextBlock Text="{Binding Title}" Margin="0,0,0,3">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource T.H3}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Title}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Message}" Style="{StaticResource T.Body}" Foreground="{StaticResource B.Text}" FontSize="12.5" />
                                    <!-- Labelled buttons: «ОТКРЫТЬ» (when the toast points somewhere) and «ЗАКРЫТЬ» -->
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Style="{StaticResource Btn}" Margin="0,0,8,0" Visibility="{Binding NavigateTo, Converter={StaticResource NullToVis}}"
                                                Command="{Binding DataContext.OpenToastTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock Text="ОТКРЫТЬ" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Btn.Ghost}"
                                                Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock Text="ЗАКРЫТЬ" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ═══════════════ Command palette (Ctrl+K / «ПОИСК») — navigates only, never applies ═══════════════ -->
            <Grid x:Name="PaletteOverlay" Grid.Row="1" Grid.RowSpan="4" Grid.ColumnSpan="2" Panel.ZIndex="25" Background="{StaticResource B.Scrim}"
                  Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}" MouseLeftButtonDown="PaletteOverlay_MouseDown"
                  d:DataContext="{d:DesignInstance Type=shell:CommandPaletteViewModel}">
                <Border Width="620" Margin="0,64,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Background="{StaticResource B.Surface2}"
                        BorderBrush="{StaticResource B.Line3}" BorderThickness="1" CornerRadius="{StaticResource R.Xl}" ui:RoundClip.Content="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.8" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <Rectangle Height="4" Fill="{StaticResource B.White}" />
                        <TextBox x:Name="PaletteBox" Margin="16,16,16,12" Height="40" FontSize="14" Tag="ПОИСК НАСТРОЕК, РАЗДЕЛОВ, ПРОГРАММ, ИНСТРУМЕНТОВ"
                                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
                        <ScrollViewer x:Name="PaletteScroll" MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <!-- Rows are inset R.Md plates (8 margin + 8 padding keeps the text on the 16 px gutter) -->
                            <ItemsControl x:Name="PaletteList" ItemsSource="{Binding Results}" Focusable="False" Margin="8,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type shell:PaletteResultItem}">
                                        <Border x:Name="Rw" Padding="8,9" Background="Transparent" Cursor="Hand" CornerRadius="{StaticResource R.Md}"
                                                MouseLeftButtonUp="PaletteRow_MouseUp">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle x:Name="Bar" Fill="{StaticResource B.White}" Visibility="Hidden" Width="3" Height="16" Margin="-8,0,0,0"
                                                           HorizontalAlignment="Left" VerticalAlignment="Center"
                                                           RadiusX="{StaticResource R.Xs.D}" RadiusY="{StaticResource R.Xs.D}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Entry.Title, Converter={StaticResource Sentence}}" Margin="10,0,12,0" VerticalAlignment="Center"
                                                           FontFamily="{StaticResource F.Display}" FontWeight="SemiBold" FontSize="14"
                                                           Foreground="{StaticResource B.Text}" TextTrimming="CharacterEllipsis" />
                                                <Border x:Name="Risk" Grid.Column="2" Margin="0,0,12,0" Style="{StaticResource Tag}"
                                                        Visibility="{Binding Entry.HasRisk, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding Entry.RiskText}" />
                                                </Border>
                                                <TextBlock Grid.Column="3" Text="{Binding Entry.KindText}" Style="{StaticResource T.Label}" FontSize="11"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Entry.Risk}" Value="Optional">
                                                <Setter TargetName="Risk" Property="Style" Value="{StaticResource Tag.Muted}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Entry.Risk}" Value="Advanced">
                                                <Setter TargetName="Risk" Property="Style" Value="{StaticResource Tag.Hatch}" />
                                            </DataTrigger>
                                            <Trigger SourceName="Rw" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Rw" Property="Background" Value="{StaticResource B.Surface3}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Rw" Property="Background" Value="{StaticResource B.Surface3}" />
                                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="НИЧЕГО НЕ НАЙДЕНО" Style="{StaticResource T.Label}" Margin="16,6,16,10"
                                   Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}" />
                        <Rectangle Height="1" Fill="{StaticResource B.Line2}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding SelectedDescription}" Style="{StaticResource T.Caption}" TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" Margin="16,9,16,8" ToolTip="{Binding SelectedDescription}" />
                        <TextBlock Text="↑↓ ВЫБОР · ENTER ОТКРЫТЬ · ESC ЗАКРЫТЬ — ПОИСК ТОЛЬКО ОТКРЫВАЕТ, НИЧЕГО НЕ ПРИМЕНЯЕТ" Style="{StaticResource T.Mono}"
                                   FontSize="12" Foreground="{StaticResource B.Text3}" Margin="16,0,16,12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════════ Dialog ═══════════════ -->
            <Grid Grid.Row="1" Grid.RowSpan="4" Grid.ColumnSpan="2" Panel.ZIndex="30" Background="{StaticResource B.Scrim}"
                  Visibility="{Binding Dialog, Converter={StaticResource NullToVis}}">
                <Border Width="560" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource B.Surface2}"
                        BorderBrush="{StaticResource B.Line3}" BorderThickness="1" CornerRadius="{StaticResource R.Xl}" ui:RoundClip.Content="True"
                        DataContext="{Binding Dialog}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.8" Color="Black" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Rectangle Height="6" VerticalAlignment="Top">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Fill" Value="{StaticResource B.White}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource B.HatchStrong}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <StackPanel Margin="28,30,28,0">
                            <TextBlock Text="{Binding Title, Converter={StaticResource Sentence}}" Style="{StaticResource T.H1}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Message}" Style="{StaticResource T.Body}" Margin="0,10,0,0" />
                            <!-- Optional checkbox («Всегда запускать с правами») -->
                            <CheckBox Margin="0,14,0,0" IsChecked="{Binding OptionChecked}" Content="{Binding OptionText}"
                                      Visibility="{Binding HasOption, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <Border Grid.Row="1" Margin="28,16,28,0" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" Background="{StaticResource B.Surface}"
                                CornerRadius="{StaticResource R.Lg}" ui:RoundClip.Content="True"
                                Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                                <ItemsControl ItemsSource="{Binding Details}" Margin="14,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Width="5" Height="5" Fill="{StaticResource B.Text2}" VerticalAlignment="Top" Margin="0,7,0,0" HorizontalAlignment="Left" />
                                                <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource T.Body}" Foreground="{StaticResource B.Text}" FontSize="12.5" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <Grid Grid.Row="2" Margin="28,22,28,26">
                            <TextBlock Text="{Binding Footnote}" Style="{StaticResource T.Caption}" VerticalAlignment="Center" MaxWidth="250" HorizontalAlignment="Left" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}" Margin="0,0,10,0" MinWidth="110" IsCancel="True"
                                        Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVis}}" />
                                <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" MinWidth="140" IsDefault="True">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource B.White}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
