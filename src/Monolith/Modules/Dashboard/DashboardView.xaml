<UserControl x:Class="Monolith.Modules.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Monolith.UI.Controls"
             xmlns:ui="clr-namespace:Monolith.UI"
             xmlns:local="clr-namespace:Monolith.Modules.Dashboard"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:DashboardViewModel}">

    <UserControl.Resources>
        <!-- Card title: big condensed uppercase -->
        <Style x:Key="Dash.CardTitle" TargetType="TextBlock" BasedOn="{StaticResource T.H2}">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontStretch" Value="Condensed" />
            <Setter Property="FontSize" Value="19" />
        </Style>

        <!-- Small index number in tile headers -->
        <Style x:Key="Dash.TileIndex" TargetType="TextBlock" BasedOn="{StaticResource T.Mono}">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource B.Text4}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Dash.TileLabel" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Dash.TileStat" TargetType="TextBlock" BasedOn="{StaticResource T.Stat}">
            <Setter Property="FontSize" Value="50" />
            <Setter Property="LineHeight" Value="50" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        </Style>

        <Style x:Key="Dash.TileUnit" TargetType="TextBlock" BasedOn="{StaticResource T.StatUnit}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="5,0,0,6" />
        </Style>

        <Style x:Key="Dash.TileLine" TargetType="TextBlock" BasedOn="{StaticResource T.Mono}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>

        <Style x:Key="Dash.TileCaption" TargetType="TextBlock" BasedOn="{StaticResource T.Caption}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="Dash.TileIcon" TargetType="TextBlock" BasedOn="{StaticResource T.Icon}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <!-- Quick action button content -->
        <Style x:Key="Dash.QuickButton" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Height" Value="68" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="Dash.QuickButtonPrimary" TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
            <Setter Property="Height" Value="68" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!-- Check row: severity marker -->
        <Style x:Key="Dash.Marker" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource B.Line3}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text3}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Background" Value="{StaticResource B.White}" />
                    <Setter Property="BorderBrush" Value="{StaticResource B.White}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource B.Ink}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Info">
                    <Setter Property="BorderBrush" Value="{StaticResource B.Text2}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Dash.CheckTitle" TargetType="TextBlock" BasedOn="{StaticResource T.H3}">
            <Setter Property="FontStretch" Value="SemiCondensed" />
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Ok">
                    <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Dash.CheckDetail" TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Ok">
                    <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Dash.SeverityTag" TargetType="Border" BasedOn="{StaticResource Tag.Muted}">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Background" Value="{StaticResource B.Hatch}" />
                    <Setter Property="BorderBrush" Value="{StaticResource B.Text2}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Info">
                    <Setter Property="BorderBrush" Value="{StaticResource B.Line3}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text2}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <c:PageHeader Index="{Binding Index}" Title="{Binding Title}" Subtitle="{Binding Subtitle}">
            <c:PageHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                        <Border Width="7" Height="7" Background="{StaticResource B.White}" VerticalAlignment="Center" />
                        <TextBlock Text="LIVE" Style="{StaticResource T.Mono}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource B.Text}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding IntervalText}" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{StaticResource B.Text3}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Command="{Binding RefreshChecksCommand}" IsEnabled="{Binding IsChecking, Converter={StaticResource InverseBool}}"
                            ToolTip="Заново выполнить все проверки (только чтение, ничего не меняет)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static ui:Glyphs.Refresh}" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="ПРОВЕРИТЬ СНОВА" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </c:PageHeader.Actions>
        </c:PageHeader>

        <ScrollViewer Grid.Row="1" Margin="0,26,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="0,0,14,8">

                <!-- ═══════════════ Live tiles ═══════════════ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- CPU -->
                    <Border Style="{StaticResource Card}" Padding="20,18,20,16">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="01" Style="{StaticResource Dash.TileIndex}" />
                                    <TextBlock Text="ЦП" Style="{StaticResource Dash.TileLabel}" />
                                </StackPanel>
                                <TextBlock Text="{x:Static ui:Glyphs.Processing}" Style="{StaticResource Dash.TileIcon}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Text="{Binding CpuText}" Style="{StaticResource Dash.TileStat}" />
                                <TextBlock Text="%" Style="{StaticResource Dash.TileUnit}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Dash.TileLine}">
                                <Run Text="ЧАСТОТА " Foreground="{StaticResource B.Text3}" /><Run Text="{Binding CpuClockText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding CpuCoresText}" Style="{StaticResource Dash.TileCaption}" />
                            <c:Meter Value="{Binding CpuLoad}" Segments="30" Height="6" Margin="0,16,0,0" HotThreshold="90" />
                            <c:Sparkline Values="{Binding CpuHistory}" AreaFill="{StaticResource B.ChartFill}" Height="46" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- GPU -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18,20,16">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="02" Style="{StaticResource Dash.TileIndex}" />
                                    <TextBlock Text="ГРАФИКА" Style="{StaticResource Dash.TileLabel}" />
                                </StackPanel>
                                <TextBlock Text="{x:Static ui:Glyphs.Monitor}" Style="{StaticResource Dash.TileIcon}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Text="{Binding GpuText}" Style="{StaticResource Dash.TileStat}" />
                                <TextBlock Text="%" Style="{StaticResource Dash.TileUnit}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Dash.TileLine}">
                                <Run Text="{Binding GpuTempText, Mode=OneWay}" /><Run Text=" · VRAM " Foreground="{StaticResource B.Text3}" /><Run Text="{Binding GpuVramText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding GpuName}" Style="{StaticResource Dash.TileCaption}" ToolTip="{Binding GpuName}" />
                            <c:Meter Value="{Binding GpuLoad}" Segments="30" Height="6" Margin="0,16,0,0" HotThreshold="95" />
                            <c:Sparkline Values="{Binding GpuHistory}" AreaFill="{StaticResource B.ChartFill}" Height="46" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- RAM -->
                    <Border Grid.Column="4" Style="{StaticResource Card}" Padding="20,18,20,16">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="03" Style="{StaticResource Dash.TileIndex}" />
                                    <TextBlock Text="ПАМЯТЬ" Style="{StaticResource Dash.TileLabel}" />
                                </StackPanel>
                                <TextBlock Text="{x:Static ui:Glyphs.Memory}" Style="{StaticResource Dash.TileIcon}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Text="{Binding RamText}" Style="{StaticResource Dash.TileStat}" />
                                <TextBlock Text="%" Style="{StaticResource Dash.TileUnit}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Dash.TileLine}">
                                <Run Text="ЗАНЯТО " Foreground="{StaticResource B.Text3}" /><Run Text="{Binding RamUsedText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Dash.TileCaption}">
                                <Run Text="Доступно" /> <Run Text="{Binding RamFreeText, Mode=OneWay}" />
                            </TextBlock>
                            <c:Meter Value="{Binding RamLoad}" Segments="30" Height="6" Margin="0,16,0,0" HotThreshold="90" />
                            <c:Sparkline Values="{Binding RamHistory}" AreaFill="{StaticResource B.ChartFill}" Height="46" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- DISK + NET -->
                    <Border Grid.Column="6" Style="{StaticResource Card}" Padding="20,18,20,16">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="04" Style="{StaticResource Dash.TileIndex}" />
                                    <TextBlock Text="ДИСК + СЕТЬ" Style="{StaticResource Dash.TileLabel}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Rectangle Width="10" Height="2" Fill="{StaticResource B.White}" VerticalAlignment="Center" />
                                    <TextBlock Text="ДИСК" Style="{StaticResource T.Label}" FontSize="9.5" Margin="5,0,10,0" VerticalAlignment="Center" />
                                    <Rectangle Width="10" Height="2" Fill="{StaticResource B.Text3}" VerticalAlignment="Center" />
                                    <TextBlock Text="СЕТЬ" Style="{StaticResource T.Label}" FontSize="9.5" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Text="{Binding DiskText}" Style="{StaticResource Dash.TileStat}" />
                                <TextBlock Text="%" Style="{StaticResource Dash.TileUnit}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Dash.TileLine}">
                                <Run Text="↓ " Foreground="{StaticResource B.Text3}" /><Run Text="{Binding NetDownText, Mode=OneWay}" /><Run Text="   ↑ " Foreground="{StaticResource B.Text3}" /><Run Text="{Binding NetUpText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding DiskIoText}" Style="{StaticResource Dash.TileCaption}" />
                            <c:Meter Value="{Binding DiskLoad}" Segments="30" Height="6" Margin="0,16,0,0" HotThreshold="90" />
                            <Grid Height="46" Margin="0,12,0,0">
                                <c:Sparkline Values="{Binding DiskHistory}" AreaFill="{StaticResource B.ChartFill}" />
                                <c:Sparkline Values="{Binding NetHistory}" Maximum="{Binding NetMax}" Stroke="{StaticResource B.Text3}" ShowGrid="False" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══════════════ Health + system ═══════════════ -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.45*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- СОСТОЯНИЕ СИСТЕМЫ -->
                    <Border Style="{StaticResource Card.Flush}" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid Margin="24,20,24,0">
                                <TextBlock Text="СОСТОЯНИЕ СИСТЕМЫ" Style="{StaticResource Dash.CardTitle}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LastCheckText}" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{StaticResource B.Text3}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="24,18,24,22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Gauge -->
                                <Grid Width="176" Height="176" VerticalAlignment="Top">
                                    <c:ArcGauge Value="{Binding Score}" Ticks="54" TickLength="14" />
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding ScoreText}" Style="{StaticResource T.Stat}" FontSize="58" HorizontalAlignment="Center"
                                                   LineHeight="58" LineStackingStrategy="BlockLineHeight" />
                                        <TextBlock Text="ИЗ 100" Style="{StaticResource T.Label}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>

                                <!-- Verdict + counters -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="ОЦЕНКА СИСТЕМЫ" Style="{StaticResource T.Label}" />
                                    <TextBlock Text="{Binding Verdict}" Style="{StaticResource T.H1}" FontSize="34" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding VerdictSummary}" Style="{StaticResource T.Body}" Margin="0,6,0,0" />

                                    <Border BorderBrush="{StaticResource B.Line2}" BorderThickness="0,1,0,1" Margin="0,18,0,0"
                                            Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,10,10,10">
                                                <TextBlock Text="{Binding WarningCount}" Style="{StaticResource T.Stat}" FontSize="28" />
                                                <TextBlock Text="ВНИМАНИЕ" Style="{StaticResource T.Label}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Rectangle Grid.Column="1" Style="{StaticResource DividerV}" Fill="{StaticResource B.Line2}" Margin="0,10" />
                                            <StackPanel Grid.Column="2" Margin="16,10,10,10">
                                                <TextBlock Text="{Binding InfoCount}" Style="{StaticResource T.Stat}" FontSize="28" />
                                                <TextBlock Text="СОВЕТЫ" Style="{StaticResource T.Label}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Rectangle Grid.Column="3" Style="{StaticResource DividerV}" Fill="{StaticResource B.Line2}" Margin="0,10" />
                                            <StackPanel Grid.Column="4" Margin="16,10,0,10">
                                                <TextBlock Text="{Binding PassedText}" Style="{StaticResource T.Stat}" FontSize="28" />
                                                <TextBlock Text="В НОРМЕ" Style="{StaticResource T.Label}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Read-only notice -->
                            <Border Style="{StaticResource Callout}" Margin="24,0,24,20" Padding="0"
                                    Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Fill="{StaticResource B.HatchStrong}" />
                                    <TextBlock Grid.Column="1" Text="{x:Static ui:Glyphs.Lock}" Style="{StaticResource T.Icon}" FontSize="15"
                                               VerticalAlignment="Top" Margin="14,13,0,0" />
                                    <StackPanel Grid.Column="2" Margin="12,11,16,12">
                                        <TextBlock Text="РЕЖИМ ПРОСМОТРА" Style="{StaticResource T.H3}" FontStretch="SemiCondensed" />
                                        <TextBlock Style="{StaticResource T.Body}" FontSize="12.5" Margin="0,3,0,0"
                                                   Text="Мониторинг и проверки работают без ограничений. Кнопки, которые меняют систему (включить защиту, применить настройку), доступны только с правами администратора — нажмите «Права администратора» в левой панели." />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Section: needs attention -->
                            <Grid Margin="24,0,24,0" Height="34" Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ПРОБЛЕМЫ И СОВЕТЫ" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                                <Rectangle Grid.Column="1" Height="1" Fill="{StaticResource B.Line2}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" Visibility="{Binding HasIssues, Converter={StaticResource InverseBoolToVis}}" />

                            <!-- Checklist: problems and advice -->
                            <ItemsControl ItemsSource="{Binding Issues}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:CheckItemViewModel}">
                                        <Border Style="{StaticResource Row}" Padding="24,16,24,16">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource Dash.Marker}">
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource F.Icons}" FontSize="13"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="2" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Dash.CheckTitle}" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Dash.CheckDetail}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Margin="20,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Right">
                                                    <Border Style="{StaticResource Dash.SeverityTag}" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding SeverityText}" />
                                                    </Border>
                                                    <Button Margin="0,12,0,0" Height="30" MinWidth="128" FontSize="11.5" HorizontalAlignment="Right"
                                                            Command="{Binding RunCommand}" IsEnabled="{Binding ActionAvailable}"
                                                            ToolTip="{Binding ActionTooltip}" ToolTipService.ShowOnDisabled="True"
                                                            Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{x:Static ui:Glyphs.Lock}" FontFamily="{StaticResource F.Icons}" FontSize="11"
                                                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                                                       Visibility="{Binding ShowAdminHint, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="{Binding ActionText}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Section: passed -->
                            <Grid Margin="24,14,24,0" Height="30" Visibility="{Binding Passed.Count, Converter={StaticResource NullToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource T.Label}" VerticalAlignment="Center">
                                    <Run Text="В НОРМЕ" /><Run Text="  ·  " Foreground="{StaticResource B.Text4}" /><Run Text="{Binding OkCount, Mode=OneWay}" />
                                </TextBlock>
                                <Rectangle Grid.Column="1" Height="1" Fill="{StaticResource B.Line2}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Passed}" Focusable="False" Margin="24,4,24,18">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:CheckItemViewModel}">
                                        <Border BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,0,1" Padding="0,11,14,11" Background="Transparent"
                                                ToolTip="{Binding Detail}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="18" Height="18" BorderBrush="{StaticResource B.Line3}" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,0,0">
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource F.Icons}" FontSize="9.5" Foreground="{StaticResource B.Text2}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.H3}" FontStretch="SemiCondensed" FontSize="13"
                                                               Foreground="{StaticResource B.Text}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Caption}" Margin="0,3,0,0"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Loading state -->
                            <StackPanel Margin="24,22,24,26" Visibility="{Binding HasResults, Converter={StaticResource InverseBoolToVis}}">
                                <ProgressBar IsIndeterminate="{Binding IsChecking}" Height="2" />
                                <TextBlock Text="Проверки выполняются в фоне и только читают систему." Style="{StaticResource T.Caption}" Margin="0,12,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Right column -->
                    <StackPanel Grid.Column="2">

                        <!-- БЫСТРЫЕ ДЕЙСТВИЯ -->
                        <Border Style="{StaticResource Card}" Padding="24,20,24,24">
                            <StackPanel>
                                <TextBlock Text="БЫСТРЫЕ ДЕЙСТВИЯ" Style="{StaticResource Dash.CardTitle}" />
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Button Style="{StaticResource Dash.QuickButtonPrimary}" Command="{Binding GoCommand}" CommandParameter="optimize"
                                            ToolTip="Раздел «Оптимизация»: профили и настройки Windows с откатом">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="ОПТИМИЗИРОВАТЬ" FontSize="13.5" />
                                                <TextBlock Text="Профили и настройки" FontFamily="{StaticResource F.Body}" FontWeight="Normal" FontStretch="Normal"
                                                           FontSize="11.5" Opacity="0.62" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Static ui:Glyphs.Bolt}" FontFamily="{StaticResource F.Icons}" FontSize="17" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>

                                    <Button Grid.Column="2" Style="{StaticResource Dash.QuickButton}" Command="{Binding GoCommand}" CommandParameter="cleaner"
                                            ToolTip="Раздел «Очистка»: временные файлы и кэш, перед удалением показывает список">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="ОЧИСТИТЬ" FontSize="13.5" />
                                                <TextBlock Text="Временные файлы" FontFamily="{StaticResource F.Body}" FontWeight="Normal" FontStretch="Normal"
                                                           FontSize="11.5" Foreground="{StaticResource B.Text3}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Static ui:Glyphs.Delete}" FontFamily="{StaticResource F.Icons}" FontSize="16" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>

                                    <Button Grid.Row="2" Style="{StaticResource Dash.QuickButton}" Command="{Binding GoCommand}" CommandParameter="games"
                                            ToolTip="Раздел «Игры»: библиотека и игровой режим MONOLITH">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="ИГРОВОЙ РЕЖИМ" FontSize="13.5" />
                                                <TextBlock Text="Игры и ускорение" FontFamily="{StaticResource F.Body}" FontWeight="Normal" FontStretch="Normal"
                                                           FontSize="11.5" Foreground="{StaticResource B.Text3}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Static ui:Glyphs.Game}" FontFamily="{StaticResource F.Icons}" FontSize="17" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>

                                    <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource Dash.QuickButton}" Command="{Binding GoCommand}" CommandParameter="drivers"
                                            ToolTip="Раздел «Драйверы»: версии, даты и обновления">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="ОБНОВИТЬ ДРАЙВЕРЫ" FontSize="13.5" />
                                                <TextBlock Text="Версии и обновления" FontFamily="{StaticResource F.Body}" FontWeight="Normal" FontStretch="Normal"
                                                           FontSize="11.5" Foreground="{StaticResource B.Text3}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Static ui:Glyphs.Devices}" FontFamily="{StaticResource F.Icons}" FontSize="16" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- СИСТЕМА -->
                        <Border Style="{StaticResource Card}" Padding="24,20,24,10" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="СИСТЕМА" Style="{StaticResource Dash.CardTitle}" />
                                <ItemsControl ItemsSource="{Binding SystemRows}" Margin="0,10,0,0" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:SystemRow}">
                                            <Border BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Padding="0,11,0,11">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="112" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource T.Label}" Margin="0,2,12,0" TextWrapping="Wrap" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Value}" Style="{StaticResource T.BodyStrong}" FontSize="13" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Caption}" Margin="0,2,0,0"
                                                                   Visibility="{Binding Detail, Converter={StaticResource NullToVis}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Margin="0,8,0,12" Visibility="{Binding SystemRows.Count, Converter={StaticResource NullToVis}, ConverterParameter=invert}">
                                    <ProgressBar IsIndeterminate="{Binding IsChecking}" Height="2" />
                                    <TextBlock Text="Сбор сведений о компьютере…" Style="{StaticResource T.Caption}" Margin="0,10,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
