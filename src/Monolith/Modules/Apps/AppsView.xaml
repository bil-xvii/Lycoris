<UserControl x:Class="Monolith.Modules.Apps.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Monolith.UI.Controls"
             xmlns:ui="clr-namespace:Monolith.UI"
             xmlns:loc="clr-namespace:Monolith.UI"
             xmlns:local="clr-namespace:Monolith.Modules.Apps"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:AppsViewModel}">
    <!--
        Obvious UI anatomy: header (title · проверено · ОБНОВИТЬ · ОБНОВИТЬ ВСЕ ПРОГРАММЫ) → search + tabs in one row
        («РЕКОМЕНДУЕМ» first) → summary line → the catalog (the only ScrollViewer; the install queue sits beside it)
        → sticky bar «ВЫБРАНО N · УСТАНОВИТЬ ВЫБРАННОЕ · N» outside the scroll.
    -->
    <UserControl.Resources>
        <!-- Status tag by Kind: always a filled block (Tag / Tag.Solid / Tag.Hatch / Tag.Muted), never white and never a button -->
        <DataTemplate x:Key="TagTemplate" DataType="{x:Type local:AppTagInfo}">
            <Border Margin="0,0,6,6" ToolTip="{Binding ToolTip}" ToolTipService.ShowDuration="30000" ToolTipService.InitialShowDelay="250">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Tag}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Solid">
                                <Setter Property="Background" Value="{StaticResource B.Surface4}" />
                                <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Hatch">
                                <Setter Property="Background" Value="{StaticResource B.Hatch}" />
                                <Setter Property="BorderBrush" Value="{StaticResource B.Outline}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Muted">
                                <Setter Property="Background" Value="{StaticResource B.Surface2}" />
                                <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text3}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Text}" />
            </Border>
        </DataTemplate>

        <!-- Visibility of an ItemsControl container follows the item's IsVisible -->
        <Style x:Key="VisibleContainer" TargetType="ContentPresenter">
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />
        </Style>

        <!-- ═══════════════ Catalog card ═══════════════ -->
        <DataTemplate x:Key="CardTemplate" DataType="{x:Type local:AppItemViewModel}">
            <Border ui:RoundClip.Content="True">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card.Hover}">
                        <Setter Property="Padding" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource B.Text2}" />
                                <Setter Property="Background" Value="{StaticResource B.Surface2}" />
                            </DataTrigger>
                            <!-- a jump from the palette: outlined for a moment -->
                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource B.White}" />
                            </DataTrigger>
                            <!-- НЕ НУЖНО: dimmed, full opacity on hover or when ticked -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsDimmed}" Value="True" />
                                    <Condition Binding="{Binding IsSelected}" Value="False" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Opacity" Value="0.7" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- installed marker -->
                    <Rectangle Grid.RowSpan="2" Width="3" HorizontalAlignment="Left" Fill="{StaticResource B.White}"
                               Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Margin="11,10,11,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" Margin="0,2,9,0"
                                      ToolTip="{loc:T Отметить для пакетной установки или обновления}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name, Converter={StaticResource Sentence}}" Style="{StaticResource T.H2}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                <TextBlock Text="{Binding PackageId}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text3}"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource T.Body}" FontSize="12.5" LineHeight="18" Margin="0,10,0,0"
                                   MaxHeight="36" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" />
                        <!-- install advice: why (every level except ПО ЖЕЛАНИЮ), one line, full text in the tooltip -->
                        <TextBlock Text="{Binding AdviceReason}" Style="{StaticResource T.Caption}" Margin="0,4,0,0"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding AdviceReason}"
                                   ToolTipService.ShowDuration="30000"
                                   Visibility="{Binding HasAdviceCaption, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding DisplayTags}" ItemTemplate="{StaticResource TagTemplate}" Margin="0,9,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <!-- action bar -->
                    <Grid Grid.Row="1" Margin="11,8,9,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- main action: white block for install / website (clickable), outline for an update; a state (built in) is text -->
                        <Grid Visibility="{Binding HasActiveJob, Converter={StaticResource InverseBoolToVis}}">
                            <Button MinWidth="128"
                                    Command="{Binding DataContext.RunActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" IsEnabled="{Binding CanRunAction}" ToolTip="{Binding ActionToolTip}"
                                    ToolTipService.ShowOnDisabled="True">
                                <Button.Visibility>
                                    <MultiBinding Converter="{x:Static local:AppsView.AllTrueToVisibility}">
                                        <Binding Path="IsPrimaryAction" />
                                    </MultiBinding>
                                </Button.Visibility>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ActionGlyph}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding ActionText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn}" MinWidth="128"
                                    Command="{Binding DataContext.RunActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" IsEnabled="{Binding CanRunAction}" ToolTip="{Binding ActionToolTip}"
                                    ToolTipService.ShowOnDisabled="True">
                                <Button.Visibility>
                                    <MultiBinding Converter="{x:Static local:AppsView.AllTrueToVisibility}">
                                        <Binding Path="HasMainAction" />
                                        <Binding Path="IsPrimaryAction" Converter="{StaticResource InverseBool}" />
                                    </MultiBinding>
                                </Button.Visibility>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ActionGlyph}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding ActionText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding StateCaption}" Style="{StaticResource T.Label}" VerticalAlignment="Center"
                                       Visibility="{Binding HasMainAction, Converter={StaticResource InverseBoolToVis}}" />
                        </Grid>

                        <!-- queued / running -->
                        <Border Height="30" MinWidth="128" Padding="9,0" BorderBrush="{StaticResource B.Outline}" BorderThickness="1"
                                Background="{StaticResource B.Surface3}" CornerRadius="{StaticResource R.Md}"
                                Visibility="{Binding HasActiveJob, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static ui:Glyphs.Sync}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{StaticResource B.Text2}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Job.StatusText, FallbackValue=''}" Style="{StaticResource T.Label}"
                                           Foreground="{StaticResource B.Text}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <ComboBox Grid.Column="1" Width="92" MinWidth="0" Margin="8,0,0,0" ItemsSource="{Binding Variants}"
                                  SelectedItem="{Binding SelectedVariant}"
                                  ToolTip="{loc:T Регион игры: от него зависят сервер и пакет winget}"
                                  Visibility="{Binding HasVariantPicker, Converter={StaticResource BoolToVis}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:AppVariant}">
                                    <TextBlock Text="{Binding Label}" FontFamily="{StaticResource F.Mono}" FontSize="12" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- result of the last queue run -->
                        <TextBlock Grid.Column="2" Margin="9,0,8,0" VerticalAlignment="Center" Style="{StaticResource T.Mono}"
                                   Text="{Binding Job.StatusText, FallbackValue=''}" ToolTip="{Binding Job.Detail, FallbackValue={x:Null}}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Job.IsFinished, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />

                        <Button Grid.Column="3" ToolTip="{Binding SiteToolTip}"
                                Command="{Binding DataContext.OpenSiteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" Visibility="{Binding ShowSiteButton, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:T САЙТ}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static ui:Glyphs.OpenExternal}" FontFamily="{StaticResource F.Icons}" FontSize="12"
                                           Margin="7,1,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ProgressBar Grid.Row="1" VerticalAlignment="Bottom" Height="2" IsIndeterminate="True"
                                 Visibility="{Binding Job.IsRunning, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ═══════════════ Queue row ═══════════════ -->
        <DataTemplate x:Key="QueueRowTemplate" DataType="{x:Type local:QueueItemViewModel}">
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="Background" Value="{StaticResource B.Surface3}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Rectangle Width="3" HorizontalAlignment="Left" Fill="{StaticResource B.White}"
                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                <Grid Margin="12,9,12,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Top" Margin="0,3,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE915;" />
                                <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Running">
                                        <Setter Property="Text" Value="{x:Static ui:Glyphs.Sync}" />
                                        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Done">
                                        <Setter Property="Text" Value="{x:Static ui:Glyphs.Check}" />
                                        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Skipped">
                                        <Setter Property="Text" Value="{x:Static ui:Glyphs.ChevronRight}" />
                                        <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                        <Setter Property="Text" Value="{x:Static ui:Glyphs.Error}" />
                                        <Setter Property="Foreground" Value="{StaticResource B.White}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Cancelled">
                                        <Setter Property="Text" Value="{x:Static ui:Glyphs.Cancel}" />
                                        <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Unknown">
                                        <Setter Property="Text" Value="{x:Static ui:Glyphs.Info}" />
                                        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.BodyStrong}" FontSize="12.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" ToolTip="{Binding Detail}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} · {1}">
                                    <Binding Path="StatusText" />
                                    <Binding Path="OperationText" />
                                </MultiBinding>
                            </TextBlock.Text>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource T.Mono}">
                                    <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Running">
                                            <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- what happened and what to do -->
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding ShowDetail, Converter={StaticResource BoolToVis}}" />
                        <!-- safe way forward: vendor download / official site / cancel the download -->
                        <Button Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,7,0,0" Content="{Binding FallbackText}"
                                Command="{Binding DataContext.RunFallbackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" ToolTip="{Binding FallbackToolTip}" ToolTipService.ShowOnDisabled="True"
                                Visibility="{Binding HasFallback, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: «ОБНОВИТЬ» = re-check; the ONE primary = update every installed catalog program -->
        <c:PageHeader Index="{Binding Index}" Title="{Binding Title}" Subtitle="{Binding Subtitle}"
                      Checked="{Binding CheckedText}" RefreshCommand="{Binding RefreshCommand}">
            <c:PageHeader.Primary>
                <Button Command="{Binding UpdateAllCommand}"
                        ToolTip="{loc:T Обновить через winget все установленные программы из каталога (кроме обновляющихся самостоятельно)}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static ui:Glyphs.Download}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding UpdateAllText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </c:PageHeader.Primary>
        </c:PageHeader>

        <!-- Search (first control of the first row) + tabs -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Top">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="10,0,10,0" Height="32"
                         Tag="{loc:T Поиск по названию или ID}" />
                <TextBlock Text="{x:Static ui:Glyphs.Search}" FontFamily="{StaticResource F.Icons}" FontSize="12"
                           Foreground="{StaticResource B.Text3}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"
                           IsHitTestVisible="False" Visibility="{Binding HasSearch, Converter={StaticResource InverseBoolToVis}}" />
            </Grid>
            <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top" Command="{Binding ClearSearchCommand}"
                    Visibility="{Binding HasSearch, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static ui:Glyphs.Close}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="{loc:T СБРОСИТЬ}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Border Grid.Column="2" Style="{StaticResource SegmentBar}" Margin="12,0,0,0" VerticalAlignment="Top">
                <ItemsControl ItemsSource="{Binding Categories}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:CategoryFilterViewModel}">
                            <RadioButton Style="{StaticResource Segment}" GroupName="AppsCategory" Padding="8,0" FontSize="12"
                                         IsChecked="{Binding IsSelected, Mode=OneWay}" ToolTip="{Binding ToolTip}"
                                         Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource TabBadge}" Margin="6,0,0,0"><TextBlock Text="{Binding Count}" /></Border>
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>

        <!-- Summary strip -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text3}" VerticalAlignment="Center">
                <Run Text="{Binding VisibleText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{loc:T 'УСТАНОВЛЕНО '}" /><Run Text="{Binding InstalledCount, Mode=OneWay}" Foreground="{StaticResource B.Text}" />
            </TextBlock>
            <TextBlock Grid.Column="1" Text="{Binding DetectionText}" Style="{StaticResource T.Caption}" VerticalAlignment="Center" Margin="14,0,0,0"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding WingetVersionText}" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="0,0,10,12">

                    <!-- ═══════════════ Outdated winget ═══════════════ -->
                    <Border Style="{StaticResource Callout}" Padding="0" Margin="0,0,0,10" ui:RoundClip.Content="True"
                            Visibility="{Binding WingetOutdated, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource B.Red}" />
                            <TextBlock Grid.Column="1" Text="{x:Static ui:Glyphs.Warning}" Style="{StaticResource T.Icon}" FontSize="18" Margin="11,0,10,0" />
                            <StackPanel Grid.Column="2" Margin="0,9,11,10">
                                <TextBlock Text="{loc:T Устаревший winget}" Style="{StaticResource T.H3}" />
                                <TextBlock Style="{StaticResource T.Body}" FontSize="12.5" Margin="0,3,0,0"
                                           Text="{loc:T Эта версия «Установщика приложений» слишком старая: часть пакетов может не ставиться. Обновите его в Microsoft Store.}" />
                            </StackPanel>
                            <Button Grid.Column="3" Style="{StaticResource Btn}" Content="{loc:T ОБНОВИТЬ В STORE}" Margin="0,0,10,0"
                                    Command="{Binding OpenAppInstallerStoreCommand}" />
                        </Grid>
                    </Border>

                    <!-- ═══════════════ winget missing ═══════════════ -->
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,17" ui:RoundClip.Content="True"
                            Visibility="{Binding WingetMissing, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource B.Red}" />
                            <StackPanel Grid.Column="1" Margin="17,15,15,16">
                                <TextBlock Text="{loc:T WINGET · УСТАНОВЩИК ПРИЛОЖЕНИЙ}" Style="{StaticResource T.Label}" />
                                <TextBlock Text="{loc:T winget не найден}" Style="{StaticResource T.H1}" FontSize="22" Margin="0,6,0,0" />
                                <TextBlock Style="{StaticResource T.Body}" Margin="0,8,0,0" MaxWidth="620" HorizontalAlignment="Left"
                                           Text="{loc:T 'Lycoris ставит программы через winget — официальный менеджер пакетов Windows из «Установщика приложений» (App Installer). Установите или обновите его в Microsoft Store, затем нажмите «Обновить». Каталог ниже остаётся доступен: у каждой программы есть ссылка на официальный сайт.'}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,15,0" VerticalAlignment="Center">
                                <Button Style="{StaticResource Btn.Primary}" Command="{Binding OpenAppInstallerStoreCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{loc:T ОТКРЫТЬ MICROSOFT STORE}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Static ui:Glyphs.OpenExternal}" FontFamily="{StaticResource F.Icons}" FontSize="12" Margin="8,1,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Btn}" Content="{loc:T ПРОВЕРИТЬ СНОВА}" Margin="0,10,0,0" Command="{Binding RefreshCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ═══════════════ Gamer kit: one compact row ═══════════════ -->
                    <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,6"
                            Visibility="{Binding WingetMissing, Converter={StaticResource InverseBoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:T Набор геймера}" Style="{StaticResource T.H2}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Style="{StaticResource T.Caption}" Margin="10,1,10,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Text="{Binding KitCaption, Mode=OneTime}"
                                       ToolTip="{Binding KitToolTip}" ToolTipService.ShowDuration="30000" />
                            <TextBlock Grid.Column="2" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text}" VerticalAlignment="Center"
                                       Margin="0,0,10,0" ToolTip="{Binding KitStatusText}">
                                <Run Text="{Binding KitInstalled, Mode=OneWay}" /><Run Text=" / " Foreground="{StaticResource B.Text3}" /><Run Text="{Binding KitTotal, Mode=OneWay}" Foreground="{StaticResource B.Text3}" />
                            </TextBlock>
                            <Button Grid.Column="3" Command="{Binding InstallKitCommand}"
                                    ToolTip="{loc:T 'Показать список пакетов и установить недостающие библиотеки, которые нужны этому ПК'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static ui:Glyphs.Download}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding KitButtonText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ═══════════════ Catalog ═══════════════ -->
                    <ItemsControl x:Name="CatalogList" ItemsSource="{Binding Groups}" ItemContainerStyle="{StaticResource VisibleContainer}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:AppGroupViewModel}">
                                <StackPanel Margin="0,16,0,0">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title, Converter={StaticResource Sentence}}" Style="{StaticResource T.H1}" FontSize="17"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Description}" Style="{StaticResource T.Caption}" Margin="10,3,0,0"
                                                   VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <Rectangle Grid.Column="2" Height="1" Fill="{StaticResource B.Line2}" Margin="10,2,10,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource T.Mono}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource B.Text3}">
                                            <Run Text="{loc:T УСТАНОВЛЕНО}" FontFamily="{StaticResource F.Display}" FontWeight="SemiBold" FontSize="12" />
                                            <Run Text="{Binding InstalledCount, Mode=OneWay}" Foreground="{StaticResource B.Text}" />
                                            <Run Text="/" />
                                            <Run Text="{Binding VisibleCount, Mode=OneWay}" />
                                        </TextBlock>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CardTemplate}"
                                                  ItemContainerStyle="{StaticResource VisibleContainer}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <local:CardGrid MinColumnWidth="318" Gap="12" MaxColumns="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ═══════════════ No results ═══════════════ -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="17,16"
                            Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static ui:Glyphs.Search}" Style="{StaticResource T.Icon}" FontSize="19" Foreground="{StaticResource B.Text3}" Margin="0,0,14,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NoResultsTitle}" Style="{StaticResource T.H2}" />
                                <TextBlock Style="{StaticResource T.Body}" Margin="0,4,0,0" Text="{Binding NoResultsText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button Style="{StaticResource Btn}" Content="{loc:T СБРОСИТЬ ПОИСК}"
                                        Command="{Binding ClearSearchCommand}" Visibility="{Binding HasSearch, Converter={StaticResource BoolToVis}}" />
                                <Button Style="{StaticResource Btn.Primary}" Content="{loc:T ПОКАЗАТЬ ВСЕ ПРОГРАММЫ}" Margin="0,8,0,0"
                                        Command="{Binding ShowAllCommand}" Visibility="{Binding ShowAllOffered, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ═══════════════ Trust: one muted line (full text in the tooltip) ═══════════════ -->
                    <TextBlock Style="{StaticResource T.Caption}" Margin="0,20,0,0" TextWrapping="Wrap" ToolTipService.ShowDuration="30000"
                               Text="{loc:T 'Только проверенные пакеты winget и Microsoft Store. Lycoris никогда не передаёт winget --force, --ignore-security-hash и --allow-reboot. Установка работает и без прав администратора: установщики сами запросят UAC.'}"
                               ToolTip="{loc:T 'Каталог составлен из пакетов, проверенных командой winget show: издатель совпадает с разработчиком, установщик скачивается с его сервера, а SHA256 сверяется с манифестом. Пакеты Microsoft Store скачиваются из Store и проверяются его подписью. При установке winget принимает за вас лицензии издателей и условия Microsoft Store — Lycoris предупреждает об этом перед каждой установкой. Удалить программу можно в «Параметры → Приложения».'}" />
                </StackPanel>
            </ScrollViewer>

            <!-- ═══════════════ Install queue ═══════════════ -->
            <Border x:Name="QueuePanel" Grid.Column="1" Width="372" Margin="12,0,0,0" Background="{StaticResource B.Surface}"
                    BorderBrush="{StaticResource B.Line2}" BorderThickness="1" SizeChanged="QueuePanel_SizeChanged"
                    CornerRadius="{StaticResource R.Lg}" ui:RoundClip.Content="True"
                    Visibility="{Binding HasQueue, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Rectangle Height="3" VerticalAlignment="Top">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Fill" Value="{StaticResource B.White}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsQueueRunning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource B.HatchStrong}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>

                    <StackPanel Margin="12,12,12,0">
                        <Grid>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
                                        <Setter Property="Text" Value="{loc:T ОЧЕРЕДЬ · ЗАВЕРШЕНО}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsQueueRunning}" Value="True">
                                                <Setter Property="Text" Value="{loc:T ОЧЕРЕДЬ · ВЫПОЛНЯЕТСЯ}" />
                                                <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding QueueCounter}" Style="{StaticResource T.Mono}" HorizontalAlignment="Right"
                                       Foreground="{StaticResource B.Text}" />
                        </Grid>
                        <TextBlock Text="{Binding QueueTitle, Converter={StaticResource Sentence}}" Style="{StaticResource T.H1}" FontSize="18" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <ProgressBar Grid.Row="1" Margin="12,10,12,0" Height="3" Minimum="0" Maximum="100" Value="{Binding QueueProgress}" />

                    <ScrollViewer x:Name="QueueScroll" Grid.Row="2" MaxHeight="290" Margin="0,9,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Queue}" ItemTemplate="{StaticResource QueueRowTemplate}" Focusable="False" />
                    </ScrollViewer>

                    <Grid Grid.Row="3" Margin="12,10,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:T ВЫВОД WINGET}" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                        <Rectangle Grid.Column="1" Height="1" Fill="{StaticResource B.Line2}" Margin="10,1,0,0" VerticalAlignment="Center" />
                    </Grid>

                    <Border Grid.Row="4" Margin="12,0,12,0" MinHeight="72" Background="{StaticResource B.Base}" BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                            CornerRadius="{StaticResource R.Md}" ui:RoundClip.Content="True">
                        <ListBox x:Name="LogList" Style="{StaticResource List.Plain}" ItemsSource="{Binding QueueLog}" Padding="10,8"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource T.Mono}" FontSize="11.5" TextWrapping="Wrap" Margin="0,1" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Grid Grid.Row="5" Margin="12,10,12,11">
                        <!-- running: stop after the current package -->
                        <Button Style="{StaticResource Btn}" Command="{Binding StopQueueCommand}"
                                ToolTip="{loc:T 'Текущий пакет будет доведён до конца, остальные — отменены'}">
                            <Button.Visibility>
                                <MultiBinding Converter="{x:Static local:AppsView.AllTrueToVisibility}">
                                    <Binding Path="IsQueueRunning" />
                                    <Binding Path="StopRequested" Converter="{StaticResource InverseBool}" />
                                </MultiBinding>
                            </Button.Visibility>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static ui:Glyphs.Stop}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{loc:T ОСТАНОВИТЬ ПОСЛЕ ТЕКУЩЕГО}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <!-- stopping: hard abort -->
                        <Button Style="{StaticResource Btn.Danger}" Command="{Binding AbortQueueCommand}"
                                ToolTip="{loc:T Принудительно завершить winget и текущий установщик}">
                            <Button.Visibility>
                                <MultiBinding Converter="{x:Static local:AppsView.AllTrueToVisibility}">
                                    <Binding Path="IsQueueRunning" />
                                    <Binding Path="StopRequested" />
                                </MultiBinding>
                            </Button.Visibility>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static ui:Glyphs.Cancel}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{loc:T ПРЕРВАТЬ СЕЙЧАС}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <!-- finished -->
                        <Button Style="{StaticResource Btn.Primary}" Content="{loc:T ЗАКРЫТЬ}" Command="{Binding CloseQueueCommand}"
                                Visibility="{Binding IsQueueRunning, Converter={StaticResource InverseBoolToVis}}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Sticky bar, outside the scroll: the reason the button is grey is the text next to it -->
        <c:StickyBar Grid.Row="4" Margin="0,10,0,0" Count="{Binding SelectedCount}" Text="{Binding StickyText}">
            <c:StickyBar.Actions>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding ClearSelectionCommand}"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static ui:Glyphs.Cancel}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{loc:T СНЯТЬ ВЫБОР}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Hero}" Command="{Binding InstallSelectedCommand}"
                            ToolTip="{loc:T 'Поставить в очередь все отмеченные программы: неустановленные — установить, установленные — обновить'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static ui:Glyphs.Download}" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding InstallSelectedText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </c:StickyBar.Actions>
        </c:StickyBar>
    </Grid>
</UserControl>
