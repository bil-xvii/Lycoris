<UserControl x:Class="Monolith.Modules.Cleaner.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Monolith.UI.Controls"
             xmlns:ui="clr-namespace:Monolith.UI"
             xmlns:local="clr-namespace:Monolith.Modules.Cleaner"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:CleanerViewModel}">
    <UserControl.Resources>
        <!-- Risk tier: БЕЗОПАСНО (outline) · ПО ЖЕЛАНИЮ (muted) · ЭКСПЕРТ (hatched) -->
        <Style x:Key="TierChip" TargetType="Border" BasedOn="{StaticResource Tag}">
            <Setter Property="Margin" Value="0,2,6,2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tier}" Value="Optional">
                    <Setter Property="BorderBrush" Value="{StaticResource B.Line2}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text3}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tier}" Value="Expert">
                    <Setter Property="Background" Value="{StaticResource B.Hatch}" />
                    <Setter Property="BorderBrush" Value="{StaticResource B.Text2}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- НУЖНЫ ПРАВА АДМИНИСТРАТОРА: muted with rights, hatched when it blocks the row -->
        <Style x:Key="AdminChip" TargetType="Border" BasedOn="{StaticResource Tag.Muted}">
            <Setter Property="Margin" Value="0,2,6,2" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RequiresAdmin}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RequiresAdmin}" Value="True" />
                        <Condition Binding="{Binding IsSelectable}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource B.Hatch}" />
                    <Setter Property="BorderBrush" Value="{StaticResource B.Text2}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WarnChip" TargetType="Border" BasedOn="{StaticResource Tag.Hatch}">
            <Setter Property="Margin" Value="0,2,6,2" />
        </Style>

        <Style x:Key="MutedChip" TargetType="Border" BasedOn="{StaticResource Tag.Muted}">
            <Setter Property="Margin" Value="0,2,6,2" />
        </Style>

        <!-- Status chip on the right of a row -->
        <Style x:Key="StatusChip" TargetType="Border" BasedOn="{StaticResource Tag.Muted}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusTone}" Value="Normal">
                    <Setter Property="BorderBrush" Value="{StaticResource B.Line3}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text2}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="Done">
                    <Setter Property="Background" Value="{StaticResource B.White}" />
                    <Setter Property="BorderBrush" Value="{StaticResource B.White}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource B.Ink}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="Warning">
                    <Setter Property="Background" Value="{StaticResource B.Hatch}" />
                    <Setter Property="BorderBrush" Value="{StaticResource B.Text2}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Size readout: bright when the row is selected -->
        <Style x:Key="RowSize" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontStretch" Value="Condensed" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Hatched-band callout -->
        <Style x:Key="BandCallout" TargetType="Border" BasedOn="{StaticResource Callout}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>

        <!-- ═══════════════ One cleanup item ═══════════════ -->
        <DataTemplate x:Key="ItemRow" DataType="{x:Type local:CleanItem}">
            <Grid>
                <Border Padding="22,17,24,17" MouseLeftButtonUp="Row_MouseLeftButtonUp">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Row}">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanToggle}" Value="True">
                                    <Setter Property="Cursor" Value="Hand" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>

                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanToggle}" VerticalAlignment="Top"
                                  Margin="0,1,20,0" ToolTip="Включить в очистку" />

                        <StackPanel Grid.Column="1" MaxWidth="820" HorizontalAlignment="Left">
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name, Converter={StaticResource Upper}}" Style="{StaticResource T.H3}" FontSize="15.5"
                                           FontStretch="SemiCondensed" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Border Style="{StaticResource TierChip}">
                                    <TextBlock Text="{Binding TierText}" />
                                </Border>
                                <Border Style="{StaticResource AdminChip}">
                                    <TextBlock Text="НУЖНЫ ПРАВА АДМИНИСТРАТОРА" />
                                </Border>
                                <Border Style="{StaticResource WarnChip}" Visibility="{Binding IsAppRunning, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding CloseAppTag}" />
                                </Border>
                                <Border Style="{StaticResource MutedChip}" Visibility="{Binding IsLong, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="ДОЛГО" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="{Binding Description}" Style="{StaticResource T.Body}" FontSize="12.5" Margin="0,7,0,0" />
                            <TextBlock Text="{Binding Effect}" Style="{StaticResource T.Caption}" Margin="0,4,0,0" LineHeight="17" />
                            <Grid Margin="0,10,0,0" Visibility="{Binding Note, Converter={StaticResource NullToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Width="6" Height="6" Fill="{StaticResource B.Text}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Note}" Style="{StaticResource T.Body}" FontSize="12" LineHeight="17"
                                           Foreground="{StaticResource B.Text}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="24,0,0,0">
                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource RowSize}" />
                            <TextBlock Text="{Binding CountText}" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{StaticResource B.Text3}"
                                       HorizontalAlignment="Right" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                            <Border Style="{StaticResource StatusChip}" Margin="0,10,0,0">
                                <TextBlock Text="{Binding StatusText}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Selected rows carry a white edge -->
                <Rectangle Width="3" HorizontalAlignment="Left" Fill="{StaticResource B.White}" Margin="0,0,0,1" IsHitTestVisible="False"
                           Visibility="{Binding IsChecked, Converter={StaticResource BoolToVis}}" />
                <ProgressBar VerticalAlignment="Bottom" Height="2" IsIndeterminate="{Binding IsWorking}" Margin="0,0,0,1" IsHitTestVisible="False"
                             Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <c:PageHeader Index="{Binding Index}" Title="{Binding Title}" Subtitle="{Binding Subtitle}">
            <c:PageHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Btn.Ghost}" Height="40" Margin="0,0,8,0" Command="{Binding CancelCommand}"
                            Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static ui:Glyphs.Cancel}" FontFamily="{StaticResource F.Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="ОТМЕНА" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Ghost}" Height="40" Margin="0,0,8,0" Content="ПО УМОЛЧАНИЮ" Command="{Binding ResetSelectionCommand}"
                            ToolTip="Вернуть рекомендуемый набор пунктов" />
                    <Button Height="40" Padding="20,0" Margin="0,0,10,0" Command="{Binding AnalyzeCommand}"
                            ToolTip="Посчитать, сколько места занимает мусор. Ничего не удаляется.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static ui:Glyphs.Search}" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,9,0" />
                            <TextBlock Text="АНАЛИЗ" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Primary}" Height="40" Padding="24,0" Command="{Binding CleanCommand}"
                            ToolTip="Удалить отмеченное — после подтверждения со списком">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static ui:Glyphs.Delete}" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,9,0" />
                            <TextBlock Text="ОЧИСТИТЬ" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </c:PageHeader.Actions>
        </c:PageHeader>

        <ScrollViewer Grid.Row="1" Margin="0,26,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="0,0,14,16">

                <!-- ═══════════════ Summary ═══════════════ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="26,22,22,20" BorderThickness="1,1,0,1">
                        <StackPanel>
                            <TextBlock Text="НАЙДЕНО" Style="{StaticResource T.Label}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{Binding FoundValue}" Style="{StaticResource T.Stat}" FontSize="52" />
                                <TextBlock Text="{Binding FoundUnit}" Style="{StaticResource T.StatUnit}" FontSize="19" Margin="7,0,0,10" />
                            </StackPanel>
                            <TextBlock Text="{Binding FoundCaption}" Style="{StaticResource T.Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card.Inverted}" Padding="26,22,22,20">
                        <StackPanel>
                            <TextBlock Text="К ОЧИСТКЕ" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Ink}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{Binding SelectedValue}" Style="{StaticResource T.Stat}" FontSize="52" Foreground="{StaticResource B.Ink}" />
                                <TextBlock Text="{Binding SelectedUnit}" Style="{StaticResource T.StatUnit}" FontSize="19" Margin="7,0,0,10" Foreground="{StaticResource B.Ink}" />
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedCaption}" Style="{StaticResource T.Caption}" Margin="0,2,0,0" Foreground="{StaticResource B.Text3}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="26,22,22,20" BorderThickness="0,1,1,1">
                        <StackPanel>
                            <TextBlock Text="ОСВОБОЖДЕНО" Style="{StaticResource T.Label}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{Binding FreedValue}" Style="{StaticResource T.Stat}" FontSize="52" />
                                <TextBlock Text="{Binding FreedUnit}" Style="{StaticResource T.StatUnit}" FontSize="19" Margin="7,0,0,10" />
                            </StackPanel>
                            <TextBlock Text="{Binding FreedCaption}" Style="{StaticResource T.Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Status strip -->
                <Border Style="{StaticResource Card}" Padding="26,14,24,14" BorderThickness="1,0,1,1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="7" Height="7" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource B.Text3}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource B.White}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding WorkTitle}" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Text}"
                                       VerticalAlignment="Center" Margin="12,0,18,0" />
                            <TextBlock Grid.Column="2" Text="{Binding WorkDetail}" Style="{StaticResource T.Caption}" VerticalAlignment="Center"
                                       Foreground="{StaticResource B.Text2}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock Grid.Column="3" Text="{Binding WorkPercent}" Style="{StaticResource T.Mono}" FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="{StaticResource B.Text}" Margin="16,0,0,0" />
                        </Grid>
                        <ProgressBar Grid.Row="1" Margin="0,12,0,0" Maximum="100" Value="{Binding WorkProgress}" IsIndeterminate="{Binding WorkIndeterminate}"
                                     Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>

                <!-- ═══════════════ Free space: one card per fixed drive + Storage Sense ═══════════════ -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl ItemsSource="{Binding Drives}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:DriveCard}">
                                <Border Style="{StaticResource Card}" Padding="22,16,22,18" Margin="0,0,16,0">
                                    <StackPanel>
                                        <TextBlock Text="СВОБОДНОЕ МЕСТО" Style="{StaticResource T.Label}" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource F.Display}" FontWeight="Bold" FontStretch="Condensed"
                                                       FontSize="26" Foreground="{StaticResource B.Text}" VerticalAlignment="Bottom" />
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource T.Label}" Margin="10,0,10,5"
                                                       VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding FreeText}" FontFamily="{StaticResource F.Display}" FontWeight="Bold"
                                                       FontStretch="Condensed" FontSize="22" Foreground="{StaticResource B.Text}" VerticalAlignment="Bottom" Margin="0,0,0,1" />
                                        </Grid>
                                        <c:Meter Value="{Binding UsedPercent}" Segments="32" Gap="2" Height="8" HotThreshold="90" Margin="0,10,0,0" />
                                        <TextBlock Text="{Binding Caption}" Style="{StaticResource T.Caption}" Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,16,22,18">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top">
                                <TextBlock Text="КОНТРОЛЬ ПАМЯТИ WINDOWS" Style="{StaticResource T.Label}" />
                                <TextBlock Text="{Binding StorageSenseState}" Style="{StaticResource T.Mono}" FontSize="11" HorizontalAlignment="Right"
                                           Foreground="{StaticResource B.Text}" />
                            </Grid>
                            <Button DockPanel.Dock="Bottom" Command="{Binding OpenStorageSenseCommand}" HorizontalContentAlignment="Stretch" Padding="14,0" Margin="0,12,0,0"
                                    ToolTip="Открыть «Параметры → Система → Память»">
                                <Grid>
                                    <TextBlock Text="ОТКРЫТЬ ПАРАМЕТРЫ ПАМЯТИ" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Static ui:Glyphs.OpenExternal}" FontFamily="{StaticResource F.Icons}" FontSize="12" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <TextBlock Text="{Binding StorageSenseText}" Style="{StaticResource T.Caption}" Margin="0,8,0,0" LineHeight="16" />
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Read-only mode -->
                <Border Style="{StaticResource BandCallout}" Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Fill="{StaticResource B.HatchStrong}" />
                        <StackPanel Grid.Column="1" Margin="20,14,22,15">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static ui:Glyphs.Lock}" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{StaticResource B.Text}" Margin="0,0,10,0" />
                                <TextBlock Text="РЕЖИМ ПРОСМОТРА · ЧАСТЬ ПУНКТОВ НЕДОСТУПНА" Style="{StaticResource T.H3}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding ReadOnlyText}" Style="{StaticResource T.Body}" FontSize="12.5" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Elevated as another account -->
                <Border Style="{StaticResource BandCallout}" Visibility="{Binding ForeignUserText, Converter={StaticResource NullToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Fill="{StaticResource B.HatchStrong}" />
                        <StackPanel Grid.Column="1" Margin="20,14,22,15">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static ui:Glyphs.Admin}" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{StaticResource B.Text}" Margin="0,0,10,0" />
                                <TextBlock Text="ДРУГАЯ УЧЁТНАЯ ЗАПИСЬ" Style="{StaticResource T.H3}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding ForeignUserText}" Style="{StaticResource T.Body}" FontSize="12.5" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Windows is servicing itself -->
                <Border Style="{StaticResource BandCallout}" Visibility="{Binding ServicingText, Converter={StaticResource NullToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Fill="{StaticResource B.HatchStrong}" />
                        <StackPanel Grid.Column="1" Margin="20,14,22,15">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static ui:Glyphs.Sync}" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{StaticResource B.Text}" Margin="0,0,10,0" />
                                <TextBlock Text="WINDOWS ВЫПОЛНЯЕТ ОБСЛУЖИВАНИЕ" Style="{StaticResource T.H3}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding ServicingText}" Style="{StaticResource T.Body}" FontSize="12.5" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══════════════ Groups ═══════════════ -->
                <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:CleanGroup}">
                            <StackPanel Margin="0,36,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource B.White}" Padding="6,1,6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Index}" FontFamily="{StaticResource F.Mono}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource B.Ink}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource T.H1}" FontSize="26" Margin="12,0,0,0"
                                               VerticalAlignment="Center" />
                                    <Rectangle Grid.Column="2" Height="1" Fill="{StaticResource B.Line2}" VerticalAlignment="Center" Margin="18,3,18,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding Meta}" Style="{StaticResource T.Mono}" FontSize="11.5" VerticalAlignment="Center"
                                               Foreground="{StaticResource B.Text2}" />
                                </Grid>
                                <TextBlock Text="{Binding Hint}" Style="{StaticResource T.Caption}" Margin="0,6,0,14" />
                                <Border Style="{StaticResource Card.Flush}" BorderThickness="1,1,1,0">
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ItemRow}" Focusable="False" />
                                </Border>
                                <TextBlock Text="{Binding MissingText}" Style="{StaticResource T.Mono}" FontSize="10.5" Foreground="{StaticResource B.Text3}"
                                           Margin="0,10,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding MissingText, Converter={StaticResource NullToVis}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ═══════════════ Bottom: guarantees + how it works ═══════════════ -->
                <Grid Margin="0,40,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Padding="24,20,24,22">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="НИКОГДА НЕ УДАЛЯЕТСЯ" Style="{StaticResource T.Label}" />
                                <TextBlock Text="{x:Static ui:Glyphs.Shield}" FontFamily="{StaticResource F.Icons}" FontSize="12" HorizontalAlignment="Right"
                                           Foreground="{StaticResource B.Text3}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding NeverTouched}" Margin="0,4,0,0" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:GuaranteeLine}">
                                        <Grid Margin="0,14,22,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Static ui:Glyphs.Lock}" FontFamily="{StaticResource F.Icons}" FontSize="11" Foreground="{StaticResource B.Text2}"
                                                       VerticalAlignment="Top" Margin="0,3,0,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource T.BodyStrong}" FontSize="12.5" LineHeight="17" />
                                                <TextBlock Text="{Binding Reason}" Style="{StaticResource T.Caption}" Margin="0,3,0,0" LineHeight="16" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,20,22,22">
                        <StackPanel>
                            <TextBlock Text="КАК РАБОТАЕТ ОЧИСТКА" Style="{StaticResource T.Label}" />
                            <ItemsControl ItemsSource="{Binding Steps}" Margin="0,2,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:StepLine}">
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{StaticResource B.Surface4}" Padding="5,1,5,2" VerticalAlignment="Top" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Index}" FontFamily="{StaticResource F.Mono}" FontSize="10.5" FontWeight="Bold"
                                                           Foreground="{StaticResource B.Text}" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Text}" />
                                                <TextBlock Text="{Binding Text}" Style="{StaticResource T.Caption}" Margin="0,3,0,0" LineHeight="16" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
