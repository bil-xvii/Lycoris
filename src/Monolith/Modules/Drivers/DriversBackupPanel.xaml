<UserControl x:Class="Monolith.Modules.Drivers.DriversBackupPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Monolith.Modules.Drivers"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:DriversViewModel}">
    <UserControl.Resources>
        <local:AnyTrueToVisibilityConverter x:Key="Drv.AnyTrueToVis" />
        <Style x:Key="Drv.Fact" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,36,0" />
        </Style>
        <Style x:Key="Drv.FactValue" TargetType="TextBlock" BasedOn="{StaticResource T.Stat}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,28">

            <!-- ═══════════ Create backup ═══════════ -->
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.ColumnSpan="2" Height="3" VerticalAlignment="Top" Fill="{StaticResource B.White}" />
                    <StackPanel Margin="24,24,24,22">
                        <TextBlock Text="РЕЗЕРВНАЯ КОПИЯ ДРАЙВЕРОВ" Style="{StaticResource T.H1}" />
                        <TextBlock Style="{StaticResource T.Body}" Margin="0,8,0,0" MaxWidth="660" HorizontalAlignment="Left"
                                   Text="Сохраняет все сторонние драйверы — видеокарты, чипсета, сети, звука — в отдельную папку встроенной утилитой Windows pnputil. Пригодится после переустановки системы или неудачного обновления: из копии драйверы возвращаются одной кнопкой." />
                        <WrapPanel Margin="0,18,0,0">
                            <StackPanel Style="{StaticResource Drv.Fact}">
                                <TextBlock Text="ПАКЕТОВ К СОХРАНЕНИЮ" Style="{StaticResource T.Label}" />
                                <TextBlock Text="{Binding OemPackageCount}" Style="{StaticResource Drv.FactValue}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Drv.Fact}">
                                <TextBlock Text="СВОБОДНО НА ДИСКЕ" Style="{StaticResource T.Label}" />
                                <TextBlock Text="{Binding BackupFreeSpace}" Style="{StaticResource Drv.FactValue}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Drv.Fact}">
                                <TextBlock Text="ПАПКА" Style="{StaticResource T.Label}" />
                                <TextBlock Text="{Binding BackupsRoot}" Style="{StaticResource T.Mono}" FontSize="12" Foreground="{StaticResource B.Text}" Margin="0,11,0,0" />
                            </StackPanel>
                        </WrapPanel>
                        <Border Style="{StaticResource Tag.Hatch}" Margin="0,14,0,0" Visibility="{Binding LowDiskSpace, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="НА СИСТЕМНОМ ДИСКЕ МЕНЬШЕ 5 ГБ — КОПИЯ МОЖЕТ НЕ ПОМЕСТИТЬСЯ" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,24,24,22" Width="230">
                        <Button Style="{StaticResource Btn.Hero}" Command="{Binding ExportBackupCommand}" HorizontalAlignment="Stretch"
                                ToolTip="pnputil /export-driver * — система не изменяется" ToolTipService.ShowOnDisabled="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="{StaticResource F.Icons}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="СОЗДАТЬ КОПИЮ" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenBackupsFolderCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="ОТКРЫТЬ ПАПКУ" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource T.Caption}" Margin="0,10,0,0" TextAlignment="Center"
                                   Text="Копирование не меняет систему. Восстановление — с точкой восстановления." />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════ Operation: progress + pnputil output ═══════════ -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="0">
                <Border.Visibility>
                    <MultiBinding Converter="{StaticResource Drv.AnyTrueToVis}">
                        <Binding Path="IsBackupRunning" />
                        <Binding Path="HasBackupOutput" />
                    </MultiBinding>
                </Border.Visibility>
                <StackPanel>
                    <Grid Margin="20,16,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{Binding BackupStage}" Style="{StaticResource T.H3}" FontSize="15"
                                       Visibility="{Binding IsBackupRunning, Converter={StaticResource BoolToVis}}" />
                            <ProgressBar Margin="0,10,0,0" Height="4" Maximum="100" Value="{Binding BackupPercent}" IsIndeterminate="{Binding BackupIndeterminate}"
                                         Visibility="{Binding IsBackupRunning, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsBackupRunning, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock FontFamily="{StaticResource F.Icons}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE7BA;" />
                                            <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BackupResultOk}" Value="True">
                                                    <Setter Property="Text" Value="&#xE73E;" />
                                                    <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding BackupResult}" Style="{StaticResource T.BodyStrong}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Content="ОТМЕНА" MinWidth="100" Command="{Binding CancelBackupCommand}"
                                Visibility="{Binding CanCancelBackup, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <Border Style="{StaticResource Card.Inverted}" Margin="20,14,20,0" Padding="16,10"
                            Visibility="{Binding BackupRebootRequired, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontFamily="{StaticResource F.Body}" FontSize="12.5" Foreground="{StaticResource B.Ink}" TextWrapping="Wrap"
                                   Text="Требуется перезагрузка для завершения установки драйвера. MONOLITH не перезагружает компьютер сам." />
                    </Border>

                    <TextBlock Text="ВЫВОД PNPUTIL" Style="{StaticResource T.Label}" Margin="20,16,20,6" />
                    <Border Background="{StaticResource B.Base}" BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0">
                        <ListBox x:Name="OutputList" Style="{StaticResource List.Plain}" ItemsSource="{Binding BackupOutput}" Height="180" Margin="20,8,8,8"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource T.Mono}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,1" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══════════ Existing backups ═══════════ -->
            <Grid Margin="0,30,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="СОХРАНЁННЫЕ КОПИИ" Style="{StaticResource T.H2}" VerticalAlignment="Center" />
                <Rectangle Grid.Column="1" Height="1" Fill="{StaticResource B.Line2}" VerticalAlignment="Center" Margin="14,0" />
                <TextBlock Grid.Column="2" Text="ВОССТАНОВЛЕНИЕ НЕ ПОНИЖАЕТ ВЕРСИИ ДРАЙВЕРОВ" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
            </Grid>

            <Border Style="{StaticResource Card}" Background="{StaticResource B.DotGrid}" Padding="28,30"
                    Visibility="{Binding HasBackups, Converter={StaticResource InverseBoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" BorderBrush="{StaticResource B.Line3}" BorderThickness="1" Background="{StaticResource B.Surface}">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource T.Icon}" FontSize="22" Foreground="{StaticResource B.Text2}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="КОПИЙ ПОКА НЕТ" Style="{StaticResource T.H2}" />
                        <TextBlock Style="{StaticResource T.Body}" Margin="0,4,0,0"
                                   Text="Создайте копию сейчас, пока все устройства работают. Перед каждой установкой драйверов из Windows Update MONOLITH также сохраняет заменяемые драйверы автоматически." />
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Backups}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:BackupItem}">
                        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="168" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource B.Surface2}" BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,1,0" Padding="20,18">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DateText}" Style="{StaticResource T.H2}" FontSize="16" />
                                        <Border Margin="0,10,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Tag}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBeforeUpdate}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource B.Line2}" />
                                                            <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text3}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding KindText}" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="22,18,16,18">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource T.Stat}" FontSize="22" />
                                        <Rectangle Style="{StaticResource DividerV}" Height="16" Margin="14,0" VerticalAlignment="Center" Fill="{StaticResource B.Line3}" />
                                        <TextBlock Text="{Binding InfCountText}" Style="{StaticResource T.Stat}" FontSize="22" Foreground="{StaticResource B.Text2}" />
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{StaticResource B.Text4}"
                                                   VerticalAlignment="Center" Margin="16,4,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ProvidersText}" Style="{StaticResource T.Body}" Foreground="{StaticResource B.Text}" Margin="0,6,0,0"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource T.Caption}" Margin="0,4,0,0" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}"
                                               Visibility="{Binding Note, Converter={StaticResource NullToVis}}" />
                                    <Expander Margin="0,12,0,0">
                                        <Expander.Header>
                                            <TextBlock Text="{Binding PackagesHeader}" Style="{StaticResource T.Label}" />
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Packages}" Margin="0,4,0,0" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:BackupPackageItem}">
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="200" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="130" />
                                                            <ColumnDefinition Width="84" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Inf}" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{StaticResource B.Text}"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Provider}" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text2}"
                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ClassText}" Style="{StaticResource T.Caption}"
                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Version}" Style="{StaticResource T.Mono}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="4" Text="{Binding DateText}" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{StaticResource B.Text3}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,18,20,18" VerticalAlignment="Top" Width="168">
                                    <Button Style="{StaticResource Btn.Danger}" HorizontalAlignment="Stretch"
                                            Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTipService.ShowOnDisabled="True"
                                            ToolTip="pnputil /add-driver … /subdirs /install — после точки восстановления">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="ВОССТАНОВИТЬ" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="ОТКРЫТЬ" Margin="0,0,8,0"
                                                Command="{Binding DataContext.OpenBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Column="1" Style="{StaticResource Btn.Icon}" Width="36" Height="36" Content="&#xE74D;"
                                                ToolTip="Удалить копию" ToolTipService.ShowOnDisabled="True"
                                                Command="{Binding DataContext.DeleteBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
