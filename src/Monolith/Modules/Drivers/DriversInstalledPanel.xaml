<UserControl x:Class="Monolith.Modules.Drivers.DriversInstalledPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:Monolith.UI"
             xmlns:local="clr-namespace:Monolith.Modules.Drivers"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:DriversViewModel}"
             xmlns:loc="clr-namespace:Monolith.UI">
    <!-- «УСТАНОВЛЕННЫЕ И КОПИИ»: the backup of drivers (create, restore, delete) and the list of installed drivers on one page -->
    <UserControl.Resources>
        <local:AnyTrueToVisibilityConverter x:Key="Drv.AnyTrueToVis" />
        <Style x:Key="Drv.Head" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Drv.Cell" TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="Drv.MonoCell" TargetType="TextBlock" BasedOn="{StaticResource T.Mono}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,9,0" />
        </Style>
        <Style x:Key="Drv.Fact" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,26,0" />
        </Style>
        <Style x:Key="Drv.FactValue" TargetType="TextBlock" BasedOn="{StaticResource T.Stat}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </UserControl.Resources>

    <!-- The list is the page's only ScrollViewer -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,17">

            <!-- ═══════════ Backup: create ═══════════ -->
            <Border Style="{StaticResource Card}" Padding="0" ui:RoundClip.Content="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.ColumnSpan="2" Height="3" VerticalAlignment="Top" Fill="{StaticResource B.White}" />
                    <StackPanel Margin="15,15,15,14">
                        <TextBlock Text="{loc:T Резервная копия драйверов}" Style="{StaticResource T.H1}" />
                        <TextBlock Style="{StaticResource T.Body}" Margin="0,8,0,0" MaxWidth="700" HorizontalAlignment="Left" TextWrapping="Wrap"
                                   Text="{loc:T 'Сохраняет все сторонние драйверы — видеокарты, чипсета, сети, звука — в отдельную папку встроенной утилитой Windows pnputil. Пригодится после переустановки системы. Более старую версию поверх новой копия не ставит — после неудачного обновления используйте «Откатить драйвер» в диспетчере устройств или точку восстановления.'}" />
                        <WrapPanel Margin="0,11,0,0">
                            <StackPanel Style="{StaticResource Drv.Fact}">
                                <TextBlock Text="{loc:T ПАКЕТОВ К СОХРАНЕНИЮ}" Style="{StaticResource T.Label}" />
                                <TextBlock Text="{Binding OemPackageCount}" Style="{StaticResource Drv.FactValue}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Drv.Fact}">
                                <TextBlock Text="{loc:T СВОБОДНО НА ДИСКЕ}" Style="{StaticResource T.Label}" />
                                <TextBlock Text="{Binding BackupFreeSpace}" Style="{StaticResource Drv.FactValue}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Drv.Fact}">
                                <TextBlock Text="{loc:T ПАПКА}" Style="{StaticResource T.Label}" />
                                <TextBlock Text="{Binding BackupsRoot}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text}" Margin="0,11,0,0" />
                            </StackPanel>
                        </WrapPanel>
                        <Border Style="{StaticResource Tag.Hatch}" Margin="0,10,0,0" Visibility="{Binding LowDiskSpace, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:T НА СИСТЕМНОМ ДИСКЕ МЕНЬШЕ 5 ГБ — КОПИЯ МОЖЕТ НЕ ПОМЕСТИТЬСЯ}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,15,15,14" Width="230">
                        <Button Command="{Binding ExportBackupCommand}" HorizontalAlignment="Stretch"
                                ToolTip="{loc:T pnputil /export-driver * — система не изменяется}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static ui:Glyphs.Save}" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{loc:T СОЗДАТЬ КОПИЮ}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenBackupsFolderCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static ui:Glyphs.Folder}" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{loc:T ОТКРЫТЬ ПАПКУ}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource T.Caption}" Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                   Text="{loc:T Копирование не меняет систему. Восстановление — с точкой восстановления.}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════ Operation: progress + pnputil output ═══════════ -->
            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="0" ui:RoundClip.Content="True">
                <Border.Visibility>
                    <MultiBinding Converter="{StaticResource Drv.AnyTrueToVis}">
                        <Binding Path="IsBackupRunning" />
                        <Binding Path="HasBackupOutput" />
                    </MultiBinding>
                </Border.Visibility>
                <StackPanel>
                    <Grid Margin="12,10,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding BackupStage, Converter={StaticResource Sentence}}" Style="{StaticResource T.H3}" FontSize="15"
                                       Visibility="{Binding IsBackupRunning, Converter={StaticResource BoolToVis}}" />
                            <ProgressBar Margin="0,10,0,0" Height="4" Maximum="100" Value="{Binding BackupPercent}" IsIndeterminate="{Binding BackupIndeterminate}"
                                         Visibility="{Binding IsBackupRunning, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsBackupRunning, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock FontFamily="{StaticResource F.Icons}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource B.Text}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE7BA;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BackupResultOk}" Value="True">
                                                    <Setter Property="Text" Value="&#xE73E;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding BackupResult}" Style="{StaticResource T.BodyStrong}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Btn.Danger}" MinWidth="100" Command="{Binding CancelBackupCommand}"
                                Visibility="{Binding CanCancelBackup, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:T ОТМЕНА}" />
                        </Button>
                    </Grid>

                    <Border Style="{StaticResource Card.Inverted}" Margin="12,10,12,0" Padding="10,10"
                            Visibility="{Binding BackupRebootRequired, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontFamily="{StaticResource F.Body}" FontSize="12.5" Foreground="{StaticResource B.Ink}" TextWrapping="Wrap"
                                   Text="{loc:T Требуется перезагрузка для завершения установки драйвера. MONOLITH не перезагружает компьютер сам.}" />
                    </Border>

                    <TextBlock Text="{loc:T ВЫВОД PNPUTIL}" Style="{StaticResource T.Label}" Margin="12,10,12,6" />
                    <Border Background="{StaticResource B.Base}" BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0">
                        <ListBox x:Name="OutputList" Style="{StaticResource List.Plain}" ItemsSource="{Binding BackupOutput}" Height="180" Margin="12,8,8,8"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource T.Mono}" TextTrimming="CharacterEllipsis" Margin="0,1" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══════════ Saved copies ═══════════ -->
            <Grid Margin="0,19,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:T Сохранённые копии}" Style="{StaticResource T.H2}" VerticalAlignment="Center" />
                <Rectangle Grid.Column="1" Height="1" Fill="{StaticResource B.Line2}" VerticalAlignment="Center" Margin="10,0" />
                <TextBlock Grid.Column="2" Text="{loc:T ВОССТАНОВЛЕНИЕ НЕ ПОНИЖАЕТ ВЕРСИИ ДРАЙВЕРОВ}" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
            </Grid>

            <Border Style="{StaticResource Card}" Background="{StaticResource B.DotGrid}" Padding="17,16"
                    Visibility="{Binding HasBackups, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{loc:T Копий пока нет}" Style="{StaticResource T.H2}" />
                    <TextBlock Style="{StaticResource T.Body}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="{loc:T 'Создайте копию сейчас, пока все устройства работают. Перед каждой установкой драйверов из Windows Update MONOLITH также сохраняет заменяемые драйверы автоматически.'}" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Backups}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:BackupItem}">
                        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,9" ui:RoundClip.Content="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="168" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource B.Surface2}" BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,1,0" Padding="12,11">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DateText, Converter={StaticResource Sentence}}" Style="{StaticResource T.H2}" FontSize="16" />
                                        <Grid Margin="0,10,0,0" HorizontalAlignment="Left">
                                            <Border Style="{StaticResource Tag}" Visibility="{Binding IsBeforeUpdate, Converter={StaticResource InverseBoolToVis}}">
                                                <TextBlock Text="{Binding KindText}" />
                                            </Border>
                                            <Border Style="{StaticResource Tag.Muted}" Visibility="{Binding IsBeforeUpdate, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding KindText}" />
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,11,10,11">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource T.Stat}" FontSize="17" />
                                        <Rectangle Style="{StaticResource DividerV}" Height="16" Margin="10,0" VerticalAlignment="Center" Fill="{StaticResource B.Line3}" />
                                        <TextBlock Text="{Binding InfCountText}" Style="{StaticResource T.Stat}" FontSize="17" Foreground="{StaticResource B.Text2}" />
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text3}"
                                                   VerticalAlignment="Center" Margin="10,4,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ProvidersText}" Style="{StaticResource T.Body}" Foreground="{StaticResource B.Text}" Margin="0,6,0,0"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource T.Caption}" Margin="0,4,0,0" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}"
                                               Visibility="{Binding Note, Converter={StaticResource NullToVis}}" />
                                    <Expander Margin="0,9,0,0">
                                        <Expander.Header>
                                            <TextBlock Text="{Binding PackagesHeader}" Style="{StaticResource T.Label}" />
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Packages}" Margin="0,4,0,0" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:BackupPackageItem}">
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="200" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="156" />
                                                            <ColumnDefinition Width="84" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Inf}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text}"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Provider}" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text2}"
                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ClassText}" Style="{StaticResource T.Caption}"
                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Version}" Style="{StaticResource T.Mono}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="4" Text="{Binding DateText}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text3}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </StackPanel>

                                <!-- Every action of a copy is a labelled button -->
                                <StackPanel Grid.Column="2" Margin="0,11,12,11" VerticalAlignment="Top" Width="190">
                                    <Button Style="{StaticResource Btn.Danger}" HorizontalAlignment="Stretch"
                                            Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{loc:T pnputil /add-driver &lt;пакет&gt;.inf /install для каждого пакета из описания копии — после точки восстановления}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{x:Static ui:Glyphs.Undo}" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{loc:T ВОССТАНОВИТЬ ИЗ КОПИИ}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Command="{Binding DataContext.OpenBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{loc:T ОТКРЫТЬ}" />
                                        </Button>
                                        <Button Grid.Column="2" Style="{StaticResource Btn.Danger}"
                                                Command="{Binding DataContext.DeleteBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="{loc:T Папка копии будет удалена безвозвратно (не в корзину)}">
                                            <TextBlock Text="{loc:T УДАЛИТЬ}" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ═══════════ Installed drivers ═══════════ -->
            <Grid Margin="0,19,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:T Установленные драйверы}" Style="{StaticResource T.H2}" VerticalAlignment="Center" />
                <Rectangle Grid.Column="1" Height="1" Fill="{StaticResource B.Line2}" VerticalAlignment="Center" Margin="10,0" />
                <TextBlock Grid.Column="2" Text="{Binding InstalledSummary}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text3}" VerticalAlignment="Center" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox Text="{Binding InstalledSearch, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="10,0,98,0"
                             Tag="{loc:T 'Поиск: устройство, производитель, версия, INF, ID'}" />
                    <TextBlock Text="{x:Static ui:Glyphs.Search}" FontFamily="{StaticResource F.Icons}" FontSize="13" Foreground="{StaticResource B.Text3}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" IsHitTestVisible="False"
                               Visibility="{Binding InstalledSearch, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                    <!-- A labelled button instead of the icon-only «✕» -->
                    <Button Padding="8,0" HorizontalAlignment="Right" Margin="0,0,0,0"
                            Command="{Binding ClearInstalledSearchCommand}" ToolTip="{loc:T Очистить строку поиска}"
                            Visibility="{Binding InstalledSearch, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{loc:T СБРОСИТЬ}" />
                    </Button>
                </Grid>
                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding HideMicrosoft}" Margin="15,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                          ToolTip="{loc:T 'Скрыть драйверы, которые входят в состав Windows или поставляются Microsoft'}">
                    <StackPanel>
                        <TextBlock Text="{loc:T СКРЫТЬ ДРАЙВЕРЫ MICROSOFT}" FontFamily="{StaticResource F.Display}" FontWeight="SemiBold" FontStretch="SemiCondensed" FontSize="12.5" />
                        <TextBlock Text="{loc:T встроенные в Windows}" Style="{StaticResource T.Caption}" />
                    </StackPanel>
                </CheckBox>
            </Grid>

            <Border Style="{StaticResource Callout}" Margin="0,10,0,0" Visibility="{Binding InstalledError, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding InstalledError}" Style="{StaticResource T.Body}" />
            </Border>

            <!-- RoundClip: hovered rows paint to the edge; the card corners clip them -->
            <Border Style="{StaticResource Card.Flush}" Margin="0,10,0,0" ui:RoundClip.Content="True">
                <StackPanel>
                    <Border BorderBrush="{StaticResource B.Line2}" BorderThickness="0,0,0,1" Padding="10,11,12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="86" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:T УСТРОЙСТВО}" Style="{StaticResource Drv.Head}" />
                            <TextBlock Grid.Column="1" Text="{loc:T КЛАСС}" Style="{StaticResource Drv.Head}" />
                            <TextBlock Grid.Column="2" Text="{loc:T ПОСТАВЩИК}" Style="{StaticResource Drv.Head}" />
                            <TextBlock Grid.Column="3" Text="{loc:T ВЕРСИЯ}" Style="{StaticResource Drv.Head}" />
                            <TextBlock Grid.Column="4" Text="{loc:T ДАТА}" Style="{StaticResource Drv.Head}" />
                            <TextBlock Grid.Column="5" Text="{loc:T ПОДПИСЬ}" Style="{StaticResource Drv.Head}" />
                            <TextBlock Grid.Column="6" Text="INF" Style="{StaticResource Drv.Head}" />
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding InstalledView}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:InstalledDriverItem}">
                                <Border Style="{StaticResource Row}" Padding="10,9,12,9" ToolTip="{Binding Tooltip}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="86" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Margin="0,0,10,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DeviceName}" Style="{StaticResource T.BodyStrong}" FontSize="12.5" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Style="{StaticResource Tag.Muted}" Margin="8,0,0,0"
                                                    Visibility="{Binding HasDuplicates, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding CountText}" FontFamily="{StaticResource F.Mono}" />
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource Tag.Muted}" Margin="8,0,0,0"
                                                    Visibility="{Binding IsInbox, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="{loc:T 'Драйвер входит в состав Windows. Дата 2006/2009 у таких драйверов — норма, они не «устаревшие».'}">
                                                <TextBlock Text="{loc:T ВСТРОЕННЫЙ}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding ClassText}" Style="{StaticResource Drv.Cell}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Provider}" Style="{StaticResource Drv.Cell}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Version}" Style="{StaticResource Drv.MonoCell}" Foreground="{StaticResource B.Text}" />
                                        <TextBlock Grid.Column="4" Text="{Binding DateText}" Style="{StaticResource Drv.MonoCell}" />
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Signer}">
                                            <TextBlock FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource B.Text2}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE73E;" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSigned}" Value="False">
                                                                <Setter Property="Text" Value="&#xE7BA;" />
                                                                <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding SignedText, Converter={StaticResource Sentence}}" FontFamily="{StaticResource F.Display}" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="6" Text="{Binding InfName}" Style="{StaticResource Drv.MonoCell}" Margin="0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,24"
                                Visibility="{Binding InstalledEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:T Ничего не найдено}" Style="{StaticResource T.H2}" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource T.Caption}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                   Text="{loc:T Измените запрос или выключите «Скрыть драйверы Microsoft».}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
