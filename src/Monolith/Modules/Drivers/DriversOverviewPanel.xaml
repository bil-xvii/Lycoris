<UserControl x:Class="Monolith.Modules.Drivers.DriversOverviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Monolith.Modules.Drivers"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:DriversViewModel}">
    <UserControl.Resources>
        <local:AllTrueToVisibilityConverter x:Key="Drv.AllTrueToVis" />
        <local:HasTextConverter x:Key="Drv.HasText" />
        <!-- Stat cell of the summary strip (a flat button that opens the matching tab) -->
        <Style x:Key="Drv.StatCell" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Padding" Value="20,16,16,16" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <Style x:Key="Drv.StatValue" TargetType="TextBlock" BasedOn="{StaticResource T.Stat}">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Drv.StatCaption" TargetType="TextBlock" BasedOn="{StaticResource T.Caption}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <!-- Section heading: TITLE ───────────── note -->
        <Style x:Key="Drv.SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource T.H2}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Tag that turns hatched when its DataContext flag says "warning" -->
        <Style x:Key="Drv.VerdictTag" TargetType="Border" BasedOn="{StaticResource Tag}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding VerdictIsWarning}" Value="True">
                    <Setter Property="Background" Value="{StaticResource B.Hatch}" />
                    <Setter Property="BorderBrush" Value="{StaticResource B.Text2}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Drv.CardFooter" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource B.Line}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="22,14" />
            <Setter Property="Margin" Value="0,18,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,28">

            <!-- ═══════════ Summary strip ═══════════ -->
            <Border Style="{StaticResource Card.Flush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource Drv.StatCell}" Command="{Binding GoToTabCommand}" CommandParameter="Installed"
                            ToolTip="Все драйверы устройств этого компьютера">
                        <StackPanel>
                            <TextBlock Text="ДРАЙВЕРЫ" Style="{StaticResource T.Label}" />
                            <TextBlock Text="{Binding DriversStat}" Style="{StaticResource Drv.StatValue}" />
                            <TextBlock Text="{Binding DriversCaption}" Style="{StaticResource Drv.StatCaption}" />
                        </StackPanel>
                    </Button>
                    <Rectangle Grid.Column="1" Style="{StaticResource DividerV}" />

                    <Grid Grid.Column="2">
                        <Rectangle Height="3" VerticalAlignment="Top" Fill="{StaticResource B.HatchStrong}"
                                   Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource Drv.StatCell}" Command="{Binding GoToTabCommand}" CommandParameter="Problems"
                                ToolTip="Устройства, о которых Windows сообщает ошибку">
                            <StackPanel>
                                <TextBlock Text="ПРОБЛЕМНЫЕ УСТРОЙСТВА" Style="{StaticResource T.Label}" />
                                <TextBlock Text="{Binding ProblemsStat}" Style="{StaticResource Drv.StatValue}" />
                                <TextBlock Text="{Binding ProblemsCaption}" Style="{StaticResource Drv.StatCaption}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Rectangle Grid.Column="3" Style="{StaticResource DividerV}" />

                    <Grid Grid.Column="4">
                        <Rectangle Height="3" VerticalAlignment="Top" Fill="{StaticResource B.White}"
                                   Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource Drv.StatCell}" Command="{Binding GoToTabCommand}" CommandParameter="Updates"
                                ToolTip="Драйверы, которые предлагает Windows Update">
                            <StackPanel>
                                <TextBlock Text="ОБНОВЛЕНИЯ WINDOWS" Style="{StaticResource T.Label}" />
                                <TextBlock Text="{Binding UpdatesStat}" Style="{StaticResource Drv.StatValue}" />
                                <TextBlock Text="{Binding UpdatesCaption}" Style="{StaticResource Drv.StatCaption}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Rectangle Grid.Column="5" Style="{StaticResource DividerV}" />

                    <Border Grid.Column="6" Padding="20,16,16,16" ToolTip="Версия драйвера основной видеокарты">
                        <StackPanel>
                            <TextBlock Text="ВИДЕОДРАЙВЕР" Style="{StaticResource T.Label}" />
                            <TextBlock Text="{Binding GpuStat}" Style="{StaticResource Drv.StatValue}" />
                            <TextBlock Text="{Binding GpuCaption}" Style="{StaticResource Drv.StatCaption}" />
                        </StackPanel>
                    </Border>
                    <Rectangle Grid.Column="7" Style="{StaticResource DividerV}" />

                    <Button Grid.Column="8" Style="{StaticResource Drv.StatCell}" Command="{Binding GoToTabCommand}" CommandParameter="Backup"
                            ToolTip="Резервные копии драйверов">
                        <StackPanel>
                            <TextBlock Text="РЕЗЕРВНЫЕ КОПИИ" Style="{StaticResource T.Label}" />
                            <TextBlock Text="{Binding BackupsStat}" Style="{StaticResource Drv.StatValue}" />
                            <TextBlock Text="{Binding BackupsCaption}" Style="{StaticResource Drv.StatCaption}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══════════ GPUs ═══════════ -->
            <Grid Margin="0,30,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="ВИДЕОКАРТЫ" Style="{StaticResource Drv.SectionTitle}" />
                <Rectangle Grid.Column="1" Height="1" Fill="{StaticResource B.Line2}" VerticalAlignment="Center" Margin="14,0" />
                <TextBlock Grid.Column="2" Text="ТОЛЬКО ОФИЦИАЛЬНЫЕ ИСТОЧНИКИ ПРОИЗВОДИТЕЛЕЙ" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
            </Grid>

            <Border Style="{StaticResource Callout}" Visibility="{Binding GpusEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource T.Body}" Text="Видеоадаптеры не найдены. Если сведения о системе ещё собираются, нажмите «Обновить» через несколько секунд." />
            </Border>

            <ItemsControl ItemsSource="{Binding Gpus}" Margin="0,0,-16,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding GpuColumns}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:GpuCardItem}">
                        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,16,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Rectangle Height="3" VerticalAlignment="Top" Fill="{StaticResource B.White}"
                                           Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVis}}" />

                                <StackPanel Margin="22,22,22,0">
                                    <DockPanel LastChildFill="False">
                                        <Border Style="{StaticResource Tag.Solid}" DockPanel.Dock="Left">
                                            <TextBlock Text="{Binding VendorText}" />
                                        </Border>
                                        <Border Style="{StaticResource Tag}" DockPanel.Dock="Left" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding RoleText}" />
                                        </Border>
                                        <Border Style="{StaticResource Drv.VerdictTag}" DockPanel.Dock="Right"
                                                Visibility="{Binding ShowVerdict, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding VerdictText}" />
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Name, Converter={StaticResource Upper}}" Style="{StaticResource T.H1}" Margin="0,14,0,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.3*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding VersionLabel}" Style="{StaticResource T.Label}" />
                                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource T.Stat}" FontSize="28" Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="ДАТА ДРАЙВЕРА" Style="{StaticResource T.Label}" />
                                            <TextBlock Text="{Binding DateText}" Style="{StaticResource T.Stat}" FontSize="28" Margin="0,4,0,0"
                                                       Foreground="{StaticResource B.Text2}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="ВОЗРАСТ" Style="{StaticResource T.Label}" />
                                            <TextBlock Text="{Binding AgeText}" Style="{StaticResource T.Stat}" FontSize="28" Margin="0,4,0,0"
                                                       Foreground="{StaticResource B.Text2}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding TechLine}" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{StaticResource B.Text3}"
                                               Margin="0,10,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding TechLine}" />
                                </StackPanel>

                                <!-- Latest driver hint (NVIDIA) -->
                                <StackPanel Grid.Row="1" Margin="22,16,22,0">
                                    <TextBlock Style="{StaticResource T.Caption}" Text="Проверка последней версии на nvidia.com…"
                                               Visibility="{Binding IsCheckingLatest, Converter={StaticResource BoolToVis}}" />
                                    <Border Padding="14,10" Visibility="{Binding HasLatest, Converter={StaticResource BoolToVis}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource B.Surface2}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource B.Line2}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource B.White}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource B.White}" />
                                                        <Setter Property="TextElement.Foreground" Value="{StaticResource B.Ink}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource F.Icons}" FontSize="15" Margin="0,0,12,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE73E;" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                                                <Setter Property="Text" Value="&#xE896;" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding LatestText}" FontFamily="{StaticResource F.Display}" FontWeight="Bold"
                                                           FontStretch="SemiCondensed" FontSize="14" />
                                                <TextBlock Text="{Binding LatestCaption}" FontFamily="{StaticResource F.Body}" FontSize="11.5" Opacity="0.7"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Text="{Binding Recommendation}" Style="{StaticResource T.Body}" Margin="22,14,22,0" />

                                <Border Grid.Row="3" Style="{StaticResource Drv.CardFooter}">
                                    <StackPanel>
                                        <!-- Direct download: progress -->
                                        <Grid Margin="0,0,0,14" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding DownloadStage}" Style="{StaticResource T.H3}" FontSize="14" DockPanel.Dock="Left" />
                                                    <TextBlock Text="{Binding DownloadDetail}" Style="{StaticResource T.Mono}" FontSize="11" Margin="12,0,0,0"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <ProgressBar Margin="0,8,0,0" Height="4" Maximum="100" Value="{Binding DownloadPercent}"
                                                             IsIndeterminate="{Binding DownloadIndeterminate}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="ОТМЕНА" MinWidth="96" Command="{Binding CancelDownloadCommand}"
                                                    ToolTip="Остановить загрузку — недокачанный файл будет удалён" ToolTipService.ShowOnDisabled="True" />
                                        </Grid>

                                        <!-- Direct download: result -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.Visibility>
                                                <MultiBinding Converter="{StaticResource Drv.AllTrueToVis}">
                                                    <Binding Path="DownloadResult" Converter="{StaticResource Drv.HasText}" />
                                                    <Binding Path="IsDownloading" Converter="{StaticResource InverseBool}" />
                                                </MultiBinding>
                                            </Grid.Visibility>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontFamily="{StaticResource F.Icons}" FontSize="14" VerticalAlignment="Top" Margin="0,1,10,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE7BA;" />
                                                        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DownloadResultOk}" Value="True">
                                                                <Setter Property="Text" Value="&#xE73E;" />
                                                                <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding DownloadResult}" Style="{StaticResource T.Body}" FontSize="12.5"
                                                       Foreground="{StaticResource B.Text}" />
                                        </Grid>

                                        <WrapPanel Margin="0,0,0,-8">
                                            <Button Style="{StaticResource Btn.Primary}" Margin="0,0,8,8"
                                                    Command="{Binding DataContext.DownloadDriverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding DownloadHint}" ToolTipService.ShowOnDisabled="True">
                                                <Button.Visibility>
                                                    <MultiBinding Converter="{StaticResource Drv.AllTrueToVis}">
                                                        <Binding Path="HasDownload" />
                                                        <Binding Path="IsDownloading" Converter="{StaticResource InverseBool}" />
                                                    </MultiBinding>
                                                </Button.Visibility>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding DownloadButtonText}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource Btn.Primary}" Margin="0,0,8,8"
                                                    Visibility="{Binding ShowToolPrimary, Converter={StaticResource BoolToVis}}"
                                                    IsEnabled="{Binding CanUseTool}"
                                                    Command="{Binding DataContext.UseGpuToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding ToolHint}" ToolTipService.ShowOnDisabled="True">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding ToolButtonText}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Margin="0,0,8,8"
                                                    Visibility="{Binding ShowToolSecondary, Converter={StaticResource BoolToVis}}"
                                                    IsEnabled="{Binding CanUseTool}"
                                                    Command="{Binding DataContext.UseGpuToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding ToolHint}" ToolTipService.ShowOnDisabled="True">
                                                <TextBlock Text="{Binding ToolButtonText}" VerticalAlignment="Center" />
                                            </Button>
                                            <Button Margin="0,0,8,8" Visibility="{Binding ShowSiteButton, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding SiteUrl}" ToolTip="{Binding SiteUrl}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="ОФИЦИАЛЬНЫЙ САЙТ" VerticalAlignment="Center" />
                                                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ═══════════ Chipset + clean install ═══════════ -->
            <Grid Margin="0,14,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="ПЛАТФОРМА" Style="{StaticResource Drv.SectionTitle}" />
                <Rectangle Grid.Column="1" Height="1" Fill="{StaticResource B.Line2}" VerticalAlignment="Center" Margin="14,0,0,0" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Chipset -->
                <Border Style="{StaticResource Card}" Padding="0">
                    <StackPanel>
                        <StackPanel Margin="22,22,22,0">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="ДРАЙВЕР ЧИПСЕТА" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                                <Border DockPanel.Dock="Right">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Tag.Muted}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ChipsetState}" Value="ok">
                                                    <Setter Property="Background" Value="{StaticResource B.White}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource B.White}" />
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource B.Ink}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ChipsetState}" Value="bad">
                                                    <Setter Property="Background" Value="{StaticResource B.Hatch}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource B.Text2}" />
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ChipsetVerdict}" />
                                </Border>
                            </DockPanel>
                            <TextBlock Text="{Binding ChipsetCpu, Converter={StaticResource Upper}}" Style="{StaticResource T.H1}" FontSize="22"
                                       Margin="0,12,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding ChipsetCpu}" />
                            <TextBlock Text="{Binding ChipsetRecommendation}" Style="{StaticResource T.Body}" Margin="0,8,0,0" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding ChipsetComponents}" Margin="0,16,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ChipsetComponentItem}">
                                    <Border BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Padding="22,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="170" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOk}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource T.BodyStrong}" FontSize="12.5" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource T.Caption}" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"
                                                           Visibility="{Binding Description, Converter={StaticResource NullToVis}}" />
                                            </StackPanel>
                                            <Border Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Tag.Muted}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource B.Hatch}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource B.Text2}" />
                                                                <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StateText}" />
                                            </Border>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding VersionText}" Style="{StaticResource T.Mono}" FontSize="11.5" Foreground="{StaticResource B.Text}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DetailText}" Style="{StaticResource T.Mono}" FontSize="10.5" Foreground="{StaticResource B.Text3}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailText}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource Callout}" Padding="0" Margin="22,16,22,0"
                                Visibility="{Binding ChipsetNote, Converter={StaticResource NullToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource B.HatchStrong}" />
                                <StackPanel Grid.Column="1" Margin="14,10,14,11">
                                    <TextBlock Text="AMD X3D" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Text}" />
                                    <TextBlock Text="{Binding ChipsetNote}" Style="{StaticResource T.Body}" FontSize="12.5" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding ChipsetPackage}" Style="{StaticResource T.Caption}" Margin="22,12,22,0"
                                   Visibility="{Binding ChipsetPackage, Converter={StaticResource NullToVis}}" />

                        <Border Style="{StaticResource Drv.CardFooter}">
                            <WrapPanel>
                                <Button Margin="0,0,8,0" Visibility="{Binding ChipsetIsAmd, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding OpenUrlCommand}" CommandParameter="{Binding AmdDriversUrl}" ToolTip="{Binding AmdDriversUrl}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ДРАЙВЕРЫ ЧИПСЕТА НА AMD.COM" VerticalAlignment="Center" />
                                        <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Btn.Primary}" Margin="0,0,8,0" Visibility="{Binding ChipsetIsIntel, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding UseIntelDsaCommand}" IsEnabled="{Binding IntelDsaEnabled}" ToolTipService.ShowOnDisabled="True"
                                        ToolTip="Intel Driver &amp; Support Assistant — официальный помощник Intel (winget, издатель Intel)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding IntelDsaButtonText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="0,0,8,0" Visibility="{Binding ChipsetIsIntel, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding OpenUrlCommand}" CommandParameter="{Binding IntelSupportUrl}" ToolTip="{Binding IntelSupportUrl}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ПОДДЕРЖКА INTEL" VerticalAlignment="Center" />
                                        <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Btn.Ghost}" Command="{Binding GoToTabCommand}" CommandParameter="Updates">
                                    <TextBlock Text="ПРОВЕРИТЬ WINDOWS UPDATE" VerticalAlignment="Center" />
                                </Button>
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Clean install (DDU) — information only -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="22,22,22,0">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="ЧИСТАЯ ПЕРЕУСТАНОВКА" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource Tag.Hatch}" DockPanel.Dock="Right">
                                    <TextBlock Text="ТОЛЬКО ВРУЧНУЮ" />
                                </Border>
                            </DockPanel>
                            <TextBlock Text="DISPLAY DRIVER UNINSTALLER" Style="{StaticResource T.H1}" FontSize="22" Margin="0,12,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource T.Body}" Margin="0,8,0,0"
                                       Text="Если видеодрайвер повреждён и обычная переустановка не помогает, его полностью удаляют утилитой DDU и ставят начисто. MONOLITH не запускает DDU — только подсказывает безопасный порядок." />

                            <ItemsControl Margin="0,14,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Number}" Style="{StaticResource T.Mono}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource B.Text}" Margin="0,2,0,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource T.Body}" FontSize="12.5"
                                                       Foreground="{StaticResource B.Text}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemsSource>
                                    <Binding Path="DduSteps" />
                                </ItemsControl.ItemsSource>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource T.Caption}" Margin="0,6,0,0"
                                       Text="Опция DDU «запретить Windows Update загружать драйверы» меняет параметры установки устройств — после установки драйвера верните её обратно." />
                        </StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource Drv.CardFooter}">
                            <Button HorizontalAlignment="Left" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding DduUrl}" ToolTip="{Binding DduUrl}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="САЙТ WAGNARDSOFT" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
