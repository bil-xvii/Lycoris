<UserControl x:Class="Monolith.Modules.Drivers.DriversProblemsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:Monolith.UI"
             xmlns:local="clr-namespace:Monolith.Modules.Drivers"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:DriversViewModel}"
             xmlns:loc="clr-namespace:Monolith.UI">
    <UserControl.Resources>
        <local:AllTrueToVisibilityConverter x:Key="Drv.AllTrueToVis" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════ Toolbar ═══════════ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                <TextBlock Text="{loc:T Проблемные устройства}" Style="{StaticResource T.H2}" />
                <TextBlock Style="{StaticResource T.Caption}" Margin="0,4,0,0"
                           Text="{loc:T 'Устройства, для которых Windows сообщает ошибку в диспетчере устройств, — с объяснением кода и тем, что с ним делать.'}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding FindInWindowsUpdateCommand}" ToolTip="{loc:T Windows Update подбирает драйверы и для проблемных устройств}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:T ИСКАТЬ В WINDOWS UPDATE}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenDeviceManagerCommand}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE772;" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:T ДИСПЕТЧЕР УСТРОЙСТВ}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Callout}" Margin="0,10,0,0" Visibility="{Binding ProblemsError, Converter={StaticResource NullToVis}}">
            <TextBlock Text="{Binding ProblemsError}" Style="{StaticResource T.Body}" />
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <!-- ═══════════ All good ═══════════ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Visibility>
                    <MultiBinding Converter="{StaticResource Drv.AllTrueToVis}">
                        <Binding Path="HasProblems" Converter="{StaticResource InverseBool}" />
                        <Binding Path="InventoryLoaded" />
                    </MultiBinding>
                </ScrollViewer.Visibility>
            <StackPanel Margin="0,0,9,12">
            <Border Style="{StaticResource Card}" Background="{StaticResource B.DotGrid}" Padding="25,25">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="72" Height="72" Background="{StaticResource B.Surface4}" CornerRadius="{StaticResource R.Lg}" VerticalAlignment="Top">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource T.Icon}" FontSize="24" Foreground="{StaticResource B.Text}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="17,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T Все устройства работают нормально}" Style="{StaticResource T.Display}" FontSize="24" LineHeight="34" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource T.Body}" Margin="0,10,0,0" MaxWidth="640" HorizontalAlignment="Left"
                                   Text="{loc:T Windows не сообщает об ошибках ни для одного подключённого устройства. Отключённые сейчас устройства (код 45) ошибкой не считаются.}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Border Style="{StaticResource Tag}">
                                <TextBlock Text="{Binding InventoryTime}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            </StackPanel>
            </ScrollViewer>

            <!-- ═══════════ List ═══════════ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Problems}" Margin="0,0,9,10" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ProblemDeviceItem}">
                            <!-- RoundClip: the code block fills the left edge -->
                            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,9" ui:RoundClip.Content="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Code block: inverted for severe problems -->
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource B.Surface3}" />
                                                <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text}" />
                                                <Style.Triggers>
                                                    <!-- Severe = hatched (white is reserved for clickable things) -->
                                                    <DataTrigger Binding="{Binding IsSevere}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource B.Hatch}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{loc:T КОД}" FontFamily="{StaticResource F.Display}" FontWeight="SemiBold" FontSize="12"
                                                       HorizontalAlignment="Center" Foreground="{StaticResource B.Text2}" />
                                            <TextBlock Text="{Binding Code, Converter={StaticResource Sentence}}" FontFamily="{StaticResource F.Display}" FontWeight="Bold" FontStretch="Condensed"
                                                       FontSize="30" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,11,10,11">
                                        <TextBlock Text="{Binding Name, Converter={StaticResource Sentence}}" Style="{StaticResource T.H3}" FontSize="16" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                        <TextBlock Style="{StaticResource T.Caption}" Margin="0,2,0,0">
                                            <Run Text="{Binding ClassText, Mode=OneWay}" />
                                            <Run Text="  ·  " />
                                            <Run Text="{Binding Vendor, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding ProblemTitle}" FontFamily="{StaticResource F.Display}" FontWeight="SemiBold"
                                                   FontStretch="SemiCondensed" FontSize="14" Foreground="{StaticResource B.Text}" Margin="0,9,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource T.Body}" Margin="0,4,0,0" />
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{loc:T ЧТО ДЕЛАТЬ}" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Text}" Margin="0,3,9,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Action}" Style="{StaticResource T.Body}" Foreground="{StaticResource B.Text}" />
                                        </Grid>
                                        <Border Background="{StaticResource B.Surface2}" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" Margin="0,9,0,0"
                                                CornerRadius="{StaticResource R.Md}" Padding="10,0,2,0" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="ID" Style="{StaticResource T.Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding HardwareId}" Style="{StaticResource T.Mono}" VerticalAlignment="Center"
                                                           Foreground="{StaticResource B.Text}" MaxWidth="520" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceId}" />
                                                <!-- Labelled (was an icon-only button) -->
                                                <Button Margin="10,0,0,0"
                                                        ToolTip="{loc:T Скопировать ID оборудования — по нему ищут драйвер на сайте производителя}"
                                                        Command="{Binding DataContext.CopyHardwareIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding HardwareId}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{x:Static ui:Glyphs.Copy}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                        <TextBlock Text="{loc:T КОПИРОВАТЬ ID}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="0,11,12,11" VerticalAlignment="Top">
                                        <Button MinWidth="176" Margin="0,0,0,8"
                                                Visibility="{Binding CanEnable, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.EnableDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{loc:T pnputil /enable-device — с записью в журнал отката}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{x:Static ui:Glyphs.Power}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="{loc:T ВКЛЮЧИТЬ УСТРОЙСТВО}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button MinWidth="176" Visibility="{Binding SuggestsWindowsUpdate, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.FindInWindowsUpdateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{x:Static ui:Glyphs.Search}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="{loc:T НАЙТИ ДРАЙВЕР}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
