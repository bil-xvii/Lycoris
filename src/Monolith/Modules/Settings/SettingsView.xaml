<UserControl x:Class="Monolith.Modules.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Monolith.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Monolith.UI.Controls"
             xmlns:ui="clr-namespace:Monolith.UI"
             xmlns:local="clr-namespace:Monolith.Modules.Settings"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:SettingsViewModel}">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource T.H1}">
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="SectionCaption" TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <!-- One settings row inside a section card -->
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource B.Line}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="14,11" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource T.H3}">
            <Setter Property="FontSize" Value="14.5" />
        </Style>
        <Style x:Key="RowText" TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <c:PageHeader Index="{Binding Index}" Title="{Binding Title}" Subtitle="{Binding Subtitle}" Checked="{Binding CheckedText}" />

        <ScrollViewer x:Name="MainScroll" Grid.Row="1" Margin="0,16,-10,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel Margin="0,0,10,0">

                <!-- ═══════════════ BEHAVIOUR ═══════════════ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:T Поведение}" Style="{StaticResource SectionTitle}" Margin="0,4,17,0" VerticalAlignment="Top" />
                    <Border Grid.Column="1" Style="{StaticResource Card.Flush}">
                        <StackPanel>
                            <!-- Language: a visible segmented choice (docs/localization.md). The labels РУССКИЙ / ENGLISH are the languages' own names and are never translated. -->
                            <Border x:Name="Row_language" Style="{StaticResource SettingRow}" BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,17,0">
                                        <TextBlock Text="{loc:T Язык / Language}" Style="{StaticResource RowTitle}" />
                                        <TextBlock Style="{StaticResource RowText}"
                                                   Text="{loc:T 'АВТО — язык Windows. Выбранный язык применяется после перезапуска MONOLITH.'}" />
                                        <TextBlock Style="{StaticResource T.BodyStrong}" Margin="0,6,0,0" Text="{Binding LanguageNote}"
                                                   Visibility="{Binding LanguageNote, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Border Style="{StaticResource SegmentBar}">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Style="{StaticResource Segment}" GroupName="UiLanguage" MinWidth="86"
                                                             IsChecked="{Binding LanguageChoice, Converter={StaticResource Equals}, ConverterParameter=auto}" Content="{loc:T АВТО}" />
                                                <RadioButton Style="{StaticResource Segment}" GroupName="UiLanguage" MinWidth="86"
                                                             IsChecked="{Binding LanguageChoice, Converter={StaticResource Equals}, ConverterParameter=ru}" Content="РУССКИЙ" /> <!-- loc:ignore -->
                                                <RadioButton Style="{StaticResource Segment}" GroupName="UiLanguage" MinWidth="86"
                                                             IsChecked="{Binding LanguageChoice, Converter={StaticResource Equals}, ConverterParameter=en}" Content="ENGLISH" />
                                            </StackPanel>
                                        </Border>
                                        <Button Margin="0,8,0,0" HorizontalAlignment="Right" Command="{Binding RestartForLanguageCommand}"
                                                Visibility="{Binding LanguagePending, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="{loc:T ПЕРЕЗАПУСТИТЬ СЕЙЧАС}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border x:Name="Row_elevate" Style="{StaticResource SettingRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,17,0">
                                        <TextBlock Text="{loc:T Запускать сразу с правами администратора}" Style="{StaticResource RowTitle}" />
                                        <TextBlock Style="{StaticResource RowText}"
                                                   Text="{loc:T 'Включено: запрос UAC при каждом запуске, и все кнопки работают сразу. Выключено: MONOLITH открывается без UAC в режиме просмотра, а права запросит при первом изменении и продолжит действие сам. Действует со следующего запуска.'}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" VerticalAlignment="Center" IsChecked="{Binding Settings.ElevateAtStartup}" />
                                </Grid>
                            </Border>
                            <Border x:Name="Row_confirm" Style="{StaticResource SettingRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,17,0">
                                        <TextBlock Text="{loc:T Подтверждение перед применением}" Style="{StaticResource RowTitle}" />
                                        <TextBlock Style="{StaticResource RowText}"
                                                   Text="{loc:T 'Перед применением показывается точный список изменений. Если выключить, твики применяются сразу; удаление, установка драйверов и другие необратимые действия всё равно спрашивают подтверждение.'}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" VerticalAlignment="Center" IsChecked="{Binding Settings.ConfirmBeforeApply}" />
                                </Grid>
                            </Border>
                            <Border x:Name="Row_updates" Style="{StaticResource SettingRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,17,0">
                                        <TextBlock Text="{loc:T Проверять обновления автоматически}" Style="{StaticResource RowTitle}" />
                                        <TextBlock Style="{StaticResource RowText}"
                                                   Text="{loc:T 'Раз в 12 часов MONOLITH сам смотрит на странице релизов, вышла ли новая версия, и показывает кнопку «ОБНОВЛЕНИЕ» в заголовке окна. Ничего не скачивается и не устанавливается без вашего подтверждения.'}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" VerticalAlignment="Center" IsChecked="{Binding Settings.AutoCheckUpdates}" />
                                </Grid>
                            </Border>
                            <Border x:Name="Row_monitor_interval" Style="{StaticResource SettingRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,17,0">
                                        <TextBlock Text="{loc:T Интервал обновления мониторинга}" Style="{StaticResource RowTitle}" />
                                        <TextBlock Style="{StaticResource RowText}"
                                                   Text="{loc:T 'Как часто «Панель» опрашивает загрузку процессора, видеокарты, памяти и дисков. Реже — меньше нагрузка от самого MONOLITH.'}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="200" VerticalAlignment="Center" ItemsSource="{Binding IntervalOptions}"
                                              SelectedItem="{Binding SelectedInterval}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Label}" FontFamily="{StaticResource F.Mono}" FontSize="12.5" Width="44" />
                                                    <TextBlock Text="{Binding Hint}" FontSize="12" Foreground="{StaticResource B.Text3}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <Rectangle Style="{StaticResource Divider}" Margin="0,19" />

                <!-- ═══════════════ DATA ═══════════════ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,17,0">
                        <TextBlock Text="{loc:T Данные}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource SectionCaption}" Text="{loc:T 'Всё хранится на этом компьютере, ничего не отправляется в сеть.'}" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource Card.Flush}" ui:RoundClip.Content="True">
                        <StackPanel x:Name="Row_data">
                            <ItemsControl ItemsSource="{Binding DataPaths}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:DataPathItem}">
                                        <Border BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,0,1" Padding="14,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,15,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title, Converter={StaticResource Sentence}}" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding State}" Style="{StaticResource T.Mono}" FontSize="11.5" Foreground="{StaticResource B.Text3}"
                                                                   VerticalAlignment="Center" Margin="9,1,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Path}" Style="{StaticResource T.Mono}" FontSize="12" Foreground="{StaticResource B.Text}"
                                                               Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource T.Caption}" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="1" VerticalAlignment="Center" MinWidth="120"
                                                        Command="{Binding DataContext.OpenPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBlock Text="{loc:T ОТКРЫТЬ}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Reset -->
                            <Grid x:Name="Row_reset">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Fill="{StaticResource B.Hatch}" />
                                <StackPanel Grid.Column="1" Margin="10,11,15,11">
                                    <TextBlock Text="{loc:T Сброс настроек}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Style="{StaticResource RowText}"
                                               Text="{loc:T 'Возвращает параметры MONOLITH к значениям по умолчанию. Изменения системы, журнал отката и папки с играми не затрагиваются.'}" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource Btn.Danger}" Content="{loc:T СБРОСИТЬ НАСТРОЙКИ}" Margin="0,0,14,0" VerticalAlignment="Center"
                                        Command="{Binding ResetSettingsCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Rectangle Style="{StaticResource Divider}" Margin="0,19" />

                <!-- ═══════════════ ABOUT ═══════════════ -->
                <Grid x:Name="Row_about" Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:T О программе}" Style="{StaticResource SectionTitle}" Margin="0,4,17,0" VerticalAlignment="Top" />

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding VersionLine}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text}" Margin="0,10,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding VersionLine}" />

                        <!-- Updates (Core/Updates): versions, notes, and every action as a labelled button -->
                        <Border x:Name="Row_update" Style="{StaticResource Card}" Margin="0,12,0,0" DataContext="{Binding Updates}">
                            <StackPanel>
                                <TextBlock Text="{Binding VersionLine}" Style="{StaticResource T.Label}" />
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource T.Body}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                <StackPanel Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                                    <TextBlock Text="{loc:T ЧТО НОВОГО}" Style="{StaticResource T.Label}" />
                                    <TextBlock Text="{Binding Notes}" Style="{StaticResource T.Caption}" Margin="0,5,0,0" TextWrapping="Wrap" LineHeight="17" />
                                </StackPanel>
                                <TextBlock Text="{Binding BlockedReason}" Style="{StaticResource T.BodyStrong}" Margin="0,10,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding BlockedReason, Converter={StaticResource NullToVis}}" />
                                <StackPanel Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding DownloadText}" Style="{StaticResource T.Mono}" />
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadPercent}" Margin="0,6,0,0" />
                                </StackPanel>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Style="{StaticResource Btn.Primary}" Command="{Binding UpdateNowCommand}" Margin="0,0,8,0" IsEnabled="{Binding CanStart}"
                                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{loc:T ОБНОВИТЬ СЕЙЧАС}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Btn}" Command="{Binding CheckNowCommand}" Margin="0,0,8,0" IsEnabled="{Binding CanStart}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{loc:T ПРОВЕРИТЬ ОБНОВЛЕНИЯ}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Btn.Ghost}" Command="{Binding RemindLaterCommand}" Margin="0,0,8,0"
                                            Visibility="{Binding ButtonVisible, Converter={StaticResource BoolToVis}}" Content="{loc:T НАПОМНИТЬ ПОЗЖЕ}" />
                                    <Button Style="{StaticResource Btn.Ghost}" Command="{Binding SkipVersionCommand}" Margin="0,0,8,0"
                                            Visibility="{Binding ButtonVisible, Converter={StaticResource BoolToVis}}" Content="{loc:T ПРОПУСТИТЬ ЭТУ ВЕРСИЮ}" />
                                    <Button Style="{StaticResource Btn}" Command="{Binding CancelDownloadCommand}"
                                            Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" Content="{loc:T ОТМЕНА}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Principles (collapsed) -->
                        <Expander Margin="0,14,0,0">
                            <Expander.Header>
                                <TextBlock Text="{loc:T КАК MONOLITH ЗАЩИЩАЕТ СИСТЕМУ}" Style="{StaticResource T.Label}" />
                            </Expander.Header>
                            <Border Style="{StaticResource Card.Flush}" Margin="0,4,0,0" ui:RoundClip.Content="True">
                                <ItemsControl ItemsSource="{Binding Principles}" Focusable="False" Margin="0,0,0,-1">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:PrincipleItem}">
                                            <Border BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,0,1" Padding="12,9">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title, Converter={StaticResource Sentence}}" Style="{StaticResource T.H3}" />
                                                    <TextBlock Text="{Binding Text}" Style="{StaticResource T.Caption}" Margin="0,4,0,0" LineHeight="17" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Expander>

                        <!-- Rejected tweaks (collapsed): what MONOLITH does not do and why; rows come from Tweaks/RejectedTweaks.cs -->
                        <Expander Margin="0,10,0,0" IsExpanded="{Binding ExpandRejected}">
                            <Expander.Header>
                                <TextBlock Text="{loc:T ЧТО MONOLITH НЕ ДЕЛАЕТ И ПОЧЕМУ}" Style="{StaticResource T.Label}" />
                            </Expander.Header>
                            <Border Style="{StaticResource Card.Flush}" Margin="0,4,0,0" ui:RoundClip.Content="True">
                                <ItemsControl x:Name="RejectedList" ItemsSource="{Binding Rejected}" Focusable="False" Margin="0,0,0,-1">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:RejectedRow}">
                                            <Border BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <!-- Selection marker like the Optimize rows: shown while the row is highlighted from the palette -->
                                                    <Border x:Name="Bar" HorizontalAlignment="Left" Width="3" Background="{StaticResource B.White}"
                                                            Margin="0,6" CornerRadius="{StaticResource R.Xs}" Visibility="Collapsed" />
                                                    <StackPanel Margin="12,9">
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource T.H3}" />
                                                        <TextBlock Style="{StaticResource T.Caption}" Margin="0,4,0,0" LineHeight="17">
                                                            <Run Text="{loc:T 'Что делают другие · '}" Foreground="{StaticResource B.Text3}" /><Run Text="{Binding WhatOthersDo, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text2}" Margin="0,3,0,0" LineHeight="17">
                                                            <Run Text="{loc:T 'Почему нет · '}" Foreground="{StaticResource B.Text3}" /><Run Text="{Binding WhyNot, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Style="{StaticResource T.Caption}" Margin="0,3,0,0" LineHeight="17">
                                                            <Run Text="{loc:T 'Вместо этого · '}" Foreground="{StaticResource B.Text3}" /><Run Text="{Binding Alternative, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Expander>

                        <!-- Licenses (collapsed) -->
                        <Expander x:Name="Row_licenses" Margin="0,10,0,0">
                            <Expander.Header>
                                <TextBlock Text="{loc:T КОМПОНЕНТЫ И ЛИЦЕНЗИИ}" Style="{StaticResource T.Label}" />
                            </Expander.Header>
                            <Border Style="{StaticResource Card.Flush}" Margin="0,4,0,0">
                                <StackPanel>
                                <ItemsControl ItemsSource="{Binding Licenses}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:LicenseItem}">
                                            <Border BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,0,1" Padding="12,9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="70" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.BodyStrong}" />
                                                        <TextBlock Style="{StaticResource T.Caption}" Margin="0,2,0,0">
                                                            <Run Text="{Binding Use, Mode=OneWay}" /><Run Text="  ·  " Foreground="{StaticResource B.Text3}" /><Run Text="{Binding Copyright, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Version}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text}"
                                                               VerticalAlignment="Center" />
                                                    <Border Grid.Column="2" Style="{StaticResource Tag}" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding License}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="12,9,12,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="{loc:T Шрифты}" Style="{StaticResource T.BodyStrong}" />
                                        <TextBlock Style="{StaticResource T.Caption}" Margin="0,2,0,0"
                                                   Text="{loc:T 'Bahnschrift, Segoe UI Variable, Cascadia Mono / Consolas, Segoe Fluent Icons — системные шрифты Windows. В составе MONOLITH не распространяются.'}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource Tag.Muted}" VerticalAlignment="Center">
                                        <TextBlock Text="WINDOWS" />
                                    </Border>
                                </Grid>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
