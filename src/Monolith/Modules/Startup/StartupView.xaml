<UserControl x:Class="Monolith.Modules.Startup.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Monolith.UI.Controls"
             xmlns:ui="clr-namespace:Monolith.UI"
             xmlns:local="clr-namespace:Monolith.Modules.Startup"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:StartupViewModel}">

    <UserControl.Resources>
        <!-- Table column header -->
        <Style x:Key="ColLabel" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Big state word next to a toggle -->
        <Style x:Key="StateWord" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontStretch" Value="SemiCondensed" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Scope tag: ДЛЯ ВСЕХ = outline, ДЛЯ МЕНЯ = muted -->
        <Style x:Key="ScopeTag" TargetType="Border" BasedOn="{StaticResource Tag}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMachine}" Value="False">
                    <Setter Property="BorderBrush" Value="{StaticResource B.Line2}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text3}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PublisherText" TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasPublisher}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource B.Text4}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CommandText" TargetType="TextBlock" BasedOn="{StaticResource T.Mono}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource T.H1}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StepNumber" TargetType="TextBlock" BasedOn="{StaticResource T.Mono}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
        </Style>

        <Style x:Key="CountMono" TargetType="TextBlock" BasedOn="{StaticResource T.Mono}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="7,1,0,0" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <c:PageHeader Index="{Binding Index}" Title="{Binding Title}" Subtitle="{Binding Subtitle}">
            <c:PageHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding RevertAllCommand}" IsEnabled="{Binding IsElevated}" Margin="0,0,8,0"
                            Visibility="{Binding HasJournal, Converter={StaticResource BoolToVis}}"
                            ToolTip="Вернуть всё, что MONOLITH менял в автозапуске, к исходному состоянию" ToolTipService.ShowOnDisabled="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static ui:Glyphs.Undo}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                                <Run Text="ОТКАТИТЬ ИЗМЕНЕНИЯ" /><Run Text="  " /><Run Text="{Binding JournalCount, Mode=OneWay}" FontFamily="{StaticResource F.Mono}" />
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshCommand}" ToolTip="Заново прочитать реестр, папки автозагрузки и планировщик">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static ui:Glyphs.Refresh}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="ОБНОВИТЬ" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </c:PageHeader.Actions>
        </c:PageHeader>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" Margin="0,26,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="0,0,14,12">

                <!-- ═══════════ Read-only notice ═══════════ -->
                <Border Style="{StaticResource Callout}" Padding="0" Margin="0,0,0,20"
                        Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource B.HatchStrong}" />
                        <TextBlock Grid.Column="1" Text="{x:Static ui:Glyphs.Lock}" Style="{StaticResource T.Icon}" FontSize="18" Margin="20,0,18,0" />
                        <StackPanel Grid.Column="2" Margin="0,13,22,14">
                            <TextBlock Text="РЕЖИМ ПРОСМОТРА — ДЛЯ ИЗМЕНЕНИЙ НУЖНЫ ПРАВА АДМИНИСТРАТОРА" Style="{StaticResource T.H3}" />
                            <TextBlock Style="{StaticResource T.Body}" Margin="0,3,0,0"
                                       Text="Данные реальные, но переключатели заблокированы: изменения пишутся в журнал отката и требуют прав администратора." />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══════════ Summary ═══════════ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="400" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card.Flush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="20,18,16,16">
                                <TextBlock Text="ВСЕГО" Style="{StaticResource T.Label}" />
                                <TextBlock Text="{Binding TotalCount}" Style="{StaticResource T.Stat}" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding TotalCaption}" Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                            </StackPanel>

                            <Border Grid.Column="1" BorderBrush="{StaticResource B.Line}" BorderThickness="1,0,0,0">
                                <StackPanel Margin="20,18,16,16">
                                    <TextBlock Text="ВКЛЮЧЕНО" Style="{StaticResource T.Label}" />
                                    <TextBlock Text="{Binding EnabledCount}" Style="{StaticResource T.Stat}" Margin="0,6,0,0" />
                                    <TextBlock Text="запускаются при входе" Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" BorderBrush="{StaticResource B.Line}" BorderThickness="1,0,0,0">
                                <StackPanel Margin="20,18,16,16">
                                    <TextBlock Text="ОТКЛЮЧЕНО" Style="{StaticResource T.Label}" />
                                    <TextBlock Text="{Binding DisabledCount}" Style="{StaticResource T.Stat}" Margin="0,6,0,0" />
                                    <TextBlock Text="записи не удалены" Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" BorderBrush="{StaticResource B.Line}" BorderThickness="1,0,0,0">
                                <StackPanel Margin="20,18,16,16">
                                    <TextBlock Text="ЗАДАЧИ ПРИ ВХОДЕ" Style="{StaticResource T.Label}" />
                                    <TextBlock Text="{Binding TaskCount}" Style="{StaticResource T.Stat}" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding TaskCaption}" Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.ColumnSpan="4" BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Padding="20,13,20,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ДОЛЯ ВКЛЮЧЁННЫХ" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                                    <c:Meter Grid.Column="1" Value="{Binding EnabledShare}" Segments="48" Height="8" Margin="18,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding EnabledShare, Converter={StaticResource Percent}}" Style="{StaticResource T.Mono}"
                                               Foreground="{StaticResource B.Text}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card.Inverted}" Padding="22,18,22,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static ui:Glyphs.Rocket}" FontFamily="{StaticResource F.Icons}" FontSize="13" Foreground="{StaticResource B.Ink}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="ГЛАВНОЕ ДЛЯ СКОРОСТИ ЗАГРУЗКИ" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Ink}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="МЕНЬШЕ АВТОЗАПУСКА — БЫСТРЕЕ ВХОД" Style="{StaticResource T.H1}" FontSize="23" Foreground="{StaticResource B.Ink}"
                                       TextWrapping="Wrap" LineHeight="25" LineStackingStrategy="BlockLineHeight" Margin="0,10,0,0" />
                            <TextBlock Style="{StaticResource T.Body}" Foreground="{StaticResource B.Ink}" Opacity="0.74" Margin="0,7,0,0"
                                       Text="Самый действенный способ ускорить загрузку Windows и освободить память — отключить лишнее в автозапуске. Ничего не удаляется." />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══════════ Section 1: autostart apps ═══════════ -->
                <Grid Margin="0,40,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ПРИЛОЖЕНИЯ В АВТОЗАПУСКЕ" Style="{StaticResource SectionTitle}" />
                    <Rectangle Grid.Column="1" Height="1" Fill="{StaticResource B.Line2}" VerticalAlignment="Center" Margin="18,3,18,0" />
                    <TextBlock Grid.Column="2" Text="{Binding ItemsCountText}" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{StaticResource B.Text3}"
                               VerticalAlignment="Center" Margin="0,3,0,0" />
                </Grid>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource T.Body}" MaxWidth="760" HorizontalAlignment="Left"
                               Text="То же, что вкладка «Автозагрузка» Диспетчера задач: ключи реестра Run и Run32 и папки автозагрузки. Отключение не удаляет запись — Windows просто не запускает её при входе." />
                    <TextBlock Grid.Column="1" Text="{Binding ScanText}" Style="{StaticResource T.Caption}" VerticalAlignment="Bottom" Margin="24,0,0,1" />
                </Grid>

                <!-- Filter + search -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.ColumnSpan="2" Height="1" Fill="{StaticResource B.Line2}" VerticalAlignment="Bottom" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="StartupFilter" Padding="2,0"
                                     IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=all}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ВСЕ" />
                                <TextBlock Text="{Binding TotalCount}" Style="{StaticResource CountMono}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Segment}" GroupName="StartupFilter" Padding="2,0" Margin="28,0,0,0"
                                     IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=enabled}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ВКЛЮЧЕНО" />
                                <TextBlock Text="{Binding EnabledCount}" Style="{StaticResource CountMono}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Segment}" GroupName="StartupFilter" Padding="2,0" Margin="28,0,0,0"
                                     IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=disabled}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ОТКЛЮЧЕНО" />
                                <TextBlock Text="{Binding DisabledCount}" Style="{StaticResource CountMono}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Segment}" GroupName="StartupFilter" Padding="2,0" Margin="28,0,0,0"
                                     IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=missing}"
                                     ToolTip="Записи, чей файл больше не существует (программа удалена или перенесена)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="НЕТ ФАЙЛА" />
                                <TextBlock Text="{Binding MissingCount}" Style="{StaticResource CountMono}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                    <TextBox Grid.Column="1" Width="300" Margin="0,0,0,8" VerticalAlignment="Bottom" Tag="Поиск: имя, команда, издатель"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- Bulk bar -->
                <Border Background="{StaticResource B.Surface3}" BorderBrush="{StaticResource B.Line3}" BorderThickness="1" Padding="16,9" Margin="0,0,0,12"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ВЫБРАНО" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedCount}" Style="{StaticResource T.Mono}" FontSize="14" Foreground="{StaticResource B.Text}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding RestorePointNote}" ToolTip="{Binding RestorePointNote}" Style="{StaticResource T.Caption}"
                                       Margin="20,0,16,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource Btn.Primary}" Command="{Binding DisableSelectedCommand}" Content="ОТКЛЮЧИТЬ ВЫБРАННЫЕ" />
                            <Button Command="{Binding EnableSelectedCommand}" Content="ВКЛЮЧИТЬ ВЫБРАННЫЕ" Margin="8,0,0,0" />
                            <Button Style="{StaticResource Btn.Ghost}" Command="{Binding ClearSelectionCommand}" Content="СНЯТЬ ВЫБОР" Margin="4,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Table -->
                <Border Style="{StaticResource Card.Flush}">
                    <StackPanel>
                        <Border Background="{StaticResource B.Surface2}" BorderBrush="{StaticResource B.Line2}" BorderThickness="0,0,0,1" Padding="16,0" Height="40">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding AllSelected}" Margin="0,0,16,0" VerticalAlignment="Center" ToolTip="Выбрать все видимые записи"
                                          Visibility="{Binding IsElevated, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Grid.Column="1" Text="ПРИЛОЖЕНИЕ И КОМАНДА" Style="{StaticResource ColLabel}" />
                                <TextBlock Grid.Column="2" Text="ИЗДАТЕЛЬ И ФАЙЛ" Style="{StaticResource ColLabel}" />
                                <TextBlock Grid.Column="3" Text="ОБЛАСТЬ" Style="{StaticResource ColLabel}" />
                                <TextBlock Grid.Column="4" Text="СОСТОЯНИЕ" Style="{StaticResource ColLabel}" />
                                <TextBlock Grid.Column="5" Text="ДЕЙСТВИЯ" Style="{StaticResource ColLabel}" HorizontalAlignment="Right" Margin="0,0,10,0" />
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding ItemsView}" Focusable="False" Margin="0,0,0,-1">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:StartupItem}">
                                    <Border Style="{StaticResource Row}" Padding="16,13">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="210" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,16,0" VerticalAlignment="Center" ToolTip="Выбрать для массового действия"
                                                      Visibility="{Binding DataContext.IsElevated, RelativeSource={RelativeSource AncestorType=local:StartupView}, Converter={StaticResource BoolToVis}}" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource T.BodyStrong}" FontSize="13.5" TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="250" VerticalAlignment="Center" ToolTip="{Binding NameTooltip}" />
                                                    <Border Style="{StaticResource Tag.Solid}" Margin="10,0,0,0" ToolTip="Значок защиты Windows или антивируса — MONOLITH его не отключает"
                                                            Visibility="{Binding Risk, Converter={StaticResource EqualsToVis}, ConverterParameter=Security}">
                                                        <TextBlock Text="ЗАЩИТА" />
                                                    </Border>
                                                    <Border Style="{StaticResource Tag}" Margin="10,0,0,0" ToolTip="Помощник драйвера: звук, тачпад, видеокарта. Без него могут пропасть панель управления и горячие клавиши"
                                                            Visibility="{Binding Risk, Converter={StaticResource EqualsToVis}, ConverterParameter=Driver}">
                                                        <TextBlock Text="ДРАЙВЕР" />
                                                    </Border>
                                                    <Border Style="{StaticResource Tag.Muted}" Margin="10,0,0,0" ToolTip="Компонент Microsoft"
                                                            Visibility="{Binding Risk, Converter={StaticResource EqualsToVis}, ConverterParameter=Microsoft}">
                                                        <TextBlock Text="MICROSOFT" />
                                                    </Border>
                                                    <Border Style="{StaticResource Tag.Hatch}" Margin="8,0,0,0" ToolTip="Файл программы не найден: программа удалена или перенесена. Запись можно отключить"
                                                            Visibility="{Binding TargetExists, Converter={StaticResource InverseBoolToVis}}">
                                                        <TextBlock Text="НЕТ ФАЙЛА" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Command}" Style="{StaticResource CommandText}" Margin="0,5,0,0" ToolTip="{Binding Command}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding PublisherText}" Style="{StaticResource PublisherText}" ToolTip="{Binding PublisherText}" />
                                                <TextBlock Text="{Binding FileText}" Style="{StaticResource CommandText}" Margin="0,4,0,0" ToolTip="{Binding TargetPath}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Border Style="{StaticResource ScopeTag}" ToolTip="{Binding LocationTooltip}">
                                                    <TextBlock Text="{Binding ScopeText}" />
                                                </Border>
                                                <TextBlock Text="{Binding SourceText}" Style="{StaticResource T.Caption}" Margin="0,5,0,0" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Grid Grid.Column="4" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Style="{StaticResource Toggle}" VerticalAlignment="Center" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                          IsEnabled="{Binding CanToggle}" ToolTip="{Binding ToggleTooltip}" ToolTipService.ShowOnDisabled="True"
                                                          Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=local:StartupView}}"
                                                          CommandParameter="{Binding}" />
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource StateWord}" />
                                                    <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource T.Caption}" FontSize="11" Margin="0,1,0,0"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Style="{StaticResource Btn.Icon}" Content="{x:Static ui:Glyphs.Folder}" ToolTip="Открыть расположение файла"
                                                        Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=local:StartupView}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource Btn.Icon}" Content="{x:Static ui:Glyphs.Copy}" ToolTip="Копировать команду"
                                                        Command="{Binding DataContext.CopyCommandCommand, RelativeSource={RelativeSource AncestorType=local:StartupView}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource Btn.Icon}" Content="{x:Static ui:Glyphs.Globe}" ToolTip="Найти в интернете, что это за программа"
                                                        Command="{Binding DataContext.SearchOnlineCommand, RelativeSource={RelativeSource AncestorType=local:StartupView}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty: filter / search -->
                        <Border Background="{StaticResource B.DotGrid}" Padding="24,26" Visibility="{Binding ShowNoMatches, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="НИЧЕГО НЕ НАЙДЕНО" Style="{StaticResource T.H3}" />
                                <TextBlock Text="Под фильтр или поиск не подходит ни одна запись. Выберите «Все» или очистите строку поиска." Style="{StaticResource T.Body}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Empty: nothing in autostart -->
                        <Border Background="{StaticResource B.DotGrid}" Padding="24,26" Visibility="{Binding ShowNoItems, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="АВТОЗАПУСК ПУСТ" Style="{StaticResource T.H3}" />
                                <TextBlock Text="В ключах Run / Run32 и папках автозагрузки нет ни одной записи — Windows не запускает при входе ничего лишнего."
                                           Style="{StaticResource T.Body}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══════════ Section 2: logon tasks ═══════════ -->
                <Grid Margin="0,44,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ЗАДАЧИ ПРИ ВХОДЕ В СИСТЕМУ" Style="{StaticResource SectionTitle}" />
                    <Rectangle Grid.Column="1" Height="1" Fill="{StaticResource B.Line2}" VerticalAlignment="Center" Margin="18,3,18,0" />
                    <TextBlock Grid.Column="2" Text="{Binding TasksCountText}" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{StaticResource B.Text3}"
                               VerticalAlignment="Center" Margin="0,3,0,0" />
                </Grid>
                <TextBlock Style="{StaticResource T.Body}" MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,0,18"
                           Text="Сторонние задачи планировщика с триггером «при входе» или «при загрузке» — Диспетчер задач их не показывает. Задачи Microsoft скрыты: они нужны самой Windows. Отключённая задача не удаляется." />

                <Border Style="{StaticResource Card.Flush}">
                    <StackPanel>
                        <Border Background="{StaticResource B.Surface2}" BorderBrush="{StaticResource B.Line2}" BorderThickness="0,0,0,1" Padding="16,0" Height="40"
                                Visibility="{Binding HasTasks, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ЗАДАЧА И ДЕЙСТВИЕ" Style="{StaticResource ColLabel}" />
                                <TextBlock Grid.Column="1" Text="АВТОР И ПАПКА" Style="{StaticResource ColLabel}" />
                                <TextBlock Grid.Column="2" Text="ТРИГГЕР" Style="{StaticResource ColLabel}" />
                                <TextBlock Grid.Column="3" Text="СОСТОЯНИЕ" Style="{StaticResource ColLabel}" />
                                <TextBlock Grid.Column="4" Text="ДЕЙСТВИЯ" Style="{StaticResource ColLabel}" HorizontalAlignment="Right" Margin="0,0,10,0" />
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Tasks}" Focusable="False" Margin="0,0,0,-1">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:LogonTaskItem}">
                                    <Border Style="{StaticResource Row}" Padding="16,13">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="210" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource T.BodyStrong}" FontSize="13.5" TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="280" VerticalAlignment="Center" ToolTip="{Binding NameTooltip}" />
                                                    <Border Style="{StaticResource Tag.Solid}" Margin="10,0,0,0" ToolTip="Задача обновляет программу и закрывает уязвимости — MONOLITH её не отключает"
                                                            Visibility="{Binding Risk, Converter={StaticResource EqualsToVis}, ConverterParameter=Updater}">
                                                        <TextBlock Text="ОБНОВЛЕНИЯ" />
                                                    </Border>
                                                    <Border Style="{StaticResource Tag.Solid}" Margin="10,0,0,0" ToolTip="Задача защитного ПО — MONOLITH её не отключает"
                                                            Visibility="{Binding Risk, Converter={StaticResource EqualsToVis}, ConverterParameter=Security}">
                                                        <TextBlock Text="ЗАЩИТА" />
                                                    </Border>
                                                    <Border Style="{StaticResource Tag}" Margin="10,0,0,0" ToolTip="Задача производителя оборудования"
                                                            Visibility="{Binding Risk, Converter={StaticResource EqualsToVis}, ConverterParameter=Driver}">
                                                        <TextBlock Text="ДРАЙВЕР" />
                                                    </Border>
                                                    <Border Style="{StaticResource Tag.Hatch}" Margin="8,0,0,0" ToolTip="Файл, который запускает задача, не найден"
                                                            Visibility="{Binding TargetExists, Converter={StaticResource InverseBoolToVis}}">
                                                        <TextBlock Text="НЕТ ФАЙЛА" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Command}" Style="{StaticResource CommandText}" Margin="0,5,0,0" ToolTip="{Binding Command}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding AuthorText}" Style="{StaticResource T.Body}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding AuthorText}" />
                                                <TextBlock Text="{Binding FolderText}" Style="{StaticResource CommandText}" Margin="0,4,0,0" ToolTip="{Binding Path}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Border Style="{StaticResource Tag}">
                                                    <TextBlock Text="{Binding TriggerText}" />
                                                </Border>
                                                <TextBlock Text="{Binding TriggerDetail}" Style="{StaticResource T.Caption}" Margin="0,5,0,0" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding TriggerDetail}" />
                                            </StackPanel>

                                            <Grid Grid.Column="3" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Style="{StaticResource Toggle}" VerticalAlignment="Center" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                          IsEnabled="{Binding CanToggle}" ToolTip="{Binding ToggleTooltip}" ToolTipService.ShowOnDisabled="True"
                                                          Command="{Binding DataContext.ToggleTaskCommand, RelativeSource={RelativeSource AncestorType=local:StartupView}}"
                                                          CommandParameter="{Binding}" />
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource StateWord}" />
                                                    <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource T.Caption}" FontSize="11" Margin="0,1,0,0"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Style="{StaticResource Btn.Icon}" Content="{x:Static ui:Glyphs.Folder}" ToolTip="Открыть расположение файла"
                                                        Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=local:StartupView}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource Btn.Icon}" Content="{x:Static ui:Glyphs.Copy}" ToolTip="Копировать команду"
                                                        Command="{Binding DataContext.CopyCommandCommand, RelativeSource={RelativeSource AncestorType=local:StartupView}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource Btn.Icon}" Content="{x:Static ui:Glyphs.Globe}" ToolTip="Найти в интернете, что это за программа"
                                                        Command="{Binding DataContext.SearchOnlineCommand, RelativeSource={RelativeSource AncestorType=local:StartupView}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Scheduler unreadable -->
                        <Border Style="{StaticResource Callout}" BorderThickness="0" Margin="0"
                                Visibility="{Binding TasksError, Converter={StaticResource NullToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static ui:Glyphs.Warning}" Style="{StaticResource T.Icon}" FontSize="14" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding TasksError}" Style="{StaticResource T.Body}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Empty -->
                        <Border Background="{StaticResource B.DotGrid}" Padding="24,26" Visibility="{Binding ShowNoTasks, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" BorderBrush="{StaticResource B.Line3}" BorderThickness="1" Background="{StaticResource B.Surface}"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{x:Static ui:Glyphs.Check}" Style="{StaticResource T.Icon}" FontSize="17" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="СТОРОННИХ ЗАДАЧ ПРИ ВХОДЕ НЕ НАЙДЕНО" Style="{StaticResource T.H3}" />
                                    <TextBlock Style="{StaticResource T.Body}" Margin="0,4,0,0"
                                               Text="В планировщике нет задач других производителей, которые запускаются при входе в систему или при загрузке Windows." />
                                    <TextBlock Style="{StaticResource T.Caption}" Margin="0,6,0,0" Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}"
                                               Text="Без прав администратора часть задач скрыта (например, в корневой папке планировщика). Перезапустите MONOLITH от имени администратора, чтобы увидеть полный список." />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══════════ How it works ═══════════ -->
                <Grid Margin="0,44,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="КАК ЭТО РАБОТАЕТ" Style="{StaticResource SectionTitle}" />
                    <Rectangle Grid.Column="1" Height="1" Fill="{StaticResource B.Line2}" VerticalAlignment="Center" Margin="18,3,0,0" />
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="01" Style="{StaticResource StepNumber}" />
                            <TextBlock Text="КАК В ДИСПЕТЧЕРЕ ЗАДАЧ" Style="{StaticResource T.H2}" Margin="0,8,0,0" />
                            <TextBlock Style="{StaticResource T.Body}" Margin="0,6,0,0"
                                       Text="MONOLITH ставит отметку «отключено» в разделе реестра StartupApproved. Запись в Run и ярлык в папке автозагрузки остаются на месте." />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="02" Style="{StaticResource StepNumber}" />
                            <TextBlock Text="КОГДА ПОДЕЙСТВУЕТ" Style="{StaticResource T.H2}" Margin="0,8,0,0" />
                            <TextBlock Style="{StaticResource T.Body}" Margin="0,6,0,0"
                                       Text="При следующем входе в Windows. Уже запущенные программы работают до перезагрузки. Задачи планировщика отключаются сразу." />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="03" Style="{StaticResource StepNumber}" />
                            <TextBlock Text="КАК ВЕРНУТЬ" Style="{StaticResource T.H2}" Margin="0,8,0,0" />
                            <TextBlock Style="{StaticResource T.Body}" Margin="0,6,0,0"
                                       Text="Переключатель на этой странице, вкладка «Автозагрузка» Диспетчера задач или откат в разделе «Восстановление» — каждое изменение в журнале." />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="6" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="04" Style="{StaticResource StepNumber}" />
                            <TextBlock Text="ЧТО ЗАЩИЩЕНО" Style="{StaticResource T.H2}" Margin="0,8,0,0" />
                            <TextBlock Style="{StaticResource T.Body}" Margin="0,6,0,0"
                                       Text="Значок «Безопасность Windows», антивирусы и задачи обновления программ MONOLITH не отключает: от них зависит защита системы." />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
