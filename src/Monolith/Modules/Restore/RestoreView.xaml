<UserControl x:Class="Monolith.Modules.Restore.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Monolith.UI.Controls"
             xmlns:local="clr-namespace:Monolith.Modules.Restore"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:RestoreViewModel}">
    <UserControl.Resources>

        <!-- One journal record -->
        <DataTemplate x:Key="RecordTemplate" DataType="{x:Type local:RecordItem}">
            <Border Style="{StaticResource Row}" BorderThickness="0,1,0,0" Padding="20,14,20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- State marker: ■ active, □ reverted, hatched = revert failed -->
                    <Rectangle Width="10" Height="10" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,5,0,0">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Fill" Value="{StaticResource B.White}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReverted}" Value="True">
                                        <Setter Property="Fill" Value="Transparent" />
                                        <Setter Property="Stroke" Value="{StaticResource B.Text3}" />
                                        <Setter Property="StrokeThickness" Value="1.5" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource B.HatchStrong}" />
                                        <Setter Property="Stroke" Value="{StaticResource B.Text}" />
                                        <Setter Property="StrokeThickness" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>

                    <StackPanel Grid.Column="1" Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource T.BodyStrong}" VerticalAlignment="Center" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Style="{StaticResource Tag.Muted}" Margin="10,0,0,0" Padding="5,1,5,2">
                                <TextBlock Text="{Binding KindLabel}" FontSize="9.5" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Target}" ToolTip="{Binding RawTarget}" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{StaticResource B.Text3}"
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource T.Mono}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap">
                            <Run Text="{Binding OldValue, Mode=OneWay}" Foreground="{StaticResource B.Text2}" />
                            <Run Text="  →  " Foreground="{StaticResource B.Text4}" />
                            <Run Text="{Binding NewValue, Mode=OneWay}" Foreground="{StaticResource B.Text}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource T.Caption}" Margin="0,6,0,0">
                            <Run Text="{Binding Source, Mode=OneWay}" FontFamily="{StaticResource F.Mono}" FontSize="10.5" />
                            <Run Text="  ·  " Foreground="{StaticResource B.Text4}" />
                            <Run Text="{Binding TimeText, Mode=OneWay}" FontFamily="{StaticResource F.Mono}" FontSize="10.5" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text}" Margin="0,6,0,0"
                                   Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}">
                            <Run Text="Ошибка отката:" FontWeight="SemiBold" />
                            <Run Text="{Binding RevertError, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                        <Border HorizontalAlignment="Right">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Tag}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReverted}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource B.Line2}" />
                                            <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text3}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource B.Hatch}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource B.Text2}" />
                                            <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusText}" />
                        </Border>
                        <Button Content="ОТКАТИТЬ" Height="30" MinWidth="110" Margin="0,10,0,0" HorizontalAlignment="Right" FontSize="11.5"
                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.RevertRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Restore point row -->
        <DataTemplate x:Key="PointTemplate" DataType="{x:Type local:RestorePointItem}">
            <Border BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Padding="0,11">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding DateText}" Style="{StaticResource T.Mono}" FontSize="11.5" Foreground="{StaticResource B.Text}" />
                        <TextBlock Text="{Binding SequenceText}" Style="{StaticResource T.Mono}" FontSize="10.5" Foreground="{StaticResource B.Text4}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource T.Body}" Foreground="{StaticResource B.Text2}" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Description}" />
                    <WrapPanel Margin="0,6,0,0">
                        <Border Style="{StaticResource Tag.Solid}" Margin="0,0,6,0" Padding="5,1,5,2"
                                Visibility="{Binding IsMonolith, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="MONOLITH" FontSize="9.5" />
                        </Border>
                        <Border Style="{StaticResource Tag.Muted}" Padding="5,1,5,2">
                            <TextBlock Text="{Binding TypeLabel}" FontSize="9.5" />
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="LinkAction" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="34" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <c:PageHeader Index="{Binding Index}" Title="{Binding Title}" Subtitle="{Binding Subtitle}">
            <c:PageHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding CreateRestorePointCommand}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA18;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="СОЗДАТЬ ТОЧКУ ВОССТАНОВЛЕНИЯ" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Danger}" Command="{Binding RevertAllCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="ОТКАТИТЬ ВСЁ" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </c:PageHeader.Actions>
        </c:PageHeader>

        <ScrollViewer x:Name="MainScroll" Grid.Row="1" Margin="0,26,-14,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel Margin="0,0,14,0">
                <!-- Read-only notice -->
                <Border Style="{StaticResource Callout}" Padding="0" Margin="0,0,0,20"
                        Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Fill="{StaticResource B.HatchStrong}" />
                        <StackPanel Grid.Column="1" Margin="18,12,18,12" Orientation="Horizontal">
                            <TextBlock Text="&#xEA18;" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="РЕЖИМ ПРОСМОТРА" Style="{StaticResource T.H3}" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <TextBlock Style="{StaticResource T.Body}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Text="Журнал доступен для чтения. Откат, точки восстановления и защита системы — с правами администратора." />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══════════════ Summary ═══════════════ -->
                <Border Style="{StaticResource Card.Flush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>

                        <!-- Active: inverted cell when something can be reverted -->
                        <Border Padding="24,18,24,20">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="АКТИВНЫХ ИЗМЕНЕНИЙ" Style="{StaticResource T.Label}" />
                                <TextBlock Text="{Binding ActiveCount}" Style="{StaticResource T.Stat}" FontSize="48" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding ActiveCaption}" Style="{StaticResource T.Caption}" />
                            </StackPanel>
                        </Border>
                        <Rectangle Grid.Column="1" Style="{StaticResource DividerV}" />
                        <StackPanel Grid.Column="2" Margin="24,18,24,20">
                            <TextBlock Text="ОТКАЧЕНО" Style="{StaticResource T.Label}" />
                            <TextBlock Text="{Binding RevertedCount}" Style="{StaticResource T.Stat}" FontSize="48" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding RevertedCaption}" Style="{StaticResource T.Caption}" />
                        </StackPanel>
                        <Rectangle Grid.Column="3" Style="{StaticResource DividerV}" />
                        <StackPanel Grid.Column="4" Margin="24,18,24,20">
                            <TextBlock Text="ПАКЕТОВ" Style="{StaticResource T.Label}" />
                            <TextBlock Text="{Binding BatchCount}" Style="{StaticResource T.Stat}" FontSize="48" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding BatchCaption}" Style="{StaticResource T.Caption}" />
                        </StackPanel>
                        <Rectangle Grid.Column="5" Style="{StaticResource DividerV}" />
                        <StackPanel Grid.Column="6" Margin="14,16,14,14" VerticalAlignment="Center">
                            <Button Style="{StaticResource LinkAction}" Command="{Binding OpenSystemRestoreCommand}" ToolTip="rstrui.exe — мастер «Восстановление системы»">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE81C;" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="ОТКРЫТЬ ВОССТАНОВЛЕНИЕ СИСТЕМЫ" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource LinkAction}" Command="{Binding OpenBackupsCommand}" Margin="0,4,0,0" ToolTip="{Binding BackupsPath}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="ПАПКА РЕЗЕРВНЫХ КОПИЙ" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <TextBlock Text="{Binding BackupsPath}" Style="{StaticResource T.Mono}" FontSize="10.5" Foreground="{StaticResource B.Text4}"
                                       Margin="36,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══════════════ Journal + System Restore ═══════════════ -->
                <Grid Margin="0,28,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <!-- Journal -->
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ЖУРНАЛ ИЗМЕНЕНИЙ" Style="{StaticResource T.H1}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Style="{StaticResource T.Mono}" FontSize="11.5" Foreground="{StaticResource B.Text3}" VerticalAlignment="Center"
                                       Margin="12,4,0,0" Text="{Binding TotalCount, StringFormat=ЗАПИСЕЙ: {0}}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <RadioButton Style="{StaticResource Segment}" Content="ВСЕ" GroupName="JournalFilter"
                                             IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=All}" />
                                <RadioButton Style="{StaticResource Segment}" Content="АКТИВНЫЕ" GroupName="JournalFilter"
                                             IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Active}" />
                                <RadioButton Style="{StaticResource Segment}" Content="ОТКАЧЕННЫЕ" GroupName="JournalFilter"
                                             IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Reverted}" />
                            </StackPanel>
                        </Grid>
                        <Rectangle Height="1" Fill="{StaticResource B.Line2}" Margin="0,0,0,16" />

                        <!-- Empty journal -->
                        <Border Style="{StaticResource Card.Flush}" Visibility="{Binding IsJournalEmpty, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Background="{StaticResource B.DotGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Monolith slab -->
                                    <Path Data="M0,0 L22,0 L32,10 L32,72 L0,72 Z" Fill="{StaticResource B.White}" Width="32" Height="72" Margin="32,32,0,32"
                                          VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Margin="28,30,32,30">
                                        <TextBlock Text="ЖУРНАЛ ПУСТ" Style="{StaticResource T.Display}" FontSize="34" LineHeight="36" />
                                        <TextBlock Style="{StaticResource T.Body}" Margin="0,10,0,0" MaxWidth="560" HorizontalAlignment="Left"
                                                   Text="MONOLITH ещё ничего не менял в системе. Каждое изменение — твик, служба, план питания, задача планировщика — попадёт сюда до того, как будет сделано: с исходным значением, новым значением и источником." />
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.ColumnSpan="5" Height="1" VerticalAlignment="Top" Fill="{StaticResource B.Line}" />
                                    <StackPanel Margin="22,18,22,20">
                                        <TextBlock Text="01 · ЗАПИСЬ" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Text}" />
                                        <TextBlock Style="{StaticResource T.Caption}" Margin="0,6,0,0" LineHeight="17"
                                                   Text="Исходное значение сохраняется в журнал раньше, чем меняется система. Ключи реестра дополнительно копируются в .reg." />
                                    </StackPanel>
                                    <Rectangle Grid.Column="1" Style="{StaticResource DividerV}" />
                                    <StackPanel Grid.Column="2" Margin="22,18,22,20">
                                        <TextBlock Text="02 · ТОЧКА" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Text}" />
                                        <TextBlock Style="{StaticResource T.Caption}" Margin="0,6,0,0" LineHeight="17"
                                                   Text="Перед каждым пакетом изменений создаётся точка восстановления Windows (если защита системы включена) — вторая страховка." />
                                    </StackPanel>
                                    <Rectangle Grid.Column="3" Style="{StaticResource DividerV}" />
                                    <StackPanel Grid.Column="4" Margin="22,18,22,20">
                                        <TextBlock Text="03 · ОТКАТ" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Text}" />
                                        <TextBlock Style="{StaticResource T.Caption}" Margin="0,6,0,0" LineHeight="17"
                                                   Text="Изменения настроек откатываются здесь: по одному, пакетом или все сразу — к точному исходному значению. Удаление файлов, установки и сброс сети не откатываются." />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Filter matched nothing -->
                        <Border Style="{StaticResource Card}" Visibility="{Binding IsFilterEmpty, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="10" Height="10" Stroke="{StaticResource B.Text3}" StrokeThickness="1.5" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding FilterEmptyText}" Style="{StaticResource T.Body}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Batches -->
                        <ItemsControl ItemsSource="{Binding Batches}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:BatchItem}">
                                    <Border Style="{StaticResource Card.Flush}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <Grid Margin="20,16,20,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding DateText}" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{StaticResource B.Text3}" />
                                                    <TextBlock Text="{Binding Title, Converter={StaticResource Upper}}" FontFamily="{StaticResource F.Display}" FontWeight="Bold"
                                                               FontStretch="Condensed" FontSize="20" Foreground="{StaticResource B.Text}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <Rectangle Width="8" Height="8" VerticalAlignment="Center" Margin="0,1,8,0">
                                                            <Rectangle.Style>
                                                                <Style TargetType="Rectangle">
                                                                    <Setter Property="Fill" Value="Transparent" />
                                                                    <Setter Property="Stroke" Value="{StaticResource B.Text3}" />
                                                                    <Setter Property="StrokeThickness" Value="1.5" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RestorePointCreated}" Value="True">
                                                                            <Setter Property="Fill" Value="{StaticResource B.White}" />
                                                                            <Setter Property="Stroke" Value="{x:Null}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Rectangle.Style>
                                                        </Rectangle>
                                                        <TextBlock Text="{Binding RestorePointText}" Style="{StaticResource T.Caption}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                    <Border HorizontalAlignment="Right">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource Tag.Muted}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanRevert}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource B.White}" />
                                                                        <Setter Property="BorderBrush" Value="{StaticResource B.White}" />
                                                                        <Setter Property="TextElement.Foreground" Value="{StaticResource B.Ink}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding CountText}" />
                                                    </Border>
                                                    <Button Content="ОТКАТИТЬ ПАКЕТ" Height="32" MinWidth="150" Margin="0,10,0,0" HorizontalAlignment="Right"
                                                            Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.RevertBatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Records}" ItemTemplate="{StaticResource RecordTemplate}" Focusable="False" />
                                            <Border BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Padding="20,12"
                                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Style="{StaticResource T.Caption}"
                                                           Text="В пакете нет записей для отката: действие выполнено напрямую (например, сброс сети) или изменения не применились. Вернуть прежнее состояние можно точкой восстановления, если она создана." />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- System Restore -->
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Card}" Padding="22,20">
                            <StackPanel>
                                <TextBlock Text="ЗАЩИТА СИСТЕМЫ WINDOWS" Style="{StaticResource T.Label}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Rectangle Width="14" Height="14" VerticalAlignment="Center" Margin="0,2,12,0">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Fill" Value="{StaticResource B.HatchStrong}" />
                                                <Setter Property="Stroke" Value="{StaticResource B.Text2}" />
                                                <Setter Property="StrokeThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ProtectionEnabled}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource B.White}" />
                                                        <Setter Property="Stroke" Value="{x:Null}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <TextBlock Text="{Binding ProtectionTitle}" Style="{StaticResource T.Display}" FontSize="32" LineHeight="34" />
                                </StackPanel>
                                <TextBlock Text="{Binding ProtectionText}" Style="{StaticResource T.Body}" Margin="0,10,0,0" />
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource Btn.Primary}" Content="ВКЛЮЧИТЬ ЗАЩИТУ" Command="{Binding EnableProtectionCommand}"
                                            Visibility="{Binding CanOfferEnable, Converter={StaticResource BoolToVis}}" />
                                    <Button Grid.Column="2" Content="НАСТРОИТЬ" Command="{Binding ConfigureProtectionCommand}"
                                            ToolTip="SystemPropertiesProtection.exe — «Свойства системы» → «Защита системы»" />
                                    <Button Content="ОБНОВИТЬ" Command="{Binding RefreshPointsCommand}"
                                            Visibility="{Binding CanOfferEnable, Converter={StaticResource InverseBoolToVis}}" />
                                </Grid>
                                <Border Background="{StaticResource B.Surface2}" Padding="12,10" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding AutoPointsText}" Style="{StaticResource T.Caption}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Style="{StaticResource Btn.Link}" Content="Настройки" Margin="10,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding OpenSettingsCommand}" />
                                    </Grid>
                                </Border>

                                <Grid Margin="0,22,0,8">
                                    <TextBlock Style="{StaticResource T.Label}" VerticalAlignment="Center">
                                        <Run Text="ТОЧКИ ВОССТАНОВЛЕНИЯ" /><Run Text="  " /><Run Text="{Binding PointsCountText, Mode=OneWay}" Foreground="{StaticResource B.Text}" />
                                    </TextBlock>
                                </Grid>
                                <TextBlock Text="Загрузка списка…" Style="{StaticResource T.Caption}" Margin="0,4,0,0"
                                           Visibility="{Binding PointsLoading, Converter={StaticResource BoolToVis}}" />
                                <Border BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0"
                                        Visibility="{Binding PointsMessage, Converter={StaticResource NullToVis}}">
                                    <TextBlock Text="{Binding PointsMessage}" Style="{StaticResource T.Caption}" LineHeight="17" />
                                </Border>
                                <ItemsControl ItemsSource="{Binding RestorePoints}" ItemTemplate="{StaticResource PointTemplate}" Focusable="False" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
