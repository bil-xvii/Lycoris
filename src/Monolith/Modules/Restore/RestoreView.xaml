<UserControl x:Class="Monolith.Modules.Restore.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Monolith.UI.Controls"
             xmlns:ui="clr-namespace:Monolith.UI"
             xmlns:local="clr-namespace:Monolith.Modules.Restore"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:RestoreViewModel}">
    <UserControl.Resources>

        <!-- One journal record -->
        <DataTemplate x:Key="RecordTemplate" DataType="{x:Type local:RecordItem}">
            <Border Style="{StaticResource Row}" BorderThickness="0,1,0,0" Padding="12,10,12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- State marker: ■ active, □ reverted, hatched = revert failed -->
                    <Rectangle Width="10" Height="10" RadiusX="{StaticResource R.Xs.D}" RadiusY="{StaticResource R.Xs.D}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,5,0,0">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Fill" Value="{StaticResource B.White}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReverted}" Value="True">
                                        <Setter Property="Fill" Value="Transparent" />
                                        <Setter Property="Stroke" Value="{StaticResource B.Text3}" />
                                        <Setter Property="StrokeThickness" Value="1.5" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource B.HatchStrong}" />
                                        <Setter Property="Stroke" Value="{StaticResource B.Text}" />
                                        <Setter Property="StrokeThickness" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource T.BodyStrong}" VerticalAlignment="Center" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Style="{StaticResource Tag.Muted}" Margin="10,0,0,0" Padding="5,1,5,2" CornerRadius="{StaticResource R.Xs}">
                                <TextBlock Text="{Binding KindLabel}" FontSize="9.5" />
                            </Border>
                            <Border Style="{StaticResource Tag.Hatch}" Margin="6,0,0,0" Padding="5,1,5,2" CornerRadius="{StaticResource R.Xs}"
                                    Visibility="{Binding IsDrifted, Converter={StaticResource BoolToVis}}"
                                    ToolTip="После MONOLITH значение изменили Windows (например, обновление), политика или другая программа.">
                                <TextBlock Text="ИЗМЕНЕНО ВНЕ MONOLITH" FontSize="9.5" />
                            </Border>
                            <Border Style="{StaticResource Tag.Hatch}" Margin="6,0,0,0" Padding="5,1,5,2" CornerRadius="{StaticResource R.Xs}"
                                    Visibility="{Binding IsMismatch, Converter={StaticResource BoolToVis}}"
                                    ToolTip="После отката MONOLITH прочитал значение заново, и оно отличается от исходного.">
                                <TextBlock Text="НЕ СОВПАДАЕТ" FontSize="9.5" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Target}" ToolTip="{Binding RawTarget}" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{StaticResource B.Text3}"
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource T.Mono}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap">
                            <Run Text="{Binding OldValue, Mode=OneWay}" Foreground="{StaticResource B.Text2}" />
                            <Run Text="  →  " Foreground="{StaticResource B.Text4}" />
                            <Run Text="{Binding NewValue, Mode=OneWay}" Foreground="{StaticResource B.Text}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource T.Caption}" Margin="0,6,0,0">
                            <Run Text="{Binding Source, Mode=OneWay}" FontFamily="{StaticResource F.Mono}" FontSize="10.5" />
                            <Run Text="  ·  " Foreground="{StaticResource B.Text4}" />
                            <Run Text="{Binding TimeText, Mode=OneWay}" FontFamily="{StaticResource F.Mono}" FontSize="10.5" />
                        </TextBlock>
                        <TextBlock Text="{Binding DriftText}" Style="{StaticResource T.Mono}" FontSize="11.5" Foreground="{StaticResource B.Text}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" Visibility="{Binding IsDrifted, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Note}" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text2}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text}" Margin="0,6,0,0"
                                   Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}">
                            <Run Text="Ошибка отката:" FontWeight="SemiBold" />
                            <Run Text="{Binding RevertError, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                        <Border HorizontalAlignment="Right">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Tag}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReverted}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource B.Line2}" />
                                            <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text3}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource B.Hatch}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource B.Text2}" />
                                            <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusText}" />
                        </Border>
                        <Button Content="ОТКАТИТЬ" Height="30" MinWidth="110" Margin="0,10,0,0" HorizontalAlignment="Right" FontSize="11.5"
                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.RevertRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <Button Style="{StaticResource Btn.Primary}" Content="ПРИМЕНИТЬ СНОВА" Height="30" MinWidth="110" Margin="0,8,0,0" HorizontalAlignment="Right" FontSize="11.5"
                                Visibility="{Binding CanReapply, Converter={StaticResource BoolToVis}}"
                                ToolTip="Снова записать значение, которое ставил MONOLITH, отдельным пакетом. Исходное значение в журнале сохраняется."
                                Command="{Binding DataContext.ReapplyDriftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <Button Content="ПОКАЗАТЬ" Height="30" MinWidth="110" Margin="0,8,0,0" HorizontalAlignment="Right" FontSize="11.5"
                                Visibility="{Binding CanShowOwner, Converter={StaticResource BoolToVis}}"
                                ToolTip="Открыть раздел, где эта настройка меняется."
                                Command="{Binding DataContext.ShowDriftOwnerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <Button Style="{StaticResource Btn.Link}" Content="ЗАБЫТЬ" Margin="0,8,0,0" HorizontalAlignment="Right"
                                Visibility="{Binding IsDrifted, Converter={StaticResource BoolToVis}}"
                                ToolTip="Оставить новое значение и больше не напоминать. Запись в журнале остаётся: откат вернёт значение, которое было до MONOLITH."
                                Command="{Binding DataContext.ForgetDriftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Restore point row -->
        <DataTemplate x:Key="PointTemplate" DataType="{x:Type local:RestorePointItem}">
            <Border BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Padding="0,11">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding DateText}" Style="{StaticResource T.Mono}" FontSize="11.5" Foreground="{StaticResource B.Text}" />
                        <TextBlock Text="{Binding SequenceText}" Style="{StaticResource T.Mono}" FontSize="10.5" Foreground="{StaticResource B.Text4}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource T.Body}" Foreground="{StaticResource B.Text2}" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Description}" />
                    <WrapPanel Margin="0,6,0,0">
                        <Border Style="{StaticResource Tag.Solid}" Margin="0,0,6,0" Padding="5,1,5,2" CornerRadius="{StaticResource R.Xs}"
                                Visibility="{Binding IsMonolith, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="MONOLITH" FontSize="9.5" />
                        </Border>
                        <Border Style="{StaticResource Tag.Muted}" Padding="5,1,5,2" CornerRadius="{StaticResource R.Xs}">
                            <TextBlock Text="{Binding TypeLabel}" FontSize="9.5" />
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <c:PageHeader Index="{Binding Index}" Title="{Binding Title}" Subtitle="{Binding Subtitle}">
            <c:PageHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Btn.Ghost}" Command="{Binding OpenSystemRestoreCommand}" Margin="0,0,6,0"
                            ToolTip="rstrui.exe — мастер «Восстановление системы»">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="ВОССТАНОВЛЕНИЕ СИСТЕМЫ" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Ghost}" Command="{Binding OpenBackupsCommand}" Margin="0,0,10,0" ToolTip="{Binding BackupsPath}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="РЕЗЕРВНЫЕ КОПИИ" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CreateRestorePointCommand}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA18;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="СОЗДАТЬ ТОЧКУ" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Danger}" Command="{Binding RevertAllCommand}"
                            ToolTip="{Binding RevertAllHint}" ToolTipService.ShowOnDisabled="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="ОТКАТИТЬ ВСЁ" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </c:PageHeader.Actions>
        </c:PageHeader>

        <ScrollViewer x:Name="MainScroll" Grid.Row="1" Margin="0,16,-10,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel Margin="0,0,10,0">
                <!-- ═══════════════ Journal + System Restore ═══════════════ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <!-- Journal -->
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Журнал изменений" Style="{StaticResource T.H1}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <RadioButton Style="{StaticResource Segment}" GroupName="JournalFilter"
                                             IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=All}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ВСЕ" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding TotalCount}" FontFamily="{StaticResource F.Mono}" FontSize="10.5" FontWeight="Normal"
                                                   Margin="7,1,0,0" Opacity="0.55" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource Segment}" GroupName="JournalFilter"
                                             IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Active}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="АКТИВНЫЕ" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ActiveCount}" FontFamily="{StaticResource F.Mono}" FontSize="10.5" FontWeight="Normal"
                                                   Margin="7,1,0,0" Opacity="0.55" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource Segment}" GroupName="JournalFilter"
                                             IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Reverted}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ОТКАЧЕННЫЕ" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding RevertedCount}" FontFamily="{StaticResource F.Mono}" FontSize="10.5" FontWeight="Normal"
                                                   Margin="7,1,0,0" Opacity="0.55" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Grid>
                        <Rectangle Height="1" Fill="{StaticResource B.Line2}" Margin="0,0,0,10" />

                        <!-- Drift: one compact line; the records themselves are tagged in the list below -->
                        <Border Style="{StaticResource Callout}" Padding="0" Margin="0,0,0,10" ui:RoundClip.Content="True"
                                Visibility="{Binding HasDrift, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Fill="{StaticResource B.HatchStrong}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource T.H3}" VerticalAlignment="Center" Margin="11,9,10,9"
                                           Text="{Binding DriftCount, StringFormat=ИЗМЕНЕНО ВНЕ MONOLITH · {0}}" />
                                <TextBlock Grid.Column="2" Text="{Binding DriftLine}" Style="{StaticResource T.Body}" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Margin="0,9,10,9" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,10,8">
                                    <Button Content="ПОКАЗАТЬ" Height="30" FontSize="11.5" Margin="0,0,8,0" Command="{Binding ShowDriftedCommand}" />
                                    <Button Style="{StaticResource Btn.Primary}" Content="ПРИМЕНИТЬ СНОВА ВСЁ" Height="30" FontSize="11.5"
                                            Visibility="{Binding HasReapplicableDrift, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding ReapplyAllDriftCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Empty journal / filter matched nothing: one line -->
                        <Border Style="{StaticResource Card}" Visibility="{Binding IsFilterEmpty, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="10" Height="10" RadiusX="{StaticResource R.Xs.D}" RadiusY="{StaticResource R.Xs.D}" Stroke="{StaticResource B.Text3}" StrokeThickness="1.5" VerticalAlignment="Center" Margin="0,0,9,0" />
                                <TextBlock Text="{Binding FilterEmptyText}" Style="{StaticResource T.Body}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Batches -->
                        <ItemsControl ItemsSource="{Binding Batches}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:BatchItem}">
                                    <Border Style="{StaticResource Card.Flush}" Margin="0,0,0,10" ui:RoundClip.Content="True">
                                        <StackPanel>
                                            <Grid Margin="12,10,12,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding DateText}" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{StaticResource B.Text3}" />
                                                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource F.Display}" FontWeight="Bold"
                                                               FontStretch="Condensed" FontSize="17" Foreground="{StaticResource B.Text}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <Rectangle Width="8" Height="8" RadiusX="{StaticResource R.Xs.D}" RadiusY="{StaticResource R.Xs.D}" VerticalAlignment="Center" Margin="0,1,8,0">
                                                            <Rectangle.Style>
                                                                <Style TargetType="Rectangle">
                                                                    <Setter Property="Fill" Value="Transparent" />
                                                                    <Setter Property="Stroke" Value="{StaticResource B.Text3}" />
                                                                    <Setter Property="StrokeThickness" Value="1.5" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RestorePointCreated}" Value="True">
                                                                            <Setter Property="Fill" Value="{StaticResource B.White}" />
                                                                            <Setter Property="Stroke" Value="{x:Null}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Rectangle.Style>
                                                        </Rectangle>
                                                        <TextBlock Text="{Binding RestorePointText}" Style="{StaticResource T.Caption}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                    <Border HorizontalAlignment="Right">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource Tag.Muted}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanRevert}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource B.White}" />
                                                                        <Setter Property="BorderBrush" Value="{StaticResource B.White}" />
                                                                        <Setter Property="TextElement.Foreground" Value="{StaticResource B.Ink}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding CountText}" />
                                                    </Border>
                                                    <Button Content="ОТКАТИТЬ ПАКЕТ" Height="32" MinWidth="150" Margin="0,10,0,0" HorizontalAlignment="Right"
                                                            Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.RevertBatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Records}" ItemTemplate="{StaticResource RecordTemplate}" Focusable="False" />
                                            <Border BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Padding="12,9"
                                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Style="{StaticResource T.Caption}"
                                                           Text="В пакете нет записей для отката: действие выполнено напрямую (например, сброс сети), настройки уже были такими или изменение не удалось. Вернуть прежнее состояние можно точкой восстановления, если она создана." />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource Btn.Ghost}" Command="{Binding ShowMoreBatchesCommand}" HorizontalAlignment="Left"
                                Content="{Binding ShowMoreText}" Visibility="{Binding HasMoreBatches, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- System Restore -->
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Card}" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="ЗАЩИТА СИСТЕМЫ WINDOWS" Style="{StaticResource T.Label}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Rectangle Width="14" Height="14" RadiusX="{StaticResource R.Xs.D}" RadiusY="{StaticResource R.Xs.D}" VerticalAlignment="Center" Margin="0,2,9,0">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Fill" Value="{StaticResource B.HatchStrong}" />
                                                <Setter Property="Stroke" Value="{StaticResource B.Text2}" />
                                                <Setter Property="StrokeThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ProtectionEnabled}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource B.White}" />
                                                        <Setter Property="Stroke" Value="{x:Null}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <TextBlock Text="{Binding ProtectionTitle, Converter={StaticResource Sentence}}" Style="{StaticResource T.Display}" FontSize="24" LineHeight="34" />
                                </StackPanel>
                                <TextBlock Text="{Binding ProtectionText}" Style="{StaticResource T.Body}" Margin="0,10,0,0" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource Btn.Primary}" Content="ВКЛЮЧИТЬ" ToolTip="Включить защиту системы для диска C:" Command="{Binding EnableProtectionCommand}"
                                            Visibility="{Binding CanOfferEnable, Converter={StaticResource BoolToVis}}" />
                                    <Button Grid.Column="2" Content="НАСТРОИТЬ" Command="{Binding ConfigureProtectionCommand}"
                                            ToolTip="SystemPropertiesProtection.exe — «Свойства системы» → «Защита системы»" />
                                    <Button Content="ОБНОВИТЬ" Command="{Binding RefreshPointsCommand}"
                                            Visibility="{Binding CanOfferEnable, Converter={StaticResource InverseBoolToVis}}" />
                                </Grid>
                                <Grid Margin="0,11,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Точка перед изменениями" Style="{StaticResource T.H3}" />
                                        <TextBlock Style="{StaticResource T.Caption}" Margin="0,3,0,0" LineHeight="17"
                                                   Text="MONOLITH создаёт точку восстановления перед каждым пакетом изменений (если защита включена)." />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" VerticalAlignment="Center" IsChecked="{Binding CreateRestorePoints}"
                                              ToolTip="Рекомендуется держать включённым" />
                                </Grid>

                                <Grid Margin="0,14,0,8">
                                    <TextBlock Style="{StaticResource T.Label}" VerticalAlignment="Center">
                                        <Run Text="ТОЧКИ ВОССТАНОВЛЕНИЯ" /><Run Text="  " /><Run Text="{Binding PointsCountText, Mode=OneWay}" Foreground="{StaticResource B.Text}" />
                                    </TextBlock>
                                </Grid>
                                <TextBlock Text="Загрузка списка…" Style="{StaticResource T.Caption}" Margin="0,4,0,0"
                                           Visibility="{Binding PointsLoading, Converter={StaticResource BoolToVis}}" />
                                <Border BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Padding="0,9,0,0"
                                        Visibility="{Binding PointsMessage, Converter={StaticResource NullToVis}}">
                                    <TextBlock Text="{Binding PointsMessage}" Style="{StaticResource T.Caption}" LineHeight="17" />
                                </Border>
                                <ItemsControl ItemsSource="{Binding RestorePoints}" ItemTemplate="{StaticResource PointTemplate}" Focusable="False" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
