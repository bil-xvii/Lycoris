<UserControl x:Class="Monolith.Modules.Optimize.OptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Monolith.UI.Controls"
             xmlns:ui="clr-namespace:Monolith.UI"
             xmlns:local="clr-namespace:Monolith.Modules.Optimize"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:OptimizeViewModel}">

    <UserControl.Resources>

        <!-- ═══════════════ Local styles (built only from theme brushes/fonts) ═══════════════ -->

        <!-- Card corners for rows of a section: only the outer corners of the stack are rounded (built from R.Lg) -->
        <CornerRadius x:Key="Opt.RowTop" TopLeft="{StaticResource R.Lg.D}" TopRight="{StaticResource R.Lg.D}" />
        <CornerRadius x:Key="Opt.RowBottom" BottomRight="{StaticResource R.Lg.D}" BottomLeft="{StaticResource R.Lg.D}" />

        <!-- One tweak row; rows of a section share borders and read as one card -->
        <Style x:Key="Opt.RowCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource B.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource B.Line2}" />
            <Setter Property="BorderThickness" Value="1,0,1,1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFirstInGroup}" Value="True">
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="{StaticResource Opt.RowTop}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLastInGroup}" Value="True">
                    <Setter Property="CornerRadius" Value="{StaticResource Opt.RowBottom}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsFirstInGroup}" Value="True" />
                        <Condition Binding="{Binding IsLastInGroup}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="CornerRadius" Value="{StaticResource R.Lg}" />
                </MultiDataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource B.Surface3}" />
                </Trigger>
                <!-- Opened from the command palette / Dashboard: white frame for a moment -->
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource B.White}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Background" Value="{StaticResource B.Surface3}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- «ПОДРОБНЕЕ ▾»: an outlined 30 px toggle that only opens the long text (what-changes / risk / undo lines stay visible) -->
        <Style x:Key="Opt.DetailsToggle" TargetType="ToggleButton" BasedOn="{StaticResource Chip.Toggle}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="124" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Content" Value="ПОДРОБНЕЕ ▾" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="СКРЫТЬ ▴" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- State marker: ■ applied, □ not applied, hatched = partial, dashed = n/a or unknown -->
        <Style x:Key="Opt.StateMark" TargetType="Rectangle">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="RadiusX" Value="{StaticResource R.Xs.D}" />
            <Setter Property="RadiusY" Value="{StaticResource R.Xs.D}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{StaticResource B.Text3}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateKey}" Value="Applied">
                    <Setter Property="Fill" Value="{StaticResource B.White}" />
                    <Setter Property="Stroke" Value="{StaticResource B.White}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="Partial">
                    <Setter Property="Fill" Value="{StaticResource B.HatchStrong}" />
                    <Setter Property="Stroke" Value="{StaticResource B.Text2}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="NotApplicable">
                    <Setter Property="Stroke" Value="{StaticResource B.Text4}" />
                    <Setter Property="StrokeDashArray" Value="2 2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="Unknown">
                    <Setter Property="StrokeDashArray" Value="2 2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="Checking">
                    <Setter Property="StrokeDashArray" Value="1 2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Opt.StateText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontStretch" Value="SemiCondensed" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateKey}" Value="Applied">
                    <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="Partial">
                    <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="NotApplicable">
                    <Setter Property="Foreground" Value="{StaticResource B.Text4}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ═══════════════ Row templates (picked by type) ═══════════════ -->

        <!-- Category section header: checkbox · title · counters · visible select-all button -->
        <DataTemplate DataType="{x:Type local:SectionRow}">
            <Grid Margin="0,10,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="47" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Margin="10,0,0,0" VerticalAlignment="Center" IsChecked="{Binding CheckState, Mode=OneWay}" Command="{Binding ToggleAllCommand}"
                          IsEnabled="{Binding HasSelectable}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title, Converter={StaticResource Sentence}}" Style="{StaticResource T.H2}" FontFamily="{StaticResource F.Body}" FontWeight="Bold" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource T.Caption}" Margin="0,1,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding CountText}" VerticalAlignment="Center" Margin="10,0,12,0" Style="{StaticResource T.Mono}"
                           Foreground="{StaticResource B.Text3}" />
                <Button Grid.Column="3" Content="{Binding ToggleAllText}" Command="{Binding ToggleAllCommand}" IsEnabled="{Binding HasSelectable}" MinWidth="130" />
            </Grid>
        </DataTemplate>

        <!-- Expert items: a hatched band that says in words why they are expert (nothing is hidden behind a toggle) -->
        <DataTemplate DataType="{x:Type local:ExpertRow}">
            <Border Margin="0,10,10,9" Background="{StaticResource B.Base}" BorderBrush="{StaticResource B.Outline}" BorderThickness="1"
                    CornerRadius="{StaticResource R.Lg}" ui:RoundClip.Content="True">
                <Grid>
                    <Border Background="{StaticResource B.HatchStrong}" Opacity="0.45" />
                    <Grid Margin="12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static ui:Glyphs.Warning}" FontFamily="{StaticResource F.Icons}" FontSize="18" Foreground="{StaticResource B.Text}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Экспертные настройки" FontFamily="{StaticResource F.Display}" FontWeight="Bold" FontStretch="Condensed" FontSize="17"
                                       Foreground="{StaticResource B.Text}" />
                            <TextBlock Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text2}" Margin="0,2,0,0"
                                       Text="Реальные компромиссы: безопасность, совместимость, античиты. Не входят ни в один профиль, каждый пункт требует отдельного подтверждения." />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding CountText}" VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource T.Mono}"
                                   Foreground="{StaticResource B.Text2}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Nothing matches the filter (or the catalog is empty) -->
        <DataTemplate DataType="{x:Type local:EmptyRow}">
            <Border Margin="0,15,10,0" Background="{StaticResource B.DotGrid}" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" Padding="17,21"
                    CornerRadius="{StaticResource R.Lg}">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock x:Name="Head" Text="Ничего не найдено" Style="{StaticResource T.H1}" />
                    <TextBlock x:Name="Body" Text="Под этот фильтр не подходит ни один пункт. Измените запрос или выберите вкладку «ВСЕ»." Style="{StaticResource T.Body}"
                               Margin="0,6,0,0" />
                    <Button x:Name="Reset" Content="СБРОСИТЬ ФИЛЬТР" Command="{Binding Page.ClearFilterCommand}" HorizontalAlignment="Left" Margin="0,11,0,0" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Page.TotalCount}" Value="0">
                    <Setter TargetName="Head" Property="Text" Value="КАТАЛОГ ПУСТ" />
                    <Setter TargetName="Body" Property="Text" Value="В этой сборке MONOLITH нет ни одной оптимизации. Обновите приложение." />
                    <Setter TargetName="Reset" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One tweak -->
        <DataTemplate DataType="{x:Type local:TweakItemViewModel}">
            <Border Style="{StaticResource Opt.RowCard}" Margin="0,0,10,0">
                <Grid>
                    <!-- Left selection bar: a left-only border that follows the row's rounded outer corners -->
                    <Border x:Name="Bar" BorderThickness="3,0,0,0" BorderBrush="{StaticResource B.White}"
                            CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=Border}}"
                            Visibility="{Binding IsChecked, Converter={StaticResource BoolToVis}}" />
                    <Grid Margin="9,10,9,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="132" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Margin="0,1,0,0" VerticalAlignment="Top" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsApplicableNow}" />

                        <StackPanel Grid.Column="1" Margin="0,0,15,0">
                            <TextBlock x:Name="TitleText" Text="{Binding Title}" FontFamily="{StaticResource F.Body}" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{StaticResource B.Text}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource T.Body}" Foreground="{StaticResource B.Text3}" Margin="0,2,0,0" />

                            <!-- Why a row is grey: always text -->
                            <Grid Margin="0,5,0,0" Visibility="{Binding StatusNote, Converter={StaticResource NullToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static ui:Glyphs.Info}" FontFamily="{StaticResource F.Icons}" FontSize="12" Margin="0,2,7,0"
                                           Foreground="{StaticResource B.Text3}" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Text="{Binding StatusNote}" Style="{StaticResource T.Caption}" />
                            </Grid>

                            <!-- «сейчас → станет» is always visible (never behind ПОДРОБНЕЕ) -->
                            <TextBlock Margin="0,6,0,0" FontFamily="{StaticResource F.Mono}" FontSize="12" TextWrapping="Wrap"
                                       Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                                <Run Text="сейчас " Foreground="{StaticResource B.Text3}" /><Run Text="{Binding PreviewCurrent, Mode=OneWay}"
                                     Foreground="{StaticResource B.Text2}" /><Run Text="  →  " Foreground="{StaticResource B.Text3}" /><Run
                                     Text="станет " Foreground="{StaticResource B.Text3}" /><Run Text="{Binding PreviewNew, Mode=OneWay}"
                                     Foreground="{StaticResource B.Text}" FontWeight="Bold" /><Run Text="{Binding PreviewMore, Mode=OneWay}"
                                     Foreground="{StaticResource B.Text3}" /><Run Text="   ·   откат: кнопка «ОТКАТИТЬ» или «Восстановление»" Foreground="{StaticResource B.Text3}"
                                     FontFamily="{StaticResource F.Body}" />
                            </TextBlock>

                            <!-- Expert risk: always visible -->
                            <Border Margin="0,8,0,0" BorderBrush="{StaticResource B.Outline}" BorderThickness="1" CornerRadius="{StaticResource R.Md}"
                                    ui:RoundClip.Content="True" Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource B.HatchStrong}" />
                                    <StackPanel Grid.Column="1" Margin="9,8">
                                        <TextBlock Text="РИСК" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Text}" />
                                        <TextBlock Text="{Binding WarningText}" Style="{StaticResource T.Body}" Foreground="{StaticResource B.Text}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <WrapPanel Margin="0,7,0,0">
                                <Border Style="{StaticResource Tag}" Margin="0,0,6,0"
                                        Visibility="{Binding RiskKey, Converter={StaticResource EqualsToVis}, ConverterParameter=Safe}">
                                    <TextBlock Text="{Binding RiskText}" />
                                </Border>
                                <Border Style="{StaticResource Tag.Muted}" Margin="0,0,6,0"
                                        Visibility="{Binding RiskKey, Converter={StaticResource EqualsToVis}, ConverterParameter=Optional}">
                                    <TextBlock Text="{Binding RiskText}" />
                                </Border>
                                <Border Style="{StaticResource Tag.Hatch}" Margin="0,0,6,0"
                                        Visibility="{Binding RiskKey, Converter={StaticResource EqualsToVis}, ConverterParameter=Advanced}">
                                    <TextBlock Text="{Binding RiskText}" />
                                </Border>
                                <Border Style="{StaticResource Tag}" Margin="0,0,6,0" Visibility="{Binding HasRestart, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static ui:Glyphs.Sync}" FontFamily="{StaticResource F.Icons}" FontSize="11" VerticalAlignment="Center"
                                                   Margin="0,1,5,0" />
                                        <TextBlock Text="{Binding RestartTag}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding CategoryText}" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Text3}"
                                           VerticalAlignment="Center" Margin="6,0,0,0" />
                            </WrapPanel>

                            <!-- Expanded: the long text and the technical list (the lines above stay visible without it) -->
                            <Border Margin="0,10,0,2" Padding="10,10" Background="{StaticResource B.Base}" BorderBrush="{StaticResource B.Line2}" BorderThickness="1"
                                    CornerRadius="{StaticResource R.Md}" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource T.Body}" Margin="0,0,0,10"
                                               Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="ЧТО ИЗМЕНИТСЯ" Style="{StaticResource T.Label}" />
                                    <ItemsControl ItemsSource="{Binding Changes}" Margin="0,8,0,0" Focusable="False"
                                                  Visibility="{Binding HasPlannedChanges, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,9">
                                                    <TextBlock Text="{Binding Target}" Style="{StaticResource T.Mono}" FontSize="11.5" Foreground="{StaticResource B.Text}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,3,0,0" FontFamily="{StaticResource F.Mono}" FontSize="11.5" TextWrapping="Wrap">
                                                        <Run Text="сейчас " Foreground="{StaticResource B.Text3}" /><Run Text="{Binding Current, Mode=OneWay}"
                                                             Foreground="{StaticResource B.Text2}" /><Run Text="  →  " Foreground="{StaticResource B.Text3}" /><Run
                                                             Text="станет " Foreground="{StaticResource B.Text3}" /><Run Text="{Binding New, Mode=OneWay}"
                                                             Foreground="{StaticResource B.Text}" FontWeight="Bold" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource T.Caption}" Margin="0,6,0,0"
                                               Visibility="{Binding HasPlannedChanges, Converter={StaticResource InverseBoolToVis}}"
                                               Text="Особая процедура: каждый её шаг записывается в журнал при применении и откатывается из него." />

                                    <TextBlock Text="КАК ОТКАТИТЬ" Style="{StaticResource T.Label}" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding UndoText}" Style="{StaticResource T.Caption}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Current state + «will change» mark -->
                        <StackPanel Grid.Column="2" Margin="0,3,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Style="{StaticResource Opt.StateMark}" />
                                <TextBlock Text="{Binding StateText}" Style="{StaticResource Opt.StateText}" Margin="9,0,0,0" />
                            </StackPanel>
                            <Grid Margin="0,9,0,0" HorizontalAlignment="Left" Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}">
                                <Rectangle Stroke="{StaticResource B.Text2}" StrokeThickness="1" StrokeDashArray="3 2" SnapsToDevicePixels="True"
                                           RadiusX="{StaticResource R.Sm.D}" RadiusY="{StaticResource R.Sm.D}" />
                                <StackPanel Orientation="Horizontal" Margin="7,2,8,3">
                                    <TextBlock Text="&#xE72A;" FontFamily="{StaticResource F.Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,1,5,0"
                                               Foreground="{StaticResource B.Text}" />
                                    <TextBlock Text="БУДЕТ ИЗМЕНЕНО" FontFamily="{StaticResource F.Display}" FontWeight="SemiBold" FontSize="11"
                                               Foreground="{StaticResource B.Text}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Row buttons: both always visible (read-only: a click asks for admin rights and repeats itself) -->
                        <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button HorizontalAlignment="Stretch" Command="{Binding RevertCommand}" Margin="0,0,0,6" MinWidth="124"
                                    Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static ui:Glyphs.Undo}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center"
                                               Margin="0,0,7,0" />
                                    <TextBlock Text="ОТКАТИТЬ" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <ToggleButton Style="{StaticResource Opt.DetailsToggle}" IsChecked="{Binding IsExpanded}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsApplicableNow}" Value="False">
                    <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource B.Text3}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Bar" Property="BorderThickness" Value="5,0,0,0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <!-- ═══════════════ Page: header · profile tiles · filter bar · the list (the only scroller) · sticky bar ═══════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <c:PageHeader Title="{Binding Title}" Subtitle="{Binding Subtitle}" Checked="{Binding CheckedText}" RefreshCommand="{Binding RecheckCommand}">
            <c:PageHeader.Actions>
                <!-- Export / import of the selection: one outlined button, its two labelled items open on a click -->
                <Button Click="OnProfileMenuClick">
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom">
                            <MenuItem Header="ЭКСПОРТ ВЫБОРА В ФАЙЛ…" Command="{Binding ExportProfileCommand}" />
                            <MenuItem Header="ИМПОРТ ВЫБОРА ИЗ ФАЙЛА…" Command="{Binding ImportProfileCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static ui:Glyphs.Save}" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="ФАЙЛ ПРОФИЛЯ" Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="▾" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </c:PageHeader.Actions>
            <c:PageHeader.Primary>
                <Button Style="{StaticResource Btn.Primary}" Command="{Binding ApplyCommand}" MinWidth="150">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static ui:Glyphs.Bolt}" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ApplyButtonText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </c:PageHeader.Primary>
        </c:PageHeader>

        <!-- Profile tiles: each has its own button, so one click applies a profile -->
        <ItemsControl Grid.Row="1" Margin="-4,12,-4,0" ItemsSource="{Binding Profiles}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Card" Margin="4,0" Padding="13,11" Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Line2}"
                            BorderThickness="1" CornerRadius="{StaticResource R.Lg}" SnapsToDevicePixels="True">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title, Converter={StaticResource Sentence}}" FontFamily="{StaticResource F.Body}" FontWeight="Bold"
                                           FontSize="14.5" Foreground="{StaticResource B.Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Border Style="{StaticResource Tag.Muted}" Margin="8,0,0,0" Visibility="{Binding Badge, Converter={StaticResource NullToVis}}">
                                    <TextBlock Text="{Binding Badge}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Description}" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text2}" Margin="0,3,0,0"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Hint}" />
                            <TextBlock Margin="0,5,0,0" FontFamily="{StaticResource F.Mono}" FontSize="11.5" Foreground="{StaticResource B.Text3}">
                                <Run Text="{Binding ToChangeText, Mode=OneWay}" Foreground="{StaticResource B.Text}" FontWeight="Bold" /><Run
                                     Text=" к изменению · " /><Run Text="{Binding AppliedText, Mode=OneWay}" Foreground="{StaticResource B.Text2}" /><Run
                                     Text=" применено" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <!-- Selected tile: white primary; the others are outlined -->
                                <Button Style="{StaticResource Btn.Primary}" Command="{Binding ActCommand}" Content="{Binding ActText}" MinWidth="120"
                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                <Button Command="{Binding ActCommand}" Content="{Binding ActText}" MinWidth="120"
                                        Visibility="{Binding IsSelected, Converter={StaticResource InverseBoolToVis}}" />
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Text}"
                                           Text="ВЫБРАН" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource T.Caption}" Text="{Binding ActNote}"
                                           Visibility="{Binding IsSelected, Converter={StaticResource InverseBoolToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource B.White}" />
                            <Setter TargetName="Card" Property="Background" Value="{StaticResource B.Surface2}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Filter bar: framed category tabs, then search · chip · summary -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left">
                <ItemsControl ItemsSource="{Binding Categories}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource Segment}" Padding="10,0" GroupName="OptimizeCategory" FontSize="12.5"
                                         IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding SelectCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource TabBadge}" Margin="7,0,0,0">
                                        <TextBlock Text="{Binding Count}" />
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="320" Margin="0,0,10,0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Поиск по названию, описанию, id" Padding="10,0,22,0" />
                    <TextBlock Text="{x:Static ui:Glyphs.Search}" FontFamily="{StaticResource F.Icons}" FontSize="13" Foreground="{StaticResource B.Text3}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" IsHitTestVisible="False"
                               Visibility="{Binding HasSearch, Converter={StaticResource InverseBoolToVis}}" />
                </Grid>
                <Button Grid.Column="1" Content="ОЧИСТИТЬ ПОИСК" Command="{Binding ClearSearchCommand}" Margin="0,0,10,0"
                        Visibility="{Binding HasSearch, Converter={StaticResource BoolToVis}}" />
                <ToggleButton Grid.Column="2" Style="{StaticResource Chip.Toggle}" Height="30" IsChecked="{Binding OnlyPending}" Content="{Binding OnlyPendingText}" />
                <TextBlock Grid.Column="3" Text="{Binding ShownSummary}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text3}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <!-- The tweak list: the only scroller -->
        <ItemsControl x:Name="RowsList" Grid.Row="3" Margin="0,12,-10,0" ItemsSource="{Binding Rows}" Focusable="False"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard"
                      VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsPresenter Margin="0,0,0,15" />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
        <!-- Soft edge where the list scrolls under the sticky bar -->
        <Rectangle Grid.Row="3" Height="26" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00090909" Offset="0" />
                    <GradientStop Color="{StaticResource C.Base}" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Sticky bar (outside the scroller): ВЫБРАНО N · БУДЕТ ИЗМЕНЕНО N · [СНЯТЬ ВЫБОР] [ПРИМЕНИТЬ · N] -->
        <StackPanel Grid.Row="4" Margin="0,9,0,0">
            <ProgressBar Height="2" Margin="6,0,6,3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <c:StickyBar Count="{Binding SelectedCount}" Detail="{Binding ChangeDetail}" Text="{Binding StatusLine}">
                <c:StickyBar.Actions>
                    <StackPanel Orientation="Horizontal">
                        <Button Margin="0,0,8,0" Command="{Binding ResumePendingRestartCommand}" Visibility="{Binding HasPendingRestart, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static ui:Glyphs.Power}" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PendingRestartText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,8,0" Content="СНЯТЬ ВЫБОР" Command="{Binding ClearSelectionCommand}" />
                        <Button Style="{StaticResource Btn.Hero}" MinWidth="190" Command="{Binding ApplyCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static ui:Glyphs.Bolt}" FontFamily="{StaticResource F.Icons}" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ApplyButtonText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </c:StickyBar.Actions>
            </c:StickyBar>
        </StackPanel>
    </Grid>
</UserControl>
