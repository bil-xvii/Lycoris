<UserControl x:Class="Lycoris.Modules.Games.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Lycoris.UI.Controls"
             xmlns:ui="clr-namespace:Lycoris.UI"
             xmlns:loc="clr-namespace:Lycoris.UI"
             xmlns:local="clr-namespace:Lycoris.Modules.Games"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:GamesViewModel}">

    <UserControl.Resources>
        <!-- Small square status marker: white = OK, hatched = needs attention, outline = info -->
        <Style x:Key="Games.Marker" TargetType="Rectangle">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="RadiusX" Value="{StaticResource R.Xs.D}" />
            <Setter Property="RadiusY" Value="{StaticResource R.Xs.D}" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{StaticResource B.Text3}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- Section caption: LABEL ───────── meta -->
        <Style x:Key="Games.SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
            <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Option title inside the boost card -->
        <Style x:Key="Games.OptionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontStretch" Value="SemiCondensed" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        </Style>

        <!-- ═══════════════ Game card ═══════════════ -->
        <DataTemplate x:Key="Games.Card" DataType="{x:Type local:GameCardViewModel}">
            <Border x:Name="Card" Margin="0,0,9,9" Padding="0" Style="{StaticResource Card.Hover}" ui:RoundClip.Content="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="112" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Typographic cover -->
                    <Grid x:Name="Cover" ClipToBounds="True" Background="{StaticResource B.Surface2}">
                        <Border x:Name="Pattern" Background="{StaticResource B.DotGrid}" />
                        <TextBlock x:Name="Monogram" Text="{Binding Initials, Converter={StaticResource Sentence}}" FontFamily="{StaticResource F.Display}" FontWeight="Bold"
                                   FontStretch="Condensed" FontSize="92" Foreground="{StaticResource B.Text}" TextOptions.TextFormattingMode="Ideal"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="9,0,0,-16" IsHitTestVisible="False" />
                        <Grid VerticalAlignment="Top" Margin="9,9,10,0">
                            <Border Style="{StaticResource Tag.Solid}" Padding="6,1,6,2">
                                <TextBlock Text="{Binding PlatformLabel}" />
                            </Border>
                            <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"
                                       Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text2}"
                                       Visibility="{Binding HasSize, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                        <!-- Missing exe band -->
                        <Border VerticalAlignment="Bottom" Height="26" Background="{StaticResource B.HatchStrong}"
                                Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}">
                            <Border Background="{StaticResource B.Ink}" HorizontalAlignment="Left" Margin="10,4" Padding="6,0" CornerRadius="{StaticResource R.Sm}">
                                <TextBlock Text="{loc:T 'ФАЙЛ НЕ НАЙДЕН'}" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Text}" VerticalAlignment="Center" />
                            </Border>
                        </Border>
                        <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{StaticResource B.Line2}" />
                    </Grid>

                    <!-- Body -->
                    <StackPanel Grid.Row="1" Margin="10,9,10,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name, Converter={StaticResource Sentence}}" Style="{StaticResource T.H2}" FontSize="15.5" TextWrapping="Wrap"
                                       ToolTip="{Binding Name}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding PathText}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text3}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding PathText}" Margin="0,2,0,0" />
                        <!-- Hybrid PCs only: Windows' per-app GPU preference for this game (state readable without admin) -->
                        <CheckBox Style="{StaticResource Toggle}" Margin="0,9,0,0" HorizontalAlignment="Left"
                                  IsChecked="{Binding IsGpuHigh, Mode=OneWay}" ToolTip="{Binding GpuTooltip}" ToolTipService.ShowOnDisabled="True"
                                  Visibility="{Binding DataContext.ShowGpuToggle, RelativeSource={RelativeSource AncestorType=local:GamesView}, Converter={StaticResource BoolToVis}}"
                                  Command="{Binding DataContext.ToggleGpuCommand, RelativeSource={RelativeSource AncestorType=local:GamesView}}"
                                  CommandParameter="{Binding}" AutomationProperties.Name="{loc:T 'Высокопроизводительный GPU'}">
                            <CheckBox.IsEnabled>
                                <MultiBinding Converter="{x:Static local:AllTrueConverter.Instance}">
                                    <Binding Path="IsAvailable" />
                                    <Binding Path="DataContext.CanChangeGpu" RelativeSource="{RelativeSource AncestorType=local:GamesView}" />
                                </MultiBinding>
                            </CheckBox.IsEnabled>
                            <TextBlock Text="{loc:T 'Высокопроизводительный GPU'}" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text2}"
                                       TextWrapping="Wrap" />
                        </CheckBox>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Outlined: a plain launch, nothing changes in the system -->
                            <Button Padding="10,0" IsEnabled="{Binding IsAvailable}"
                                    Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=local:GamesView}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static ui:Glyphs.Play}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="{loc:T 'ИГРАТЬ'}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <!-- White primary: the game starts together with a game session -->
                            <Button Grid.Column="2" Padding="10,0"
                                    Command="{Binding DataContext.PlayBoostedCommand, RelativeSource={RelativeSource AncestorType=local:GamesView}}"
                                    CommandParameter="{Binding}">
                                <Button.IsEnabled>
                                    <MultiBinding Converter="{x:Static local:AllTrueConverter.Instance}">
                                        <Binding Path="IsAvailable" />
                                        <Binding Path="DataContext.CanLaunchBoosted" RelativeSource="{RelativeSource AncestorType=local:GamesView}" />
                                    </MultiBinding>
                                </Button.IsEnabled>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static ui:Glyphs.Bolt}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:T 'С УСКОРЕНИЕМ'}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <!-- Secondary actions, labelled -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Style="{StaticResource Btn.Ghost}" Padding="10,0" Margin="0,0,6,0"
                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=local:GamesView}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static ui:Glyphs.Folder}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="{loc:T 'ПАПКА ИГРЫ'}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.Ghost}" Padding="10,0" Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=local:GamesView}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static ui:Glyphs.Remove}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="{loc:T 'УБРАТЬ'}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding CoverVariant}" Value="1">
                    <Setter TargetName="Pattern" Property="Background" Value="{StaticResource B.Hatch}" />
                    <Setter TargetName="Cover" Property="Background" Value="{StaticResource B.Surface}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CoverVariant}" Value="2">
                    <Setter TargetName="Pattern" Property="Background" Value="Transparent" />
                    <Setter TargetName="Cover" Property="Background" Value="{StaticResource B.Surface3}" />
                    <Setter TargetName="Monogram" Property="Foreground" Value="{StaticResource B.Text2}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter TargetName="Monogram" Property="Foreground" Value="{StaticResource B.Text3}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ═══════════════ Boost change row ═══════════════ -->
        <DataTemplate x:Key="Games.ChangeRow" DataType="{x:Type local:BoostChange}">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle x:Name="Mark" Style="{StaticResource Games.Marker}" Margin="0,4,0,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.BodyStrong}" FontSize="12.5" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Caption}" Margin="0,2,0,0" LineHeight="16" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Changed">
                    <Setter TargetName="Mark" Property="Fill" Value="{StaticResource B.White}" />
                    <Setter TargetName="Mark" Property="Stroke" Value="{StaticResource B.White}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Skipped">
                    <Setter TargetName="Mark" Property="Fill" Value="{StaticResource B.HatchStrong}" />
                    <Setter TargetName="Mark" Property="Stroke" Value="{StaticResource B.Text2}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ═══════════════ Launcher source cell (empty state) ═══════════════ -->
        <DataTemplate x:Key="Games.SourceCell" DataType="{x:Type local:SourceStatus}">
            <Border BorderBrush="{StaticResource B.Line2}" BorderThickness="0,1,0,0" Padding="0,9,11,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Rectangle x:Name="Mark" Style="{StaticResource Games.Marker}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource T.BodyStrong}" FontSize="12.5" VerticalAlignment="Center" />
                    <TextBlock x:Name="Status" Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource T.Mono}"
                               Foreground="{StaticResource B.Text3}" VerticalAlignment="Center" Margin="9,0,0,0" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Installed}" Value="True">
                    <Setter TargetName="Mark" Property="Stroke" Value="{StaticResource B.Text2}" />
                    <Setter TargetName="Status" Property="Foreground" Value="{StaticResource B.Text2}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasGames}" Value="True">
                    <Setter TargetName="Mark" Property="Fill" Value="{StaticResource B.White}" />
                    <Setter TargetName="Mark" Property="Stroke" Value="{StaticResource B.White}" />
                    <Setter TargetName="Status" Property="Foreground" Value="{StaticResource B.Text}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════════ Header ═══════════════ -->
        <c:PageHeader Title="{Binding Title}" Subtitle="{Binding Subtitle}" Checked="{Binding CheckedText}" RefreshCommand="{Binding RefreshCommand}">
            <c:PageHeader.Actions>
                <Button Command="{Binding AddGameCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static ui:Glyphs.Add}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:T 'ДОБАВИТЬ ИГРУ'}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </c:PageHeader.Actions>
            <!-- The ONE primary button: the game session (the same command as the rail's «СТАРТ» and the Dashboard tile) -->
            <c:PageHeader.Primary>
                <Grid>
                    <Button Style="{StaticResource Btn.Primary}" Command="{Binding StartBoostCommand}"
                            Visibility="{Binding IsBoostIdle, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static ui:Glyphs.Bolt}" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{loc:T 'ИГРОВОЙ СЕАНС · СТАРТ'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Danger}" Command="{Binding StopBoostCommand}"
                            Visibility="{Binding Boost.IsActive, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource Dot.Red}" Margin="0,0,9,0" />
                            <TextBlock Text="{x:Static ui:Glyphs.Stop}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{loc:T 'СТОП СЕАНСА'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </c:PageHeader.Primary>
        </c:PageHeader>

        <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="344" />
                </Grid.ColumnDefinitions>

                <!-- ═══════════════ LIBRARY (toolbar fixed, cards scroll) ═══════════════ -->
                <Grid x:Name="LibraryHost">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,9,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:T 'БИБЛИОТЕКА'}" Style="{StaticResource Games.SectionLabel}" />
                        <Rectangle Grid.Column="1" Height="1" Fill="{StaticResource B.Line2}" Margin="9,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding ScanText}" Style="{StaticResource T.Mono}"
                                   Foreground="{StaticResource B.Text3}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Count + search + platform filter (only when there are games) -->
                    <StackPanel Grid.Row="1" Margin="0,0,9,0" Visibility="{Binding HasGames, Converter={StaticResource BoolToVis}}">
                        <!-- Summary strip: count · search · platform chips (filters sit next to the search box) -->
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{Binding TotalCount}" Style="{StaticResource T.Stat}" FontSize="26" />
                                <TextBlock Text="{Binding CountUnit}" Style="{StaticResource T.StatUnit}" Margin="8,0,0,4" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <Grid Width="230" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="{loc:T 'Поиск по названию'}" Padding="10,0,21,0" />
                                <TextBlock Text="{x:Static ui:Glyphs.Search}" FontFamily="{StaticResource F.Icons}" FontSize="12" Foreground="{StaticResource B.Text3}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"
                                           Visibility="{Binding SearchText, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                            </Grid>
                            <Button Content="{loc:T 'ОЧИСТИТЬ'}" Command="{Binding ClearSearchCommand}" Margin="0,0,8,0" VerticalAlignment="Center"
                                    Visibility="{Binding SearchText, Converter={StaticResource NullToVis}}" />
                            <ItemsControl ItemsSource="{Binding Platforms}" Focusable="False" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:PlatformFilterItem}">
                                        <RadioButton Style="{StaticResource Chip}" GroupName="GamesPlatformFilter" Height="30"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                <Border Style="{StaticResource TabBadge}" Margin="7,0,0,0">
                                                    <TextBlock Text="{Binding Count}" />
                                                </Border>
                                            </StackPanel>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                        <!-- Why the «С УСКОРЕНИЕМ» buttons are grey: text, not a tooltip -->
                        <TextBlock Style="{StaticResource T.Caption}" Margin="0,8,0,0" Foreground="{StaticResource B.Text2}" Text="{Binding BoostActiveNote}"
                                   Visibility="{Binding HasBoostActiveNote, Converter={StaticResource BoolToVis}}" />
                        <Rectangle Height="1" Fill="{StaticResource B.Line2}" Margin="0,10,0,11" />
                    </StackPanel>

                    <!-- First scan (no cache yet) -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource B.Line}" BorderThickness="1" Background="{StaticResource B.Surface}" Height="220"
                            CornerRadius="{StaticResource R.Lg}" ui:RoundClip.Content="True" Margin="0,0,9,0" VerticalAlignment="Top" Visibility="{Binding ShowFirstScan, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Border Background="{StaticResource B.DotGrid}" />
                            <StackPanel VerticalAlignment="Center" Margin="20,0">
                                <TextBlock Text="{loc:T 'Поиск игр'}" Style="{StaticResource T.H1}" />
                                <TextBlock Text="Steam, Epic Games, GOG Galaxy, EA app, Ubisoft Connect, Battle.net, Riot Client…" Style="{StaticResource T.Body}" Margin="0,6,0,10" />
                                <ProgressBar IsIndeterminate="True" Height="2" Width="260" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Game grid -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                  SizeChanged="CardsScroll_SizeChanged" Visibility="{Binding HasVisibleGames, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding VisibleGames}" ItemTemplate="{StaticResource Games.Card}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid VerticalAlignment="Top"
                                                 Columns="{Binding CardColumns, RelativeSource={RelativeSource AncestorType=local:GamesView}}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Filter matched nothing -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource B.Line}" BorderThickness="1" Background="{StaticResource B.Surface}" Padding="17,16"
                            CornerRadius="{StaticResource R.Lg}" Margin="0,0,9,0" VerticalAlignment="Top" Visibility="{Binding IsFilterEmpty, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:T 'Ничего не найдено'}" Style="{StaticResource T.H1}" FontSize="17" />
                                <TextBlock Text="{loc:T 'Ни одна игра не подходит под запрос и выбранный лаунчер.'}" Style="{StaticResource T.Body}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{loc:T 'СБРОСИТЬ ПОИСК'}" Command="{Binding ClearSearchCommand}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Empty library -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource B.Line}" BorderThickness="1" Background="{StaticResource B.Surface}" ClipToBounds="True"
                            CornerRadius="{StaticResource R.Lg}" ui:RoundClip.Content="True" Margin="0,0,9,0" Visibility="{Binding IsLibraryEmpty, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <StackPanel Margin="19,17,19,16">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="40" Height="40" Background="{StaticResource B.Surface4}" CornerRadius="{StaticResource R.Sm}" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Static ui:Glyphs.Game}" FontFamily="{StaticResource F.Icons}" FontSize="19"
                                                       Foreground="{StaticResource B.Text}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{loc:T 'Игры не найдены'}" Style="{StaticResource T.Display}" FontSize="25" LineHeight="36" Margin="10,2,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource T.Body}" Margin="0,10,0,0" MaxWidth="540" HorizontalAlignment="Left"
                                               Text="{loc:T 'Lycoris проверил лаунчеры ниже и не нашёл установленных игр. Если игра стоит отдельно от лаунчера — добавьте её вручную: укажите .exe файл, и у неё появятся кнопки запуска и игрового сеанса.'}" />
                                    <TextBlock Text="{loc:T 'ПРОВЕРЕННЫЕ ЛАУНЧЕРЫ'}" Style="{StaticResource T.Label}" Margin="0,14,0,8" />
                                    <ItemsControl ItemsSource="{Binding Sources}" ItemTemplate="{StaticResource Games.SourceCell}"
                                                  MaxWidth="560" HorizontalAlignment="Left" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Style="{StaticResource Btn.Primary}" Command="{Binding AddGameCommand}" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{x:Static ui:Glyphs.Add}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="{loc:T 'ДОБАВИТЬ ИГРУ'}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Content="{loc:T 'ИСКАТЬ СНОВА'}" Command="{Binding RefreshCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Footer: which launchers were checked -->
                    <TextBlock Grid.Row="3" Text="{Binding SourcesFooter}" Style="{StaticResource T.Caption}" Margin="0,8,9,0"
                               TextWrapping="Wrap" ToolTip="{Binding SourcesFooter}"
                               Visibility="{Binding HasGames, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- ═══════════════ RIGHT RAIL (own scroll; scrollbar sits in the page margin) ═══════════════ -->
                <ScrollViewer Grid.Column="2" Margin="0,0,-10,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="0,0,10,9">

                    <!-- ─────────── GAME BOOST ─────────── -->
                    <Border Style="{StaticResource Card.Flush}" ui:RoundClip.Content="True">
                        <StackPanel>
                            <Rectangle Height="4" Fill="{StaticResource B.HatchStrong}" />
                            <Grid Margin="12,11,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" Background="{StaticResource B.Surface4}" CornerRadius="{StaticResource R.Sm}" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static ui:Glyphs.Bolt}" FontFamily="{StaticResource F.Icons}" FontSize="18"
                                               Foreground="{StaticResource B.Text}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="GAME BOOST" Style="{StaticResource T.Label}" />
                                    <TextBlock Text="{loc:T 'Игровой сеанс'}" Style="{StaticResource T.H1}" FontSize="17" Margin="0,1,0,0" />
                                </StackPanel>
                                <Border Grid.Column="2" VerticalAlignment="Top" Margin="8,2,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Tag.Muted}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Boost.IsActive}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource B.Surface4}" />
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding BoostStatus}" />
                                </Border>
                            </Grid>

                            <!-- Active session: inverted block -->
                            <StackPanel Visibility="{Binding Boost.IsActive, Converter={StaticResource BoolToVis}}">
                                <Border Margin="12,11,12,0" Background="{StaticResource B.Surface3}" BorderBrush="{StaticResource B.Line3}" BorderThickness="1" Padding="11,10,11,10"
                                        CornerRadius="{StaticResource R.Md}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Boost.PhaseText}" Style="{StaticResource T.Label}" FontWeight="Bold" Foreground="{StaticResource B.Text}" />
                                            <TextBlock Text="{loc:T 'ВРЕМЯ СЕАНСА'}" Style="{StaticResource T.Label}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <TextBlock Text="{Binding ElapsedText, Converter={StaticResource Sentence}}" FontFamily="{StaticResource F.Display}" FontWeight="Bold" FontStretch="Condensed"
                                                   FontSize="36" Foreground="{StaticResource B.Text}" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0" />
                                        <Rectangle Height="1" Fill="{StaticResource B.Line3}" Margin="0,8,0,10" />
                                        <TextBlock Text="{Binding Boost.GameName, Converter={StaticResource Sentence}}" FontFamily="{StaticResource F.Display}" FontWeight="Bold" FontStretch="Condensed"
                                                   FontSize="19" Foreground="{StaticResource B.Text}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Boost.ProcessText}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text2}"
                                                   Margin="0,3,0,0" Visibility="{Binding Boost.ProcessText, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{loc:T 'ЧТО ИЗМЕНЕНО'}" Style="{StaticResource T.Label}" Margin="12,11,12,10" />
                                <ItemsControl ItemsSource="{Binding Boost.Changes}" ItemTemplate="{StaticResource Games.ChangeRow}" Margin="12,0,12,0" Focusable="False" />
                            </StackPanel>

                            <!-- Idle: what it does + options -->
                            <StackPanel Margin="12,0,12,0" Visibility="{Binding IsBoostIdle, Converter={StaticResource BoolToVis}}">
                                <!-- Leftovers of a crashed session -->
                                <Border Style="{StaticResource Callout}" Padding="0" Margin="0,10,0,0" ui:RoundClip.Content="True"
                                        Visibility="{Binding HasStaleBoost, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Fill="{StaticResource B.White}" />
                                        <StackPanel Grid.Column="1" Margin="10,11,10,9">
                                            <TextBlock Text="{loc:T 'НЕЗАВЕРШЁННЫЙ СЕАНС'}" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Text}" />
                                            <TextBlock Text="{Binding StaleText}" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text2}" Margin="0,4,0,10" LineHeight="16" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource Btn.Primary}" Padding="12,0" Content="{Binding StaleActionText}"
                                                        Command="{Binding RestoreStaleCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Options -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.ColumnSpan="2" Height="1" Fill="{StaticResource B.Line}" VerticalAlignment="Top" />
                                    <StackPanel Margin="0,10,9,0">
                                        <TextBlock Text="{loc:T 'Схема питания'}" Style="{StaticResource Games.OptionTitle}" />
                                        <TextBlock Text="{Binding PowerNote}" Style="{StaticResource T.Caption}" Margin="0,3,0,0" LineHeight="16" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding Settings.GameBoostPowerPlan}"
                                              VerticalAlignment="Top" Margin="0,10,0,0" ToolTip="{loc:T 'На настольном ПК — схема «Высокая производительность», на ноутбуке и ПК с Modern Standby — режим питания «Максимальная производительность» от сети; только на время игры'}" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.ColumnSpan="2" Height="1" Fill="{StaticResource B.Line}" VerticalAlignment="Top" />
                                    <StackPanel Margin="0,10,9,0">
                                        <TextBlock Text="{loc:T 'Приоритет игры'}" Style="{StaticResource Games.OptionTitle}" />
                                        <TextBlock Style="{StaticResource T.Caption}" Margin="0,3,0,0" LineHeight="16"
                                                   Text="{loc:T '«Высокий» на время игры — никогда «Реального времени». Эффект небольшой, риск минимальный.'}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding Settings.GameBoostPriority}"
                                              VerticalAlignment="Top" Margin="0,10,0,0" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.ColumnSpan="2" Height="1" Fill="{StaticResource B.Line}" VerticalAlignment="Top" />
                                    <StackPanel Margin="0,10,9,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{loc:T 'Очистка памяти'}" Style="{StaticResource Games.OptionTitle}" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource Tag.Muted}" Margin="8,0,0,0">
                                                <TextBlock Text="{loc:T 'ПО ЖЕЛАНИЮ'}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource T.Caption}" Margin="0,3,0,0" LineHeight="16"
                                                   Text="{loc:T 'Однократно очищает список ожидания (standby). Честно: на FPS обычно не влияет, а загрузки могут стать дольше.'}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding Settings.GameBoostPurgeStandby}"
                                              VerticalAlignment="Top" Margin="0,10,0,0" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.ColumnSpan="2" Height="1" Fill="{StaticResource B.Line}" VerticalAlignment="Top" />
                                    <StackPanel Margin="0,10,9,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{loc:T 'Закрытие программ'}" Style="{StaticResource Games.OptionTitle}" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource TabBadge}" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding CloseListCount}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding CloseListSummary}" Style="{StaticResource T.Caption}" Margin="0,3,0,0" LineHeight="16" />
                                        <!-- Windows 11 only: close the listed apps, or keep them running in efficiency mode (EcoQoS) -->
                                        <StackPanel Visibility="{Binding ShowCloseModeChoice, Converter={StaticResource BoolToVis}}">
                                        <Border Style="{StaticResource SegmentBar}" Margin="0,6,0,0"><StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Segment}" GroupName="GamesCloseMode" Height="26" FontSize="12" Padding="10,0"
                                                         Content="{loc:T 'ЗАКРЫТЬ'}" IsChecked="{Binding CloseModeIsClose}"
                                                         ToolTip="{loc:T 'Программы из списка закрываются перед игрой: сначала обычная команда «закрыть окно», принудительно — только после отдельного вопроса.'}" />
                                            <RadioButton Style="{StaticResource Segment}" GroupName="GamesCloseMode" Height="26" FontSize="12" Padding="10,0"
                                                         Content="{loc:T 'РЕЖИМ ЭФФЕКТИВНОСТИ'}" IsChecked="{Binding CloseModeIsEcoQos}"
                                                         ToolTip="{x:Static local:GamesViewModel.CloseModeEcoQosCaption}" />
                                        </StackPanel></Border>
                                        <TextBlock Text="{x:Static local:GamesViewModel.CloseModeEcoQosCaption}" Style="{StaticResource T.Caption}" Margin="0,2,0,0" LineHeight="16"
                                                   TextWrapping="Wrap" Visibility="{Binding CloseModeIsEcoQos, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{loc:T 'НАСТРОИТЬ'}" Padding="12,0" VerticalAlignment="Top" Margin="0,9,0,0"
                                            Command="{Binding OpenEditorCommand}" />
                                </Grid>
                            </StackPanel>

                            <!-- Start / stop -->
                            <Grid Margin="12,12,12,0">
                                <Button Height="48" HorizontalAlignment="Stretch" Command="{Binding StartBoostCommand}"
                                        Visibility="{Binding IsBoostIdle, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static ui:Glyphs.Play}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="{loc:T 'СТАРТ'}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Btn.Danger}" Height="38" FontSize="15" HorizontalAlignment="Stretch" Command="{Binding StopBoostCommand}"
                                        IsEnabled="{Binding Boost.IsTransitioning, Converter={StaticResource InverseBool}}"
                                        Visibility="{Binding Boost.IsActive, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static ui:Glyphs.Stop}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Text="{loc:T 'СТОП И ВЕРНУТЬ НАСТРОЙКИ'}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <!-- Read-only: the reason is text under the button (the click asks for admin rights and continues by itself) -->
                            <TextBlock Margin="12,10,12,0" LineHeight="16" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text2}" Text="{Binding StartNote}"
                                       Visibility="{Binding HasStartNote, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Margin="12,10,12,12" LineHeight="16">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource T.Caption}">
                                        <Setter Property="Text" Value="{loc:T 'Или нажмите «С УСКОРЕНИЕМ» на карточке игры: режим включится вместе с игрой и выключится, когда вы из неё выйдете.'}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Boost.IsActive}" Value="True">
                                                <Setter Property="Text" Value="{loc:T 'Схема или режим питания вернётся к прежнему, приоритет игры — к обычному. Закрытые программы откройте сами, если они нужны.'}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Readiness: the checks themselves live on the Dashboard (with fix buttons) -->
                    <Button Style="{StaticResource Btn.Link}" Content="{Binding ReadinessText}" Command="{Binding GoDashboardCommand}"
                            HorizontalAlignment="Left" Margin="0,10,0,0"
                            Visibility="{Binding ReadinessLoaded, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                </ScrollViewer>
        </Grid>

        <!-- ═══════════════ Close-list editor (overlay) ═══════════════ -->
        <Grid Grid.RowSpan="2" Margin="-25,-19,-25,-15" Background="{StaticResource B.Scrim}" Panel.ZIndex="10"
              Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}" PreviewKeyDown="Editor_PreviewKeyDown">
            <Border Width="880" Margin="15" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource B.Surface2}"
                    BorderBrush="{StaticResource B.Line3}" BorderThickness="1" CornerRadius="{StaticResource R.Xl}" ui:RoundClip.Content="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.8" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Rectangle Height="6" VerticalAlignment="Top" Fill="{StaticResource B.White}" />
                    <StackPanel Margin="17,17,17,0">
                        <TextBlock Text="{loc:T 'Закрывать перед игрой'}" Style="{StaticResource T.H1}" />
                        <TextBlock Style="{StaticResource T.Body}" Margin="0,8,0,0" MaxWidth="760" HorizontalAlignment="Left"
                                   Text="{loc:T 'Отметьте программы, которые Lycoris закроет перед запуском игры в игровом сеансе: браузеры, мессенджеры, облачные клиенты. Системные процессы, драйверы, античиты и лаунчеры сюда не попадают. Закрытые программы после игры сами не откроются.'}" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="17,12,17,0" Height="330">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="290" />
                        </Grid.ColumnDefinitions>

                        <!-- Running now -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{loc:T 'ЗАПУЩЕНО СЕЙЧАС'}" Style="{StaticResource Games.SectionLabel}" />
                                <Button Style="{StaticResource Btn.Ghost}" Padding="10,0" HorizontalAlignment="Right"
                                        Command="{Binding RefreshRunningCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static ui:Glyphs.Refresh}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:T 'ОБНОВИТЬ'}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Grid.Row="1" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" Background="{StaticResource B.Surface}"
                                    CornerRadius="{StaticResource R.Lg}" ui:RoundClip.Content="True">
                                <Grid>
                                    <ListBox Style="{StaticResource List.Plain}" ItemsSource="{Binding RunningApps}" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             VirtualizingPanel.IsVirtualizing="True">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:RunningAppItem}">
                                                <Border Style="{StaticResource Row}" Padding="10,8,10,8">
                                                    <CheckBox IsChecked="{Binding IsInList, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" Style="{StaticResource T.BodyStrong}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Description}" Style="{StaticResource T.Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding Meta}" Style="{StaticResource T.Mono}"
                                                                       Foreground="{StaticResource B.Text3}" VerticalAlignment="Center" Margin="9,0,0,0" />
                                                        </Grid>
                                                    </CheckBox>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="{loc:T 'Загрузка списка процессов…'}" Style="{StaticResource T.Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding IsLoadingRunning, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- The list -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,8" Height="24">
                                <TextBlock Text="{loc:T 'СПИСОК ЗАКРЫТИЯ'}" Style="{StaticResource Games.SectionLabel}" />
                                <TextBlock Text="{Binding EditorList.Count}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text2}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding NewProcessName, UpdateSourceTrigger=PropertyChanged}" Tag="{loc:T 'Имя процесса, напр. Discord'}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding AddManualCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="1" Style="{StaticResource Btn.Primary}" Padding="12,0" Margin="6,0,0,0" Command="{Binding AddManualCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static ui:Glyphs.Add}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <TextBlock Text="{loc:T 'ДОБАВИТЬ'}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Grid.Row="2" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" Background="{StaticResource B.Surface}"
                                    CornerRadius="{StaticResource R.Lg}" ui:RoundClip.Content="True">
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding EditorList}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,0,1" Padding="10,6,6,6">
                                                        <Grid>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Rectangle Width="6" Height="6" Fill="{StaticResource B.White}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                                           RadiusX="{StaticResource R.Xs.D}" RadiusY="{StaticResource R.Xs.D}" />
                                                                <TextBlock Text="{Binding}" Style="{StaticResource T.Mono}" FontSize="12.5" Foreground="{StaticResource B.Text}" />
                                                            </StackPanel>
                                                            <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Right" Content="{loc:T 'УБРАТЬ'}" Padding="10,0"
                                                                    Command="{Binding DataContext.RemoveFromListCommand, RelativeSource={RelativeSource AncestorType=local:GamesView}}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <StackPanel VerticalAlignment="Center" Margin="12,0" Visibility="{Binding EditorListEmpty, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{loc:T 'СПИСОК ПУСТ'}" Style="{StaticResource T.Label}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{loc:T 'Перед игрой ничего не закрывается. Отметьте программы слева или впишите имя процесса.'}" Style="{StaticResource T.Caption}"
                                                   TextAlignment="Center" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2" Margin="17,14,17,16">
                        <TextBlock Style="{StaticResource T.Caption}" VerticalAlignment="Center" MaxWidth="460" HorizontalAlignment="Left" LineHeight="16"
                                   Text="{loc:T 'Перед закрытием Lycoris покажет список и спросит подтверждение. Принудительное завершение — только после отдельного вопроса.'}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{loc:T 'ОТМЕНА'}" Command="{Binding CancelEditorCommand}" MinWidth="110" Margin="0,0,10,0" />
                            <Button Style="{StaticResource Btn.Primary}" Content="{loc:T 'СОХРАНИТЬ'}" Command="{Binding SaveEditorCommand}" MinWidth="140" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
