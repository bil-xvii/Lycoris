<UserControl x:Class="Lycoris.Modules.Services.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Lycoris.UI.Controls"
             xmlns:ui="clr-namespace:Lycoris.UI"
             xmlns:loc="clr-namespace:Lycoris.UI"
             xmlns:local="clr-namespace:Lycoris.Modules.Services"
             xmlns:start="clr-namespace:Lycoris.Modules.Startup"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:ServicesViewModel}"
             d:DesignWidth="1100" d:DesignHeight="760">

    <UserControl.Resources>
        <!-- ─────────────── Small building blocks ─────────────── -->
        <Style x:Key="Key" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontStretch" Value="SemiCondensed" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Status square: solid white = running, hollow = stopped -->
        <Style x:Key="Dot" TargetType="Border">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource B.Text3}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{StaticResource R.Xs}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Background" Value="{StaticResource B.White}" />
                    <Setter Property="BorderBrush" Value="{StaticResource B.White}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StartCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="9,0" />
        </Style>

        <Style x:Key="GroupCount" TargetType="TextBlock" BasedOn="{StaticResource T.Mono}">
            <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
            <Setter Property="Margin" Value="9,3,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Selectable row of the service list: the right chevron says «click to open» -->
        <Style x:Key="SvcItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,0,1" />
                            <Rectangle x:Name="Bar" Width="3" HorizontalAlignment="Left" Fill="{StaticResource B.White}" Visibility="Hidden" />
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Surface3}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Surface3}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One state vocabulary: ПРИМЕНЕНО · НЕ ПРИМЕНЕНО · ИЗМЕНЕНО Lycoris · НЕПРИМЕНИМО (the theme's Tag styles) -->
        <DataTemplate x:Key="RowBadge">
            <Grid HorizontalAlignment="Right">
                <Border Style="{StaticResource Tag.Ok}" HorizontalAlignment="Right"
                        Visibility="{Binding Badge, Converter={StaticResource EqualsToVis}, ConverterParameter=Done}">
                    <TextBlock Text="{loc:T ПРИМЕНЕНО}" />
                </Border>
                <Border Style="{StaticResource Tag.Ok}" HorizontalAlignment="Right"
                        Visibility="{Binding Badge, Converter={StaticResource EqualsToVis}, ConverterParameter=AlreadyManual}">
                    <TextBlock Text="{loc:T ПРИМЕНЕНО}" />
                </Border>
                <Border Style="{StaticResource Tag.Muted}" HorizontalAlignment="Right"
                        Visibility="{Binding Badge, Converter={StaticResource EqualsToVis}, ConverterParameter=Pending}">
                    <TextBlock Text="{loc:T НЕ ПРИМЕНЕНО}" />
                </Border>
                <Border Style="{StaticResource Tag.Hatch}" HorizontalAlignment="Right"
                        Visibility="{Binding Badge, Converter={StaticResource EqualsToVis}, ConverterParameter=Blocked}">
                    <TextBlock Text="{loc:T НЕПРИМЕНИМО}" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ─────────────── Recommendation row ─────────────── -->
        <DataTemplate x:Key="RecRow" DataType="{x:Type local:RecommendationItem}">
            <Border Style="{StaticResource Row}" Padding="0,11,12,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="236" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <!-- Mark: checkbox / done / locked (always visible; read-only mode asks for rights when the action is pressed) -->
                    <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,1,0,0">
                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" ToolTip="{loc:T Отметить для изменения}"
                                  Visibility="{Binding Mark, Converter={StaticResource EqualsToVis}, ConverterParameter=Check}" />
                        <Border Width="18" Height="18" BorderBrush="{StaticResource B.Outline}" BorderThickness="1.5" CornerRadius="{StaticResource R.Xs}" ToolTip="{loc:T Уже настроено}"
                                Visibility="{Binding Mark, Converter={StaticResource EqualsToVis}, ConverterParameter=Done}">
                            <TextBlock Text="{x:Static ui:Glyphs.Check}" FontFamily="{StaticResource F.Icons}" FontSize="11" Foreground="{StaticResource B.Text2}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{x:Static ui:Glyphs.Lock}" FontFamily="{StaticResource F.Icons}" FontSize="15" Foreground="{StaticResource B.Text3}"
                                   ToolTip="{loc:T Недоступно на этом ПК}"
                                   Visibility="{Binding Mark, Converter={StaticResource EqualsToVis}, ConverterParameter=Locked}" />
                    </Grid>

                    <!-- What / when / risk -->
                    <StackPanel Grid.Column="1" Margin="0,0,20,0">
                        <TextBlock Text="{Binding Title, Converter={StaticResource Sentence}}" Style="{StaticResource T.H3}" FontSize="15.5" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SystemName}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text3}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SystemName}" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource T.Body}" FontSize="12.5" Margin="0,9,0,0" />
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{loc:T УСЛОВИЕ}" Style="{StaticResource Key}" />
                            <TextBlock Grid.Column="1" Text="{Binding Condition}" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text2}" />
                            <TextBlock Grid.Row="1" Text="{loc:T РИСК}" Style="{StaticResource Key}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Impact}" Style="{StaticResource T.Caption}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="2" Text="{loc:T ПРИЧИНА}" Style="{StaticResource Key}" Margin="0,6,0,0" Foreground="{StaticResource B.Text}"
                                       Visibility="{Binding BlockReason, Converter={StaticResource NullToVis}}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BlockReason}" Style="{StaticResource T.Caption}" Margin="0,6,0,0"
                                       Foreground="{StaticResource B.Text}" Visibility="{Binding BlockReason, Converter={StaticResource NullToVis}}" />
                            <TextBlock Grid.Row="3" Text="{loc:T ВЫИГРЫШ}" Style="{StaticResource Key}" Margin="0,6,0,0"
                                       Visibility="{Binding IsAlreadyManual, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource T.Caption}" Margin="0,6,0,0"
                                       Text="{loc:T Почти нулевой: служба уже запускается только по требованию.}"
                                       Visibility="{Binding IsAlreadyManual, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                        <WrapPanel Margin="0,9,0,0">
                            <Border Style="{StaticResource Tag.Solid}" Margin="0,0,6,0" Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:T РЕКОМЕНДОВАНО}" />
                            </Border>
                            <Border Style="{StaticResource Tag}" Margin="0,0,6,0" Visibility="{Binding Risk, Converter={StaticResource EqualsToVis}, ConverterParameter=Safe}">
                                <TextBlock Text="{Binding RiskLabel}" />
                            </Border>
                            <Border Style="{StaticResource Tag.Muted}" Margin="0,0,6,0" Visibility="{Binding Risk, Converter={StaticResource EqualsToVis}, ConverterParameter=Optional}">
                                <TextBlock Text="{Binding RiskLabel}" />
                            </Border>
                            <Border Style="{StaticResource Tag.Hatch}" Margin="0,0,6,0" Visibility="{Binding Risk, Converter={StaticResource EqualsToVis}, ConverterParameter=Advanced}">
                                <TextBlock Text="{Binding RiskLabel}" />
                            </Border>
                            <Border Style="{StaticResource Tag.Muted}" Margin="0,0,6,0" Visibility="{Binding IsConditional, Converter={StaticResource BoolToVis}}"
                                    ToolTip="{loc:T 'Профили не отмечают этот пункт: отметьте его сами, если условие про вас.'}">
                                <TextBlock Text="{loc:T ПО УСЛОВИЮ}" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Now → target -->
                    <Grid Grid.Column="2" VerticalAlignment="Top" Margin="0,1,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{loc:T СЕЙЧАС}" Style="{StaticResource Key}" />
                        <TextBlock Grid.Column="1" Text="{Binding CurrentText}" Style="{StaticResource Val}" />
                        <TextBlock Grid.Row="1" Text="{loc:T СТАТУС}" Style="{StaticResource Key}" Margin="0,10,0,0" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Style="{StaticResource Dot}" />
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Val}" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="{loc:T ЦЕЛЬ}" Style="{StaticResource Key}" Margin="0,10,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TargetText}" Style="{StaticResource Val}" Foreground="{StaticResource B.Text}"
                                   FontWeight="Bold" Margin="0,8,0,0" />
                    </Grid>

                    <!-- State tag / revert -->
                    <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <StackPanel Visibility="{Binding Badge, Converter={StaticResource EqualsToVis}, ConverterParameter=Changed}" HorizontalAlignment="Right">
                            <Border Style="{StaticResource Tag.Solid}" HorizontalAlignment="Right">
                                <TextBlock Text="{loc:T ИЗМЕНЕНО Lycoris}" />
                            </Border>
                            <Button Style="{StaticResource RowButton}" Margin="0,10,0,0" HorizontalAlignment="Right"
                                    Command="{Binding DataContext.RevertServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Name}" ToolTip="{Binding ChangeText}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static ui:Glyphs.Undo}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="{loc:T ОТКАТИТЬ}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <ContentPresenter ContentTemplate="{StaticResource RowBadge}" Content="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ─────────────── Recommendation group ─────────────── -->
        <DataTemplate x:Key="RecGroup" DataType="{x:Type local:RecommendationGroup}">
            <StackPanel Margin="0,0,0,19">
                <Grid Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title, Converter={StaticResource Sentence}}" Style="{StaticResource T.H1}" FontSize="17" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding CountText}" Style="{StaticResource GroupCount}" />
                    <Rectangle Grid.Column="2" Height="1" Fill="{StaticResource B.Line2}" Margin="10,2,0,0" VerticalAlignment="Center" />
                </Grid>
                <Border Style="{StaticResource Callout}" Padding="0" Margin="0,0,0,9" ui:RoundClip.Content="True" Visibility="{Binding Note, Converter={StaticResource NullToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource B.Warning}" />
                        <TextBlock Grid.Column="1" Text="{x:Static ui:Glyphs.Warning}" FontFamily="{StaticResource F.Icons}" FontSize="14"
                                   Foreground="{StaticResource B.Text}" VerticalAlignment="Top" Margin="10,9,0,0" />
                        <TextBlock Grid.Column="2" Text="{Binding Note}" Style="{StaticResource T.Body}" FontSize="12.5" Foreground="{StaticResource B.Text}"
                                   Margin="9,10,11,11" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card.Flush}" ui:RoundClip.Content="True">
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource RecRow}" Margin="0,0,0,-1" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- ─────────────── Scheduled task row ─────────────── -->
        <DataTemplate x:Key="TaskRow" DataType="{x:Type local:TaskItem}">
            <Border Style="{StaticResource Row}" Padding="0,10,12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="236" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,1,0,0">
                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" ToolTip="{loc:T Отметить для отключения}"
                                  Visibility="{Binding Mark, Converter={StaticResource EqualsToVis}, ConverterParameter=Check}" />
                        <Border Width="18" Height="18" BorderBrush="{StaticResource B.Outline}" BorderThickness="1.5" CornerRadius="{StaticResource R.Xs}" ToolTip="{loc:T Уже отключена}"
                                Visibility="{Binding Mark, Converter={StaticResource EqualsToVis}, ConverterParameter=Done}">
                            <TextBlock Text="{x:Static ui:Glyphs.Check}" FontFamily="{StaticResource F.Icons}" FontSize="11" Foreground="{StaticResource B.Text2}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="0,0,20,0">
                        <TextBlock Text="{Binding Title, Converter={StaticResource Sentence}}" Style="{StaticResource T.H3}" FontSize="15.5" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Path}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text3}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource T.Body}" FontSize="12.5" Margin="0,9,0,0" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:T РИСК}" Style="{StaticResource Key}" />
                            <TextBlock Grid.Column="1" Text="{Binding Impact}" Style="{StaticResource T.Caption}" />
                        </Grid>
                        <WrapPanel Margin="0,9,0,0">
                            <Border Style="{StaticResource Tag.Solid}" Margin="0,0,6,0" Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:T РЕКОМЕНДОВАНО}" />
                            </Border>
                            <Border Style="{StaticResource Tag}" Margin="0,0,6,0" Visibility="{Binding Risk, Converter={StaticResource EqualsToVis}, ConverterParameter=Safe}">
                                <TextBlock Text="{Binding RiskLabel}" />
                            </Border>
                            <Border Style="{StaticResource Tag.Muted}" Margin="0,0,6,0" Visibility="{Binding Risk, Converter={StaticResource EqualsToVis}, ConverterParameter=Optional}">
                                <TextBlock Text="{Binding RiskLabel}" />
                            </Border>
                            <Border Style="{StaticResource Tag.Muted}" Margin="0,0,6,0" Visibility="{Binding IsConditional, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:T ПО УСЛОВИЮ}" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <Grid Grid.Column="2" VerticalAlignment="Top" Margin="0,1,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{loc:T СЕЙЧАС}" Style="{StaticResource Key}" />
                        <TextBlock Grid.Column="1" Text="{Binding StateText}" Style="{StaticResource Val}" />
                        <TextBlock Grid.Row="1" Text="{loc:T ЦЕЛЬ}" Style="{StaticResource Key}" Margin="0,10,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{loc:T Отключена}" Style="{StaticResource Val}" Foreground="{StaticResource B.Text}"
                                   FontWeight="Bold" Margin="0,8,0,0" />
                    </Grid>

                    <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <StackPanel Visibility="{Binding Badge, Converter={StaticResource EqualsToVis}, ConverterParameter=Changed}" HorizontalAlignment="Right">
                            <Border Style="{StaticResource Tag.Solid}" HorizontalAlignment="Right">
                                <TextBlock Text="{loc:T ИЗМЕНЕНО Lycoris}" />
                            </Border>
                            <Button Style="{StaticResource RowButton}" Margin="0,10,0,0" HorizontalAlignment="Right"
                                    Command="{Binding DataContext.RevertTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Path}" ToolTip="{Binding ChangeText}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static ui:Glyphs.Undo}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="{loc:T ОТКАТИТЬ}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <ContentPresenter ContentTemplate="{StaticResource RowBadge}" Content="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ─────────────── Service list row ─────────────── -->
        <DataTemplate x:Key="SvcRow" DataType="{x:Type local:ServiceItem}">
            <Grid Height="54">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="26" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static ui:Glyphs.Lock}" FontFamily="{StaticResource F.Icons}" FontSize="13" Foreground="{StaticResource B.Text3}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{loc:T Защищено: Lycoris не меняет эту службу}"
                           Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding DisplayName}" FontFamily="{StaticResource F.Body}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource B.Text}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text3}" TextTrimming="CharacterEllipsis" />
                        <Border Style="{StaticResource Tag.Muted}" Margin="8,0,0,0" Visibility="{Binding IsThirdParty, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:T СТОРОННЯЯ}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Dot}" />
                    <TextBlock Text="{Binding StatusText}" FontFamily="{StaticResource F.Body}" FontSize="12" Foreground="{StaticResource B.Text2}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,9,0">
                    <TextBlock Text="{Binding StartText}" FontFamily="{StaticResource F.Body}" FontSize="12" Foreground="{StaticResource B.Text2}"
                               TextTrimming="CharacterEllipsis" MaxWidth="120" />
                    <Border Style="{StaticResource Tag.Solid}" Margin="8,0,0,0" ToolTip="{Binding ChangeText}"
                            Visibility="{Binding IsChanged, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:T ИЗМЕНЕНО Lycoris}" />
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="4" Text="{x:Static ui:Glyphs.ChevronRight}" FontFamily="{StaticResource F.Icons}" FontSize="12" Foreground="{StaticResource B.Text3}"
                           VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- ─────────────── The one profile picker: filters-style chips (recommendations + Microsoft tasks) ─────────────── -->
        <DataTemplate x:Key="ProfileChips">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding ProfileDescription}">
                <TextBlock Text="{loc:T ПРОФИЛЬ}" Style="{StaticResource T.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <RadioButton Style="{StaticResource Chip}" Content="{loc:T ОБЫЧНЫЙ}"
                             IsChecked="{Binding SelectedProfile, Converter={StaticResource Equals}, ConverterParameter=Normal, Mode=TwoWay}" />
                <RadioButton Style="{StaticResource Chip}" Content="{loc:T РЕКОМЕНДУЕМЫЙ}"
                             IsChecked="{Binding SelectedProfile, Converter={StaticResource Equals}, ConverterParameter=Recommended, Mode=TwoWay}" />
                <RadioButton Style="{StaticResource Chip}" Content="{loc:T ИГРОВОЙ}"
                             IsChecked="{Binding SelectedProfile, Converter={StaticResource Equals}, ConverterParameter=Gaming, Mode=TwoWay}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: проверено · ОБНОВИТЬ · the ONE main button («ОТКЛЮЧИТЬ ЛИШНЕЕ · N» on АВТОЗАПУСК) -->
        <c:PageHeader Title="{Binding Title}" Subtitle="{Binding Subtitle}" Checked="{Binding CheckedText}" RefreshCommand="{Binding RefreshCommand}">
            <c:PageHeader.Primary>
                <Button Style="{StaticResource Btn.Primary}" Command="{Binding DisableExtraStartupCommand}"
                        Visibility="{Binding HasPrimary, Converter={StaticResource BoolToVis}}"
                        ToolTip="{loc:T 'Отключит записи, которые Windows отметила как замедляющие загрузку, и записи с удалёнными файлами. Перед отключением — подтверждение со списком.'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static ui:Glyphs.Power}" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding PrimaryText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </c:PageHeader.Primary>
        </c:PageHeader>

        <!-- Organization-managed PC: the only place this is explained -->
        <Border Grid.Row="1" Style="{StaticResource Callout}" Padding="0" Margin="0,11,0,0" ui:RoundClip.Content="True" Visibility="{Binding IsManaged, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource B.HatchStrong}" />
                <TextBlock Grid.Column="1" Text="{x:Static ui:Glyphs.Shield}" FontFamily="{StaticResource F.Icons}" FontSize="16"
                           Foreground="{StaticResource B.Text}" VerticalAlignment="Center" Margin="11,0,0,0" />
                <StackPanel Grid.Column="2" Margin="10,11,11,9">
                    <TextBlock Text="{loc:T ПК управляется организацией}" Style="{StaticResource T.H3}" FontStretch="SemiCondensed" />
                    <TextBlock Text="{Binding ManagedText}" Style="{StaticResource T.Body}" FontSize="12.5" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Margin="0,11,0,0" SelectedIndex="{Binding SelectedTab}">
            <!-- ═══════════════ АВТОЗАПУСК: programs + third-party logon tasks (hosted Startup page) ═══════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:T АВТОЗАПУСК}" />
                        <Border Style="{StaticResource TabBadge}"><TextBlock Text="{Binding StartupTabCount}" /></Border>
                    </StackPanel>
                </TabItem.Header>
                <start:StartupView DataContext="{Binding Startup}" />
            </TabItem>

            <!-- ═══════════════ СЛУЖБЫ (recommendations) ═══════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:T СЛУЖБЫ}" />
                        <Border Style="{StaticResource TabBadge}"><TextBlock Text="{Binding RecommendationCount}" /></Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter ContentTemplate="{StaticResource ProfileChips}" Content="{Binding}" VerticalAlignment="Center" ToolTip="{Binding ProfileTooltip}" Visibility="{Binding ShowProfilePicker, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource T.Caption}" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap">
                            <Run Text="{loc:T К изменению}" /> <Run Text="{Binding ToChangeCount, Mode=OneWay}" Foreground="{StaticResource B.Text}" /><Run Text="{loc:T ' · применено'}" />
                            <Run Text="{Binding OptimalCount, Mode=OneWay}" Foreground="{StaticResource B.Text}" /><Run Text="{loc:T ' · изменено Lycoris'}" />
                            <Run Text="{Binding ChangedCount, Mode=OneWay}" Foreground="{StaticResource B.Text}" /><Run Text=". " /><Run
                                 Text="{Binding ProfileCaption, Mode=OneWay}" /><Run Text="{loc:T ' Отключение служб не прибавляет FPS: выигрыш — память и меньше фоновой активности. Работающие службы не останавливаются.'}" />
                        </TextBlock>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,10">
                            <ItemsControl ItemsSource="{Binding RecommendationGroups}" ItemTemplate="{StaticResource RecGroup}" />

                            <TextBlock Text="{Binding MissingServicesText}" Style="{StaticResource T.Caption}" Margin="0,11,0,0"
                                       Visibility="{Binding MissingServicesText, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <c:StickyBar Grid.Row="2" Margin="0,8,0,0" Count="{Binding SelectedRecommendationCount}"
                                 Text="{loc:T Изменится только тип запуска. Перед применением Lycoris покажет точный список «сейчас → станет».}">
                        <c:StickyBar.Actions>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Btn.Ghost}" Margin="0,0,8,0" Command="{Binding ClearRecommendationSelectionCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static ui:Glyphs.Cancel}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <TextBlock Text="{loc:T СНЯТЬ ВЫБОР}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Btn.Hero}" Command="{Binding ApplyRecommendationsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static ui:Glyphs.Check}" FontFamily="{StaticResource F.Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{loc:T ПРИМЕНИТЬ ВЫБРАННОЕ}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </c:StickyBar.Actions>
                    </c:StickyBar>
                </Grid>
            </TabItem>

            <!-- ═══════════════ ВСЕ СЛУЖБЫ ═══════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:T ВСЕ СЛУЖБЫ}" />
                        <Border Style="{StaticResource TabBadge}"><TextBlock Text="{Binding CountAll}" /></Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Center">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="{loc:T 'Поиск: имя, описание, файл…'}" Padding="10,0,24,0" />
                            <TextBlock Text="{x:Static ui:Glyphs.Search}" FontFamily="{StaticResource F.Icons}" FontSize="13" Foreground="{StaticResource B.Text3}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" IsHitTestVisible="False" />
                        </Grid>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                            <RadioButton Style="{StaticResource Chip}" GroupName="SvcFilter"
                                         IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=All}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:T ВСЕ}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource TabBadge}"><TextBlock Text="{Binding CountAll}" /></Border>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Chip}" GroupName="SvcFilter"
                                         IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Running}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:T ЗАПУЩЕННЫЕ}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource TabBadge}"><TextBlock Text="{Binding CountRunning}" /></Border>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Chip}" GroupName="SvcFilter"
                                         IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Automatic}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:T АВТОМАТИЧЕСКИЕ}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource TabBadge}"><TextBlock Text="{Binding CountAutomatic}" /></Border>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Chip}" GroupName="SvcFilter"
                                         IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Disabled}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:T ОТКЛЮЧЁННЫЕ}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource TabBadge}"><TextBlock Text="{Binding CountDisabled}" /></Border>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Chip}" GroupName="SvcFilter"
                                         IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=ThirdParty}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:T СТОРОННИЕ}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource TabBadge}"><TextBlock Text="{Binding CountThirdParty}" /></Border>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <!-- Expert mode: a labelled switch; turning it on asks first -->
                        <CheckBox Grid.Column="2" Style="{StaticResource Toggle}" VerticalAlignment="Center" IsChecked="{Binding ServicesExpertMode}"
                                  ToolTip="{loc:T 'Разрешает менять службы, которых нет в проверенном списке Lycoris: другие службы Windows и службы сторонних программ. Критичные службы, драйверы и защищённые службы заблокированы всегда. Включение — после предупреждения.'}">
                            <TextBlock Text="{loc:T ЭКСПЕРТНЫЙ РЕЖИМ}" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Text}" />
                        </CheckBox>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="400" />
                        </Grid.ColumnDefinitions>

                        <!-- List -->
                        <Border Style="{StaticResource Card.Flush}" ui:RoundClip.Content="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="{StaticResource B.Surface2}" BorderBrush="{StaticResource B.Line2}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="250" />
                                            <ColumnDefinition Width="26" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" Text="{loc:T СЛУЖБА (НАЖМИТЕ — ОТКРОЕТСЯ СПРАВА)}" Style="{StaticResource T.Label}" />
                                        <TextBlock Grid.Column="2" Text="{loc:T СОСТОЯНИЕ}" Style="{StaticResource T.Label}" />
                                        <TextBlock Grid.Column="3" Text="{loc:T ТИП ЗАПУСКА}" Style="{StaticResource T.Label}" />
                                    </Grid>
                                </Border>
                                <ListBox x:Name="ServiceList" Grid.Row="1" Style="{StaticResource List.Plain}" ItemContainerStyle="{StaticResource SvcItem}"
                                         ItemsSource="{Binding ServicesView}" SelectedItem="{Binding SelectedService}" ItemTemplate="{StaticResource SvcRow}"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding ShownCount, Converter={StaticResource NullToVis}, ConverterParameter=invert}">
                                    <TextBlock Text="{x:Static ui:Glyphs.Search}" FontFamily="{StaticResource F.Icons}" FontSize="17" Foreground="{StaticResource B.Text3}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
                                                <Setter Property="Text" Value="{loc:T НИЧЕГО НЕ НАЙДЕНО}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsServicesLoading}" Value="True">
                                                        <Setter Property="Text" Value="{loc:T ЧТЕНИЕ СЛУЖБ…}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Inspector -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" ui:RoundClip.Content="True">
                            <Grid>
                                <Grid Visibility="{Binding SelectedService, Converter={StaticResource NullToVis}, ConverterParameter=invert}">
                                    <Border Background="{StaticResource B.DotGrid}" />
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{x:Static ui:Glyphs.Services}" FontFamily="{StaticResource F.Icons}" FontSize="21" Foreground="{StaticResource B.Text3}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{loc:T ВЫБЕРИТЕ СЛУЖБУ В СПИСКЕ}" Style="{StaticResource T.Label}" Margin="0,9,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Visibility="{Binding SelectedService, Converter={StaticResource NullToVis}}">
                                    <StackPanel Margin="15,14,14,15" DataContext="{Binding SelectedService}">
                                        <Border Style="{StaticResource Callout}" Padding="0" Margin="0,0,0,11" ui:RoundClip.Content="True" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{StaticResource B.HatchStrong}" />
                                                <StackPanel Grid.Column="1" Margin="10,11,10,9">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{x:Static ui:Glyphs.Lock}" FontFamily="{StaticResource F.Icons}" FontSize="12" Foreground="{StaticResource B.Text}"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBlock Text="{loc:T НЕПРИМЕНИМО · СЛУЖБА ЗАЩИЩЕНА}" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Text}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding LockReason}" Style="{StaticResource T.Body}" FontSize="12.5" Margin="0,6,0,0" />
                                                    <Button Style="{StaticResource Btn.Link}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                            Command="{Binding DataContext.OpenOptimizeTweakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding OptimizeTweakId}"
                                                            Visibility="{Binding IsOptimizeOwned, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{loc:T ОТКРЫТЬ В ОПТИМИЗАЦИИ}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{x:Static ui:Glyphs.OpenExternal}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="7,0,0,0" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="{loc:T СЛУЖБА}" Style="{StaticResource T.Label}" />
                                        <TextBlock Text="{Binding DisplayName, Converter={StaticResource Sentence}}" Style="{StaticResource T.H1}" FontSize="17" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text3}" Margin="0,5,0,0"
                                                   TextWrapping="Wrap" Visibility="{Binding DataContext.ExpertMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
                                        <WrapPanel Margin="0,9,0,0">
                                            <Border Style="{StaticResource Tag}" Margin="0,0,6,6" Visibility="{Binding IsThirdParty, Converter={StaticResource InverseBoolToVis}}">
                                                <TextBlock Text="WINDOWS" />
                                            </Border>
                                            <Border Style="{StaticResource Tag.Solid}" Margin="0,0,6,6" Visibility="{Binding IsThirdParty, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{loc:T СТОРОННЯЯ}" />
                                            </Border>
                                            <Border Style="{StaticResource Tag.Muted}" Margin="0,0,6,6" Visibility="{Binding IsPerUser, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding TemplateName, StringFormat={loc:T 'ПОЛЬЗОВАТЕЛЬСКАЯ · {0}'}}" />
                                            </Border>
                                            <Border Style="{StaticResource Tag.Muted}" Margin="0,0,6,6" Visibility="{Binding HasTriggers, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="{loc:T 'Windows запускает службу сама при нужном событии (устройство, сеть, вызов)'}">
                                                <TextBlock Text="{loc:T ЗАПУСК ПО ТРИГГЕРУ}" />
                                            </Border>
                                            <Border Style="{StaticResource Tag}" Margin="0,0,6,6" Visibility="{Binding IsCurated, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{loc:T В РЕКОМЕНДАЦИЯХ}" />
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource T.Body}" FontSize="12.5" Margin="0,8,0,0" />

                                        <Rectangle Style="{StaticResource Divider}" Margin="0,11" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{loc:T СОСТОЯНИЕ}" Style="{StaticResource Key}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Border Style="{StaticResource Dot}" />
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Val}" Foreground="{StaticResource B.Text}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="{loc:T ТИП ЗАПУСКА}" Style="{StaticResource Key}" Margin="0,9,0,0" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StartText}" Style="{StaticResource Val}" Foreground="{StaticResource B.Text}" Margin="0,10,0,0" />
                                            <TextBlock Grid.Row="2" Text="{loc:T УЧЁТНАЯ ЗАПИСЬ}" Style="{StaticResource Key}" Margin="0,9,0,0" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Account}" Style="{StaticResource Val}" Margin="0,10,0,0" />
                                            <TextBlock Grid.Row="3" Text="{loc:T ИЗДАТЕЛЬ}" Style="{StaticResource Key}" Margin="0,9,0,0" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Publisher}" Style="{StaticResource Val}" Margin="0,10,0,0" />
                                            <TextBlock Grid.Row="4" Text="{loc:T ФАЙЛ}" Style="{StaticResource Key}" Margin="0,9,0,0" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Binary}" Style="{StaticResource T.Mono}" TextWrapping="Wrap"
                                                       Margin="0,11,0,0" />
                                        </Grid>

                                        <!-- Actions (hidden for locked services — the callout above says why) -->
                                        <StackPanel Visibility="{Binding IsLocked, Converter={StaticResource InverseBoolToVis}}">
                                            <Rectangle Style="{StaticResource Divider}" Margin="0,11" />
                                            <TextBlock Text="{loc:T ТИП ЗАПУСКА}" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Text}" />
                                            <ComboBox Margin="0,10,0,0" ItemsSource="{Binding StartOptions}" SelectedItem="{Binding PendingStart}"
                                                      DisplayMemberPath="Label" IsEnabled="{Binding CanModify}" ToolTipService.ShowOnDisabled="True">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox" BasedOn="{StaticResource StartCombo}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MustStayDisabled}" Value="True">
                                                                <Setter Property="ToolTip" Value="{loc:T Эту службу можно только оставить отключённой — Lycoris её не включает.}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                            </ComboBox>
                                            <TextBlock Style="{StaticResource T.Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                       Text="{loc:T Эту службу можно только оставить отключённой — Lycoris её не включает.}"
                                                       Visibility="{Binding MustStayDisabled, Converter={StaticResource BoolToVis}}" />
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Command="{Binding DataContext.ResetStartTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        ToolTip="{loc:T Вернуть текущее значение}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{x:Static ui:Glyphs.Cancel}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                        <TextBlock Text="{loc:T СБРОСИТЬ}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="2" Style="{StaticResource Btn.Primary}" Content="{loc:T ПРИМЕНИТЬ ТИП ЗАПУСКА}"
                                                        Command="{Binding DataContext.ApplyStartTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        ToolTip="{loc:T 'Записывается в журнал, перед изменением создаётся точка восстановления. Служба не останавливается — новый тип сработает при следующем старте Windows.'}" />
                                            </Grid>
                                            <TextBlock Style="{StaticResource T.Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                       Text="{loc:T Служба не останавливается — новый тип сработает при следующем старте Windows. Откат — в этой карточке или в «Восстановлении».}" />

                                            <TextBlock Text="{loc:T СЕЙЧАС}" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Text}" Margin="0,14,0,0" />
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Command="{Binding DataContext.StartServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        ToolTip="{loc:T Запуск действует до перезагрузки и не записывается в журнал изменений.}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{x:Static ui:Glyphs.Play}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBlock Text="{loc:T ЗАПУСТИТЬ}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="2" Style="{StaticResource Btn.Danger}"
                                                        Command="{Binding DataContext.StopServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        ToolTip="{loc:T Остановка действует до перезагрузки и не записывается в журнал изменений. Службы с работающими зависимыми Lycoris не останавливает.}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{x:Static ui:Glyphs.Stop}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBlock Text="{loc:T ОСТАНОВИТЬ}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <TextBlock Style="{StaticResource T.Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                       Text="{loc:T Запуск и остановка действуют до перезагрузки и не записываются в журнал. Службы с работающими зависимыми не останавливаются.}" />
                                        </StackPanel>

                                        <!-- Journal -->
                                        <Border Style="{StaticResource Callout}" Margin="0,12,0,0" Padding="10,10" Visibility="{Binding IsChanged, Converter={StaticResource BoolToVis}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,9,0">
                                                    <TextBlock Text="{loc:T ИЗМЕНЕНО Lycoris}" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Text}" />
                                                    <TextBlock Text="{Binding ChangeText}" Style="{StaticResource T.Body}" FontSize="12" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource RowButton}" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.RevertServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Name}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{x:Static ui:Glyphs.Undo}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                        <TextBlock Text="{loc:T ОТКАТИТЬ}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═══════════════ ЗАДАЧИ: Microsoft data-collection tasks (third-party logon tasks are on АВТОЗАПУСК) ═══════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:T ЗАДАЧИ}" />
                        <Border Style="{StaticResource TabBadge}"><TextBlock Text="{Binding AllTaskCount}" /></Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter ContentTemplate="{StaticResource ProfileChips}" Content="{Binding}" VerticalAlignment="Center" ToolTip="{Binding ProfileTooltip}" Visibility="{Binding ShowProfilePicker, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource T.Caption}" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap">
                            <Run Text="{Binding TaskEnabledCount, Mode=OneWay}" Foreground="{StaticResource B.Text}" /><Run Text="{loc:T ' включено · '}" /><Run Text="{Binding TaskDisabledCount, Mode=OneWay}" Foreground="{StaticResource B.Text}" /><Run Text="{loc:T ' отключено. Собирают данные для Microsoft: программа улучшения качества (CEIP), опросы «Центра отзывов», диагностика дисков. Задачи только отключаются, не удаляются.'}" />
                        </TextBlock>
                    </Grid>
                    <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,10">
                            <Border Style="{StaticResource Card.Flush}" ui:RoundClip.Content="True">
                                <ItemsControl ItemsSource="{Binding TaskItems}" ItemTemplate="{StaticResource TaskRow}" Margin="0,0,0,-1" />
                            </Border>
                            <TextBlock Text="{Binding MissingTasksText}" Style="{StaticResource T.Caption}" Margin="0,9,0,0"
                                       Visibility="{Binding MissingTasksText, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <c:StickyBar Grid.Row="2" Margin="0,8,0,0" Count="{Binding SelectedTaskCount}"
                                 Text="{loc:T Крупные обновления Windows иногда включают задачи заново — просто отключите их снова.}">
                        <c:StickyBar.Actions>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Btn.Ghost}" Margin="0,0,8,0" Command="{Binding ClearTaskSelectionCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static ui:Glyphs.Cancel}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <TextBlock Text="{loc:T СНЯТЬ ВЫБОР}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Btn.Hero}" Command="{Binding ApplyTasksCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static ui:Glyphs.Check}" FontFamily="{StaticResource F.Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{loc:T ОТКЛЮЧИТЬ ВЫБРАННЫЕ}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </c:StickyBar.Actions>
                    </c:StickyBar>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
