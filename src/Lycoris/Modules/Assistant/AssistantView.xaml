<UserControl x:Class="Lycoris.Modules.Assistant.AssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Lycoris.UI.Controls"
             xmlns:ui="clr-namespace:Lycoris.UI"
             xmlns:loc="clr-namespace:Lycoris.UI"
             xmlns:shell="clr-namespace:Lycoris.Shell"
             xmlns:local="clr-namespace:Lycoris.Modules.Assistant"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:AssistantViewModel}">
    <!-- Chat and diagnostics share a bounded viewport. -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <c:PageHeader Title="{Binding Title}" Subtitle="{Binding Subtitle}" />

        <Border Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource Card}" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DiagnosticSummary}" Style="{StaticResource T.BodyStrong}" TextWrapping="Wrap" />
                    <TextBlock Text="{loc:T 'Проверка без интернета. Выберите проблему и следующий шаг.'}" Style="{StaticResource T.Caption}"
                               Foreground="{StaticResource B.Text2}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding DiagnosticsTimestamp}" Style="{StaticResource T.Caption}" Margin="0,4,0,0"
                               Visibility="{Binding DiagnosticsTimestamp, Converter={StaticResource NullToVis}}" />
                    <TextBlock Text="{Binding DiagnosticStatus}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                               AutomationProperties.LiveSetting="Polite" Visibility="{Binding DiagnosticStatus, Converter={StaticResource NullToVis}}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource Btn.Primary}" Command="{Binding RefreshDiagnosticsCommand}"
                        IsEnabled="{Binding IsDiagnosticBusy, Converter={StaticResource InverseBool}}" VerticalAlignment="Center"
                        ToolTip="{loc:T 'Заново проверить компьютер без изменения настроек'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static ui:Glyphs.Diagnostic}" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:T 'Проверить компьютер'}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,42"
                          Visibility="{Binding IsExpanded, ElementName=ChatExpander, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{loc:T 'Что делать дальше'}" Style="{StaticResource T.BodyStrong}" Margin="0,0,0,8"
                               AutomationProperties.HeadingLevel="Level2" />
                    <ItemsControl ItemsSource="{Binding DiagnosticCards}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <WrapPanel Margin="0,0,0,6">
                                            <TextBlock x:Name="SeverityIcon" Text="{x:Static ui:Glyphs.Info}" FontFamily="{StaticResource F.Icons}"
                                                       FontSize="13" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding SeverityLabel}" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding Title, Converter={StaticResource Sentence}}" Style="{StaticResource T.BodyStrong}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Body}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding NextStep}" Style="{StaticResource T.Body}" TextWrapping="Wrap" Margin="0,7,0,0" />
                                        <TextBlock Text="{Binding PathText}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,7,0,0"
                                                   Visibility="{Binding PathText, Converter={StaticResource NullToVis}}" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <StackPanel Margin="0,0,14,0" Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}">
                                                <Button Style="{StaticResource Btn.Link}" HorizontalAlignment="Left"
                                                        Command="{Binding DataContext.OpenDiagnosticCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                        ToolTip="{loc:T 'Открыть раздел — без изменения настроек'}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{x:Static ui:Glyphs.Folder}" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                        <TextBlock Text="{Binding OpenLabel}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <TextBlock Text="{loc:T 'Открыть раздел — без изменений'}" Style="{StaticResource T.Caption}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding CanFix, Converter={StaticResource BoolToVis}}">
                                                <Button Style="{StaticResource Btn}" HorizontalAlignment="Left"
                                                        Command="{Binding DataContext.FixDiagnosticCommand, ElementName=Root}" CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{x:Static ui:Glyphs.Repair}" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                        <TextBlock Text="{Binding FixLabel}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <TextBlock Text="{loc:T 'Исправление — с подтверждением'}" Style="{StaticResource T.Caption}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                        <Setter TargetName="SeverityIcon" Property="Text" Value="{x:Static ui:Glyphs.Warning}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Expander x:Name="ChatExpander" IsExpanded="{Binding IsChatOpen, Mode=TwoWay}">
                <Expander.Style>
                    <Style TargetType="Expander">
                        <Setter Property="VerticalAlignment" Value="Bottom" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Expander">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <ToggleButton x:Name="ChatToggle" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                      HorizontalAlignment="Left" Cursor="Hand" FocusVisualStyle="{StaticResource FocusVisual.Mono}"
                                                      AutomationProperties.Name="{loc:T 'Чат и команды служб'}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="Plate" Background="Transparent" BorderBrush="{StaticResource B.Outline}" BorderThickness="1"
                                                            CornerRadius="{StaticResource R.Md}" Height="30" Padding="12,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Static ui:Glyphs.Assistant}" FontFamily="{StaticResource F.Icons}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                            <TextBlock x:Name="ChatLabel" Text="{loc:T 'Открыть чат'}" Style="{StaticResource T.BodyStrong}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{x:Static ui:Glyphs.ChevronDown}" FontFamily="{StaticResource F.Icons}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Background" Value="{StaticResource B.Surface3}" /></Trigger>
                                                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="ChatLabel" Property="Text" Value="{loc:T 'Показать результаты диагностики'}" /></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <ContentPresenter x:Name="ChatBody" Grid.Row="1" Visibility="Collapsed" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ChatBody" Property="Visibility" Value="Visible" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter Property="VerticalAlignment" Value="Stretch" /></Trigger>
                        </Style.Triggers>
                    </Style>
                </Expander.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
        <Border Grid.Row="0" Margin="0,10,0,0" Style="{StaticResource Card}" Padding="14,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border Style="{StaticResource Tag.Ok}" Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding StateTag}" />
                    </Border>
                    <Border Style="{StaticResource Tag.Warn}" Visibility="{Binding IsReady, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="{Binding StateTag}" />
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource T.BodyStrong}" Text="{loc:T 'Локальная модель'}" />
                    <TextBlock Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text2}" Text="{Binding StateText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource T.Caption}" Text="{loc:T Модель}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" MinWidth="170" IsEnabled="{Binding IsAnswering, Converter={StaticResource InverseBool}}"
                                  AutomationProperties.Name="{loc:T 'Локальная модель'}" />
                    </StackPanel>
                    <Button Style="{StaticResource Btn}" Command="{Binding InstallOllamaCommand}" Visibility="{Binding NeedsOllama, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static ui:Glyphs.Download}" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,9,0" />
                            <TextBlock Text="{loc:T УСТАНОВИТЬ OLLAMA}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn}" Command="{Binding CheckCommand}" Margin="8,0,0,0"
                            ToolTip="{loc:T 'Проверить подключение к Ollama и список моделей'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static ui:Glyphs.Refresh}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="{loc:T 'Проверить модель'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ItemsControl Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding QuickQuestions}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource Btn}" Margin="0,0,8,6" Content="{Binding}"
                            Command="{Binding DataContext.AskCommand, ElementName=Root}" CommandParameter="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="2" Margin="0,4,0,0" Style="{StaticResource Card.Flush}">
            <Grid>
                <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" Padding="14,12">
                    <ItemsControl x:Name="Conversation" ItemsSource="{Binding Messages}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:AssistantMessage}">
                                <Border x:Name="Bubble" Margin="0,0,0,10" Padding="13,10" CornerRadius="{StaticResource R.Lg}" BorderThickness="1"
                                        Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Line2}" HorizontalAlignment="Left" MaxWidth="760">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Style="{StaticResource T.Label}" Text="{Binding Author}" Foreground="{StaticResource B.Text3}" />
                                            <TextBlock Style="{StaticResource T.Label}" Text="{loc:T ' · ПЕЧАТАЕТ…'}" Foreground="{StaticResource B.Text3}"
                                                       Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource T.Body}" Text="{Binding Text}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource T.Caption}" Text="{Binding Note}" TextWrapping="Wrap" Margin="0,5,0,0"
                                                   Visibility="{Binding Note, Converter={StaticResource NullToVis}}" />
                                        <ItemsControl ItemsSource="{Binding Actions}" Focusable="False" Margin="0,4,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type shell:PaletteEntry}">
                                                    <Button Style="{StaticResource Btn.Link}" Margin="0,6,8,0" ToolTip="{Binding Description}"
                                                            Command="{Binding DataContext.OpenPlaceCommand, ElementName=Root}" CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{loc:T 'ОТКРЫТЬ: '}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Title, Converter={StaticResource Upper}}" VerticalAlignment="Center" />
                                                            <TextBlock Text=" →" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                        <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="Bubble" Property="Background" Value="{StaticResource B.Surface3}" />
                                        <Setter TargetName="Bubble" Property="MaxWidth" Value="560" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <!-- Empty: what to ask and what the assistant sees -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" Visibility="{Binding HasMessages, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Style="{StaticResource T.BodyStrong}" HorizontalAlignment="Center" TextAlignment="Center" Text="{loc:T 'Спросите о своём ПК'}" />
                    <TextBlock Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text2}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="{loc:T 'Помощник видит результаты проверок Lycoris и сводку о железе — без имени пользователя, паролей и файлов. Под ответом — кнопки, которые открывают нужное место.'}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="0,10,0,0" Style="{StaticResource Card}" Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.ColumnSpan="2" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text2}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="{loc:T '«Включи службу Spooler» разрешает запуск, «запусти службу Spooler» запускает её. Модель для этих команд не нужна.'}" />
                <TextBox Grid.Row="1" x:Name="Input" Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" Tag="{loc:T 'Вопрос или команда'}" VerticalContentAlignment="Center" MinHeight="30" MaxLength="1000"
                         AutomationProperties.Name="{loc:T 'Вопрос или команда'}" ToolTip="{loc:T 'Enter — спросить'}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AskCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Style="{StaticResource Btn}" Command="{Binding ClearCommand}" Margin="0,0,8,0" Height="30">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static ui:Glyphs.Delete}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="{loc:T 'Очистить чат'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn}" Command="{Binding StopCommand}" Margin="0,0,8,0" Height="30"
                            Visibility="{Binding IsAnswering, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static ui:Glyphs.Stop}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="{loc:T Остановить}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn}" Command="{Binding AskCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static ui:Glyphs.Assistant}" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,9,0" />
                            <TextBlock Text="{loc:T Спросить}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
                </Grid>
            </Expander>
        </Grid>
    </Grid>
</UserControl>
