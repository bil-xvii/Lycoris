<UserControl x:Class="Lycoris.Modules.Tools.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Lycoris.UI.Controls"
             xmlns:ui="clr-namespace:Lycoris.UI" xmlns:loc="clr-namespace:Lycoris.UI"
             xmlns:local="clr-namespace:Lycoris.Modules.Tools"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:ToolsViewModel}">
    <UserControl.Resources>

        <!-- Quick link: an outlined tile that opens a standard Windows tool (the ↗ mark says it leaves Lycoris) -->
        <Style x:Key="QuickTile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Mono}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Outline}" BorderThickness="1"
                                CornerRadius="{StaticResource R.Md}" Padding="10,8,9,8" MinHeight="30" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Ic" Text="{Binding Glyph}" Style="{StaticResource T.Icon}" FontSize="15" HorizontalAlignment="Left"
                                           VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{StaticResource B.Text2}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title, Converter={StaticResource Sentence}}" FontFamily="{StaticResource F.Display}" FontWeight="SemiBold" FontStretch="SemiCondensed"
                                               FontSize="13" Foreground="{StaticResource B.Text}" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Command}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text3}"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="Ext" Grid.Column="2" Text="{x:Static ui:Glyphs.OpenExternal}" Style="{StaticResource T.Icon}" FontSize="12" VerticalAlignment="Top"
                                           Margin="0,3,0,0" Foreground="{StaticResource B.Text2}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Surface3}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Text2}" />
                                <Setter TargetName="Ext" Property="Foreground" Value="{StaticResource B.Text}" />
                                <Setter TargetName="Ic" Property="Foreground" Value="{StaticResource B.Text}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Surface4}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button on a tool card: outlined (the page's one white button is in the header); dangerous ones are hatched at rest.
             Read-only mode does not disable it: a click asks for rights and repeats the action after the relaunch. -->
        <DataTemplate x:Key="ActionTemplate" DataType="{x:Type local:ToolCardAction}">
            <Grid Margin="0,0,0,8">
                <Button Style="{StaticResource Btn}" Content="{Binding Label}" HorizontalAlignment="Stretch" ToolTip="{Binding Hint}"
                        Visibility="{Binding IsDanger, Converter={StaticResource InverseBoolToVis}}"
                        Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                <Button Style="{StaticResource Btn.Danger}" Content="{Binding Label}" HorizontalAlignment="Stretch" ToolTip="{Binding Hint}"
                        Visibility="{Binding IsDanger, Converter={StaticResource BoolToVis}}"
                        Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
            </Grid>
        </DataTemplate>

        <!-- Tool card -->
        <DataTemplate x:Key="ToolCardTemplate" DataType="{x:Type local:ToolCard}">
            <Border Style="{StaticResource Card}" Padding="14,12,14,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Width="40" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" BorderThickness="1" CornerRadius="{StaticResource R.Md}"
                            BorderBrush="{StaticResource B.Line3}" Background="{StaticResource B.Surface2}">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource T.Icon}" FontSize="18" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="8,0,16,0">
                        <TextBlock Text="{Binding Title, Converter={StaticResource Sentence}}" FontFamily="{StaticResource F.Display}" FontWeight="Bold" FontStretch="Condensed" FontSize="17"
                                   Foreground="{StaticResource B.Text}" TextWrapping="Wrap" />
                        <Expander Margin="0,4,0,0">
                            <Expander.Header>
                                <TextBlock Text="{loc:T ПОДРОБНЕЕ}" Style="{StaticResource T.Label}" />
                            </Expander.Header>
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="{loc:T КОМАНДА}" Style="{StaticResource T.Label}" />
                                <TextBlock Text="{Binding Command}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text2}"
                                           TextWrapping="Wrap" Margin="0,2,0,6" />
                                <TextBlock Text="{loc:T ОПИСАНИЕ}" Style="{StaticResource T.Label}" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource T.Body}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Expander>
                        <TextBlock Text="{Binding Note}" Style="{StaticResource T.Caption}" Margin="0,6,0,0" LineHeight="17" TextWrapping="Wrap"
                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                        <WrapPanel Margin="0,8,0,4">
                            <Border Style="{StaticResource Tag}" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE916;" FontFamily="{StaticResource F.Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,1,6,0" />
                                    <TextBlock Text="{Binding Duration}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tag.Muted}" Margin="0,0,6,6" Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:T 'НУЖНЫ ПРАВА АДМИНИСТРАТОРА'}" />
                            </Border>
                            <Border Style="{StaticResource Tag.Muted}" Margin="0,0,6,6" Visibility="{Binding NeedsReboot, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:T ПЕРЕЗАГРУЗКА}" />
                            </Border>
                            <Border Style="{StaticResource Tag.Hatch}" Margin="0,0,6,6" Visibility="{Binding IsDanger, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:T ОСТОРОЖНО}" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Actions}" ItemTemplate="{StaticResource ActionTemplate}" VerticalAlignment="Top" Focusable="False" />

                    <!-- Boot-time check status (chkdsk card): read from BootExecute, works without admin rights -->
                    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,4,0,6" Padding="10,10" Background="{StaticResource B.Surface2}"
                            CornerRadius="{StaticResource R.Md}"
                            Visibility="{Binding HasBootCheck, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{loc:T 'ПРОВЕРКА ПРИ ЗАГРУЗКЕ'}" Style="{StaticResource T.Label}" />
                            <TextBlock Text="{Binding DataContext.BootCheckText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text2}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Console line -->
        <DataTemplate x:Key="ConsoleLineTemplate" DataType="{x:Type local:ConsoleLine}">
            <Grid Margin="0,1,9,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Marker}" FontFamily="{StaticResource F.Mono}" FontSize="11.5" Foreground="{StaticResource B.Text3}" />
                <TextBlock x:Name="Tx" Grid.Column="1" Text="{Binding Text}" FontFamily="{StaticResource F.Mono}" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{StaticResource B.Text2}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCommand}" Value="True">
                    <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource B.Text}" />
                    <Setter TargetName="Tx" Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEmphasis}" Value="True">
                    <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource B.White}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Info">
                    <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource B.Text3}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ONE main button: DISM → SFC in one go (the cards below stay for single steps) -->
        <c:PageHeader Title="{Binding Title}" Subtitle="{Binding Subtitle}" Checked="{Binding CheckedText}" RefreshCommand="{Binding RefreshCommand}">
            <c:PageHeader.Primary>
                <Button Style="{StaticResource Btn.Primary}" Command="{Binding RepairWindowsCommand}"
                        ToolTip="{loc:T 'DISM восстановит хранилище компонентов, затем SFC проверит системные файлы. Перед запуском — подтверждение.'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static ui:Glyphs.Repair}" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:T 'ПРОВЕРИТЬ И ВОССТАНОВИТЬ WINDOWS'}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </c:PageHeader.Primary>
        </c:PageHeader>

        <DockPanel Grid.Row="1" Margin="0,16,0,0" LastChildFill="True">

            <!-- ═══════════════ Tool console: only while a tool runs (and until its result is closed) ═══════════════ -->
            <Border DockPanel.Dock="Right" Width="380" Margin="10,0,0,0" Style="{StaticResource Card.Flush}"
                    Visibility="{Binding ShowConsole, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Margin="12,10,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle Width="8" Height="8" VerticalAlignment="Center">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Fill" Value="{StaticResource B.Text3}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource B.White}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                            <TextBlock Text="{loc:T 'КОНСОЛЬ ИНСТРУМЕНТОВ'}" Style="{StaticResource T.Label}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid HorizontalAlignment="Right">
                            <Border Style="{StaticResource Tag.Muted}" Visibility="{Binding RunStateIsPlain, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding RunState, Converter={x:Static loc:LocConverter.Instance}}" />
                            </Border>
                            <Border Style="{StaticResource Tag.Solid}" Visibility="{Binding RunStateIsActive, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding RunState, Converter={x:Static loc:LocConverter.Instance}}" />
                            </Border>
                            <Border Style="{StaticResource Tag.Hatch}" Visibility="{Binding RunStateIsProblem, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding RunState, Converter={x:Static loc:LocConverter.Instance}}" />
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Current operation -->
                    <StackPanel Grid.Row="1" Margin="12,11,12,11">
                        <TextBlock Text="{Binding RunTitle, Converter={StaticResource Sentence}}" FontFamily="{StaticResource F.Display}" FontWeight="Bold" FontStretch="Condensed" FontSize="17"
                                   Foreground="{StaticResource B.Text}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding RunCommandText}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text3}"
                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                        <Grid Margin="0,10,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource T.Stat}" FontSize="30" />
                                <TextBlock Text="%" Style="{StaticResource T.StatUnit}" Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                <TextBlock Text="{loc:T ПРОШЛО}" Style="{StaticResource T.Label}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource T.Mono}" FontSize="14" Foreground="{StaticResource B.Text}"
                                           HorizontalAlignment="Right" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                        <Grid Height="8">
                            <c:Meter Value="{Binding Progress}" Segments="40" Height="8" />
                            <ProgressBar IsIndeterminate="True" Height="8" VerticalAlignment="Center">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsRunning}" Value="True" />
                                                    <Condition Binding="{Binding HasProgress}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                        </Grid>
                    </StackPanel>

                    <!-- Output -->
                    <Grid Grid.Row="2" Background="{StaticResource B.Base}" MinHeight="120">
                        <Rectangle Height="1" VerticalAlignment="Top" Fill="{StaticResource B.Line}" />
                        <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{StaticResource B.Line}" />
                        <ListBox x:Name="OutputList" Style="{StaticResource List.Plain}" ItemsSource="{Binding ConsoleLines}" Margin="10,10,6,10"
                                 ItemTemplate="{StaticResource ConsoleLineTemplate}" VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling" />
                    </Grid>

                    <!-- Result -->
                    <Grid Grid.Row="3" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle>
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Fill" Value="{StaticResource B.Text2}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ResultIsProblem}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource B.Red}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <StackPanel Grid.Column="1" Margin="10,9,12,9">
                            <TextBlock Text="{loc:T РЕЗУЛЬТАТ}" Style="{StaticResource T.Label}" />
                            <TextBlock Text="{Binding ResultText}" Style="{StaticResource T.Body}" Foreground="{StaticResource B.Text}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Controls: each button is labelled; «ОТМЕНА» exists only while a tool runs -->
                    <StackPanel Grid.Row="4" Margin="10,9,10,10">
                        <TextBlock Style="{StaticResource T.Caption}" Margin="4,0,0,10" TextWrapping="Wrap"
                                   Text="{loc:T 'Эту операцию нельзя безопасно прервать — дождитесь завершения.'}"
                                   Visibility="{Binding ShowNoCancelHint, Converter={StaticResource BoolToVis}}" />
                        <UniformGrid Rows="1">
                            <Button Style="{StaticResource Btn.Danger}" Margin="0,0,6,0" Command="{Binding CancelRunCommand}"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static ui:Glyphs.Cancel}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="{loc:T ОТМЕНА}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Margin="3,0" Command="{Binding CopyOutputCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static ui:Glyphs.Copy}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="{loc:T КОПИРОВАТЬ}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Margin="6,0,0,0" Command="{Binding ClearConsoleCommand}"
                                    Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static ui:Glyphs.Close}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="{loc:T ЗАКРЫТЬ}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════ Tools: the list is the page's only ScrollViewer ═══════════════ -->
            <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="0,0,10,0">
                    <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ToolSection}">
                                <StackPanel Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title, Converter={StaticResource Sentence}}" Style="{StaticResource T.H1}" VerticalAlignment="Center" />
                                        <Rectangle Grid.Column="1" Height="1" Fill="{StaticResource B.Line2}" VerticalAlignment="Center" Margin="10,3,0,0" />
                                    </Grid>
                                    <TextBlock Text="{Binding Caption}" Style="{StaticResource T.Body}" Margin="0,4,0,10" />
                                    <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource ToolCardTemplate}" Focusable="False" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Quick links -->
                    <StackPanel Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:T 'Системные утилиты'}" Style="{StaticResource T.H1}" VerticalAlignment="Center" />
                            <Rectangle Grid.Column="1" Height="1" Fill="{StaticResource B.Line2}" VerticalAlignment="Center" Margin="10,3,0,0" />
                        </Grid>
                        <TextBlock Style="{StaticResource T.Body}" Margin="0,4,0,10"
                                   Text="{loc:T 'Lycoris только открывает эти средства Windows — изменения в них вы вносите сами.'}" />
                        <ItemsControl ItemsSource="{Binding QuickLinks}" Focusable="False" Margin="0,0,-8,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:QuickLink}">
                                    <Button Style="{StaticResource QuickTile}" Margin="0,0,8,8" ToolTip="{Binding Command}"
                                            Command="{Binding DataContext.OpenQuickLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
