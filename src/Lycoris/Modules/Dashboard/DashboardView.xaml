<UserControl x:Class="Lycoris.Modules.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Lycoris.UI.Controls"
             xmlns:ui="clr-namespace:Lycoris.UI"
             xmlns:loc="clr-namespace:Lycoris.UI"
             xmlns:local="clr-namespace:Lycoris.Modules.Dashboard"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:DashboardViewModel}">

    <UserControl.Resources>
        <Style x:Key="Dash.CardTitle" TargetType="TextBlock" BasedOn="{StaticResource T.H2}">
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Dash.MonValue" TargetType="TextBlock" BasedOn="{StaticResource T.H3}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Severity = a status tag (never white, never an outline capsule) -->
        <Style x:Key="Dash.SeverityTag" TargetType="Border" BasedOn="{StaticResource Tag}">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="Background" Value="{StaticResource B.Surface2}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text3}" />
            <Style.Triggers>
                <!-- ВНИМАНИЕ = amber (needs a look, not a failure) · СОВЕТ = steel blue · В НОРМЕ = green -->
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Background" Value="{StaticResource B.WarningDeep}" />
                    <Setter Property="BorderBrush" Value="{StaticResource B.Warning}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource B.WarningText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Info">
                    <Setter Property="Background" Value="{StaticResource B.InfoDeep}" />
                    <Setter Property="BorderBrush" Value="{StaticResource B.Info}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource B.InfoText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Ok">
                    <Setter Property="Background" Value="{StaticResource B.SuccessDeep}" />
                    <Setter Property="BorderBrush" Value="{StaticResource B.Success}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource B.SuccessText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

            <DataTemplate x:Key="Dash.CheckRow" DataType="{x:Type local:CheckItemViewModel}">
                <Border Style="{StaticResource Row}" Padding="16,11,16,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Dash.SeverityTag}">
                            <TextBlock Text="{Binding SeverityText, Converter={StaticResource Sentence}}" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title, Converter={StaticResource Sentence}}" Style="{StaticResource T.BodyStrong}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Body}" Foreground="{StaticResource B.Text2}" FontSize="12.5"
                                       LineHeight="18" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <StackPanel Margin="0,6,0,0" Visibility="{Binding HasGuidance, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding PathText}" Style="{StaticResource T.BodyStrong}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding NextStep}" Style="{StaticResource T.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Margin="0,6,0,0" Visibility="{Binding Result.SecondaryAction, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding SecondaryPathText}" Style="{StaticResource T.BodyStrong}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SecondaryNextStep}" Style="{StaticResource T.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <WrapPanel>
                                <Button Style="{StaticResource Btn.Link}" Margin="0,8,8,0"
                                        Command="{Binding DataContext.OpenAdviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding OpenText}" AutomationProperties.HelpText="{Binding PathText}"
                                        ToolTip="{Binding OpenTooltip}" Visibility="{Binding HasOpenAction, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static ui:Glyphs.ChevronRight}" FontFamily="{StaticResource F.Icons}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding OpenText, Converter={StaticResource Sentence}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Btn.Link}" Margin="0,8,8,0"
                                        Command="{Binding DataContext.RunSecondaryActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding SecondaryActionText}" AutomationProperties.HelpText="{Binding SecondaryPathText}"
                                        ToolTip="{Binding SecondaryActionTooltip}"
                                        Visibility="{Binding Result.SecondaryAction, Converter={StaticResource NullToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static ui:Glyphs.ChevronRight}" FontFamily="{StaticResource F.Icons}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding SecondaryActionText, Converter={StaticResource Sentence}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Btn}" Margin="0,8,0,0" Command="{Binding RunCommand}"
                                        AutomationProperties.Name="{Binding ActionText}" AutomationProperties.HelpText="{Binding Title}"
                                        ToolTip="{Binding ActionTooltip}" Visibility="{Binding ShowPrimaryAction, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ActionGlyph}" FontFamily="{StaticResource F.Icons}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding ActionText, Converter={StaticResource Sentence}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

        <DataTemplate x:Key="Dash.TileButtonContent" DataType="{x:Type local:LaunchTile}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ButtonGlyph}" FontFamily="{StaticResource F.Icons}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,7,0" />
                <TextBlock Grid.Column="1" Text="{Binding ButtonText, Converter={StaticResource Sentence}}" TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Dash.GameSession" DataType="{x:Type local:LaunchTile}">
            <Border Style="{StaticResource Card}" Background="{StaticResource B.Surface2}" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource B.Selected}" CornerRadius="{StaticResource R.Md}" Width="30" Height="30" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource F.Icons}" FontSize="14" Foreground="{StaticResource B.Accent}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Label, Converter={StaticResource Sentence}}" Style="{StaticResource T.BodyStrong}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="GameButton" Grid.Column="1" Style="{StaticResource Btn}" Command="{Binding Command}"
                            Content="{Binding}" ContentTemplate="{StaticResource Dash.TileButtonContent}"
                            AutomationProperties.Name="{Binding ButtonText, Converter={StaticResource Sentence}}" Margin="8,0,0,0" />
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                        <TextBlock Text="{Binding Value}" Style="{StaticResource T.H2}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsPrimary}" Value="True" />
                        <Condition Binding="{Binding DataContext.HasSafeFixes, RelativeSource={RelativeSource AncestorType=local:DashboardView}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="GameButton" Property="Style" Value="{StaticResource Btn.Primary}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsSecondary}" Value="True">
                    <Setter TargetName="GameButton" Property="Style" Value="{StaticResource Btn.Danger}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="Dash.Tool" DataType="{x:Type local:LaunchTile}">
            <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource B.Line}" Padding="14,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <DockPanel>
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center"
                                       Margin="0,0,7,0" DockPanel.Dock="Left">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource B.InfoText}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Accent}" Value="Success">
                                                <Setter Property="Foreground" Value="{StaticResource B.SuccessText}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Label, Converter={StaticResource Sentence}}" Style="{StaticResource T.Label}"
                                       Foreground="{StaticResource B.Text2}" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock Text="{Binding Value}" Style="{StaticResource T.BodyStrong}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource Btn}" Command="{Binding Command}" Content="{Binding}"
                            ContentTemplate="{StaticResource Dash.TileButtonContent}" AutomationProperties.Name="{Binding ButtonText, Converter={StaticResource Sentence}}"
                            Height="Auto" MinHeight="30" MaxWidth="156" Padding="8,4" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}" Style="{StaticResource T.Caption}"
                               TextWrapping="Wrap" Margin="0,3,0,0" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <c:PageHeader Title="{Binding Title}" Subtitle="{Binding Subtitle}" Checked="{Binding CheckedText}"
                      RefreshCommand="{Binding RefreshChecksCommand}">
            <c:PageHeader.Actions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- «ПОЧЕМУ ТОРМОЗИТ?»: 10 s read-only measurement, explained in plain words -->
                    <Button AutomationProperties.AutomationId="DiagnoseButton" Style="{StaticResource Btn}" Command="{Binding DiagnoseCommand}" Margin="0,0,8,0"
                            ToolTip="{loc:T 'Замер 10 секунд: кто грузит процессор и память, занят ли диск, и что с этим делать'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static ui:Glyphs.Search}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding Source={loc:T 'ПОЧЕМУ ТОРМОЗИТ?'}, Converter={StaticResource Sentence}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- «ОТЧЁТ О ПК»: a readable HTML page on the Desktop from the checks already made (nothing is sent anywhere). -->
                    <Button Style="{StaticResource Btn}" Command="{Binding CreateHealthReportCommand}"
                            ToolTip="{loc:T 'Понятный отчёт о ПК: оценка, проверки, сводка о системе'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static ui:Glyphs.Save}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="{loc:T Отчёт о ПК}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </c:PageHeader.Actions>
        </c:PageHeader>

        <ScrollViewer Grid.Row="1" Margin="0,0,-10,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="0,12,10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.7*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" MinWidth="254" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" MinWidth="78">
                                <TextBlock FontSize="34" LineHeight="38" LineStackingStrategy="BlockLineHeight">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource T.Stat}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ScoreTier}" Value="Good"><Setter Property="Foreground" Value="{StaticResource B.SuccessText}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding ScoreTier}" Value="Fair"><Setter Property="Foreground" Value="{StaticResource B.WarningText}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding ScoreTier}" Value="Poor"><Setter Property="Foreground" Value="{StaticResource B.WarningText}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding ScoreTier}" Value="Bad"><Setter Property="Foreground" Value="{StaticResource B.RedText}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding ScoreText, Mode=OneWay}" /><Run Text=" / 100" FontSize="11" Foreground="{StaticResource B.Text3}" />
                                </TextBlock>
                                <c:Meter Value="{Binding Score}" Segments="10" Gap="2" Height="4" Margin="0,3,0,0">
                                    <c:Meter.Style>
                                        <Style TargetType="c:Meter">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ScoreTier}" Value="Good"><Setter Property="Fill" Value="{StaticResource B.Success}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding ScoreTier}" Value="Fair"><Setter Property="Fill" Value="{StaticResource B.Warning}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding ScoreTier}" Value="Poor"><Setter Property="Fill" Value="{StaticResource B.Warning}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding ScoreTier}" Value="Bad"><Setter Property="Fill" Value="{StaticResource B.Red}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </c:Meter.Style>
                                </c:Meter>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Verdict, Converter={StaticResource Sentence}}" Style="{StaticResource Dash.CardTitle}" />
                                <TextBlock Text="{Binding VerdictSummary}" Style="{StaticResource T.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <Button Style="{StaticResource Btn.Primary}" Command="{Binding FixSafeCommand}" Height="Auto" MinHeight="30" MaxWidth="190" Padding="8,4" Visibility="{Binding HasSafeFixes, Converter={StaticResource BoolToVis}}"
                                        ToolTip="{loc:T 'Включает безопасные настройки одним пакетом: один список, одно подтверждение, откат одной кнопкой'}">
                                    <DockPanel>
                                        <TextBlock Text="{x:Static ui:Glyphs.Check}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding FixSafeText, Converter={StaticResource Sentence}}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Button>
                                <Button Style="{StaticResource Btn}" Command="{Binding FixSafeCommand}" Height="Auto" MinHeight="30" MaxWidth="190" Padding="8,4" Visibility="{Binding HasSafeFixes, Converter={StaticResource InverseBoolToVis}}"
                                        ToolTip="{loc:T 'Безопасных исправлений сейчас нет'}">
                                    <DockPanel>
                                        <TextBlock Text="{x:Static ui:Glyphs.Check}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding FixSafeText, Converter={StaticResource Sentence}}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Button>
                            </Grid>
                            <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0"
                                       Visibility="{Binding RestartCountdown, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding RestartCountdown}" Style="{StaticResource T.BodyStrong}" Foreground="{StaticResource B.WarningText}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button Style="{StaticResource Btn}" Content="{Binding Source={loc:T ОТМЕНИТЬ ПЕРЕЗАГРУЗКУ}, Converter={StaticResource Sentence}}"
                                        Command="{Binding CancelRestartCommand}" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <!-- BuildTiles provides the gaming session first, followed by the secondary tools. -->
                    <ContentControl Grid.Column="2" Content="{Binding Tiles[0]}" ContentTemplate="{StaticResource Dash.GameSession}"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Focusable="False" />
                </Grid>

                <Border Style="{StaticResource Card.Flush}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={loc:T ИНСТРУМЕНТЫ}, Converter={StaticResource Sentence}}" Style="{StaticResource Dash.CardTitle}"
                                   Margin="14,10,14,8" />
                        <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource Dash.Tool}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- A two-item upper band and three shorter items below. Positions follow tile keys. -->
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Grid.Row" Value="1" />
                                    <Setter Property="Grid.ColumnSpan" Value="2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Key}" Value="game">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Key}" Value="optimize">
                                            <Setter Property="Grid.Row" Value="0" />
                                            <Setter Property="Grid.ColumnSpan" Value="3" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Key}" Value="clean">
                                            <Setter Property="Grid.Row" Value="0" />
                                            <Setter Property="Grid.Column" Value="3" />
                                            <Setter Property="Grid.ColumnSpan" Value="3" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Key}" Value="undo">
                                            <Setter Property="Grid.Column" Value="2" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Key}" Value="ping">
                                            <Setter Property="Grid.Column" Value="4" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" MinWidth="300" MaxWidth="440" />
                    </Grid.ColumnDefinitions>

                    <!-- «ПОЧЕМУ ТОРМОЗИТ?» (Доктор ПК): appears after the button; the same rows and buttons as the checks -->
                    <StackPanel VerticalAlignment="Top">
                    <Border x:Name="DoctorCard" Style="{StaticResource Card.Flush}" Margin="0,0,0,14" Visibility="{Binding HasDoctor, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Margin="16,12,16,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'Почему тормозит'}" Style="{StaticResource Dash.CardTitle}" />
                                    <!-- Live region: DashboardView.xaml.cs raises LiveRegionChanged when DoctorStatus changes -->
                                    <TextBlock x:Name="DoctorStatusText" Text="{Binding DoctorStatus}" Style="{StaticResource T.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Style="{StaticResource Btn.Link}" Command="{Binding OpenDoctorSourceCommand}" Margin="12,0,6,0" ToolTip="{Binding DoctorSourceUrl}"
                                            AutomationProperties.Name="{loc:T 'Советы Microsoft, откроется в браузере'}">
                                        <TextBlock Text="{loc:T 'Советы Microsoft ↗'}" VerticalAlignment="Center" />
                                    </Button>
                                    <Button Command="{Binding CloseDoctorCommand}" AutomationProperties.Name="{loc:T 'Закрыть «Почему тормозит»'}">
                                        <TextBlock Text="{Binding Source={loc:T ЗАКРЫТЬ}, Converter={StaticResource Sentence}}" VerticalAlignment="Center" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <ProgressBar IsIndeterminate="{Binding IsDiagnosing}" Height="2" Margin="16,0,16,10"
                                         AutomationProperties.Name="{loc:T 'Идёт замер'}"
                                         Visibility="{Binding IsDiagnosing, Converter={StaticResource BoolToVis}}" />
                            <Rectangle Style="{StaticResource Divider}" />
                            <ItemsControl ItemsSource="{Binding DoctorItems}" ItemTemplate="{StaticResource Dash.CheckRow}" Focusable="False" />
                            <TextBlock Text="{loc:T 'Lycoris только измеряет: программы не закрываются и ничего не меняется без вашей кнопки.'}"
                                       Style="{StaticResource T.Caption}" Margin="16,10,16,12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Problems and advice -->
                    <Border Style="{StaticResource Card.Flush}" VerticalAlignment="Top">
                        <StackPanel>
                            <WrapPanel Margin="16,10,16,8" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ListTitle}" Style="{StaticResource Dash.CardTitle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="DashFilter" IsChecked="{Binding ShowWarnings, Mode=TwoWay}"
                                                 AutomationProperties.Name="{Binding WarningChipName}" AutomationProperties.HelpText="{loc:T 'Показать проблемы'}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Source={loc:T ВНИМАНИЕ}, Converter={StaticResource Sentence}}" VerticalAlignment="Center" />
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource TabBadge.Alert}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WarningCount}" Value="0">
                                                                <Setter Property="Background" Value="{StaticResource B.Surface4}" />
                                                                <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text2}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding WarningCount}" />
                                            </Border>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="DashFilter" IsChecked="{Binding ShowInfos, Mode=TwoWay}"
                                                 AutomationProperties.Name="{Binding InfoChipName}" AutomationProperties.HelpText="{loc:T 'Показать советы'}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{loc:T Советы}" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource TabBadge}"><TextBlock Text="{Binding InfoCount}" /></Border>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="DashFilter" IsChecked="{Binding ShowOk, Mode=TwoWay}" Margin="0"
                                                 AutomationProperties.Name="{Binding OkChipName}" AutomationProperties.HelpText="{loc:T 'Показать проверки в норме'}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{loc:T 'В норме'}" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource TabBadge}"><TextBlock Text="{Binding OkCount}" /></Border>
                                        </StackPanel>
                                    </RadioButton>
                                </WrapPanel>
                            </WrapPanel>
                            <Rectangle Style="{StaticResource Divider}" />

                            <ItemsControl ItemsSource="{Binding Visible}" ItemTemplate="{StaticResource Dash.CheckRow}" Focusable="False">
                            </ItemsControl>

                            <!-- Empty list: says what it means -->
                            <TextBlock Text="{Binding EmptyText}" Style="{StaticResource T.Body}" Foreground="{StaticResource B.Text2}" Margin="16,14,16,16" TextWrapping="Wrap"
                                       Visibility="{Binding EmptyText, Converter={StaticResource NullToVis}}" />

                            <!-- Loading -->
                            <StackPanel Margin="16,14,16,16" Visibility="{Binding HasResults, Converter={StaticResource InverseBoolToVis}}">
                                <ProgressBar IsIndeterminate="{Binding IsChecking}" Height="2" />
                                <TextBlock Text="{loc:T 'Проверки выполняются в фоне и только читают систему.'}" Style="{StaticResource T.Caption}" Margin="0,9,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    </StackPanel>

                    <!-- Right column: monitor in four rows + the system facts behind ВСЕ СВЕДЕНИЯ -->
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Card}" Padding="16,12,16,6">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{loc:T Монитор}" Style="{StaticResource Dash.CardTitle}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Style="{StaticResource Dot.Info}" />
                                        <TextBlock Text="{loc:T В реальном времени}" Style="{StaticResource T.Caption}"
                                                   Foreground="{StaticResource B.Text2}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding IntervalText}" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text3}"
                                                   Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <!-- ЦП -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:T ЦП}" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CpuText}" Style="{StaticResource Dash.MonValue}" />
                                        <TextBlock Text=" %" Style="{StaticResource T.Caption}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource T.Caption}" TextWrapping="Wrap">
                                            <Run Text="{Binding CpuClockText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding CpuCoresText, Mode=OneWay}" />
                                        </TextBlock>
                                        <c:Meter Value="{Binding CpuLoad}" Segments="24" Height="5" Margin="0,5,0,0" WarnThreshold="75" HotThreshold="90" />
                                    </StackPanel>
                                </Grid>
                                <Rectangle Style="{StaticResource Divider}" Margin="0,10,0,0" />

                                <!-- ГРАФИКА -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={loc:T ГРАФИКА}, Converter={StaticResource Sentence}}" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GpuText}" Style="{StaticResource Dash.MonValue}" />
                                        <TextBlock Text=" %" Style="{StaticResource T.Caption}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource T.Caption}" TextWrapping="Wrap">
                                            <Run Text="{Binding GpuTempText, Mode=OneWay}" /><Run Text=" · VRAM " /><Run Text="{Binding GpuVramText, Mode=OneWay}" />
                                        </TextBlock>
                                        <c:Meter Value="{Binding GpuLoad}" Segments="24" Height="5" Margin="0,5,0,0" WarnThreshold="80" HotThreshold="95" />
                                    </StackPanel>
                                </Grid>
                                <Rectangle Style="{StaticResource Divider}" Margin="0,10,0,0" />

                                <!-- ПАМЯТЬ -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={loc:T ПАМЯТЬ}, Converter={StaticResource Sentence}}" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RamText}" Style="{StaticResource Dash.MonValue}" />
                                        <TextBlock Text=" %" Style="{StaticResource T.Caption}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource T.Caption}" TextWrapping="Wrap">
                                            <Run Text="{Binding RamUsedText, Mode=OneWay}" /><Run Text="{loc:T ' занято'}" />
                                        </TextBlock>
                                        <c:Meter Value="{Binding RamLoad}" Segments="24" Height="5" Margin="0,5,0,0" WarnThreshold="75" HotThreshold="90" />
                                    </StackPanel>
                                </Grid>
                                <Rectangle Style="{StaticResource Divider}" Margin="0,10,0,0" />

                                <!-- ДИСК + СЕТЬ -->
                                <Grid Margin="0,10,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={loc:T 'ДИСК · СЕТЬ'}, Converter={StaticResource Sentence}}" Style="{StaticResource T.Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DiskText}" Style="{StaticResource Dash.MonValue}" />
                                        <TextBlock Text=" %" Style="{StaticResource T.Caption}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource T.Caption}" TextWrapping="Wrap">
                                            <Run Text="↓ " /><Run Text="{Binding NetDownText, Mode=OneWay}" /><Run Text="   ↑ " /><Run Text="{Binding NetUpText, Mode=OneWay}" />
                                        </TextBlock>
                                        <c:Meter Value="{Binding DiskLoad}" Segments="24" Height="5" Margin="0,5,0,0" WarnThreshold="75" HotThreshold="90" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Система: one line, the rest behind ВСЕ СВЕДЕНИЯ -->
                        <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16,12,16,14">
                            <StackPanel>
                                <TextBlock Text="{loc:T Система}" Style="{StaticResource Dash.CardTitle}" />
                                <TextBlock Text="{Binding SystemSummary}" Style="{StaticResource T.Body}" Foreground="{StaticResource B.Text2}" Margin="0,8,0,10" TextWrapping="Wrap"
                                           Visibility="{Binding SystemSummary, Converter={StaticResource NullToVis}}" />
                                <StackPanel Margin="0,0,0,10" Visibility="{Binding SystemRows.Count, Converter={StaticResource NullToVis}, ConverterParameter=invert}">
                                    <ProgressBar IsIndeterminate="{Binding IsChecking}" Height="2" />
                                    <TextBlock Text="{loc:T 'Сбор сведений о компьютере…'}" Style="{StaticResource T.Caption}" Margin="0,8,0,0" />
                                </StackPanel>
                                <Expander Header="{Binding Source={loc:T 'ВСЕ СВЕДЕНИЯ'}, Converter={StaticResource Sentence}}" Visibility="{Binding SystemRows.Count, Converter={StaticResource NullToVis}}">
                                    <ItemsControl ItemsSource="{Binding SystemRows}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:SystemRow}">
                                                <Border BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Padding="0,9,0,9">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="104" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label, Converter={StaticResource Sentence}}" Style="{StaticResource T.Label}" Margin="0,2,9,0" TextWrapping="Wrap" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Value}" Style="{StaticResource T.BodyStrong}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                                       Visibility="{Binding Detail, Converter={StaticResource NullToVis}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
