<UserControl x:Class="Lycoris.Modules.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Lycoris.UI.Controls"
             xmlns:ui="clr-namespace:Lycoris.UI"
             xmlns:loc="clr-namespace:Lycoris.UI"
             xmlns:local="clr-namespace:Lycoris.Modules.Dashboard"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:DashboardViewModel}">

    <!--
        «Панель» = the launchpad (Obvious UI, option A):
          header (title · проверено · ОБНОВИТЬ · LIVE)
          score strip   100 · Отлично · [ВНИМАНИЕ n] [СОВЕТЫ n] [В НОРМЕ n]            [ИСПРАВИТЬ ВСЁ БЕЗОПАСНОЕ · N]
          six tiles     ИГРОВОЙ СЕАНС · ОПТИМИЗАЦИЯ · ОЧИСТКА · ВИДЕОКАРТА · ОТКАТ · ПИНГ — live value + ONE labelled button each
          list (the only ScrollViewer)   problems with verb buttons  |  monitor in 4 rows + «ВСЕ СВЕДЕНИЯ ▾»
    -->
    <UserControl.Resources>
        <Style x:Key="Dash.CardTitle" TargetType="TextBlock" BasedOn="{StaticResource T.H2}">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontStretch" Value="Condensed" />
            <Setter Property="FontSize" Value="18" />
        </Style>

        <Style x:Key="Dash.TileValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontStretch" Value="Condensed" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,9,0,0" />
        </Style>

        <Style x:Key="Dash.TileDetail" TargetType="TextBlock" BasedOn="{StaticResource T.Caption}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        </Style>

        <!-- Monitor row -->
        <Style x:Key="Dash.MonValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Severity = a status tag (never white, never an outline capsule) -->
        <Style x:Key="Dash.SeverityTag" TargetType="Border" BasedOn="{StaticResource Tag}">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="Background" Value="{StaticResource B.Surface2}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text3}" />
            <Style.Triggers>
                <!-- ВНИМАНИЕ = amber (needs a look, not a failure) · СОВЕТ = steel blue · В НОРМЕ = green -->
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Background" Value="{StaticResource B.WarningDeep}" />
                    <Setter Property="BorderBrush" Value="{StaticResource B.Warning}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource B.WarningText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Info">
                    <Setter Property="Background" Value="{StaticResource B.InfoDeep}" />
                    <Setter Property="BorderBrush" Value="{StaticResource B.Info}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource B.InfoText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Ok">
                    <Setter Property="Background" Value="{StaticResource B.SuccessDeep}" />
                    <Setter Property="BorderBrush" Value="{StaticResource B.Success}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource B.SuccessText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="Dash.ButtonContent">
            <TextBlock Text="{Binding}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════════ Header ═══════════════ -->
        <c:PageHeader Title="{Binding Title}" Subtitle="{Binding Subtitle}" Checked="{Binding CheckedText}"
                      RefreshCommand="{Binding RefreshChecksCommand}">
            <c:PageHeader.Actions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- «ОТЧЁТ О ПК»: a readable HTML page on the Desktop from the checks already made (nothing is sent anywhere). -->
                    <Button Style="{StaticResource Btn}" Command="{Binding CreateHealthReportCommand}" Margin="0,0,14,0"
                            ToolTip="{loc:T 'Понятный отчёт о ПК на рабочий стол: оценка, проверки, сводка о системе'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static ui:Glyphs.Save}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="{loc:T ОТЧЁТ О ПК}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource Dot.Red}" />
                    <TextBlock Text="LIVE" Style="{StaticResource T.Mono}" FontWeight="Bold" Foreground="{StaticResource B.Text2}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding IntervalText}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text3}" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </c:PageHeader.Actions>
        </c:PageHeader>

        <!-- ═══════════════ Score strip ═══════════════ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The score: the number takes the tier hue (green >= 90, amber >= 70, red < 50) and a short segmented bar repeats it; the verdict words say the same -->
                <StackPanel VerticalAlignment="Center" MinWidth="58">
                    <TextBlock Text="{Binding ScoreText}" FontSize="40" LineHeight="44" LineStackingStrategy="BlockLineHeight">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource T.Stat}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScoreTier}" Value="Good"><Setter Property="Foreground" Value="{StaticResource B.SuccessText}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding ScoreTier}" Value="Fair"><Setter Property="Foreground" Value="{StaticResource B.WarningText}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding ScoreTier}" Value="Poor"><Setter Property="Foreground" Value="{StaticResource B.WarningText}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding ScoreTier}" Value="Bad"><Setter Property="Foreground" Value="{StaticResource B.RedText}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <c:Meter Value="{Binding Score}" Segments="10" Gap="2" Height="4" Margin="0,3,0,0">
                        <c:Meter.Style>
                            <Style TargetType="c:Meter">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScoreTier}" Value="Good"><Setter Property="Fill" Value="{StaticResource B.Success}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding ScoreTier}" Value="Fair"><Setter Property="Fill" Value="{StaticResource B.Warning}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding ScoreTier}" Value="Poor"><Setter Property="Fill" Value="{StaticResource B.Warning}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding ScoreTier}" Value="Bad"><Setter Property="Fill" Value="{StaticResource B.Red}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </c:Meter.Style>
                    </c:Meter>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource T.H3}" TextWrapping="Wrap">
                        <Run Text="{Binding Verdict, Converter={StaticResource Sentence}, Mode=OneWay}" /><Run Text="{loc:T ' · оценка '}" Foreground="{StaticResource B.Text2}" /><Run Text="{Binding ScoreText, Mode=OneWay}" Foreground="{StaticResource B.Text2}" /><Run Text="{loc:T ' из 100'}" Foreground="{StaticResource B.Text2}" />
                    </TextBlock>
                    <TextBlock Text="{Binding VerdictSummary}" Style="{StaticResource T.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Chips = the filter of the list below -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                            Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                    <RadioButton Style="{StaticResource Chip}" GroupName="DashFilter" IsChecked="{Binding ShowWarnings, Mode=TwoWay}"
                                 AutomationProperties.Name="{loc:T 'Показать проблемы'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:T ВНИМАНИЕ}" VerticalAlignment="Center" />
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource TabBadge.Alert}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WarningCount}" Value="0">
                                                <Setter Property="Background" Value="{StaticResource B.Surface4}" />
                                                <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text2}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding WarningCount}" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Chip}" GroupName="DashFilter" IsChecked="{Binding ShowInfos, Mode=TwoWay}"
                                 AutomationProperties.Name="{loc:T 'Показать советы'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:T СОВЕТЫ}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource TabBadge}"><TextBlock Text="{Binding InfoCount}" /></Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Chip}" GroupName="DashFilter" IsChecked="{Binding ShowOk, Mode=TwoWay}" Margin="0"
                                 AutomationProperties.Name="{loc:T 'Показать проверки в норме'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:T 'В НОРМЕ'}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource TabBadge}"><TextBlock Text="{Binding OkCount}" /></Border>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- ONE primary action: white only while it has something to do -->
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                <!-- A restart scheduled from «ОЖИДАЕТСЯ ПЕРЕЗАГРУЗКА»: countdown and the way back, until it happens. -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" HorizontalAlignment="Right" Visibility="{Binding RestartCountdown, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{Binding RestartCountdown}" Foreground="{StaticResource B.WarningText}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
                    <Button Style="{StaticResource Btn}" Content="{loc:T ОТМЕНИТЬ ПЕРЕЗАГРУЗКУ}" Command="{Binding CancelRestartCommand}" />
                </StackPanel>
                <Grid>
                    <Button Style="{StaticResource Btn.Primary}" Command="{Binding FixSafeCommand}" Visibility="{Binding HasSafeFixes, Converter={StaticResource BoolToVis}}"
                            ToolTip="{loc:T 'Включает безопасные настройки одним пакетом: один список, одно подтверждение, откат одной кнопкой'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static ui:Glyphs.Check}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding FixSafeText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn}" Command="{Binding FixSafeCommand}" Visibility="{Binding HasSafeFixes, Converter={StaticResource InverseBoolToVis}}"
                            ToolTip="{loc:T 'Безопасных исправлений сейчас нет'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static ui:Glyphs.Check}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding FixSafeText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ Six tiles: live value + ONE labelled button ═══════════════ -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Tiles}" Margin="0,10,-10,0" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:LaunchTile}">
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="0">
                        <StackPanel>
                            <!-- Thin top line in the tile's hue (the card clips it to the rounded corners); the label below says what the tile is -->
                            <Border Height="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource B.Info}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Accent}" Value="Red"><Setter Property="Background" Value="{StaticResource B.Red}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Accent}" Value="Success"><Setter Property="Background" Value="{StaticResource B.Success}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <StackPanel Margin="12,9,12,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource B.InfoText}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Accent}" Value="Red"><Setter Property="Foreground" Value="{StaticResource B.RedText}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Accent}" Value="Success"><Setter Property="Foreground" Value="{StaticResource B.SuccessText}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Text="{Binding Value}" Style="{StaticResource Dash.TileValue}" ToolTip="{Binding Value}" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Dash.TileDetail}" ToolTip="{Binding Detail}" />
                            <Grid Margin="0,9,0,0">
                                <Button Style="{StaticResource Btn.Primary}" Command="{Binding Command}" Height="Auto" MinHeight="30" Padding="6,4"
                                        Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVis}}">
                                    <DockPanel HorizontalAlignment="Center" LastChildFill="True">
                                        <TextBlock Text="{Binding ButtonGlyph}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding ButtonText}" VerticalAlignment="Center" TextWrapping="NoWrap" TextAlignment="Center" />
                                    </DockPanel>
                                </Button>
                                <Button Style="{StaticResource Btn}" Command="{Binding Command}" Height="Auto" MinHeight="30" Padding="6,4"
                                        Visibility="{Binding IsSecondary, Converter={StaticResource BoolToVis}}">
                                    <DockPanel HorizontalAlignment="Center" LastChildFill="True">
                                        <TextBlock Text="{Binding ButtonGlyph}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding ButtonText}" VerticalAlignment="Center" TextWrapping="NoWrap" TextAlignment="Center" />
                                    </DockPanel>
                                </Button>
                            </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ═══════════════ List (the only ScrollViewer): problems | monitor + system ═══════════════ -->
        <ScrollViewer Grid.Row="3" Margin="0,2,-10,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid Margin="0,8,10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" MinWidth="300" MaxWidth="440" />
                </Grid.ColumnDefinitions>

                <!-- Problems and advice -->
                <Border Style="{StaticResource Card.Flush}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="16,12,16,10">
                            <TextBlock Text="{Binding ListTitle}" Style="{StaticResource Dash.CardTitle}" VerticalAlignment="Center" />
                        </Grid>
                        <Rectangle Style="{StaticResource Divider}" />

                        <ItemsControl ItemsSource="{Binding Visible}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:CheckItemViewModel}">
                                    <Border Style="{StaticResource Row}" Padding="16,11,16,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="82" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource Dash.SeverityTag}">
                                                <TextBlock Text="{Binding SeverityText}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Title, Converter={StaticResource Sentence}}" Style="{StaticResource T.BodyStrong}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Body}" Foreground="{StaticResource B.Text2}" FontSize="12.5"
                                                           LineHeight="18" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                                                <Button MinWidth="150" HorizontalAlignment="Stretch" Command="{Binding RunCommand}"
                                                        ToolTip="{Binding ActionTooltip}" Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{x:Static ui:Glyphs.Lock}" FontFamily="{StaticResource F.Icons}" FontSize="12"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                                   Visibility="{Binding ShowAdminHint, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding ActionText}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <!-- Optional second lever (it only shows the setting; the change is made there) -->
                                                <Button Margin="0,6,0,0" MinWidth="150" HorizontalAlignment="Stretch"
                                                        Command="{Binding DataContext.RunSecondaryActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="{loc:T 'Показать настройку в разделе «Оптимизация» — сама по себе кнопка ничего не меняет'}"
                                                        Visibility="{Binding Result.SecondaryAction, Converter={StaticResource NullToVis}}">
                                                    <TextBlock Text="{Binding SecondaryActionText}" VerticalAlignment="Center" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty list: says what it means -->
                        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource T.Body}" Foreground="{StaticResource B.Text2}" Margin="16,14,16,16" TextWrapping="Wrap"
                                   Visibility="{Binding EmptyText, Converter={StaticResource NullToVis}}" />

                        <!-- Loading -->
                        <StackPanel Margin="16,14,16,16" Visibility="{Binding HasResults, Converter={StaticResource InverseBoolToVis}}">
                            <ProgressBar IsIndeterminate="{Binding IsChecking}" Height="2" />
                            <TextBlock Text="{loc:T 'Проверки выполняются в фоне и только читают систему.'}" Style="{StaticResource T.Caption}" Margin="0,9,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Right column: monitor in four rows + the system facts behind ВСЕ СВЕДЕНИЯ -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="16,12,16,6">
                        <StackPanel>
                            <TextBlock Text="{loc:T Монитор}" Style="{StaticResource Dash.CardTitle}" />

                            <!-- ЦП -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:T ЦП}" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CpuText}" Style="{StaticResource Dash.MonValue}" />
                                    <TextBlock Text=" %" Style="{StaticResource T.Caption}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource T.Caption}" TextWrapping="Wrap">
                                        <Run Text="{Binding CpuClockText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding CpuCoresText, Mode=OneWay}" />
                                    </TextBlock>
                                    <c:Meter Value="{Binding CpuLoad}" Segments="24" Height="5" Margin="0,5,0,0" WarnThreshold="75" HotThreshold="90" />
                                </StackPanel>
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" Margin="0,10,0,0" />

                            <!-- ГРАФИКА -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:T ГРАФИКА}" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding GpuText}" Style="{StaticResource Dash.MonValue}" />
                                    <TextBlock Text=" %" Style="{StaticResource T.Caption}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource T.Caption}" TextWrapping="Wrap">
                                        <Run Text="{Binding GpuTempText, Mode=OneWay}" /><Run Text=" · VRAM " /><Run Text="{Binding GpuVramText, Mode=OneWay}" />
                                    </TextBlock>
                                    <c:Meter Value="{Binding GpuLoad}" Segments="24" Height="5" Margin="0,5,0,0" WarnThreshold="80" HotThreshold="95" />
                                </StackPanel>
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" Margin="0,10,0,0" />

                            <!-- ПАМЯТЬ -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:T ПАМЯТЬ}" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding RamText}" Style="{StaticResource Dash.MonValue}" />
                                    <TextBlock Text=" %" Style="{StaticResource T.Caption}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource T.Caption}" TextWrapping="Wrap">
                                        <Run Text="{Binding RamUsedText, Mode=OneWay}" /><Run Text="{loc:T ' занято'}" />
                                    </TextBlock>
                                    <c:Meter Value="{Binding RamLoad}" Segments="24" Height="5" Margin="0,5,0,0" WarnThreshold="75" HotThreshold="90" />
                                </StackPanel>
                            </Grid>
                            <Rectangle Style="{StaticResource Divider}" Margin="0,10,0,0" />

                            <!-- ДИСК + СЕТЬ -->
                            <Grid Margin="0,10,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:T 'ДИСК · СЕТЬ'}" Style="{StaticResource T.Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DiskText}" Style="{StaticResource Dash.MonValue}" />
                                    <TextBlock Text=" %" Style="{StaticResource T.Caption}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource T.Caption}" TextWrapping="Wrap">
                                        <Run Text="↓ " /><Run Text="{Binding NetDownText, Mode=OneWay}" /><Run Text="   ↑ " /><Run Text="{Binding NetUpText, Mode=OneWay}" />
                                    </TextBlock>
                                    <c:Meter Value="{Binding DiskLoad}" Segments="24" Height="5" Margin="0,5,0,0" WarnThreshold="75" HotThreshold="90" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Система: one line, the rest behind ВСЕ СВЕДЕНИЯ -->
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16,12,16,14">
                        <StackPanel>
                            <TextBlock Text="{loc:T Система}" Style="{StaticResource Dash.CardTitle}" />
                            <TextBlock Text="{Binding SystemSummary}" Style="{StaticResource T.Body}" Foreground="{StaticResource B.Text2}" Margin="0,8,0,10" TextWrapping="Wrap"
                                       Visibility="{Binding SystemSummary, Converter={StaticResource NullToVis}}" />
                            <StackPanel Margin="0,0,0,10" Visibility="{Binding SystemRows.Count, Converter={StaticResource NullToVis}, ConverterParameter=invert}">
                                <ProgressBar IsIndeterminate="{Binding IsChecking}" Height="2" />
                                <TextBlock Text="{loc:T 'Сбор сведений о компьютере…'}" Style="{StaticResource T.Caption}" Margin="0,8,0,0" />
                            </StackPanel>
                            <Expander Header="{loc:T 'ВСЕ СВЕДЕНИЯ'}" Visibility="{Binding SystemRows.Count, Converter={StaticResource NullToVis}}">
                                <ItemsControl ItemsSource="{Binding SystemRows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:SystemRow}">
                                            <Border BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Padding="0,9,0,9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="104" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource T.Label}" Margin="0,2,9,0" TextWrapping="Wrap" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Value}" Style="{StaticResource T.BodyStrong}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                                   Visibility="{Binding Detail, Converter={StaticResource NullToVis}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
