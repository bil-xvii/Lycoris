<UserControl x:Class="Lycoris.Modules.Cleaner.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:Lycoris.UI.Controls"
             xmlns:ui="clr-namespace:Lycoris.UI"
             xmlns:loc="clr-namespace:Lycoris.UI"
             xmlns:local="clr-namespace:Lycoris.Modules.Cleaner"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=local:CleanerViewModel}">
    <UserControl.Resources>
        <!-- Size readout: bright when the row is selected -->
        <Style x:Key="RowSize" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontStretch" Value="Condensed" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Hatched-band callout (RoundClip keeps the band inside the rounded corners) -->
        <Style x:Key="BandCallout" TargetType="Border" BasedOn="{StaticResource Callout}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="ui:RoundClip.Content" Value="True" />
        </Style>

        <!-- ═══════════════ One cleanup item ═══════════════ -->
        <DataTemplate x:Key="ItemRow" DataType="{x:Type local:CleanItem}">
            <Grid>
                <Border Padding="14,11,15,11" MouseLeftButtonUp="Row_MouseLeftButtonUp">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Row}">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanToggle}" Value="True">
                                    <Setter Property="Cursor" Value="Hand" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="210" />
                        </Grid.ColumnDefinitions>

                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanToggle}" VerticalAlignment="Top"
                                  Margin="0,1,12,0" ToolTip="{loc:T 'Включить в очистку'}" />

                        <StackPanel Grid.Column="1" MaxWidth="820" HorizontalAlignment="Left">
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name, Converter={StaticResource Sentence}}" Style="{StaticResource T.H3}" FontSize="15.5"
                                           FontStretch="SemiCondensed" VerticalAlignment="Center" Margin="0,0,9,0" />
                                <!-- Risk: БЕЗОПАСНО · ПО ЖЕЛАНИЮ · ЭКСПЕРТ (the theme's Tag styles) -->
                                <Border Style="{StaticResource Tag.Ok}" Margin="0,2,6,2" Visibility="{Binding IsSafeTier, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding TierText}" />
                                </Border>
                                <Border Style="{StaticResource Tag.Info}" Margin="0,2,6,2" Visibility="{Binding IsOptionalTier, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding TierText}" />
                                </Border>
                                <Border Style="{StaticResource Tag.Hatch}" Margin="0,2,6,2" Visibility="{Binding IsExpertTier, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding TierText}" />
                                </Border>
                                <Border Style="{StaticResource Tag.Hatch}" Margin="0,2,6,2" Visibility="{Binding IsAppRunning, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding CloseAppTag}" />
                                </Border>
                                <Border Style="{StaticResource Tag.Muted}" Margin="0,2,6,2" Visibility="{Binding IsLong, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{loc:T ДОЛГО}" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="{Binding Description}" Style="{StaticResource T.Body}" FontSize="12.5" Margin="0,7,0,0" />
                            <TextBlock Text="{Binding Effect}" Style="{StaticResource T.Caption}" Margin="0,4,0,0" LineHeight="17" />
                            <Grid Margin="0,10,0,0" Visibility="{Binding Note, Converter={StaticResource NullToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Width="6" Height="6" Fill="{StaticResource B.Text}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Note}" Style="{StaticResource T.Body}" FontSize="12" LineHeight="17"
                                           Foreground="{StaticResource B.Text}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="15,0,0,0">
                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource RowSize}" />
                            <TextBlock Text="{Binding CountText}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text3}"
                                       HorizontalAlignment="Right" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                            <!-- One status tag: muted · plain · filled (done) · hatched (needs attention) -->
                            <Grid Margin="0,10,0,0" HorizontalAlignment="Right">
                                <Border Style="{StaticResource Tag.Muted}" Visibility="{Binding ToneIsMuted, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding StatusText}" />
                                </Border>
                                <Border Style="{StaticResource Tag}" Visibility="{Binding ToneIsNormal, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding StatusText}" />
                                </Border>
                                <Border Style="{StaticResource Tag.Solid}" Visibility="{Binding ToneIsDone, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding StatusText}" />
                                </Border>
                                <Border Style="{StaticResource Tag.Hatch}" Visibility="{Binding ToneIsWarning, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding StatusText}" />
                                </Border>
                            </Grid>
                            <!-- Read-only mode: the row says why it is grey and offers the way out right here -->
                            <Button Style="{StaticResource Btn}" Margin="0,8,0,0" HorizontalAlignment="Right"
                                    Command="{Binding DataContext.GetRightsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding NeedsRights, Converter={StaticResource BoolToVis}}"
                                    ToolTip="{loc:T 'Lycoris перезапустится с правами администратора и продолжит очистку — перед удалением снова покажет список.'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static ui:Glyphs.Admin}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="{loc:T 'ПОЛУЧИТЬ ПРАВА'}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Selected rows carry a white edge -->
                <Rectangle Width="3" HorizontalAlignment="Left" Fill="{StaticResource B.White}" Margin="0,0,0,1" IsHitTestVisible="False"
                           Visibility="{Binding IsChecked, Converter={StaticResource BoolToVis}}" />
                <ProgressBar VerticalAlignment="Bottom" Height="2" IsIndeterminate="{Binding IsWorking}" Margin="0,0,0,1" IsHitTestVisible="False"
                             Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: проверено · ОБНОВИТЬ (= a new read-only analysis). Embedded in «Обслуживание», it shares its line with the
             host's tabs, which are drawn over its left side — so the wider actions sit on their own row below, not in the header. -->
        <c:PageHeader Index="{Binding Index}" Title="{Binding Title}" Subtitle="{Binding Subtitle}" Checked="{Binding CheckedText}"
                      RefreshCommand="{Binding RefreshCommand}">

        </c:PageHeader>

        <!-- One action line: secondary [ОТМЕНА] · РЕКОМЕНДУЕМЫЙ НАБОР wrap on the left, the ONE main button stays on the right -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                <Button Style="{StaticResource Btn.Danger}" Margin="0,0,8,0" Command="{Binding CancelCommand}"
                        Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static ui:Glyphs.Cancel}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:T ОТМЕНА}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Btn}" Command="{Binding ResetSelectionCommand}"
                        ToolTip="{loc:T 'Вернуть рекомендуемый набор пунктов'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static ui:Glyphs.Undo}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:T 'РЕКОМЕНДУЕМЫЙ НАБОР'}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>
            <Button Grid.Column="1" Style="{StaticResource Btn.Primary}" Command="{Binding CleanCommand}" VerticalAlignment="Top"
                    ToolTip="{loc:T 'Удалить отмеченное — после подтверждения со списком. Если анализ устарел, он выполнится заново.'}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static ui:Glyphs.Delete}" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,9,0" />
                    <TextBlock Text="{Binding PrimaryText}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
        <ScrollViewer Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="0,0,10,10">

                <!-- ═══════════════ Summary + status: one rounded strip ═══════════════ -->
                <Border Style="{StaticResource Card.Flush}" ui:RoundClip.Content="True">
                    <StackPanel>
                        <Grid MinHeight="54">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Padding="14,8" BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,1,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T НАЙДЕНО}" Style="{StaticResource T.Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding FoundValue}" Style="{StaticResource T.Stat}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding FoundUnit}" Style="{StaticResource T.StatUnit}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <!-- Emphasis without white fill (white = clickable only): a raised plate with a white edge -->
                            <Border Grid.Column="1" Background="{StaticResource B.Surface3}" BorderBrush="{StaticResource B.White}" BorderThickness="0,2,0,0" Padding="14,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T 'К ОЧИСТКЕ'}" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Text}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding SelectedValue}" Style="{StaticResource T.Stat}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SelectedUnit}" Style="{StaticResource T.StatUnit}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Padding="14,8" BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T ОСВОБОЖДЕНО}" Style="{StaticResource T.Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding FreedValue}" Style="{StaticResource T.Stat}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding FreedUnit}" Style="{StaticResource T.StatUnit}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Status strip -->
                        <Border Padding="16,10,15,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="7" Height="7" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource B.Text3}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource B.White}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding WorkTitle}" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Text}"
                                               VerticalAlignment="Center" Margin="9,0,11,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding WorkDetail}" Style="{StaticResource T.Caption}" VerticalAlignment="Center"
                                               Foreground="{StaticResource B.Text2}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Grid.Column="3" Text="{Binding WorkPercent}" Style="{StaticResource T.Mono}" FontSize="11.5" VerticalAlignment="Center"
                                               Foreground="{StaticResource B.Text}" Margin="10,0,0,0" />
                                </Grid>
                                <ProgressBar Grid.Row="1" Margin="0,9,0,0" Maximum="100" Value="{Binding WorkProgress}" IsIndeterminate="{Binding WorkIndeterminate}"
                                             Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══════════════ Free space: one card per fixed drive ═══════════════ -->
                <ItemsControl ItemsSource="{Binding Drives}" Focusable="False" Margin="0,10,-10,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:DriveCard}">
                            <Border Style="{StaticResource Card}" Padding="14,10,14,11" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'СВОБОДНОЕ МЕСТО'}" Style="{StaticResource T.Label}" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name, Converter={StaticResource Sentence}}" FontFamily="{StaticResource F.Display}" FontWeight="Bold" FontStretch="Condensed"
                                                   FontSize="19" Foreground="{StaticResource B.Text}" VerticalAlignment="Bottom" />
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource T.Label}" Margin="10,0,10,5"
                                                   VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding FreeText}" FontFamily="{StaticResource F.Display}" FontWeight="Bold"
                                                   FontStretch="Condensed" FontSize="17" Foreground="{StaticResource B.Text}" VerticalAlignment="Bottom" Margin="0,0,0,1" />
                                    </Grid>
                                    <c:Meter Value="{Binding UsedPercent}" Segments="32" Gap="2" Height="8" WarnThreshold="75" HotThreshold="90" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding Caption}" Style="{StaticResource T.Caption}" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Elevated as another account -->
                <TextBlock Text="{Binding ForeignUserText}" Style="{StaticResource T.Caption}" Margin="0,10,0,0"
                           Visibility="{Binding ForeignUserText, Converter={StaticResource NullToVis}}" />

                <!-- Windows is servicing itself -->
                <Border Style="{StaticResource BandCallout}" Visibility="{Binding ServicingText, Converter={StaticResource NullToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Fill="{StaticResource B.Info}" />
                        <StackPanel Grid.Column="1" Margin="12,10,14,11">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static ui:Glyphs.Sync}" FontFamily="{StaticResource F.Icons}" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{StaticResource B.InfoText}" Margin="0,0,10,0" />
                                <TextBlock Text="{loc:T 'Windows выполняет обслуживание'}" Style="{StaticResource T.H3}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding ServicingText}" Style="{StaticResource T.Body}" FontSize="12.5" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══════════════ Groups ═══════════════ -->
                <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:CleanGroup}">
                            <StackPanel Margin="0,22,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="{Binding Title, Converter={StaticResource Sentence}}" Style="{StaticResource T.H2}" FontFamily="{StaticResource F.Body}" FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                    <Rectangle Grid.Column="2" Height="1" Fill="{StaticResource B.Line2}" VerticalAlignment="Center" Margin="11,3,11,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding Meta}" Style="{StaticResource T.Mono}" FontSize="11.5" VerticalAlignment="Center"
                                               Foreground="{StaticResource B.Text2}" />
                                </Grid>
                                <TextBlock Text="{Binding Hint}" Style="{StaticResource T.Caption}" Margin="0,6,0,10" />
                                <!-- RoundClip: row hover, the white selection edge and the row progress bar paint to the edge.
                                     -1 bottom margin: the last row's hairline lies on the card's bottom border instead of doubling it. -->
                                <Border Style="{StaticResource Card.Flush}" ui:RoundClip.Content="True">
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ItemRow}" Focusable="False" Margin="0,0,0,-1" />
                                </Border>
                                <TextBlock Text="{Binding MissingText}" Style="{StaticResource T.Mono}" FontSize="11.5" Foreground="{StaticResource B.Text3}"
                                           Margin="0,10,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding MissingText, Converter={StaticResource NullToVis}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ═══════════════ What takes the space: the largest files — shown only, never deleted by Lycoris ═══════════════ -->
                <StackPanel Margin="0,22,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:T 'Что занимает место'}" Style="{StaticResource T.H2}" FontFamily="{StaticResource F.Body}" FontWeight="Bold" VerticalAlignment="Center" />
                        <Rectangle Grid.Column="1" Height="1" Fill="{StaticResource B.Line2}" VerticalAlignment="Center" Margin="11,3,11,0" />
                        <Button Grid.Column="2" Style="{StaticResource Btn}" Command="{Binding FindLargeFilesCommand}"
                                ToolTip="{loc:T 'Только поиск и показ: Lycoris не удаляет ваши файлы'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static ui:Glyphs.Search}" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{loc:T 'НАЙТИ КРУПНЫЕ ФАЙЛЫ'}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{loc:T 'Самые крупные файлы в вашей папке пользователя (от 100 МБ). Это ваши данные: Lycoris их только показывает, удалить или перенести — решаете вы в Проводнике.'}"
                               Style="{StaticResource T.Caption}" Margin="0,6,0,6" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LargeFilesSummary}" Style="{StaticResource T.Mono}" FontSize="11.5" Foreground="{StaticResource B.Text2}" Margin="0,0,0,10" TextWrapping="Wrap" />
                    <Border Style="{StaticResource Card.Flush}" ui:RoundClip.Content="True" Visibility="{Binding LargeFilesFound, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding LargeFilesList}" Focusable="False" Margin="0,0,0,-1">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:LargeFile}">
                                    <Border BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,0,1" Padding="14,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource T.BodyStrong}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                <TextBlock Text="{Binding Folder}" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{StaticResource B.Text3}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" />
                                                <TextBlock Text="{Binding Hint}" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.WarningText}" Margin="0,3,0,0" TextWrapping="Wrap"
                                                           Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding DateText}" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{StaticResource B.Text3}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <Button Grid.Column="3" Style="{StaticResource Btn}" Content="{loc:T 'ПОКАЗАТЬ'}" VerticalAlignment="Center"
                                                    ToolTip="{loc:T 'Открыть в Проводнике с выделенным файлом'}"
                                                    Command="{Binding DataContext.RevealLargeFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- ═══════════════ Bottom: what is never deleted (secondary text only) ═══════════════ -->
                <Expander Margin="0,22,0,0">
                    <Expander.Header>
                        <TextBlock Text="{loc:T 'ЧТО НИКОГДА НЕ УДАЛЯЕТСЯ'}" Style="{StaticResource T.Label}" />
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding NeverTouched}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:GuaranteeLine}">
                                <Grid Margin="0,6,14,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static ui:Glyphs.Lock}" FontFamily="{StaticResource F.Icons}" FontSize="12" Foreground="{StaticResource B.Text2}"
                                               VerticalAlignment="Top" Margin="0,3,0,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource T.BodyStrong}" FontSize="12.5" LineHeight="17" />
                                        <TextBlock Text="{Binding Reason}" Style="{StaticResource T.Caption}" Margin="0,3,0,0" LineHeight="16" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
