<UserControl x:Class="Lycoris.Modules.Home.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Lycoris.UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource F.Display}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource B.Text}" />
            <TextBlock Text="{Binding Subtitle}" Margin="0,4,0,16" Foreground="{StaticResource B.Text2}" />
            <Border Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" CornerRadius="{StaticResource R.Lg}" Padding="14" Margin="0,0,0,14">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DoctorText}" VerticalAlignment="Center" Foreground="{StaticResource B.Text}" FontSize="14"/>
                    <Button Grid.Column="1" Style="{StaticResource Btn}" Content="{loc:T ПОСМОТРЕТЬ И ИСПРАВИТЬ БЕЗОПАСНОЕ}" Command="{Binding OpenDoctorCommand}"/>
                </Grid>
            </Border>
            <UniformGrid Columns="2">
                <Border Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" CornerRadius="{StaticResource R.Lg}" Padding="16" Margin="0,0,8,8"><StackPanel><TextBlock Text="{loc:T Игры}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource B.Text}"/><TextBlock Text="{loc:T Игровой профиль оптимизации и настройки игр.}" Margin="0,8" Foreground="{StaticResource B.Text2}"/><TextBlock Text="{loc:T БЕЗОПАСНО}" Foreground="{StaticResource B.SuccessText}"/><Button Style="{StaticResource Btn}" Content="{loc:T ВЫБРАТЬ}" Command="{Binding SelectGoalCommand}" CommandParameter="Gaming" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Border>
                <Border Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" CornerRadius="{StaticResource R.Lg}" Padding="16" Margin="8,0,0,8"><StackPanel><TextBlock Text="{loc:T Работа}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource B.Text}"/><TextBlock Text="{loc:T Ближайший готовый сценарий — обычный режим без игрового профиля.}" TextWrapping="Wrap" Margin="0,8" Foreground="{StaticResource B.Text2}"/><TextBlock Text="{loc:T БЕЗОПАСНО}" Foreground="{StaticResource B.SuccessText}"/><Button Style="{StaticResource Btn}" Content="{loc:T ВЫБРАТЬ}" Command="{Binding SelectGoalCommand}" CommandParameter="Normal" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Border>
                <Border Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" CornerRadius="{StaticResource R.Lg}" Padding="16" Margin="0,8,8,0"><StackPanel><TextBlock Text="{loc:T Ноутбук от батареи}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource B.Text}"/><TextBlock Text="{loc:T Сценарий автономности; доступность зависит от устройства.}" Margin="0,8" Foreground="{StaticResource B.Text2}"/><TextBlock Text="{loc:T БЕЗОПАСНО}" Foreground="{StaticResource B.SuccessText}"/><Button Style="{StaticResource Btn}" Content="{loc:T ВЫБРАТЬ}" Command="{Binding SelectGoalCommand}" CommandParameter="Efficiency" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Border>
                <Border Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" CornerRadius="{StaticResource R.Lg}" Padding="16" Margin="8,8,0,0"><StackPanel><TextBlock Text="{loc:T Тишина и охлаждение}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource B.Text}"/><TextBlock Text="{loc:T Ближайший готовый сценарий — обычный режим; отдельных настроек охлаждения нет.}" TextWrapping="Wrap" Margin="0,8" Foreground="{StaticResource B.Text2}"/><TextBlock Text="{loc:T БЕЗОПАСНО}" Foreground="{StaticResource B.SuccessText}"/><Button Style="{StaticResource Btn}" Content="{loc:T ВЫБРАТЬ}" Command="{Binding SelectGoalCommand}" CommandParameter="Normal" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Border>
            </UniformGrid>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Style="{StaticResource Btn}" Content="{loc:T ИГРЫ}" Command="{Binding OpenGamesCommand}" Margin="0,0,8,0"/><Button Style="{StaticResource Btn}" Content="{loc:T ОЧИСТКА}" Command="{Binding OpenCleanerCommand}" Margin="0,0,8,0"/><Button Style="{StaticResource Btn}" Content="{loc:T ОТКАТ}" Command="{Binding OpenRestoreCommand}"/></StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
