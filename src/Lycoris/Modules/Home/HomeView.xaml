<UserControl x:Class="Lycoris.Modules.Home.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Lycoris.UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource F.Display}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource B.Text}" />
            <TextBlock Text="{Binding Subtitle}" Margin="0,4,0,14" Foreground="{StaticResource B.Text2}" />
            <Border Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" CornerRadius="{StaticResource R.Lg}" Padding="10" Margin="0,0,0,8"
                    Visibility="{Binding ShowWizardPrompt, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{loc:T Настроим ПК вместе}" Style="{StaticResource T.H3}" Foreground="{StaticResource B.Text}"/>
                        <TextBlock Text="{loc:T Мастер поможет выбрать безопасный профиль под ваши задачи.}" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text2}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <!-- One primary action per page: the wizard button steps back to an ordinary one while «ИСПРАВИТЬ ВСЁ БЕЗОПАСНОЕ» is shown. -->
                    <Button Grid.Column="1" Style="{StaticResource Btn.Primary}" Content="{loc:T НАЧАТЬ МАСТЕР}" Command="{Binding OpenWizardCommand}" VerticalAlignment="Center" Visibility="{Binding HasSafeFixes, Converter={StaticResource InverseBoolToVis}}"/>
                    <Button Grid.Column="1" Style="{StaticResource Btn}" Content="{loc:T НАЧАТЬ МАСТЕР}" Command="{Binding OpenWizardCommand}" VerticalAlignment="Center" Visibility="{Binding HasSafeFixes, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding Goals}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Border Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" CornerRadius="{StaticResource R.Lg}" Padding="10" Margin="0,0,6,6">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource F.Icons}" FontSize="30" Foreground="{StaticResource B.Text}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,3,8,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource B.Text}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Description}" Margin="0,3,0,0" Foreground="{StaticResource B.Text2}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Fact}" Margin="0,5,0,0" Foreground="{StaticResource B.Text}" TextWrapping="Wrap" Visibility="{Binding Fact, Converter={StaticResource NullToVis}}"/>
                                <Border HorizontalAlignment="Left" Margin="0,7,0,0"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Tag.Ok}"><Style.Triggers><DataTrigger Binding="{Binding Id}" Value="startup"><Setter Property="Background" Value="{StaticResource B.InfoDeep}"/><Setter Property="BorderBrush" Value="{StaticResource B.Info}"/></DataTrigger><DataTrigger Binding="{Binding Id}" Value="cleanup"><Setter Property="Background" Value="{StaticResource B.InfoDeep}"/><Setter Property="BorderBrush" Value="{StaticResource B.Info}"/></DataTrigger><DataTrigger Binding="{Binding Id}" Value="laptop"><Setter Property="Background" Value="{StaticResource B.InfoDeep}"/><Setter Property="BorderBrush" Value="{StaticResource B.Info}"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Risk}" Foreground="{StaticResource B.SuccessText}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource T.Label}"><Setter Property="Foreground" Value="{StaticResource B.SuccessText}"/><Style.Triggers><DataTrigger Binding="{Binding Id}" Value="startup"><Setter Property="Foreground" Value="{StaticResource B.InfoText}"/></DataTrigger><DataTrigger Binding="{Binding Id}" Value="cleanup"><Setter Property="Foreground" Value="{StaticResource B.InfoText}"/></DataTrigger><DataTrigger Binding="{Binding Id}" Value="laptop"><Setter Property="Foreground" Value="{StaticResource B.InfoText}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
                                <TextBlock Text="{Binding ExpertDetail}" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text3}" Margin="0,2,0,0" TextWrapping="Wrap" Visibility="{Binding DataContext.ExpertMode, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}"/>
                                <Button Style="{StaticResource Btn}" Content="{Binding Action}" Command="{Binding DataContext.OpenGoalCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" CornerRadius="{StaticResource R.Lg}" Padding="10" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{loc:T Замер до / после}" Style="{StaticResource T.H3}" Foreground="{StaticResource B.Text}"/>
                        <TextBlock Text="{Binding MeasurementSummary}" Foreground="{StaticResource B.Text}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding MeasurementDetails}" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text3}" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="{Binding ExpertMode, Converter={StaticResource BoolToVis}}"/>
                        <Border Visibility="{Binding ExpertMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding BootTimeSourceText}" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text2}" Margin="0,2,0,0" TextWrapping="Wrap" Visibility="{Binding BootTimeSourceText, Converter={StaticResource NullToVis}}"/>
                        </Border>
                        <TextBlock Text="{Binding MeasurementNote}" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.WarningText}" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="{Binding MeasurementNote, Converter={StaticResource NullToVis}}"/>
                        <TextBlock Text="{loc:T Замер только читает данные и хранится на этом ПК}" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text2}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource Btn}" Content="{loc:T ЗАПИСАТЬ ЗАМЕР}" Command="{Binding RecordMeasurementCommand}" VerticalAlignment="Center"/>
                    <!-- History: newest first, «дата · показатели · изменение к предыдущему»; differences inside the noise are said so. -->
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                        <StackPanel.Resources>
                        <DataTemplate x:Key="MeasurementRow">
                            <Border BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Padding="0,5,0,5">
                                <StackPanel>
                                    <WrapPanel>
                                        <TextBlock Text="{Binding When}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text2}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Values}" Foreground="{StaticResource B.Text}" TextWrapping="Wrap"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Change}" Margin="0,2,0,0" TextWrapping="Wrap">
                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource T.Caption}"><Setter Property="Foreground" Value="{StaticResource B.Text2}"/><Style.Triggers><DataTrigger Binding="{Binding Incomparable}" Value="True"><Setter Property="Foreground" Value="{StaticResource B.WarningText}"/></DataTrigger><DataTrigger Binding="{Binding WithinNoise}" Value="True"><Setter Property="Foreground" Value="{StaticResource B.Text3}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                        </StackPanel.Resources>
                        <TextBlock Text="{loc:T ИСТОРИЯ ЗАМЕРОВ}" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Text3}" Margin="0,0,0,4" Visibility="{Binding HasMeasurements, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{loc:T 'Запишите замер сейчас и ещё раз после изменений — здесь появится история с разницей между замерами.'}" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text2}" TextWrapping="Wrap" Visibility="{Binding HasMeasurements, Converter={StaticResource InverseBoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding MeasurementHistoryTop}" ItemTemplate="{StaticResource MeasurementRow}" Focusable="False"/>
                        <Expander Margin="0,4,0,0" IsExpanded="{Binding MeasurementHistoryExpanded, Mode=TwoWay}" Visibility="{Binding HasMoreMeasurementHistory, Converter={StaticResource BoolToVis}}">
                            <Expander.Header><TextBlock Text="{Binding MoreMeasurementHistoryText}" Style="{StaticResource T.Label}"/></Expander.Header>
                            <ItemsControl ItemsSource="{Binding MeasurementHistoryMore}" ItemTemplate="{StaticResource MeasurementRow}" Focusable="False"/>
                        </Expander>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" CornerRadius="{StaticResource R.Lg}" Padding="8" Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <Ellipse Width="9" Height="9" HorizontalAlignment="Left" Margin="1,0,0,4"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource B.SuccessText}"/><Style.Triggers><DataTrigger Binding="{Binding DoctorHasProblems}" Value="True"><Setter Property="Fill" Value="{StaticResource B.WarningText}"/></DataTrigger><DataTrigger Binding="{Binding DoctorHasData}" Value="False"><Setter Property="Fill" Value="{StaticResource B.Text3}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
                            <TextBlock Text="{Binding DoctorStatus}" Foreground="{StaticResource B.Text}" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{Binding DoctorChecked}" Foreground="{StaticResource B.Text2}" Style="{StaticResource T.Caption}" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding ScoreText}" Style="{StaticResource T.Stat}" Margin="0,6,0,0" Visibility="{Binding ScoreText, Converter={StaticResource NullToVis}}" ToolTip="{loc:T 'Оценка ПК по проверкам «Панели»: 100 — замечаний нет'}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource Btn.Primary}" Content="{Binding FixSafeText}" Command="{Binding FixSafeCommand}" Margin="0,0,8,0" Visibility="{Binding HasSafeFixes, Converter={StaticResource BoolToVis}}" ToolTip="{loc:T 'Одно подтверждение, запись в журнал и откат — то же, что на «Панели»'}"/>
                            <Button Style="{StaticResource Btn}" Content="{loc:T ПРОВЕРИТЬ СНОВА}" Command="{Binding RefreshDoctorCommand}" Visibility="{Binding DoctorHasProblems, Converter={StaticResource InverseBoolToVis}}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{loc:T Остальное требует вашего решения — кнопки у каждого пункта ниже}" Style="{StaticResource T.Caption}" Margin="0,6,0,0" Visibility="{Binding ShowDecisionHint, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{loc:T Пока не удалось получить результаты проверки.}" Foreground="{StaticResource B.Text2}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding DoctorHasData, Converter={StaticResource InverseBoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding DoctorIssues}" Margin="0,4,0,0" Visibility="{Binding DoctorHasProblems, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border BorderBrush="{StaticResource B.Line2}" BorderThickness="0,1,0,0" Padding="0,5,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Ellipse Width="9" Height="9" Margin="2,5,10,0" VerticalAlignment="Top"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource B.WarningText}"/><Style.Triggers><DataTrigger Binding="{Binding DotStyle}" Value="Dot.Red"><Setter Property="Fill" Value="{StaticResource B.Red}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource B.Text}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Reason}" Foreground="{StaticResource B.Text2}" Margin="0,3,8,3" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource Tag.Info}" Margin="0,0,6,0"><TextBlock Text="{Binding Risk}" Style="{StaticResource T.Label}" Foreground="{StaticResource B.InfoText}"/></Border>
                                        </StackPanel>
                                        <Expander Header="{loc:T ПОДРОБНЕЕ}" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding FullDetail}" Foreground="{StaticResource B.Text2}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </Expander>
                                        <TextBlock Text="{Binding TechnicalDetail}" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text3}" TextWrapping="Wrap" Visibility="{Binding DataContext.ExpertMode, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource Btn}" Content="{Binding Action}" Command="{Binding DataContext.RunDoctorActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="8,0,0,0" VerticalAlignment="Top"/>
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource Btn.Link}" Content="{loc:T ВСЕ ПРОБЛЕМЫ}" Command="{Binding OpenDoctorCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="{Binding DoctorHasProblems, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{loc:T ЧТО МЕНЯЛОСЬ}" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Text2}" Margin="0,4,0,4"/>
            <Border Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" CornerRadius="{StaticResource R.Lg}" Padding="12">
                <StackPanel>
                    <TextBlock Text="{loc:T Lycoris ещё ничего не менял}" Style="{StaticResource T.H3}" Foreground="{StaticResource B.Text}" Visibility="{Binding HasJournalEntries, Converter={StaticResource InverseBoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding RecentChanges}" Visibility="{Binding HasJournalEntries, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Date}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text3}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Grid.Column="1" Margin="8,0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource B.Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:T ОТКАЧЕНО}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text3}" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding IsReverted, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource Btn}" Content="{Binding ActionLabel}" Command="{Binding DataContext.OpenRestoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Id}"/>
                            </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource Btn.Link}" Content="{loc:T ОТКРЫТЬ ВОССТАНОВЛЕНИЕ}" Command="{Binding OpenRestoreCommand}" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
