<UserControl x:Class="Lycoris.Modules.Removal.RemovalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Lycoris.UI.Controls"
             xmlns:loc="clr-namespace:Lycoris.UI">
    <UserControl.Resources>
        <DataTemplate x:Key="RemovalBrowser">
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding InventoryMessage}" Style="{StaticResource T.Caption}" Margin="0,0,0,8"
                           Visibility="{Binding HasBatchPreview, Converter={StaticResource InverseBoolToVis}}" />
                <Grid Grid.Row="1" Margin="0,0,0,10"
                      Visibility="{Binding HasBatchPreview, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:T Поиск}" Style="{StaticResource T.Caption}" VerticalAlignment="Center" Margin="0,0,9,0" />
                    <TextBox Grid.Column="1" Height="33" Margin="0,0,12,0"
                             AutomationProperties.Name="{loc:T Поиск}"
                             AutomationProperties.AutomationId="RemovalSearch"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
                    <ComboBox Grid.Column="2" MinWidth="164" MaxWidth="300" Height="33" AutomationProperties.Name="{loc:T Фильтр по решению}"
                              AutomationProperties.AutomationId="RemovalDecisionFilter"
                              ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" DisplayMemberPath="Title" />
                </Grid>

                <Grid Grid.Row="2" Visibility="{Binding HasBatchPreview, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card.Flush}" Padding="0" Margin="0,0,10,0">
                        <Grid>
                            <ListBox ItemsSource="{Binding VisibleRows}" SelectedItem="{Binding SelectedRow}"
                                     AutomationProperties.Name="{loc:T Результаты проверки}" HorizontalContentAlignment="Stretch"
                                     AutomationProperties.AutomationId="RemovalResults"
                                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="10,7" />
                                        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,5">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource T.BodyStrong}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Metadata}" Style="{StaticResource T.Caption}" TextTrimming="CharacterEllipsis" />
                                            <Border Style="{StaticResource Tag.Muted}" HorizontalAlignment="Left" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding DecisionText}" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource T.Caption}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Margin="15" TextAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="{loc:T 'Выберите запись, чтобы увидеть основание решения.'}" Style="{StaticResource T.Caption}"
                                           Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />
                                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding SelectedRow.Name}" Style="{StaticResource T.H2}"
                                               AutomationProperties.AutomationId="RemovalSelectedName" />
                                    <TextBlock Text="{Binding SelectedRow.Metadata}" Style="{StaticResource T.Caption}" Margin="0,4,0,10" />
                                    <Border Style="{StaticResource Tag.Solid}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding SelectedRow.DecisionText}" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock Text="{Binding SelectedRow.Reason}" Style="{StaticResource T.Body}"
                                               AutomationProperties.AutomationId="RemovalSelectedReason" />
                                    <StackPanel Margin="0,14,0,0" Visibility="{Binding ShowProgramAction, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{loc:T 'Сверьте имя, издателя и версию. Если решите удалить программу, подтвердите это в Параметрах Windows.'}"
                                                   Style="{StaticResource T.Caption}" Margin="0,0,0,8" />
                                        <Button Content="{loc:T СВЕРИТЬ В WINDOWS}" Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left"
                                                Command="{Binding OpenSelectedProgramCommand}" />
                                    </StackPanel>
                                    <Button Content="{loc:T НАЙТИ ЗАПИСЬ В АВТОЗАПУСКЕ}" Margin="0,14,0,0" Style="{StaticResource Btn.Ghost}"
                                            HorizontalAlignment="Left" Command="{Binding OpenSelectedStartupCommand}"
                                            Visibility="{Binding ShowStartupAction, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Border Grid.RowSpan="3" Style="{StaticResource Card}"
                        Visibility="{Binding HasBatchPreview, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding BatchPreviewTitle}" Style="{StaticResource T.H2}"
                                       AutomationProperties.AutomationId="RemovalBatchPreviewTitle" />
                            <TextBlock Text="{Binding BatchPreviewDescription}" Style="{StaticResource T.Caption}" Margin="0,5,0,8" />
                        </StackPanel>
                        <WrapPanel Grid.Row="1" Margin="0,0,0,4">
                            <TextBlock Text="{Binding BatchSelectionText}" Style="{StaticResource T.BodyStrong}" VerticalAlignment="Center"
                                       Margin="0,0,12,4" AutomationProperties.AutomationId="RemovalBatchSelectionCount" />
                            <Button Content="{loc:T ВЫБРАТЬ ВСЕ}" Style="{StaticResource Btn.Ghost}"
                                    Command="{Binding SelectAllBatchCommand}" Margin="0,0,6,4" />
                            <Button Content="{loc:T СНЯТЬ ВЫБОР}" Style="{StaticResource Btn.Ghost}"
                                    Command="{Binding ClearBatchSelectionCommand}" Margin="0,0,0,4" />
                        </WrapPanel>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding BatchRows}" IsEnabled="{Binding CanEditBatchPreview}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  AutomationProperties.Name="{Binding Name}" Margin="0,0,4,7"
                                                  VerticalContentAlignment="Top">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource T.BodyStrong}" />
                                                <TextBlock Text="{Binding Metadata}" Style="{StaticResource T.Caption}" />
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource T.Caption}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel Grid.Row="3" Margin="0,8,0,0">
                            <TextBlock Text="{Binding BatchRightsNotice}" Style="{StaticResource T.Caption}" Margin="0,0,0,6"
                                       Visibility="{Binding BatchRightsNotice, Converter={StaticResource NullToVis}}" />
                            <WrapPanel>
                                <Button Content="{Binding BatchExecuteText}" Command="{Binding ExecuteBatchCommand}" Margin="0,0,6,0"
                                        AutomationProperties.AutomationId="RemovalExecuteBatch"
                                        Visibility="{Binding IsUninstallPreview, Converter={StaticResource InverseBoolToVis}}"
                                        Style="{StaticResource Btn.Primary}" />
                                <Button Content="{Binding BatchExecuteText}" Command="{Binding ExecuteBatchCommand}" Margin="0,0,6,0"
                                        AutomationProperties.AutomationId="RemovalExecuteBatch"
                                        Visibility="{Binding IsUninstallPreview, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource Btn.Danger}" />
                                <Button Content="{loc:T ОТМЕНА}" Style="{StaticResource Btn.Ghost}" Command="{Binding CancelBatchPreviewCommand}"
                                        AutomationProperties.AutomationId="RemovalCancelBatchPreview" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <c:PageHeader Title="{Binding Title}" Subtitle="{Binding Subtitle}" Checked="{Binding CheckedText}"
                      RefreshCommand="{Binding RefreshCommand}" />

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,10" Padding="12,8">
            <StackPanel>
                <WrapPanel Margin="0,0,0,4">
                    <Button Content="{loc:T ПРОВЕРИТЬ И УДАЛИТЬ}" Style="{StaticResource Btn.Primary}"
                            Command="{Binding AutoUninstallCommand}" Margin="0,0,6,4" AutomationProperties.AutomationId="RemovalAutoUninstall" />
                    <Button Content="{loc:T ПРОВЕРИТЬ И ОТКЛЮЧИТЬ АВТОЗАПУСК}" Style="{StaticResource Btn.Primary}"
                            Command="{Binding AutoDisableStartupCommand}" Margin="0,0,0,4" AutomationProperties.AutomationId="RemovalAutoDisableStartup" />
                </WrapPanel>
                <TextBlock Text="{loc:T 'Lycoris подберёт подходящие записи и попросит подтвердить список. Чтобы сначала изменить выбор, откройте предпросмотр.'}"
                           Style="{StaticResource T.Caption}" Margin="1,0,0,5" />
                <WrapPanel Margin="0,0,0,4">
                    <Button Content="{loc:T ПРЕДПРОСМОТР УДАЛЕНИЯ}" Style="{StaticResource Btn.Ghost}"
                            Command="{Binding PrepareUninstallCommand}" Margin="0,0,6,4" AutomationProperties.AutomationId="RemovalPrepareUninstall" />
                    <Button Content="{loc:T ПРЕДПРОСМОТР ОТКЛЮЧЕНИЯ}" Style="{StaticResource Btn.Ghost}"
                            Command="{Binding PrepareDisableStartupCommand}" Margin="0,0,0,4" AutomationProperties.AutomationId="RemovalPrepareDisableStartup" />
                </WrapPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="94" Margin="1,0,0,8" Visibility="{Binding HasBatchMessage, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding BatchMessage}" Style="{StaticResource T.Caption}"
                               AutomationProperties.AutomationId="RemovalBatchMessage" />
                </ScrollViewer>
                <WrapPanel>
                    <Button Content="{loc:T ПРИЛОЖЕНИЯ WINDOWS}" Style="{StaticResource Btn.Ghost}" Command="{Binding OpenWindowsAppsCommand}"
                            Margin="0,0,6,4" />
                    <Button Content="{loc:T ДОПОЛНИТЕЛЬНЫЕ КОМПОНЕНТЫ WINDOWS}" Style="{StaticResource Btn.Ghost}"
                            Command="{Binding OpenWindowsFeaturesCommand}" Margin="0,0,6,4" />
                    <Button Content="{loc:T ПРОВЕРИТЬ СЛУЖБЫ}" Style="{StaticResource Btn.Ghost}" Command="{Binding OpenServicesCommand}"
                            Margin="0,0,0,4" />
                </WrapPanel>
                <TextBlock Text="{loc:T 'Дополнительные компоненты меняются в Windows. Перед отключением проверьте, где используется компонент.'}"
                           Style="{StaticResource T.Caption}" Margin="1,2,0,0" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" SelectedIndex="{Binding TabIndex}">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource SegmentBar}">
                            <TabPanel IsItemsHost="True" />
                        </Border>
                        <!-- WPF's selected tab automation peer looks up this named content host. -->
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" Margin="0,16,0,0" />
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabItem Header="{loc:T ПРОГРАММЫ}" Content="{Binding}" ContentTemplate="{StaticResource RemovalBrowser}"
                     HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            <TabItem Header="{loc:T АВТОЗАПУСК}" Content="{Binding}" ContentTemplate="{StaticResource RemovalBrowser}"
                     HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </TabControl>
    </Grid>
</UserControl>
