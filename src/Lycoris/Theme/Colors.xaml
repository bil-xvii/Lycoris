<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Shape tokens: clearly rounded corners, still strict (owner, 27.10: «вообще не округлен… сделай ещё более круглым,
        не такой заостренный, но строгим, агрессивным и профессиональным»). Every surface uses one of these — no ad-hoc values.
        R.Xs   4  checkboxes, progress bars, scroll thumbs, meter segments, tiny badges
        R.Sm   6  tags, chips, small icon buttons
        R.Md   8  buttons, inputs, combo boxes, toggles, nav items, row highlights
        R.Lg  12  cards, callouts, tiles, list panels, strips
        R.Xl  16  popups, dialogs, toasts, menus
        *.D       the same radius as a double (Rectangle.RadiusX/RadiusY, clip geometries).
        The window itself uses the Windows 11 rounded frame (DWMWCP_ROUND).
    -->
    <CornerRadius x:Key="R.Xs">4</CornerRadius>
    <CornerRadius x:Key="R.Sm">6</CornerRadius>
    <CornerRadius x:Key="R.Md">8</CornerRadius>
    <CornerRadius x:Key="R.Lg">12</CornerRadius>
    <CornerRadius x:Key="R.Xl">16</CornerRadius>
    <sys:Double x:Key="R.Xs.D">4</sys:Double>
    <sys:Double x:Key="R.Sm.D">6</sys:Double>
    <sys:Double x:Key="R.Md.D">8</sys:Double>
    <sys:Double x:Key="R.Lg.D">12</sys:Double>
    <sys:Double x:Key="R.Xl.D">16</sys:Double>

    <!-- Graphite canvas, layered slate surfaces, and steel for interactive states. -->
    <!-- Outline marks active control boundaries. The Line colors divide static surfaces. -->
    <!-- Text4 is reserved for disabled controls. -->
    <Color x:Key="C.Base">#FF12171E</Color>
    <Color x:Key="C.Surface">#FF19212B</Color>
    <Color x:Key="C.Surface2">#FF202A36</Color>
    <Color x:Key="C.Surface3">#FF283543</Color>
    <Color x:Key="C.Surface4">#FF303E4E</Color>
    <Color x:Key="C.Line">#FF2C3948</Color>
    <Color x:Key="C.Line2">#FF354555</Color>
    <Color x:Key="C.Line3">#FF415063</Color>
    <Color x:Key="C.Text">#FFE8EDF2</Color>
    <Color x:Key="C.Text2">#FFB8C5D2</Color>
    <Color x:Key="C.Text3">#FFA4B0BD</Color>
    <Color x:Key="C.Text4">#FF8794A2</Color>
    <Color x:Key="C.Outline">#FF8192A1</Color>
    <Color x:Key="C.Selected">#FF2B3E51</Color>
    <Color x:Key="C.White">#FFFFFFFF</Color>
    <Color x:Key="C.Black">#FF000000</Color>
    <Color x:Key="C.Ink">#FF121C26</Color>
    <Color x:Key="C.Scrim">#D20B1118</Color>

    <!-- Primary action fills share the same dark foreground across pointer states. -->
    <Color x:Key="C.Accent">#FFABC0D4</Color>
    <Color x:Key="C.AccentHover">#FFC1D1E0</Color>
    <Color x:Key="C.AccentPressed">#FF97ADC2</Color>

    <!-- Semantic colors provide an edge or icon, readable text, and a low-luminance background. -->
    <Color x:Key="C.Red">#FFC27880</Color>
    <Color x:Key="C.RedHover">#FFD79AA1</Color>
    <Color x:Key="C.RedText">#FFE0A0A6</Color>
    <Color x:Key="C.RedDeep">#FF302027</Color>
    <Color x:Key="C.Success">#FF77A789</Color>
    <Color x:Key="C.SuccessText">#FFA0C9AD</Color>
    <Color x:Key="C.SuccessDeep">#FF182820</Color>
    <Color x:Key="C.Warning">#FFBE9D65</Color>
    <Color x:Key="C.WarningText">#FFD8BA88</Color>
    <Color x:Key="C.WarningDeep">#FF2B251B</Color>
    <Color x:Key="C.Info">#FF789AB9</Color>
    <Color x:Key="C.InfoText">#FFA2BDD7</Color>
    <Color x:Key="C.InfoDeep">#FF172738</Color>

    <SolidColorBrush x:Key="B.Base" Color="{StaticResource C.Base}" />
    <SolidColorBrush x:Key="B.Surface" Color="{StaticResource C.Surface}" />
    <SolidColorBrush x:Key="B.Surface2" Color="{StaticResource C.Surface2}" />
    <SolidColorBrush x:Key="B.Surface3" Color="{StaticResource C.Surface3}" />
    <SolidColorBrush x:Key="B.Surface4" Color="{StaticResource C.Surface4}" />
    <SolidColorBrush x:Key="B.Line" Color="{StaticResource C.Line}" />
    <SolidColorBrush x:Key="B.Line2" Color="{StaticResource C.Line2}" />
    <SolidColorBrush x:Key="B.Line3" Color="{StaticResource C.Line3}" />
    <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="B.Text2" Color="{StaticResource C.Text2}" />
    <SolidColorBrush x:Key="B.Text3" Color="{StaticResource C.Text3}" />
    <SolidColorBrush x:Key="B.Text4" Color="{StaticResource C.Text4}" />
    <SolidColorBrush x:Key="B.Outline" Color="{StaticResource C.Outline}" />
    <SolidColorBrush x:Key="B.Selected" Color="{StaticResource C.Selected}" />
    <SolidColorBrush x:Key="B.White" Color="{StaticResource C.White}" />
    <SolidColorBrush x:Key="B.Black" Color="{StaticResource C.Black}" />
    <SolidColorBrush x:Key="B.Ink" Color="{StaticResource C.Ink}" />
    <SolidColorBrush x:Key="B.Scrim" Color="{StaticResource C.Scrim}" />
    <SolidColorBrush x:Key="B.Transparent" Color="Transparent" />
    <SolidColorBrush x:Key="B.Accent" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="B.AccentHover" Color="{StaticResource C.AccentHover}" />
    <SolidColorBrush x:Key="B.AccentPressed" Color="{StaticResource C.AccentPressed}" />
    <SolidColorBrush x:Key="B.OnAccent" Color="{StaticResource C.Ink}" />
    <SolidColorBrush x:Key="B.Red" Color="{StaticResource C.Red}" />
    <SolidColorBrush x:Key="B.RedHover" Color="{StaticResource C.RedHover}" />
    <SolidColorBrush x:Key="B.RedText" Color="{StaticResource C.RedText}" />
    <SolidColorBrush x:Key="B.RedDeep" Color="{StaticResource C.RedDeep}" />
    <SolidColorBrush x:Key="B.Success" Color="{StaticResource C.Success}" />
    <SolidColorBrush x:Key="B.SuccessText" Color="{StaticResource C.SuccessText}" />
    <SolidColorBrush x:Key="B.SuccessDeep" Color="{StaticResource C.SuccessDeep}" />
    <SolidColorBrush x:Key="B.Warning" Color="{StaticResource C.Warning}" />
    <SolidColorBrush x:Key="B.WarningText" Color="{StaticResource C.WarningText}" />
    <SolidColorBrush x:Key="B.WarningDeep" Color="{StaticResource C.WarningDeep}" />
    <SolidColorBrush x:Key="B.Info" Color="{StaticResource C.Info}" />
    <SolidColorBrush x:Key="B.InfoText" Color="{StaticResource C.InfoText}" />
    <SolidColorBrush x:Key="B.InfoDeep" Color="{StaticResource C.InfoDeep}" />

    <SolidColorBrush x:Key="B.RowHover" Color="{StaticResource C.Surface3}" />

    <!-- Former pattern resource keys now provide flat layers for existing panels and indicators. -->
    <SolidColorBrush x:Key="B.Hatch" Color="#354A6279" />
    <SolidColorBrush x:Key="B.HatchStrong" Color="{StaticResource C.Outline}" />
    <SolidColorBrush x:Key="B.DotGrid" Color="Transparent" />
    <SolidColorBrush x:Key="B.ChartFill" Color="#28789AB9" />
</ResourceDictionary>
