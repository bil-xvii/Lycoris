<Window x:Class="Lycoris.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Lycoris.UI"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:Lycoris.Shell"
        xmlns:ui="clr-namespace:Lycoris.UI"
        xmlns:dash="clr-namespace:Lycoris.Modules.Dashboard"
        xmlns:home="clr-namespace:Lycoris.Modules.Home"
        xmlns:opt="clr-namespace:Lycoris.Modules.Optimize"
        xmlns:games="clr-namespace:Lycoris.Modules.Games"
        xmlns:maint="clr-namespace:Lycoris.Modules.Maintenance"
        xmlns:drv="clr-namespace:Lycoris.Modules.Drivers"
        xmlns:svc="clr-namespace:Lycoris.Modules.Services"
        xmlns:apps="clr-namespace:Lycoris.Modules.Apps"
        xmlns:dev="clr-namespace:Lycoris.Modules.Devices"
        xmlns:rest="clr-namespace:Lycoris.Modules.Restore"
        xmlns:set="clr-namespace:Lycoris.Modules.Settings"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=shell:MainViewModel}"
        Title="Lycoris" Width="1380" Height="880" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{StaticResource B.Base}"
        Foreground="{StaticResource B.Text}" FontFamily="{StaticResource F.Body}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/Assets/lycoris.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Page view-model → view -->
        <DataTemplate DataType="{x:Type home:HomeViewModel}"><home:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type dash:DashboardViewModel}"><dash:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type opt:OptimizeViewModel}"><opt:OptimizeView /></DataTemplate>
        <DataTemplate DataType="{x:Type games:GamesViewModel}"><games:GamesView /></DataTemplate>
        <DataTemplate DataType="{x:Type maint:MaintenanceViewModel}"><maint:MaintenanceView /></DataTemplate>
        <DataTemplate DataType="{x:Type drv:DriversViewModel}"><drv:DriversView /></DataTemplate>
        <DataTemplate DataType="{x:Type svc:ServicesViewModel}"><svc:ServicesView /></DataTemplate>
        <DataTemplate DataType="{x:Type dev:DevicesViewModel}"><dev:DevicesView /></DataTemplate>
        <DataTemplate DataType="{x:Type apps:AppsViewModel}"><apps:AppsView /></DataTemplate>
        <DataTemplate DataType="{x:Type rest:RestoreViewModel}"><rest:RestoreView /></DataTemplate>
        <DataTemplate DataType="{x:Type set:SettingsViewModel}"><set:SettingsView /></DataTemplate>

        <!-- Page enter animation -->
        <Storyboard x:Key="PageEnter">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="10" To="0" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Title-bar buttons: outlined like every action, 28 px to fit the 40 px caption, clickable inside the chrome -->
        <Style x:Key="Btn.TitleBar" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
        <Style x:Key="Btn.TitleBar.Primary" TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource B.Line2}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="226" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═══════════════ Title bar ═══════════════ -->
            <Grid Grid.ColumnSpan="2" Background="{StaticResource B.Base}">
                <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{StaticResource B.Line}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <!-- Logo: Lycoris mark (Theme/Brand.xaml) -->
                    <Path Data="{StaticResource G.LycorisMark}" Fill="{StaticResource B.Red}" Stretch="Uniform" Width="26" Height="26" VerticalAlignment="Center" />
                    <TextBlock Text="Lycoris" Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource F.Display}"
                               FontWeight="Bold" FontStretch="Condensed" FontSize="21" Foreground="{StaticResource B.Text}" />
                    <TextBlock Text="{Binding Version}" Margin="10,3,0,0" VerticalAlignment="Center" Style="{StaticResource T.Mono}"
                               FontSize="11.5" Foreground="{StaticResource B.Text3}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- «ОБНОВЛЕНИЕ 1.0.1»: a newer version exists (Core/Updates). White = clickable; opens the confirmation with what will happen. -->
                    <Button Style="{StaticResource Btn.TitleBar.Primary}" Command="{Binding Updates.UpdateNowCommand}"
                            Visibility="{Binding Updates.ButtonVisible, Converter={StaticResource BoolToVis}}"
                            ToolTip="{loc:T 'Вышла новая версия Lycoris. Нажмите, чтобы посмотреть, что изменится, и обновить.'}">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource Dot.Red}" Margin="0,0,8,0" />
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Updates.ButtonText}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource SegmentBar}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="{loc:T ПРОСТОЙ}" Command="{Binding SetSimpleModeCommand}" IsChecked="{Binding ExpertMode, Converter={StaticResource InverseBool}}" />
                            <RadioButton Style="{StaticResource Segment}" Content="{loc:T ЭКСПЕРТ}" Command="{Binding SetExpertModeCommandCommand}" IsChecked="{Binding ExpertMode}" />
                        </StackPanel>
                    </Border>
                    <!-- Visible search: the one entry to the command palette besides Ctrl+K -->
                    <Button Style="{StaticResource Btn.TitleBar}" Command="{Binding OpenSearchCommand}" ToolTip="{loc:T 'Поиск настроек, разделов и инструментов (Ctrl+K)'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:T ПОИСК}" Margin="7,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="Ctrl+K" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource F.Mono}" FontSize="11.5"
                                       FontWeight="Normal" FontStretch="Normal" Foreground="{StaticResource B.Text3}" />
                        </StackPanel>
                    </Button>
                    <!-- «ОТКАТ · 71 ▾»: the last batch and the journal, one click away on every page -->
                    <Button x:Name="UndoButton" Style="{StaticResource Btn.TitleBar}" Click="Undo_Click" ToolTip="{loc:T Откатить последний пакет изменений или открыть журнал}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding UndoButtonText}" Margin="7,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="7,1,0,0" Foreground="{StaticResource B.Text2}" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Placement="Bottom">
                                <MenuItem Header="{Binding LastBatchMenuText}" IsEnabled="{Binding HasLastBatch}" Command="{Binding RevertLastBatchCommand}" />
                                <MenuItem Header="{loc:T ОТКРЫТЬ ЖУРНАЛ ИЗМЕНЕНИЙ}" Command="{Binding OpenRestoreCenterCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Rectangle Width="1" Height="18" Fill="{StaticResource B.Line2}" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource Btn.Caption}" Content="&#xE921;" Click="Minimize_Click" ToolTip="{loc:T Свернуть}" />
                    <Button x:Name="MaxButton" Style="{StaticResource Btn.Caption}" Content="&#xE922;" Click="Maximize_Click" ToolTip="{loc:T Развернуть}" />
                    <Button Style="{StaticResource Btn.CaptionClose}" Content="&#xE8BB;" Click="Close_Click" ToolTip="{loc:T Закрыть}" />
                </StackPanel>
            </Grid>

            <!-- ═══════════════ Read-only strip (the one place that explains read-only mode) ═══════════════ -->
            <!-- One 28 px line: honest text (any change button asks for rights by itself and continues the action) + the shortcut. -->
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
            <Border Margin="10,6,10,2" Padding="9,0" Height="28" Background="{StaticResource B.Surface2}"
                    BorderBrush="{StaticResource B.Line2}" BorderThickness="1" CornerRadius="{StaticResource R.Lg}"
                    Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="22" Height="8" Background="{StaticResource B.HatchStrong}" CornerRadius="{StaticResource R.Xs}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="{loc:T РЕЖИМ ПРОСМОТРА}" FontFamily="{StaticResource F.Display}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource B.Text}" />
                        <Run Text="{loc:T ' — смотреть и проверять можно сразу; любая кнопка изменения сама попросит права и продолжит действие.'}" FontSize="12" Foreground="{StaticResource B.Text2}" />
                    </TextBlock>
                    <Button Grid.Column="2" Style="{StaticResource Btn}" Height="22" Padding="8,0" FontSize="11.5" Command="{Binding RestartAsAdminCommand}"
                            ToolTip="{loc:T Перезапустить Lycoris с правами администратора сейчас (запрос UAC)}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA18;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="{loc:T ПЕРЕЗАПУСТИТЬ С ПРАВАМИ}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══════════════ Operation note: why something did not start / is waiting (text, never only a tooltip) ═══════════════ -->
            <Border Margin="10,6,10,2" Padding="9,3" MinHeight="28" Background="{StaticResource B.Surface2}"
                    BorderBrush="{StaticResource B.Line2}" BorderThickness="1" CornerRadius="{StaticResource R.Lg}"
                    Visibility="{Binding CurrentPage.OperationNote, Converter={StaticResource NullToVis}, FallbackValue=Collapsed}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="22" Height="8" Background="{StaticResource B.HatchStrong}" CornerRadius="{StaticResource R.Xs}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource B.Text}"
                               Text="{Binding CurrentPage.OperationNote}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Btn}" Height="22" Padding="8,0" FontSize="12" Margin="0,0,6,0" Command="{Binding ToggleTasksCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="{loc:T ОТКРЫТЬ ЗАДАЧИ}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn}" Height="22" Padding="8,0" FontSize="12" Command="{Binding DismissOperationNoteCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="{loc:T ЗАКРЫТЬ}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            </StackPanel>

            <!-- ═══════════════ Sidebar ═══════════════ -->
            <Grid Grid.Row="2" Grid.RowSpan="2" Background="{StaticResource B.Surface}">
                <Rectangle Width="1" HorizontalAlignment="Right" Fill="{StaticResource B.Line}" />
                <DockPanel Margin="0,6,1,0">
                    <!-- Footer: settings -->
                    <Grid DockPanel.Dock="Bottom" Margin="0,0,0,14">
                        <!-- Same plate and marker as a selected nav item while Settings is open -->
                        <Border Margin="10,0,8,0" Height="34" Background="{StaticResource B.Surface2}" CornerRadius="{StaticResource R.Md}"
                                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                            <Rectangle Width="3" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{StaticResource B.White}"
                                       RadiusX="{StaticResource R.Xs.D}" RadiusY="{StaticResource R.Xs.D}" />
                        </Border>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="settings" ToolTip="{loc:T Настройки Lycoris}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="10,0,8,0" Height="34" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource F.Icons}" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{loc:T Настройки}" FontFamily="{StaticResource F.Body}" FontWeight="SemiBold" FontSize="13.5"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Button.Style>
                                <!-- A nav item, not a button: same plate as the list rows (no outline), foreground Text2 → Text -->
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Mono}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource R.Md}" Padding="10,0,8,0">
                                                    <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Surface3}" />
                                                        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Groups ОБЗОР · УСКОРЕНИЕ · ОБСЛУЖИВАНИЕ · ЗАЩИТА; a badge on the right = the page's own fact (PageViewModel.BadgeText) -->
                    <ListBox x:Name="NavList" Style="{StaticResource Nav.List}" ItemsSource="{Binding NavView}" SelectedItem="{Binding NavSelection}"
                             IsSynchronizedWithCurrentItem="False">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name, Converter={x:Static loc:LocConverter.Instance}}" Style="{StaticResource T.Label}" Margin="20,12,0,4" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource F.Icons}" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayTitle, Converter={StaticResource Sentence}}" FontFamily="{StaticResource F.Body}"
                                               FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2" Style="{StaticResource TabBadge}" Margin="8,0,0,0"
                                            Visibility="{Binding BadgeText, Converter={StaticResource NullToVis}}">
                                        <TextBlock Text="{Binding BadgeText}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>

            <!-- ═══════════════ Content ═══════════════ -->
            <Grid Grid.Row="2" Grid.Column="1" ClipToBounds="True">
                <ProgressBar VerticalAlignment="Top" IsIndeterminate="True" Height="2" Panel.ZIndex="5"
                             Visibility="{Binding CurrentPage.IsBusy, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}" Margin="24,16,24,14" Focusable="False">
                    <ContentControl.RenderTransform>
                        <TranslateTransform />
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>

            <Grid x:Name="WizardLayer" Grid.RowSpan="4" Grid.ColumnSpan="2" Panel.ZIndex="40" Background="#B8000000"
                  Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
                <Border Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Outline}" BorderThickness="1" CornerRadius="12"
                        Width="760" MaxHeight="640" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Step, StringFormat={loc:T 'ШАГ {0} ИЗ 3'}}" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Text3}"/>
                            <Grid Margin="0,8,0,0" Height="4">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="4" CornerRadius="2" Margin="0,0,6,0" Background="{StaticResource B.White}"/>
                                <Border Grid.Column="1" Height="4" CornerRadius="2" Margin="0,0,6,0"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource B.Line3}"/><Style.Triggers><DataTrigger Binding="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=2|3}" Value="Visible"><Setter Property="Background" Value="{StaticResource B.White}"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
                                <Border Grid.Column="2" Height="4" CornerRadius="2"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource B.Line3}"/><Style.Triggers><DataTrigger Binding="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=3}" Value="Visible"><Setter Property="Background" Value="{StaticResource B.White}"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
                            </Grid>
                            <TextBlock Text="{Binding StepTitle}" FontSize="26" FontWeight="SemiBold" Margin="0,14,0,14" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid Grid.Row="2">
                            <StackPanel>
                                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Step}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                <TextBlock Text="{loc:T Выберите основную цель. Мастер ничего не применяет.}" Style="{StaticResource T.Body}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <UniformGrid Columns="2" Margin="-6,0,-6,0">
                                    <RadioButton Style="{StaticResource Tile}" GroupName="WizGoal" Margin="6,0,6,10" Padding="14,12" IsChecked="{Binding Goal, Converter={StaticResource Equals}, ConverterParameter=Games}">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Static ui:Glyphs.Game}" FontFamily="{StaticResource F.Icons}" FontSize="22" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                            <StackPanel Grid.Column="1"><TextBlock Text="{loc:T Игры}" FontSize="16" FontWeight="SemiBold" Margin="0,0,80,0"/><TextBlock Text="{loc:T 'Игровой профиль и меньше лишнего в фоне'}" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text2}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource Tag.Solid}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,18,0" Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, Converter={StaticResource BoolToVis}}"><TextBlock Text="{loc:T ВЫБРАНО}"/></Border>
                                        </Grid>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Tile}" GroupName="WizGoal" Margin="6,0,6,10" Padding="14,12" IsChecked="{Binding Goal, Converter={StaticResource Equals}, ConverterParameter=Work}">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Static ui:Glyphs.Monitor}" FontFamily="{StaticResource F.Icons}" FontSize="22" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                            <StackPanel Grid.Column="1"><TextBlock Text="{loc:T Работа}" FontSize="16" FontWeight="SemiBold" Margin="0,0,80,0"/><TextBlock Text="{loc:T 'Тишина в фоне, чистый автозапуск'}" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text2}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource Tag.Solid}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,18,0" Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, Converter={StaticResource BoolToVis}}"><TextBlock Text="{loc:T ВЫБРАНО}"/></Border>
                                        </Grid>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Tile}" GroupName="WizGoal" Margin="6,0,6,10" Padding="14,12" Visibility="{Binding IsLaptop, Converter={StaticResource BoolToVis}}" IsChecked="{Binding Goal, Converter={StaticResource Equals}, ConverterParameter=LaptopBattery}">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Static ui:Glyphs.Battery}" FontFamily="{StaticResource F.Icons}" FontSize="22" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                            <StackPanel Grid.Column="1"><TextBlock Text="{loc:T Ноутбук от батареи}" FontSize="16" FontWeight="SemiBold" Margin="0,0,80,0" TextWrapping="Wrap"/><TextBlock Text="{loc:T 'Дольше работает от батареи'}" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text2}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource Tag.Solid}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,18,0" Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, Converter={StaticResource BoolToVis}}"><TextBlock Text="{loc:T ВЫБРАНО}"/></Border>
                                        </Grid>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Tile}" GroupName="WizGoal" Margin="6,0,6,10" Padding="14,12" IsChecked="{Binding Goal, Converter={StaticResource Equals}, ConverterParameter=Quiet}">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Static ui:Glyphs.Speaker}" FontFamily="{StaticResource F.Icons}" FontSize="22" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                            <StackPanel Grid.Column="1"><TextBlock Text="{loc:T Тихо и прохладно}" FontSize="16" FontWeight="SemiBold" Margin="0,0,80,0" TextWrapping="Wrap"/><TextBlock Text="{loc:T 'Меньше шума и нагрева'}" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text2}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource Tag.Solid}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,18,0" Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, Converter={StaticResource BoolToVis}}"><TextBlock Text="{loc:T ВЫБРАНО}"/></Border>
                                        </Grid>
                                    </RadioButton>
                                </UniformGrid>
                            </StackPanel>
                            <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Step}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Stretch"><UniformGrid Columns="2">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="WizMode" Content="{loc:T ПРОСТОЙ}" IsChecked="{Binding Simple}"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="WizMode" Content="{loc:T ЭКСПЕРТ}" IsChecked="{Binding Expert}"/>
                                </UniformGrid></Border>
                                <Grid Margin="2,8,2,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:T Понятные названия и короткие пояснения}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="8,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{loc:T Технические детали и риски}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="8,0,8,0"/>
                                </Grid>
                                <Border Style="{StaticResource Callout.Ok}" Padding="16,12" Margin="0,16,0,0"><StackPanel>
                                    <TextBlock Text="{loc:T Как мы гарантируем безопасность}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{x:Static ui:Glyphs.History}" FontFamily="{StaticResource F.Icons}" FontSize="13" Foreground="{StaticResource B.SuccessText}" Width="24" VerticalAlignment="Center"/><TextBlock Text="{loc:T Каждое изменение попадает в журнал}" VerticalAlignment="Center"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{x:Static ui:Glyphs.Undo}" FontFamily="{StaticResource F.Icons}" FontSize="13" Foreground="{StaticResource B.SuccessText}" Width="24" VerticalAlignment="Center"/><TextBlock Text="{loc:T Откат всегда на виду}" VerticalAlignment="Center"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{x:Static ui:Glyphs.Shield}" FontFamily="{StaticResource F.Icons}" FontSize="13" Foreground="{StaticResource B.SuccessText}" Width="24" VerticalAlignment="Center"/><TextBlock Text="{loc:T Точка восстановления Windows создаётся перед пакетом}" VerticalAlignment="Center"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="{x:Static ui:Glyphs.Lock}" FontFamily="{StaticResource F.Icons}" FontSize="13" Foreground="{StaticResource B.SuccessText}" Width="24" VerticalAlignment="Center"/><TextBlock Text="{loc:T Без прав администратора программа только смотрит}" VerticalAlignment="Center"/></StackPanel>
                                </StackPanel></Border>
                            </StackPanel>
                            <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Step}" Value="3"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                <Border Style="{StaticResource Card}" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T Ваш выбор}" Style="{StaticResource T.Label}" Foreground="{StaticResource B.Text3}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="{loc:T Цель}" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text3}" Width="80" VerticalAlignment="Center"/><TextBlock Text="{Binding GoalName}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="{loc:T Режим}" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Text3}" Width="80" VerticalAlignment="Center"/><TextBlock Text="{Binding ModeName}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{loc:T Настройки можно изменить позже. Ничего не будет применено автоматически.}" TextWrapping="Wrap" Margin="0,14,0,0" Style="{StaticResource T.Body}"/>
                            </StackPanel>
                        </Grid>
                        <DockPanel Grid.Row="3" Margin="0,18,0,0">
                            <Button Content="{loc:T НАЗАД}" Command="{Binding BackCommand}" Style="{StaticResource Btn}" DockPanel.Dock="Left" Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=2|3}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{loc:T ИГРЫ И ПРОФИЛИ}" Command="{Binding OpenGamesCommand}" Style="{StaticResource Btn}" Margin="0,0,8,0" Visibility="{Binding ShowGamesLink, Converter={StaticResource BoolToVis}}"/><Button Content="{loc:T ПРОПУСТИТЬ}" Command="{Binding SkipCommand}" Style="{StaticResource Btn}" Margin="0,0,8,0"/><Button Content="{loc:T ДАЛЕЕ}" Command="{Binding NextCommand}" Style="{StaticResource Btn.Primary}" Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=1|2}"/><Button Content="{loc:T 'ПОКАЗАТЬ, ЧТО УЛУЧШИТЬ'}" Command="{Binding FinishCommand}" Style="{StaticResource Btn.Primary}" Visibility="{Binding Step, Converter={StaticResource EqualsToVis}, ConverterParameter=3}"/></StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══════════════ Console ═══════════════ -->
            <!-- Shown only when expanded; the toggle lives in the status bar. An R.Lg panel aligned with the page content. -->
            <Border Grid.Row="3" Grid.Column="1" Margin="24,0,24,10" Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Line}"
                    BorderThickness="1" CornerRadius="{StaticResource R.Lg}" ui:RoundClip.Content="True"
                    Visibility="{Binding ConsoleExpanded, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="14,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="6" Height="6" Background="{StaticResource B.White}" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:T ЖУРНАЛ ДЕЙСТВИЙ}" Style="{StaticResource T.Label}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource T.Mono}" FontSize="11.5" Foreground="{StaticResource B.Text3}"
                                       Text="{Binding LogEntries.Count, StringFormat={loc:T 'СТРОК: {0}'}}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource Btn.Ghost}" Margin="0,0,6,0" Command="{Binding ClearConsoleCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="{loc:T ОЧИСТИТЬ}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn}" Command="{Binding ToggleConsoleCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="{loc:T СКРЫТЬ}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="ConsoleList" Grid.Row="1" Height="128" Style="{StaticResource List.Plain}" ItemsSource="{Binding LogEntries}"
                             Margin="14,0,8,8"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource T.Mono}" FontSize="11.5" Foreground="{StaticResource B.Text3}" />
                                    <TextBlock Grid.Column="1" Text="{Binding LevelTag}" FontFamily="{StaticResource F.Mono}" FontSize="11.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="Success">
                                                        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                                        <Setter Property="Foreground" Value="{StaticResource B.White}" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{Binding Display}" Style="{StaticResource T.Mono}" FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ═══════════════ Status bar (34 px) ═══════════════ -->
            <Grid Grid.Row="4" Grid.ColumnSpan="2" Background="{StaticResource B.Base}">
                <Rectangle Height="1" VerticalAlignment="Top" Fill="{StaticResource B.Line}" />
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Border Width="6" Height="6" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource B.Text3}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage.IsBusy}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource B.White}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11.5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource T.Mono}">
                                <Setter Property="Text" Value="{loc:T ГОТОВ}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage.IsBusy}" Value="True">
                                        <Setter Property="Text" Value="{Binding CurrentPage.BusyText}" />
                                        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource T.Mono}" FontSize="11.5" Foreground="{StaticResource B.Text3}"
                               Text="{Binding CurrentPage.CheckedText, StringFormat=· {0}}"
                               Visibility="{Binding CurrentPage.CheckedText, Converter={StaticResource NullToVis}, FallbackValue=Collapsed}" />
                </StackPanel>
                <!-- The in-app log: an outlined button («ЖУРНАЛ ДЕЙСТВИЙ · 2 ▴»), 26 px inside the 34 px bar -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center">
                <!-- «ЗАДАЧИ · N»: running and queued operations (installs, repairs, changes, cleanup); opens the list above the bar -->
                <Button Style="{StaticResource Btn}" Height="26" Padding="10,0" FontSize="12" Margin="0,0,8,0"
                        Command="{Binding ToggleTasksCommand}" ToolTip="{loc:T Что сейчас выполняется и что ждёт очереди}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding TasksButtonText}" VerticalAlignment="Center" />
                        <TextBlock FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="7,1,0,0" Foreground="{StaticResource B.Text2}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE70E;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TasksOpen}" Value="True">
                                            <Setter Property="Text" Value="&#xE70D;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Btn}" Height="26" Padding="10,0" FontSize="11.5" VerticalAlignment="Center"
                        Command="{Binding ToggleConsoleCommand}" ToolTip="{loc:T Показать или скрыть журнал действий Lycoris}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE756;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding LogEntries.Count, StringFormat={loc:T 'ЖУРНАЛ ДЕЙСТВИЙ · {0}'}}" VerticalAlignment="Center" />
                        <TextBlock FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="7,1,0,0" Foreground="{StaticResource B.Text2}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE70E;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConsoleExpanded}" Value="True">
                                            <Setter Property="Text" Value="&#xE70D;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                </StackPanel>
            </Grid>

            <!-- ═══════════════ Task list (opened by «ЗАДАЧИ · N»): an R.Xl panel above the status bar ═══════════════ -->
            <Border Grid.Row="2" Grid.RowSpan="3" Grid.Column="1" Width="480" MaxHeight="460" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,12,40" Panel.ZIndex="25" Background="{StaticResource B.Surface2}" BorderBrush="{StaticResource B.Line3}" BorderThickness="1"
                    CornerRadius="{StaticResource R.Xl}" ui:RoundClip.Content="True"
                    Visibility="{Binding TasksOpen, Converter={StaticResource BoolToVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.7" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Rectangle Height="4" Fill="{StaticResource B.White}" VerticalAlignment="Top" />
                    <Grid Margin="16,16,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T ЗАДАЧИ}" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Operations.Count, StringFormat=· {0}}" Style="{StaticResource T.Mono}" FontSize="12" Margin="8,0,0,0"
                                       Foreground="{StaticResource B.Text3}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Style="{StaticResource Btn}" HorizontalAlignment="Right" Command="{Binding CloseTasksCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="{loc:T ЗАКРЫТЬ}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding TasksSummary}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="16,8,16,10" />
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,0,0,10">
                        <ItemsControl ItemsSource="{Binding Operations}" Margin="8,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,8" Margin="0,2" CornerRadius="{StaticResource R.Md}" Background="{StaticResource B.Surface3}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Style="{StaticResource Tag.Muted}" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding ClassText}" />
                                                    </Border>
                                                    <Border Style="{StaticResource Tag.Solid}">
                                                        <TextBlock Text="{Binding StateText}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource T.BodyStrong}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding NoCancelText}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding HasNoCancelText, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource Btn}" VerticalAlignment="Top" Margin="10,0,0,0"
                                                    Command="{Binding DataContext.CancelOperationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                    <TextBlock Text="{loc:T ОТМЕНИТЬ}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ═══════════════ Toasts ═══════════════ -->
            <ItemsControl Grid.Row="2" Grid.RowSpan="2" Grid.Column="1" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right"
                          VerticalAlignment="Bottom" Margin="0,0,24,20" Panel.ZIndex="20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- R.Xl toast; the clip makes the accent bar follow the rounded left edge -->
                        <Border Width="400" Margin="0,8,0,0" Background="{StaticResource B.Surface3}" BorderBrush="{StaticResource B.Line3}" BorderThickness="1"
                                CornerRadius="{StaticResource R.Xl}" ui:RoundClip.Content="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.6" Color="Black" />
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle>
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Fill" Value="{StaticResource B.White}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Success"><Setter Property="Fill" Value="{StaticResource B.Success}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Info"><Setter Property="Fill" Value="{StaticResource B.Info}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Warning"><Setter Property="Fill" Value="{StaticResource B.Warning}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Error"><Setter Property="Fill" Value="{StaticResource B.Red}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <TextBlock Grid.Column="1" Text="{Binding Glyph}" FontFamily="{StaticResource F.Icons}" FontSize="15" Margin="14,14,0,0" VerticalAlignment="Top">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Success"><Setter Property="Foreground" Value="{StaticResource B.SuccessText}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Info"><Setter Property="Foreground" Value="{StaticResource B.InfoText}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Warning"><Setter Property="Foreground" Value="{StaticResource B.WarningText}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Error"><Setter Property="Foreground" Value="{StaticResource B.RedText}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="2" Margin="12,12,12,12">
                                    <TextBlock Text="{Binding Title}" Margin="0,0,0,3">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource T.H3}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Title}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Message}" Style="{StaticResource T.Body}" Foreground="{StaticResource B.Text}" FontSize="12.5" />
                                    <!-- Labelled buttons: «ОТКРЫТЬ» (when the toast points somewhere) and «ЗАКРЫТЬ» -->
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Style="{StaticResource Btn}" Margin="0,0,8,0" Visibility="{Binding NavigateTo, Converter={StaticResource NullToVis}}"
                                                Command="{Binding DataContext.OpenToastTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock Text="{loc:T ОТКРЫТЬ}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Btn.Ghost}"
                                                Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource F.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock Text="{loc:T ЗАКРЫТЬ}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ═══════════════ Command palette (Ctrl+K / «ПОИСК») — navigates only, never applies ═══════════════ -->
            <Grid x:Name="PaletteOverlay" Grid.Row="1" Grid.RowSpan="4" Grid.ColumnSpan="2" Panel.ZIndex="25" Background="{StaticResource B.Scrim}"
                  Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}" MouseLeftButtonDown="PaletteOverlay_MouseDown"
                  d:DataContext="{d:DesignInstance Type=shell:CommandPaletteViewModel}">
                <Border Width="620" Margin="0,64,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Background="{StaticResource B.Surface2}"
                        BorderBrush="{StaticResource B.Line3}" BorderThickness="1" CornerRadius="{StaticResource R.Xl}" ui:RoundClip.Content="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.8" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <Rectangle Height="4" Fill="{StaticResource B.White}" />
                        <TextBox x:Name="PaletteBox" Margin="16,16,16,12" Height="40" FontSize="14" Tag="{loc:T 'ПОИСК НАСТРОЕК, РАЗДЕЛОВ, ПРОГРАММ, ИНСТРУМЕНТОВ'}"
                                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
                        <ScrollViewer x:Name="PaletteScroll" MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <!-- Rows are inset R.Md plates (8 margin + 8 padding keeps the text on the 16 px gutter) -->
                            <ItemsControl x:Name="PaletteList" ItemsSource="{Binding Results}" Focusable="False" Margin="8,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type shell:PaletteResultItem}">
                                        <Border x:Name="Rw" Padding="8,9" Background="Transparent" Cursor="Hand" CornerRadius="{StaticResource R.Md}"
                                                MouseLeftButtonUp="PaletteRow_MouseUp">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle x:Name="Bar" Fill="{StaticResource B.White}" Visibility="Hidden" Width="3" Height="16" Margin="-8,0,0,0"
                                                           HorizontalAlignment="Left" VerticalAlignment="Center"
                                                           RadiusX="{StaticResource R.Xs.D}" RadiusY="{StaticResource R.Xs.D}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Entry.Title, Converter={StaticResource Sentence}}" Margin="10,0,12,0" VerticalAlignment="Center"
                                                           FontFamily="{StaticResource F.Display}" FontWeight="SemiBold" FontSize="14"
                                                           Foreground="{StaticResource B.Text}" TextTrimming="CharacterEllipsis" />
                                                <Border x:Name="Risk" Grid.Column="2" Margin="0,0,12,0" Style="{StaticResource Tag}"
                                                        Visibility="{Binding Entry.HasRisk, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding Entry.RiskText}" />
                                                </Border>
                                                <TextBlock Grid.Column="3" Text="{Binding Entry.KindText}" Style="{StaticResource T.Label}" FontSize="11"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Entry.Risk}" Value="Optional">
                                                <Setter TargetName="Risk" Property="Style" Value="{StaticResource Tag.Muted}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Entry.Risk}" Value="Advanced">
                                                <Setter TargetName="Risk" Property="Style" Value="{StaticResource Tag.Hatch}" />
                                            </DataTrigger>
                                            <Trigger SourceName="Rw" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Rw" Property="Background" Value="{StaticResource B.Surface3}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Rw" Property="Background" Value="{StaticResource B.Surface3}" />
                                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{loc:T НИЧЕГО НЕ НАЙДЕНО}" Style="{StaticResource T.Label}" Margin="16,6,16,10"
                                   Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}" />
                        <Rectangle Height="1" Fill="{StaticResource B.Line2}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding SelectedDescription}" Style="{StaticResource T.Caption}" TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" Margin="16,9,16,8" ToolTip="{Binding SelectedDescription}" />
                        <TextBlock Text="{loc:T '↑↓ ВЫБОР · ENTER ОТКРЫТЬ · ESC ЗАКРЫТЬ — ПОИСК ТОЛЬКО ОТКРЫВАЕТ, НИЧЕГО НЕ ПРИМЕНЯЕТ'}" Style="{StaticResource T.Mono}"
                                   FontSize="12" Foreground="{StaticResource B.Text3}" Margin="16,0,16,12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════════ Dialog ═══════════════ -->
            <Grid Grid.Row="1" Grid.RowSpan="4" Grid.ColumnSpan="2" Panel.ZIndex="30" Background="{StaticResource B.Scrim}"
                  Visibility="{Binding Dialog, Converter={StaticResource NullToVis}}">
                <Border Width="560" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource B.Surface2}"
                        BorderBrush="{StaticResource B.Line3}" BorderThickness="1" CornerRadius="{StaticResource R.Xl}" ui:RoundClip.Content="True"
                        DataContext="{Binding Dialog}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.8" Color="Black" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Rectangle Height="6" VerticalAlignment="Top">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Fill" Value="{StaticResource B.White}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource B.Red}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <StackPanel Margin="28,30,28,0">
                            <TextBlock Text="{Binding Title, Converter={StaticResource Sentence}}" Style="{StaticResource T.H1}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Message}" Style="{StaticResource T.Body}" Margin="0,10,0,0" />
                            <!-- Optional checkbox («Всегда запускать с правами») -->
                            <CheckBox Margin="0,14,0,0" IsChecked="{Binding OptionChecked}" Content="{Binding OptionText}"
                                      Visibility="{Binding HasOption, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <Border Grid.Row="1" Margin="28,16,28,0" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" Background="{StaticResource B.Surface}"
                                CornerRadius="{StaticResource R.Lg}" ui:RoundClip.Content="True"
                                Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                                <ItemsControl ItemsSource="{Binding Details}" Margin="14,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Width="5" Height="5" Fill="{StaticResource B.Text2}" VerticalAlignment="Top" Margin="0,7,0,0" HorizontalAlignment="Left" />
                                                <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource T.Body}" Foreground="{StaticResource B.Text}" FontSize="12.5" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <Grid Grid.Row="2" Margin="28,22,28,26">
                            <TextBlock Text="{Binding Footnote}" Style="{StaticResource T.Caption}" VerticalAlignment="Center" MaxWidth="250" HorizontalAlignment="Left" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}" Margin="0,0,10,0" MinWidth="110" IsCancel="True"
                                        Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVis}}" />
                                <Button Content="{Binding ExtraText}" Command="{Binding ExtraCommand}" Margin="0,0,10,0" MinWidth="110"
                                        Visibility="{Binding HasExtra, Converter={StaticResource BoolToVis}}" />
                                <!-- A destructive confirmation is a red outline (not the white main button) and is not the Enter default -->
                                <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" MinWidth="140" IsDefault="True" Style="{StaticResource Btn.Primary}"
                                        Visibility="{Binding IsDanger, Converter={StaticResource InverseBoolToVis}}" />
                                <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" MinWidth="140" Style="{StaticResource Btn.Danger}"
                                        Visibility="{Binding IsDanger, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
